SOLUTION 1
    temp 200
    pH 2 charge
    Fe(3) 4e-3
    Fe(2) 4e-3
KNOBS
    -iter 200
GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    -temperature 200
    H2S(g) 1
KINETICS 1
    Albite
        -m0 1
        -m 1
        -parms 1.0 10.0
        -time 1000 in 100
        -steps 10
        -tol 1e-12
USER_PUNCH
    -headings step I
    -start
    10 PUNCH STEP_NO, SI("H2O")
    -end
END