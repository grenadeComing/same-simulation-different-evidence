SOLUTION 1
    temp 25
    pH 7.0
    units mol/kgw

GAS_PHASE 1
    -fixed_pressure
    -temperature 25
    -pressure 1.0
    O2(g) -0.7

EQUILIBRIUM_PHASES 1
    Pyrite 0 0.1
    Goethite 0 0
    Gypsum 0 0

SELECTED_OUTPUT
    -file pyrite_alk2.sel
    -reset false
    -pH true
    -alkalinity true
END
