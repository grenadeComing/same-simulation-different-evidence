SOLUTION 1
    temp 25
    pH 7.0
    units mol/kgw
    pe 8

GAS_PHASE 1
    -fixed_pressure
    -temperature 25
    -pressure 1.0
    O2(g) -0.7

EQUILIBRIUM_PHASES 1
    O2(g) -0.7 10
    Pyrite 0 0.1
    Goethite 0 0
    Gypsum 0 0

SELECTED_OUTPUT
    -file pyrite_alk3.sel
    -pH true
    -alkalinity true
END
