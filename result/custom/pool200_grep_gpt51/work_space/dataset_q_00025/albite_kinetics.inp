TITLE Albite dissolution with Fe redox and H2S(g)
SOLUTION 1
    temp 200
    pH 2 charge
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4
    S(-2) 0
    C(4) 0
GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1.0
        -m  1.0
        -parms 1.0 10.0
        -steps 10 in 100
        -cvode
INCREMENTAL_REACTIONS true

SELECTED_OUTPUT
    -file albite_sel.out
    -reset false
    -step true
    -si Goethite
END