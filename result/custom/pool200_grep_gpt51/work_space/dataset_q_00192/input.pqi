SOLUTION 1
    temp      25
    pH        8.0
    pe        4
    units     ppm
    Ca        50
    Mg        12
    Na        20
    K         2
    Alkalinity 150 as HCO3
    S(6)      40
    Cl        15

REACTION 1
    H2O -1.0  # remove water
    50.0 moles

EQUILIBRIUM_PHASES 1
    Calcite   0 0
    Gypsum    0 0
    Halite    0 0

SELECTED_OUTPUT
    -reset false
    -solution 1
    -pe true
    -high_precision true
    -user_punch true

USER_PUNCH
    -headings pe
    10 PUNCH pe