SOLUTION 0-10
    pH 7 charge
    Ca 1
    Cl 2

SOLUTION 11
    pH 7 charge
    Na 1
    Cl 1

EXCHANGE 1-10
    X- 0.001

TRANSPORT
    -cells 10
    -shifts 10
    -length 1
    -time_step 1
    -flow_direction forward
    -boundary_conditions flux flux
    -initial_time 0
    -print_cells 4
    -print_frequency 10
    -punch_cells 4
    -punch_frequency 10

INCREMENTAL_REACTIONS true

SELECTED_OUTPUT
    -file trans.sel
    -molalities HCl
    -pH true
END
