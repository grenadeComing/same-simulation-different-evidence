SOLUTION 1 Pure water
    temp 150
    pH 7 charge
    pe 4
    units mol/kgw

GAS_PHASE 1 Fixed P gas mix
    -fixed_pressure true
    -pressure 1
    -temperature 150
    -volume 1
    CH4(g) 10
    CO2(g) 10
    NH3(g) 5

USER_PUNCH
    -headings sc
    10 PUNCH SC

SELECTED_OUTPUT
    -file sel.out
    -reset false
    -user_punch true
END
