SOLUTION 1
    temp 100
    pH 5 charge
    pe 4
    units mmol/kgw
    C(4) 0.5
    Mn 1

KINETICS 1
    Calcite
    -parms 10.0 1.0 0.001
    -m 1.0
    -steps 10*100
    -cvode false

INCREMENTAL_REACTIONS true
SELECTED_OUTPUT
    -file selected.out
    -time true
    -step true
    -pe true
END
