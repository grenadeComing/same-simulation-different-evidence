SOLUTION 1
    temp      200
    pH        2
    pe        4
    units     mmol/kgw
    Fe(2)     4
    Fe(3)     4

GAS_PHASE 1
    -fixed_pressure  true
    -pressure        1
    -temperature     200
    H2S(g)           5

KINETICS 1
    Albite
        -m0              1
        -parms           10 1.0
        -steps           10 100
        -cvode

RATES
    Albite
    -start
    10 k = PARM(1)
    20 ssa = PARM(2)
    30 moles = k * ssa
    40 SAVE moles
    -end

SELECTED_OUTPUT
    -file             albite_kinetics.sel
    -reset            false
    -time             true
    -kinetic_reactants  Albite
    -totals           Si
    -step

END