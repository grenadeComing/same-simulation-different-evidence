SOLUTION 1
    temp 200
    pH 2
    pe 4
    units mmol/kgw
    Cu 10
    Ba 5

KINETICS 1
    Calcite
        -m0 1
        -m 1
        -parms 1.0 1.0
        -steps 10 in 100
        -cvode

USER_PUNCH
    -headings step tot_C tot_Cu
    -start
    10 PUNCH STEP_NO, TOT("C(4)"), TOT("Cu(2)")
    -end
