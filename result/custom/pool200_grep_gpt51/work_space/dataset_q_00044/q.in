SOLUTION 1
    temp 100
    units mmol/kgw
    Ca 50
    pH 7 charge

EQUILIBRIUM_PHASES 1
    Calcite 0 0
    Gypsum 0 0
    Aragonite 0 0

GAS_PHASE 1
    -fixed_pressure
    -temperature 25
    -pressure 1
    CO2(g) 1
    CH4(g) 5
    H2S(g) 10

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -molalities true
    -si CaCO3
    -totals Ca C S

USER_PUNCH
    -headings kappa
    10 PUNCH SC

END
