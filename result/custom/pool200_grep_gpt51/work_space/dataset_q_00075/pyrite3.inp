SOLUTION 1
    temp 25
    pH 7 charge
    units mol/kgw

EQUILIBRIUM_PHASES 1
    Pyrite 0 0.1
    Goethite 0 0
    Gypsum 0 0

GAS_PHASE 1
    -fixed_pressure
    -temperature 25
    -pressure 1
    O2(g) -0.7

REACTION 1
    O2
    1.0
    0.4

USE solution 1
USE equilibrium_phases 1
USE gas_phase 1

SELECTED_OUTPUT
    -file pyrite3.sel
    -reset false
    -molalities SO4-2
    -high_precision true
END
