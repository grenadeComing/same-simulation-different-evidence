SOLUTION 1
    temp 200
    pH 2 charge
    Fe(3) 4e-3
    Fe(2) 4e-3

GAS_PHASE 1
    -fixed_pressure
    -temperature 200
    -pressure 5
    H2S(g) 1

KINETICS 1
    Albite
        -m0 1
        -m  1
        -parms 1.0 10
        -steps 1000 in 100
        -bad_step_max 1000

SELECTED_OUTPUT
    -file albite_kinetics2.sel
    -reset false
    -time true
    -step true
    -totals Na Al Si
    -kinetic_reactants Albite
