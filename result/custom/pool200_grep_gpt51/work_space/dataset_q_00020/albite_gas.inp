SOLUTION 1
    temp 200
    pH 2 charge
    units mol/kgw
    Fe(3) 4e-3
    Fe(2) 4e-3
    -water 1

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g)  0

KINETICS 1
    Albite
        -m0 1
        -m  1
        -parms 1.0 10.0
        -steps 10 in 100

SELECTED_OUTPUT
    -file albite.sel
    -reset false
    -time true
    -step true
    -totals Fe Na S Al

END
