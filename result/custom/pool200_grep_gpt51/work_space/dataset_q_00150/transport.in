TITLE Transport exchange problem
SOLUTION 0-10
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 0-10
    X- 0.001
SOLUTION 1
    pH 7.0
    Na 1.0
    Cl 1.0
EXCHANGE_SPECIES
    Na+ + X- = NaX
    log_k 0
    Ca+2 + 2X- = CaX2
    log_k 0
TRANSPORT
    -cells               10
    -shifts              10
    -time_step           1
    -lengths             10*1
    -boundary_conditions flux flux
    -initial_time        0
    -print_cells         1-10
    -print_frequency     1
    -punch_cells         1-10
    -punch_frequency     1
    -dump                dump
    -dump_frequency      1
    -dump_restart        false
SELECTED_OUTPUT
    -file                transport.sel
    -reset               false
    -time                true
    -step                true
    -state               true
    -totals              Ca Na Cl
    -molalities          Ca+2 Na+ Cl-
END