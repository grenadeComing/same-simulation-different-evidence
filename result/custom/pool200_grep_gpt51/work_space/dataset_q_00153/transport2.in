SOLUTION 0-10
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 11
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 0-10
    X- 0.001
    -equilibrate 11

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -length 1
    -boundary_conditions flux closed
    -print_cells 1-10
    -print_frequency 1

SELECTED_OUTPUT
    -file sel2.out
    -reset false
    -molalities NaX
    -totals Na
