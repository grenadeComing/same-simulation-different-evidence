TITLE Transport problem for H2O(g) SI

SOLUTION 0
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 1
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1
    X- 0.001

EQUILIBRIUM_PHASES 1
    H2O(g) 0 0

SOLUTION 2-10
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 2-10
    X- 0.001

EQUILIBRIUM_PHASES 2-10
    H2O(g) 0 0

TRANSPORT
    -cells               10
    -shifts              10
    -flow_direction      forward
    -lengths             10*1.0
    -time_step           1.0
    -boundary_conditions constant constant
    -print_cells         1-10
    -print_frequency     1

SELECTED_OUTPUT
    -file                sel.out
    -dist                false
    -solution            true
    -state               true
    -equilibrium_phases  true
    -si                  H2O(g)
END
