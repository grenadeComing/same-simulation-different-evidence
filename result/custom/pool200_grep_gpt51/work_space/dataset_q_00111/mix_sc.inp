SOLUTION 1 River
    pH 6.0
    units   mg/L
    temp    25
    Cl      10

SOLUTION 2 Seawater
    pH 8.1
    units   mg/L
    temp    25
    Cl      19000

MIX 1
    1 0.7
    2 0.3

USER_PUNCH
    -headings sc
    10 PUNCH SC

SELECTED_OUTPUT
    -file mix_sc.sel
    -reset false
    -user_punch true
END
