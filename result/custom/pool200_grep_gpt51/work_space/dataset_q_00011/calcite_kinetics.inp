SOLUTION 1
    temp 200
    pH 2
    pe 4
    units mmol/kgw
    Cu 10
    Ba 5
    C 0

KINETICS 1
    Calcite
        -m0 1
        -m 1
        -parms 1.0 1.0
        -tol 1e-12
        -steps 1000 in 100

SELECTED_OUTPUT
    -file calcite_CO2.sel
    -reset false
    -time true
    -step true
    -molalities CO2
END
