SOLUTION 0-10
    pH 7
    Ca 1
    Cl 2

SOLUTION 11
    pH 7
    Na 1
    Cl 1

EXCHANGE 0-10
    X- 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 1
    -boundary_conditions flux flux
    -dispersivities 0
    -initial_time 0
    -flow_direction forward
    -print_cells 3
    -print_frequency 1
    -punch_cells 3
    -punch_frequency 1

USER_PUNCH
    -head step Na_aq
    -start
    10 PUNCH TOT("Na"), ACT("Na+")
    -end
