SOLUTION 1
    temp      200
    pH        2 charge
    pe        4
    units     mmol/kgw
    Cu        0.01
    Ba        0.005

KINETICS 1
    Calcite
        -m0      1
        -parms   1.0 10.0
        -steps   1000 in 100 steps

RATES
    Calcite
    -start
    10 REM Parameters: parm(1) = surface area, parm(2) = rate constant
    20 area = parm(1)
    30 k = parm(2)
    40 rate = k * area
    50 moles = rate * TIME
    60 SAVE moles
    -end

INCREMENTAL_REACTIONS true

SELECTED_OUTPUT
    -file          sel_calcite_cu_ba.txt
    -reset         false
    -time          true
    -si            Witherite

END