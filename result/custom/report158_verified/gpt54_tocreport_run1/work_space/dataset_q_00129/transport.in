SOLUTION 0 Infilling
    pH      7.0
    units   mol/kgw
    Na      1.0
    Cl      1.0
SOLUTION 1-10 Initial
    pH      7.0
    units   mol/kgw
    Ca      1.0
    Cl      2.0
EXCHANGE 1-10
    X       0.001
    -equilibrate 1
TRANSPORT
    -cells              10
    -shifts             10
    -flow_direction     forward
    -boundary_conditions flux flux
    -correct_disp       false
    -diffusion_coefficient 0
    -dispersivities     0
    -lengths            1
    -print_cells        4
    -print_frequency    10
END
