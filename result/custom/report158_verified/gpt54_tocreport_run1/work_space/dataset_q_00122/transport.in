SOLUTION 0
    pH 7.0
    temp 25
    units mmol/kgw
    Na 1.0
    Cl 1.0
SOLUTION 1-10
    pH 7.0
    temp 25
    units mmol/kgw
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    equilibrate 1
    X 0.001
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -correct_disp true
    -dispersivities 0
    -lengths 1
    -time_step 1
    -punch_cells 1
    -punch_frequency 1
SELECTED_OUTPUT
    -reset false
    -simulation true
    -state true
    -solution true
    -distance true
    -time true
    -step true
    -pH true
    -totals Na Ca Cl
END
