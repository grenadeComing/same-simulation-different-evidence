SOLUTION 1
    temp      200
    pH        2
    pe        4
    redox     pe
    units     mmol/kgw
    Cu        10
    Ba        5

RATES
Calcite_rate
-start
10 rate = 10 * 1.0
20 moles = rate * TIME
30 SAVE moles
-end

KINETICS 1
    Calcite_rate
        -formula  CaCO3 1
        -m        1.0
        -m0       1.0
        -steps    1000 in 100 steps
        -cvode    false
        -tol      1e-6

PRINT
    -reset false
    -status false
    -species false
    -saturation_indices false
    -totals false

END
