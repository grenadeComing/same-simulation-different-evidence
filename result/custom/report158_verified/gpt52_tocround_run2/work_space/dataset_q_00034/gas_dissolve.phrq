SOLUTION 1
    temp 100
    units mmol/kgw
    pH 7 charge
    Ca 50

EQUILIBRIUM_PHASES 1
    Calcite 0 0
    Aragonite 0 0
    Gypsum 0 0

GAS_PHASE 1
    -fixed_pressure
    -temperature 25
    -pressure 1
    CO2(g) 1
    CH4(g) 5
    H2S(g) 10

SELECTED_OUTPUT
    -file sel.txt
    -reset false
USER_PUNCH
    -headings dCO2_mol dCH4_mol dH2S_mol
10 PUNCH (GAS("CO2(g)")*-1),(GAS("CH4(g)")*-1),(GAS("H2S(g)")*-1)
END
