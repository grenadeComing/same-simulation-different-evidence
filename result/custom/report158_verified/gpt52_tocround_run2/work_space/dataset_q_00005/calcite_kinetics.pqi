SOLUTION 1
    temp 200
    pH   2
    pe   4
    units mmol/kgw
    Cu   10
    Ba   5

KINETICS 1
    Calcite
        -m0 1.0
        -m  1.0
        -parms 1.0 10
        -steps 10 100
        -tol 1e-12

SELECTED_OUTPUT
    -file sel.tsv
    -reset false
    -time true
    -step true
    -molalities CO2
END
