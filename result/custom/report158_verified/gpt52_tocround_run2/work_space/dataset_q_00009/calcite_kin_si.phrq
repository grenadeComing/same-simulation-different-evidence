SOLUTION 1
    temp 200
    pH   2
    pe   4
    units mmol/kgw
    Cu   10
    Ba   5

KINETICS 1
    Calcite
        -m0 1
        -m  1
        -parms 1.0 10
        -steps 10 100*10
        -tol 1e-10

KNOBS
    -iterations 500

SELECTED_OUTPUT
    -file sel.txt
    -reset false
    -time true
    -step true
    -si Witherite
END
