TITLE 1D transport with exchange; query SI(H2O(g)) at cell 4 step 10

SOLUTION 0 Infilling
    pH 7.0
    Na 1.0
    Cl 1.0

SOLUTION 1-10 Initial cells
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001

# Equilibrate exchange sites with solution 1 in all cells
EQUILIBRATE 1
    Exchange 1-10 1

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -print_cells 4
    -print_frequency 10
    -punch_cells 4
    -punch_frequency 1

SELECTED_OUTPUT
    -file selected.csv
    -reset false
    -high_precision true

USER_PUNCH
    -headings step cell si_h2o_g
10 PUNCH STEP_NO, CELL_NO, SI("H2O(g)")

END
