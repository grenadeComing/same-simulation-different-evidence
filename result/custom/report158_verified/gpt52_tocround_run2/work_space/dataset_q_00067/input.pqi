TITLE 150C pure water equilibrated with fixed-pressure gas mixture CH4 CO2 NH3
SOLUTION 1
    temp 150
    pH 7 charge
    pe 4
    redox pe
    -water 1
GAS_PHASE 1
    -fixed_pressure true
    -pressure 1
    -temperature 150
    CH4(g) 0.4 10
    CO2(g) 0.4 10
    NH3(g) 0.2 5
SELECTED_OUTPUT
    -file selected.csv
    -reset false
USER_PUNCH
    -headings m_NH4 m_NH3
    10 PUNCH MOL("NH4+"), MOL("NH3")
END
