TITLE Albite kinetic dissolution, pH 2, 200C, Fe2/Fe3, fixed P H2S
SOLUTION 1
    temp 200
    pH 2 charge
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4
    -water 1

GAS_PHASE 1
    -fixed_pressure true
    -pressure 5
    H2S(g) 5

RATES
Albite_kin
-start
10 k = PARM(1)
20 sa = PARM(2)
30 rate = k*sa
40 moles = rate*TIME
50 if (moles > M) then moles = M
60 SAVE moles
-end

KINETICS 1
    Albite_kin
        -formula NaAlSi3O8 1
        -m0 1
        -parms 10 1.0
    -steps 1000 in 100 steps

SELECTED_OUTPUT
    -file selected.csv
    -reset false
    -time true
    -step true
    -totals Ba
END
