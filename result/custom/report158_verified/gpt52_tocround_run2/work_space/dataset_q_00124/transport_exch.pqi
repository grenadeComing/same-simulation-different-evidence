SOLUTION 1-10 Initial
    pH 7.0
    units mmol/kgw
    Ca 1.0
    Cl 2.0

SOLUTION 0 Infilling
    pH 7.0
    units mmol/kgw
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1
    -dispersivities 0
    -time_step 1
    -diffusion_coefficient 0

SELECTED_OUTPUT
    -file sel.txt
    -reset false
    -high_precision true

END
