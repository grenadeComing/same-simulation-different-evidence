SOLUTION 1
    temp 200
    pH 2
    pe 4
    units mmol/kgw
    Cu 10
    Ba 5
    Cl 30

KNOBS
    -iterations 1000

KINETICS 1
    Calcite
        -m0 1
        -m  1
        -parms 1.0 10
        -tol 1e-12
    -steps 10 in 100

SELECTED_OUTPUT
    -file sel.tsv
    -reset false
    -step true
    -pH true
END
