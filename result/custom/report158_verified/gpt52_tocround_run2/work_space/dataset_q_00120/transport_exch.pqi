TITLE 1D transport, cation exchange
SOLUTION 0 Infilling
    pH 7.0
    Na 1.0
    Cl 1.0
SOLUTION 1-10 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
    -equilibrate 1
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1
    -dispersivities 0
    -diffusion_coefficient 0
    -time_step 1
    -punch_frequency 1
SELECTED_OUTPUT
    -file selected.csv
    -reset false
    -high_precision true
USER_PUNCH
    -headings shift cell CaX2
10 PUNCH SHIFTS, CELL_NO, MOL("CaX2")
END
