SOLUTION 1
    temp 200
    pH   2
    pe   4
    units mmol/kgw
    Cu   10
    Ba   5
    -water 1

KINETICS 1
    Calcite
        -m0 1
        -m  1
        -parms 1.0 10
        -steps 10 in 100
        -tol 1e-12

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -time true
    -step true
    -totals Alkalinity
END
