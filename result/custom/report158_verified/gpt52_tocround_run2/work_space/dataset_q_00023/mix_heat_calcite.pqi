SOLUTION 1 DIC
    temp 20
    pH   7 charge
    units mmol/kgw
    C(4) 50
    -water 1
SOLUTION 2 CA
    temp 20
    pH   7 charge
    units mmol/kgw
    Ca   50
    -water 1

MIX 1
    1 0.5
    2 0.5

EQUILIBRIUM_PHASES 1
    Calcite 0 0

REACTION_TEMPERATURE 1
    20 200 in 10

SELECTED_OUTPUT
    -file sel.tsv
    -reset false
USER_PUNCH
    -headings step temp calcite_moles
    10 PUNCH STEP_NO, TC, EQUI("Calcite")
END
