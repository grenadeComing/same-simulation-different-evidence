TITLE 1D transport, Ca-Na exchange

SOLUTION 0  Infilling
    pH      7.0
    Na      1.0
    Cl      1.0

SOLUTION 1-10 Initial
    pH      7.0
    Ca      1.0
    Cl      2.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -step true

USER_PUNCH
    -headings step cell mol_CaX2 eqfrac_CaX2
10 PUNCH STEP_NO, CELL_NO, MOL("CaX2"), MOL("CaX2")/(MOL("NaX")+MOL("CaX2")+MOL("MgX2")+MOL("KX")+MOL("LiX")+MOL("NH4X")+MOL("SrX2")+MOL("BaX2")+MOL("MnX2")+MOL("FeX2")+MOL("CuX2")+MOL("ZnX2")+MOL("CdX2")+MOL("PbX2")+MOL("AlX3")+MOL("AlOHX2") )

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions flux flux
    -print_cells 1
    -punch_cells 1-10
    -punch_frequency 1
END
