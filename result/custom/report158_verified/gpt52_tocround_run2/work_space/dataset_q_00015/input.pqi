SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1
        -parms 10 1.0
        -tol 1e-10
    -steps 100*10

RATES
Albite
-start
10 k = PARM(1)
20 sa = PARM(2)
30 rate = k*sa
40 moles = rate*TIME
50 SAVE moles
-end

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -ionic_strength true
USER_PUNCH
    -headings step ionic_strength
10 PUNCH STEP_NO, IONIC_STRENGTH
END
