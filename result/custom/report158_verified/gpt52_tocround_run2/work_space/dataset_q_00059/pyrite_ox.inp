TITLE Pyrite oxidation equilibrium in pure water with O2(g), precip Goethite and Gypsum
SOLUTION 1
    temp 25
    pH 7.0 charge
    units mol/kgw
    -water 1
EQUILIBRIUM_PHASES 1
    Pyrite 0 0.1
    Goethite 0 0
    Gypsum 0 0
GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    O2(g) -0.7
SELECTED_OUTPUT
    -file sel.txt
    -reset false
    -high_precision true
USER_PUNCH
    -headings Fe3_species_count
10 PUNCH TOT("Fe(+3)")
END
