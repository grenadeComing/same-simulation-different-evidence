SOLUTION 1 Pure water
    temp 25
    pH 7
    -water 1

REACTION 1
    Pyrite 1
    0.1

GAS_PHASE 1
    -fixed_pressure
    -volume 1
    O2(g) -0.7

EQUILIBRIUM_PHASES 1
    Goethite 0 0
    Gypsum 0 0

SELECTED_OUTPUT
    -reset false
    -high_precision true
USER_PUNCH
    -headings SpCond_uScm
    10 PUNCH SC
END
