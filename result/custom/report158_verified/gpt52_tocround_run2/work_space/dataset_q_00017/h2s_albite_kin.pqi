SOLUTION 1
    temp 200
    pH 2 charge
    Fe(3) 4e-3
    Fe(2) 4e-3
    -water 1

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 1.0

KINETICS 1
    Albite
        -m0 1
        -m  1
        -parms 1.0 10
        -steps 10 100
        -tol 1e-12

SELECTED_OUTPUT
    -file sel.txt
    -reset false
USER_PUNCH
    -headings step H2S_gas_dissolved
10 PUNCH TOTAL_TIME/10, GAS("H2S(g)")
END
