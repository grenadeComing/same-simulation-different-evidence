TITLE 1D transport with exchange; report CaX2 equiv fraction at exchanger 1, step 6

SOLUTION 0  Infilling
    pH 7.0
    Na 1.0
    Cl 1.0

SOLUTION 1-10 Initial cells
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1
    -dispersivities 0
    -diffusion_coefficient 0
    -correct_disp true
    -punch_frequency 1

SELECTED_OUTPUT
    -reset false
    -high_precision false

USER_PRINT
-start
10 PUNCH "Step", TOT("time")
-end

END
