SOLUTION 1
    temp      200
    pH        2
    pe        4
    units     mmol/kgw
    Cu        10
    Ba        5
    -water    1

KINETICS 1
    Calcite
        -m0    1
        -m     1
        -parms 1.0 10
    -steps 10 in 100

SELECTED_OUTPUT
    -reset false
    -time true
    -pH true
END
