TITLE 1D transport with exchange; find eq frac CaX2 at exchanger 8 step 4

SOLUTION 0  Infilling
    pH 7.0
    Na 1.0
    Cl 1.0

SOLUTION 1-10 Initial cells
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1
    -dispersivities 0
    -correct_disp true

USER_PUNCH
    -headings step exch8_eqfrac_CaX2
    10 PUNCH STEP_NO, EQUI("CaX2", 8)/EQUI("X", 8)
END

SELECTED_OUTPUT
    -file selected.txt
    -reset false
    -step true
    -simulation true
    -state true
    -user_punch true
END
