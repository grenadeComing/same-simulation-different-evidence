SOLUTION 1
    temp 200
    pH 2
    pe 4
    units mmol/kgw
    Cu 10
    Ba 5

RATES
Calcite_custom
-start
10 k = PARM(1)
20 sa = PARM(2)
30 rate = k * sa
40 moles = rate * TIME
50 SAVE moles
-end

KINETICS 1
    Calcite_custom
        -formula CaCO3 1
        -m0 1
        -m  1
        -parms 10 1.0
        -steps 10 in 100
        -tol 1e-12
END
