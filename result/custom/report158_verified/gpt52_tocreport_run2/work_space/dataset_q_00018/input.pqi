SOLUTION 1
    temp      200
    pH        2 charge
    units     mmol/kgw
    Fe(3)     4
    Fe(2)     4

KINETICS 1
    Albite
        -m0 1
        -m  1
        -parms 10 1.0
        -tol 1e-12

RATES
Albite
-start
10 k = PARM(1)
20 sa = PARM(2)
30 rate = k*sa
40 moles = rate*TIME
50 SAVE moles
-end

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5

REACTION_TEMPERATURE 1
    200

USER_PRINT
-start
10 IF (STEP_NO = 100) THEN GOTO 100
20 GOTO 200
100 PRINT "SI_Goethite ", SI("Goethite")
200 END
-end

RUN_CELLS
    -cells 1

KINETICS
    -steps 10 in 100 steps
