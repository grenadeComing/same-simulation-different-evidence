SOLUTION 1
    temp 20
    units mmol/kgw
    C(4) 50
    pH 7 charge

SOLUTION 2
    temp 20
    units mmol/kgw
    Ca 50
    pH 7 charge

MIX 1
    1 0.5
    2 0.5

EQUILIBRIUM_PHASES 1
    Calcite 0 0

REACTION_TEMPERATURE 1
    20 200 in 10 steps

SELECTED_OUTPUT 1
    -file mix_calcite2.sel
    -reset false
    -temperature true
    -si Aragonite

RUN_CELLS
    -cells 1
