SOLUTION 1
    temp 200
    pH 2 charge
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4

GAS_PHASE 1
    -fixed_pressure
    -temperature 200
    -pressure 5
    H2S(g) 1

RATES
Albite
-start
10 k = 10
20 SA = 1.0
30 moles = k * SA * TIME
40 SAVE moles
-end

KINETICS 1
    Albite
        -m0 1
        -m  1
        -steps 10 in 100

SELECTED_OUTPUT
    -file albite_gas.sel
    -reset false
    -time true
    -step true
    -totals Ba
END