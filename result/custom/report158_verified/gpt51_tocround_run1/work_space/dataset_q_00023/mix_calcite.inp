SOLUTION 1
    temp 20
    pH 7 charge
    C(4) 0.05

SOLUTION 2
    temp 20
    pH 7 charge
    Ca 0.05

MIX 1
    1 1
    2 1

EQUILIBRIUM_PHASES 1
    Calcite 0 0

REACTION_TEMPERATURE 1
    20 200 in 10 steps

USER_PUNCH
    -headings step temp m_Calcite
    -start
    10 PUNCH STEP_NO, TC, MOL("Calcite")
    -end

SELECTED_OUTPUT
    -file mix_calcite.sel
    -reset false
    -user_punch true

RUN_CELLS
    -cells 1
    -time_step 1