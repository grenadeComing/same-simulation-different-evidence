SOLUTION 1
    temp 200
    pH 2 charge
    units mmol/kgw
    Fe(2) 4
    Fe(3) 4

GAS_PHASE 1
    -fixed_pressure
    -temperature 200
    -pressure 5
    H2S(g) 5

KINETICS 1
    Albite
    -m0 1.0
    -m 1.0
    -parms 10 1.0
    -steps 1000 in 100 steps

RATES
    Albite
    -start
    10 k = PARM(1)
    20 ssa = PARM(2)
    30 moles = k * ssa * TIME
    40 SAVE moles
    -end

INCREMENTAL_REACTIONS true

SELECTED_OUTPUT
    -file albite_h2s.sel
    -reset false
    -time true
    -step true
    -gas
END