SOLUTION 1
    temp 200
    pH 2
    pe 4
    Cu 0.01
    Ba 0.005
    units mol/kgw

KINETICS 1
    Calcite
        -m0 1.0
        -formula CaCO3 1
        -parms 10 1.0
        -steps 100*10

RATES
    Calcite
    -start
    10 k = PARM(1)
    20 ssa = PARM(2)
    30 rate = k * ssa
    40 SAVE rate
    -end

SELECTED_OUTPUT
    -file calcite_kinetics.sel
    -reset false
    -time true
    -pH true
    -step true

END
