SOLUTION 0-10
    pH 7.0
    units   mmol/kgw
    Ca      1.0
    Cl      2.0

SOLUTION 11
    pH 7.0
    units   mmol/kgw
    Na      1.0
    Cl      1.0

EXCHANGE 1-10
    X- 0.001
    -equilibrate 1

EQUILIBRIUM_PHASES 1-10
    H2O(g) 0 0

TRANSPORT
    -cells             10
    -shifts            10
    -time_step         1
    -length            1
    -boundary_conditions flux flux
    -dispersivities    0
    -initial_time      0
    -print_cells       1-10
    -print_frequency   1
    -punch_cells       1-10
    -punch_frequency   1

SELECTED_OUTPUT
    -file transport.sel
    -reset false
    -solution          true
    -si                H2O(g)
    -state             true
