SOLUTION 1
    temp 200
    pH 2
    pe 4
    Cu 0.01
    Ba 0.005
    units mol/kgw

KINETICS 1
    Calcite
        -m0 1
        -m  1
        -parms 1.0 1.0
        -tol 1e-12
        -time 1000 in 100

SELECTED_OUTPUT
    -file sel.out
    -reset false
    -time true
    -step true
    -si Witherite
END
