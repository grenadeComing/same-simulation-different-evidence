SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    units mmol/kgw
    Cu 10
    Ba 5

KINETICS 1
    Calcite
        -m0 1
        -m 1
        -parms 1.0 1.0
        -steps 10 in 100
        -tol 1e-8

SELECTED_OUTPUT
    -file sel_final.out
    -reset false
    -time true
    -si Witherite

KNOBS
    -iterations 500
    -tolerance 1e-12
END