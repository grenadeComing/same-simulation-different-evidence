SOLUTION 1 Pure water at 150C
    temp      150
    pH        7    charge
    pe        4
    water     1 # kg

GAS_PHASE 1 Fixed P gas mixture
    -fixed_pressure
    -temperature 150
    -pressure 1
    CH4(g)  10
    CO2(g)  10
    NH3(g)  5

SELECTED_OUTPUT
    -reset false
    -solution 1
    -pH true
END
