SOLUTION 0-10
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 11
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 0-10
    X- 0.001
    -equilibrate 1

EXCHANGE_SPECIES
    X- = X-
    Na+ + X- = NaX
        log_k 0
    Ca+2 + 2 X- = CaX2
        log_k 0

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 1
    -boundary_conditions flux flux
    -print_cells 1-10
    -print_frequency 1
    -punch_cells 1-10
    -punch_frequency 1
    -initial_time 0
    -flow_direction forward

SELECTED_OUTPUT
    -file transport_sel.out
    -reset false
    -pH true
    -equilibrium_phases false
    -totals Na Ca Cl
    -molalities NaX CaX2
    -high_precision true
