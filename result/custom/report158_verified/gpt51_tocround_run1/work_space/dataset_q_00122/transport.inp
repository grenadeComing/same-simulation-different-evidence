SOLUTION 0
    pH 7 charge
    Ca 1
    Cl 2

SOLUTION 1
    pH 7 charge
    Na 1
    Cl 1

SOLUTION 2-10
    pH 7 charge
    Ca 1
    Cl 2

EXCHANGE 1-10
    X- 0.001

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions flux flux
    -dispersivity 0
    -correct_disp false
    -lengths 1
    -print_cells 1
    -print_frequency 1
    -punch_cells 1
    -punch_frequency 1

SELECTED_OUTPUT
    -file selout.txt
    -reset false
    -time
    -step
    -totals Na