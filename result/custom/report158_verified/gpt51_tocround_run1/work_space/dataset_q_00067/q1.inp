SOLUTION 1 Pure water
    temp 150
    pH 7 charge
    pe 4
    units mol/kgw

GAS_PHASE 1
    -fixed_pressure
    -temperature 150
    -pressure 1
    CH4(g) 10
    CO2(g) 10
    NH3(g) 5

EQUILIBRIUM_PHASES 1
    CO2(g) 0 0
    CH4(g) 0 0
    NH3(g) 0 0

SELECTED_OUTPUT
    -file q1.sel
    -molalities NH3 NH4+
    -si NH3(g) CO2(g) CH4(g)
END
