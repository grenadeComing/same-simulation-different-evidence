SOLUTION 1 Pure water, 150C
    temp      150
    pH        7 charge
    pe        4
    units     mol/kgw
    water     1

GAS_PHASE 1 Fixed P CH4-CO2-NH3
    -fixed_pressure  1.0
    -temperature     150
    -pressure        1.0
    -volume          1.0
    CH4(g)  10
    CO2(g)  10
    NH3(g)   5

EQUILIBRIUM_PHASES 1

SELECTED_OUTPUT
    -reset false
    -alkalinity  true
    -high_precision true
    -totals   C N
END
