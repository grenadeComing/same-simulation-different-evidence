SOLUTION 1
    temp 25
    pH 7.0 charge
    units mol/kgw

GAS_PHASE 1
    -fixed_pressure true
    -pressure 1.0
    -volume 1.0
    O2(g) -0.7

EQUILIBRIUM_PHASES 1
    Pyrite 0 0.1
    Goethite 0 0
    Gypsum 0 0

SELECTED_OUTPUT
    -file pyrite_oxidation.sel
    -reset false
    -solution 1
    -si true
    -ionic_strength true
    -totals Fe S Ca
    -temperature true
    -high_precision true
END