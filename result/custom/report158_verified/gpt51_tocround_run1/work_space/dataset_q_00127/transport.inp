SOLUTION 0
    pH 7.0
    units mol/kgw
    temp 25
    Ca 1.0
    Cl 2.0

SOLUTION 1-10
    pH 7.0
    units mol/kgw
    temp 25
    Ca 1.0
    Cl 2.0

SOLUTION 1
    pH 7.0
    units mol/kgw
    temp 25
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X- 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 10*1
    -dispersivities 10*0
    -correct_disp false
    -diffusion_coefficient 0
    -print_cells 1-10
    -print_frequency 1
    -punch_cells 1-10
    -punch_frequency 1

SELECTED_OUTPUT
    -file transport.sel
    -reset false
    -time true
    -step true
    -solution true
    -molalities Ca+2