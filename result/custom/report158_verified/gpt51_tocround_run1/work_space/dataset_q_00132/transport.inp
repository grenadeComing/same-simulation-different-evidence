TITLE 1D cation exchange transport
SOLUTION 0
    pH 7.0
    Ca 1.0
    Cl 2.0
SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X- 0.001
EQUILIBRIUM_PHASES 1-10
    Calcite 0 0
SOLUTION 11
    pH 7.0
    Na 1.0
    Cl 1.0
EXCHANGE 11
    X- 0.001
EQUILIBRIUM_PHASES 11
    Calcite 0 0
TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 1
    -boundary_conditions flux flux
    -dispersivities 0
    -punch_cells 3
SELECTED_OUTPUT
    -file selout.txt
    -reset false
    -alkalinity true
END
