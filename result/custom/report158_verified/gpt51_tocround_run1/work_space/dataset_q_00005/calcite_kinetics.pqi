SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    Cu 0.01
    Ba 0.005

KINETICS 1
    Calcite
        -formula CaCO3 1
        -m0 1
        -parms 10 1.0
        -steps 10 in 100 steps
        -cvode false

RATES
    Calcite
    -start
    10 k = PARM(1)
    20 ssa = PARM(2)
    30 rate = k * ssa
    40 moles = rate * TIME
    50 SAVE moles
    -end

SELECTED_OUTPUT
    -file calcite_kinetics_sel.out
    -reset false
    -time true
    -step true
    -totals CO2
