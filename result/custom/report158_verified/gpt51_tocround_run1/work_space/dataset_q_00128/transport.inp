SOLUTION 0-10
    pH 7.0
    units mol/kgw
    Ca 1.0
    Cl 2.0

SOLUTION 11
    pH 7.0
    units mol/kgw
    Na 1.0
    Cl 1.0

EXCHANGE 0-10
    X- 0.001
    -equilibrate 1

EXCHANGE 11
    X- 0.001
    -equilibrate 11

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 1
    -flow_direction forward
    -boundary_conditions flux flux
    -print_cells 4
    -print_frequency 10
    -punch_cells 4
    -punch_frequency 10

SELECTED_OUTPUT
    -file transport.sel
    -reset false
    -totals Na
    -equilibrium_phases
    -molalities Na+
