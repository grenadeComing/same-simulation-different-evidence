SOLUTION 0
    pH 7.0
    units mmol/kgw
    Na 1.0
    Cl 1.0

SOLUTION 1-10
    pH 7.0
    units mmol/kgw
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 1
    -dispersivities 0
    -boundary_conditions flux flux
    -flow_direction forward
    -print_cells 1-10
    -print_frequency 1
    -punch_cells 1
    -punch_frequency 1

SELECTED_OUTPUT
    -file sel.out
    -reset false
    -step true
    -totals Na Ca Cl
    -si Calcite
    -ionic_strength true
END
