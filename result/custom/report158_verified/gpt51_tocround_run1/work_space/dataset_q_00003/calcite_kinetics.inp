SOLUTION 1
    temp 200
    pH 2
    pe 4
    units mmol/kgw
    Cu 10
    Ba 5

KINETICS 1
    Calcite
        -formula CaCO3 1
        -m0 1
        -parms 10 1.0
        -steps 100*10

RATES
Calcite
    -start
    10 rem  k (1), SA (2)
    20 rate = PARM(1) * PARM(2)
    30 SAVE rate
    80 END
    -end

SELECTED_OUTPUT
    -file calcite_kinetics.sel
    -reset false
    -high_precision true
    -time true
    -pH true

END
