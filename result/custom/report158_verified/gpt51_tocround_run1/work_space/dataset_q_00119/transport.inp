SOLUTION 0-10
    pH 7.0
    pe 4
    temp 25
    units mmol/kgw
    Ca 1.0
    Na 0.0
    Cl 2.0

SOLUTION 1
    pH 7.0
    pe 4
    temp 25
    units mmol/kgw
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 0.001

SELECTED_OUTPUT
    -file selout.txt
    -reset false
    -solution true
    -state true
    -totals Na Ca Cl
    -pe true

TRANSPORT
    -cells 10
    -shifts 10
    -lengths 10*1.0
    -time_step 1.0
    -flow_direction forward
    -boundary_conditions flux flux
    -initial_time 0.0
    -print_cells 10
    -print_frequency 1
    -punch_cells 10
    -punch_frequency 1
    -warnings false
    -dispersivities 10*0.0
    -correct_disp false
    -stagnant 0
    -multi_D false
    -flow_direction forward
    -boundary_conditions flux flux
END
