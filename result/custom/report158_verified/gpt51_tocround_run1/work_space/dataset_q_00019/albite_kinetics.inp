SOLUTION 1
    temp 200
    pH 2 charge
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 1

KINETICS 1
    Albite
        -m0 1.0
        -m  1.0
        -parms 1.0 10.0
        -steps 10 in 100

SELECTED_OUTPUT
    -file albite_si_species.out
    -reset false
    -high_precision true
    -totals Si
    -molalities Si

END
