SOLUTION 1
    temp 25
    pH 8.0
    units ppm
    Ca 50
    Mg 12
    Na 20
    K 2
    Alkalinity 150 as HCO3
    S(6) 40
    Cl 15
END

REACTION 1
    H2O -1.0
    50.0 moles
END

EQUILIBRIUM_PHASES 1
    Calcite 0 0
    Gypsum 0 0
    Halite 0 0
END

USER_PUNCH
    -headings viscosity
    10 PUNCH VISOCITY
END

SELECTED_OUTPUT
    -reset false
    -solution true
    -user_punch true
END

RUN_CELLS
    -cells 1
END
