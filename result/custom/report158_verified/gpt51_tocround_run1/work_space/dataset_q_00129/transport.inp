SOLUTION 1-10 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 0 Inflow
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X- 0.001

TRANSPORT
    -cells               10
    -shifts              10
    -time_step           1.0
    -length              1.0
    -flow_direction      forward
    -boundary_conditions flux
    -print_cells         4
    -print_frequency     10
    -punch_cells         4
    -punch_frequency     10

SELECTED_OUTPUT
    -file transport.sel
    -molalities HCl
    -step
END
