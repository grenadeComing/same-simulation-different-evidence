SOLUTION 0-10
    pH 7 charge
    Ca 1
    Cl 2

SOLUTION 11
    pH 7 charge
    Na 1
    Cl 1

EXCHANGE 1-10
    X- 0.001
    -equilibrate 0

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -lengths 1
    -dispersivities 0
    -correct_disp false
    -boundary_conditions flux flux
    -print_cells 1-10
    -print_frequency 1
    -punch_cells 1-10
    -punch_frequency 1
    -initial_time 0
    -time_step 1
    11  0

SELECTED_OUTPUT
    -file ex.out
    -reset false
    -step true
    -state true
    -totals Ca Na Cl
    -molalities Ca+2 Na+ Cl-
    -pH true
END
