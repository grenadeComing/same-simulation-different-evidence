SOLUTION 1
    temp 100
    units mmol/kgw
    Ca 50
    pH 7 charge

EQUILIBRIUM_PHASES 1
    Calcite 0 0
    Gypsum 0 0
    Aragonite 0 0

GAS_PHASE 1
    -temperature 25
    -pressure 16
    -fixed_pressure
    CO2(g) 1
    CH4(g) 5
    H2S(g) 10

SELECTED_OUTPUT
    -file q.sel
    -reset false
    -solution true
    -gas true
    -equilibrium_phases true
    -molalities CO2 CH4 H2S HS-
    -totals C(4) C(-4) S(-2)
END
