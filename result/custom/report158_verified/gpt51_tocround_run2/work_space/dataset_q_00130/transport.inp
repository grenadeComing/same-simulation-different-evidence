TITLE 1D transport 10 cells 10 shifts

SOLUTION 0
    pH 7.0
    units mol/kgw
    Ca 1.0
    Cl 2.0

SOLUTION 1-10
    pH 7.0
    units mol/kgw
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X- 0.001

EQUILIBRIUM_PHASES 1-10
    H2O(g) 0 0

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions constant constant
    -lengths 10
    -dispersivities 0
    -correct_disp true
    -print_cells 1-10
    -print_frequency 1
    -punch_cells 1-10
    -punch_frequency 1

SELECTED_OUTPUT
    -file trans.sel
    -reset false
    -time true
    -step true
    -solution true
    -si H2O(g)
END
