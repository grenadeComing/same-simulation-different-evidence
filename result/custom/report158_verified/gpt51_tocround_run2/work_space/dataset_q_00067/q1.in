SOLUTION 1
    temp 150
    pH 7 charge
    pe 4
    redox pe
    units mol/kgw

GAS_PHASE 1
    -fixed_pressure
    -pressure 1.0
    -temperature 150
    -volume 1.0
    CH4(g) 10
    CO2(g) 10
    NH3(g) 5

EQUILIBRIUM_PHASES 1
    CH4(g) 0 10
    CO2(g) 0 10
    NH3(g) 0 5

SELECTED_OUTPUT
    -reset false
    -molalities NH3 NH4+
    -pH true
END
