SOLUTION 1
    temp 200
    pH 2 charge
    Fe(3) 4e-3
    Fe(2) 4e-3

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    -temperature 200
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1
        -m 1
        -parms 1.0 1.0
        -time 1000 in 100 steps

SELECTED_OUTPUT
    -file albite_kinetic.sel
    -reset false
    -time true
    -molalities Fe+2 Fe+3 Na+ S(6) Al+3

END
