SOLUTION 1
    temp 200
    pH 2 charge
    Fe(3) 4e-3
    Fe(2) 4e-3

EQUILIBRIUM_PHASES 1
    Fix_H2S(g) 0 5

KINETICS 1
    Albite
        -formula NaAlSi3O8 1
        -m0 1
        -m 1
        -parms 10 1.0
        -steps 10*100 in 100 steps
        -runge_kutta 6

RATES
    Albite
    -start
    10 k = PARM(1)
    20 ssa = PARM(2)
    30 rate = k * ssa
    40 moles = rate * TIME
    50 SAVE moles
    -end

SELECTED_OUTPUT
    -file albite_kinetic.sel
    -reset false
    -time true
    -molalities Fe+2 Fe+3 Na+ S(6) Al+3

END
