SOLUTION 0
    temp      200
    pH        2 charge
    pe        4
    Cu        0.01
    Ba        0.005

SOLUTION 1
    temp      200
    pH        2 charge
    pe        4
    Cu        0.01
    Ba        0.005

EQUILIBRIUM_PHASES 1
    Calcite 0 1

KINETICS 1
    Calcite_kinetic
        -formula CaCO3 1
        -m0      1
        -parms   10 1.0
        -tol     1e-12

RATES
Calcite_kinetic
    -start
    10 k = PARM(1)
    20 ssa = PARM(2)
    30 rate = k * ssa
    40 moles = rate * TIME
    50 SAVE moles
    -end

INCREMENTAL_REACTIONS true

TRANSPORT
    -cells               1
    -shifts              100
    -time_step           10
    -flow_direction      forward
    -print_cells         1
    -print_frequency     1
    -punch_cells         1
    -punch_frequency     1

USER_PUNCH
    -head step pH
    10 PUNCH SIM_NO, -LA("H+")
END