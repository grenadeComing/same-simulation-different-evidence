SOLUTION 1
    temp 25
    pH 8
    units ppm
    Ca 50
    Mg 12
    Na 20
    K 2
    Alkalinity 150 as HCO3
    S(6) 40
    Cl 15

REACTION 1
    H2O -1
    50 moles

EQUILIBRIUM_PHASES 1
    Calcite 0 0
    Gypsum 0 0
    Halite 0 0

PRINT
    -reset false

USER_PUNCH
    -headings sc
    -start
    10 PUNCH SC
    -end

SELECTED_OUTPUT
    -file sel.out
    -reset false
    -user_punch true
END
