SOLUTION 1
    temp      200
    pH        2 charge
    units     mmol/kgw
    Fe(2)     4
    Fe(3)     4

GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    H2S(g)   5

KINETICS 1
    Albite  1.0
    -steps  10*100

RATES
    Albite
    -start
    10 k = 10
    20 ssa = 1.0
    30 rate = k * ssa
    40 moles = rate * TIME
    50 SAVE moles
    -end

INCREMENTAL_REACTIONS true

SELECTED_OUTPUT
    -file albite_h2s.sel
    -reset false
    -time true
    -step true
    -ionic_strength true
END