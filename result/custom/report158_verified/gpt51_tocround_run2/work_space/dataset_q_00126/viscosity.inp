SOLUTION 0-10 Initial
    pH 7.0
    units mol/kgw
    Ca 1.0
    Cl 2.0

SOLUTION 11 Infill
    pH 7.0
    units mol/kgw
    Na 1.0
    Cl 1.0

EXCHANGE_SPECIES
    X- = X-
        -log_k 0.0

EXCHANGE 0-10
    X- 0.001
    -equilibrate 1

SELECTED_OUTPUT
    -file vis_sel.csv
    -reset false
    -time true
    -distance true
    -solution true
    -step true
    -totals Na Ca Cl

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1.0
    -lengths 10*1.0
    -boundary_conditions flux flux
    -flow_direction forward
    -initial_time 0.0
    -print_cells 1-10
    -print_frequency 1
    -punch_cells 1-10
    -punch_frequency 1
    -correct_disp true
    -warnings true
END
