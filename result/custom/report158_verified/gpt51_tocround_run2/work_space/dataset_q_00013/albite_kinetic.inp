SOLUTION 1
    temp 200
    pH 2 charge
    Fe(2) 4e-3
    Fe(3) 4e-3
    units mol/kgw

GAS_PHASE 1
    -fixed_pressure true
    -pressure 1
    -volume 1
    H2S(g) 5

KINETICS 1
    Albite_kin
        -formula NaAlSi3O8 1
        -m0 1
        -parms 10 1.0
        -steps 10*100

RATES
Albite_kin
    -start
    10 k = PARM(1)
    20 ssa = PARM(2)
    30 rate = k * ssa
    40 moles = rate * TIME
    50 SAVE moles
    -end

SELECTED_OUTPUT
    -file albite_kinetic.sel
    -reset false
    -high_precision true
    -time true
    -totals Si

END