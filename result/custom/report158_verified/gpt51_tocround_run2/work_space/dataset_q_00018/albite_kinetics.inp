SOLUTION 1
    temp 200
    pH 2 charge
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 1

KINETICS 1
    Albite
        -m0 1
        -m 1
        -parms 1.0 10
        -steps 10 in 100
        -cvode

SELECTED_OUTPUT
    -file albite_kinetics.sel
    -reset false
    -time true
    -si Goethite
    -step true
    -pH true
    -totals Fe
