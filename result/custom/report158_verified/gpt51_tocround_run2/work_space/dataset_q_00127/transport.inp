TITLE 1D transport with cation exchange
SOLUTION 0
    pH 7.0
    Ca 1.0
    Cl 2.0
SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0
SOLUTION 11
    pH 7.0
    Na 1.0
    Cl 1.0
EXCHANGE 1-10
    X- 0.001
SELECTED_OUTPUT
    -file selout.csv
    -reset false
    -step true
    -solution true
    -molalities Ca+2
TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -length 1
    -boundary_conditions flux flux
    -dispersivities 0
    -initial_time 0
    -print_cells 1-10
    -print_frequency 1
    -punch_cells 1-10
    -punch_frequency 1
    -correct_disp false
    -flow_direction forward
END
RUN_CELLS
    -cells 1-10
    -solution 0
    -exchange 1-10
END
