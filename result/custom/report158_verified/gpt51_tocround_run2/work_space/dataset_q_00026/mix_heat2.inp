SOLUTION 1
    temp 20
    pH 7 charge
    units mmol/kgw
    C(4) 50

SOLUTION 2
    temp 20
    pH 7 charge
    units mmol/kgw
    Ca 50

MIX 1
    1 0.5
    2 0.5

EQUILIBRIUM_PHASES 1
    Calcite 0 0

REACTION_TEMPERATURE 1
    20 200 in 10

USER_PUNCH 1
    -headings Step Temp SI_Calcite SI_Aragonite
    -start
    10 PUNCH STEP_NO
    20 PUNCH TOT("temp")
    30 PUNCH SI("Calcite"), SI("Aragonite")
    -end

END