SOLUTION 0-10
    pH 7 charge
    Ca 1
    Cl 2

SOLUTION 11
    pH 7 charge
    Na 1
    Cl 1

EXCHANGE_SPECIES
    X- = X-
        log_k 0
    Na+ + X- = NaX
        log_k 0
    Ca+2 + 2 X- = CaX2
        log_k 0

EXCHANGE 1-10
    X- 0.001

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions constant constant
    -initial_time 0
    -print_cells 1-10
    -print_frequency 1
    -punch_cells 1-10
    -punch_frequency 1

SELECTED_OUTPUT
    -file transport.sel
    -reset false
    -step
    -totals Ca
    -molalities Ca+2
