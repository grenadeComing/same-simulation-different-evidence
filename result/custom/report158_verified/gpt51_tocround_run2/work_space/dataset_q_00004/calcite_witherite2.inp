SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    units mmol/kgw
    Cu 10
    Ba 5
    Na 0.1
    Cl 0.2

KINETICS 1
    Calcite
        -m0 1
        -m 1
        -parms 1.0 1.0
        -steps 10 in 100
        -tol 1e-12

RATES
    Calcite
        -start
        10 rate = 10 * PARM(1) * (10^SI("Calcite"))
        20 moles = rate * TIME
        30 SAVE moles
        -end

SELECTED_OUTPUT
    -file witherite_si.csv
    -reset false
    -time true
    -si Witherite Calcite
END