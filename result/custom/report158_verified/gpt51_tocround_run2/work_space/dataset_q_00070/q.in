SOLUTION 1
    temp      150
    pH        7 charge
    pe        4
    units     mol/kgw
    water     1

GAS_PHASE 1
    -fixed_pressure
    -pressure     1
    -temperature  150
    CH4(g) 10
    CO2(g) 10
    NH3(g) 5

SELECTED_OUTPUT
    -file q.sel
    -reset false
    -solution
    -totals CH4 CO2 N
    -pH true
    -ionic_strength true

USER_PUNCH
    -headings sc
    10 PUNCH SC
