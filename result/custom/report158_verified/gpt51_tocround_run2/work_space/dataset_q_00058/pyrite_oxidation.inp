SOLUTION 1
    temp 25
    pH 7.0 charge
    units mol/kgw
    water 1 # 1 kg water

EQUILIBRIUM_PHASES 1
    O2(g)   -0.7   10
    Pyrite  0.0    0.1
    Goethite 0.0  0
    Gypsum   0.0  0

SELECTED_OUTPUT
    -file pyrite_oxidation.sel
    -reset false
    -alkalinity true
    -pH true
    -totals Fe S O Ca
    -equilibrium_phases true
END