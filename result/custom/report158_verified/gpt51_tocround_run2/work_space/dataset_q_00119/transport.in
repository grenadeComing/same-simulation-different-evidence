SOLUTION 0-10
    pH 7.0
    pe 4
    Ca 1.0
    Cl 2.0

SOLUTION 11
    pH 7.0
    pe 4
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X- 0.001

TRANSPORT
    -cells               10
    -shifts              10
    -time_step           1.0
    -length              1.0
    -flow_direction      forward
    -boundary_conditions flux flux
    -dispersivities      0.0
    -initial_time        0.0
    -print_cells         10
    -print_frequency     1
    -punch_cells         10
    -punch_frequency     1

SELECTED_OUTPUT
    -file trans.sel
    -reset false
    -time
    -distance
    -solution 10
    -pe
END
