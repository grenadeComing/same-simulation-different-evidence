TITLE 1D transport, 10 cells, 10 shifts, cation exchange (0.001 mol sites each)

SOLUTION 0 Infilling
    pH 7.0
    Na 1.0
    Cl 1.0

SOLUTION 1-10 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

SELECTED_OUTPUT
    -reset false
    -high_precision true

USER_PUNCH
    -headings step cell eqfrac_CaX2
    10 PUNCH SIM_NO, CELL_NO, EQUIV_FRAC("CaX2")

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 10*1
    -flow_direction forward
    -boundary_conditions constant constant
    -dispersivity 0
    -diffusion_coefficient 0
    -punch_cells 1
    -punch_frequency 1
END
