TITLE 1D transport 10 cells 10 shifts with exchanger
SOLUTION 0 Infilling
    pH 7 charge
    Na 1.0
    Cl 1.0
SOLUTION 1-10 Initial
    pH 7 charge
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
END
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -diffusion_coefficient 0
    -dispersivities 0
    -correct_disp true
    -print_cells 1
    -print_frequency 1
SELECTED_OUTPUT
    -file selected.csv
    -reset false
    -high_precision true
USER_PUNCH
    -headings step cell Na
    10 PUNCH TRANSPORT_STEP_NO, CELL_NO, TOT("Na")
END
