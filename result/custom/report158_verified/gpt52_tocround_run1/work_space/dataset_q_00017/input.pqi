SOLUTION 1
    temp 200
    pH   2 charge
    Fe(3) 0.004
    Fe(2) 0.004
    -water 1

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 1.0

KINETICS 1
    Albite
        -m0 1
        -m  1
        -parms 1.0 10
        -steps 10 in 100
        -tol 1e-12

SELECTED_OUTPUT
    -file selected.csv
    -reset false
    -time true
    -step true
USER_PUNCH
    -headings H2S_dissolved
10 PUNCH GAS("H2S(g)")
END
