TITLE Pure water + fixed-pressure gas (CH4/CO2/NH3) at 150C
SOLUTION 1
    temp 150
    pH 7 charge
    pe 4
    units mol/kgw
    -water 1

GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    -temperature 150
    CH4(g) 10
    CO2(g) 10
    NH3(g) 5

SELECTED_OUTPUT
    -file selected.txt
    -reset false
USER_PUNCH
    -headings pH
    10 PUNCH -LA("H+")
END
