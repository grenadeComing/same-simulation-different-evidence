TITLE 1D transport: exchange in 10 cells, 10 shifts

SOLUTION 0  # infilling solution
    pH 7.0
    pe 0
    Na 1.0
    Cl 1.0

SOLUTION 1-10  # initial solutions
    pH 7.0
    pe 0
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions constant constant
    -lengths 1
    -time_step 1
    -dispersivities 0
    -diffusion_coefficient 0

SELECTED_OUTPUT
    -reset false
    -high_precision true
USER_PUNCH
    -headings shift pe_cell10
    10 PUNCH TOT("shift"), SOLN_PE(10)
END
