TITLE 1D transport, Na-Ca exchange

SOLUTION 0  Infilling
    pH 7.0
    Na 1.0
    Cl 1.0

SOLUTION 1-10  Initial
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001

# Equilibrate all cells with their initial solutions
EQUILIBRATE 1-10

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions constant constant
    -lengths 1
    -time_step 1
    -diffusion_coefficient 0
    -dispersivities 0
    -punch_cells 3

SELECTED_OUTPUT
    -file selected.out
    -reset false
    -high_precision true
    -simulation false
    -state false
    -solution true
USER_PUNCH
    -headings Na_act
10 PUNCH ACT("Na+")
