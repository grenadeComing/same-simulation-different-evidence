SOLUTION 1 River
    units mg/L
    pH 6.0
    Cl 10
SOLUTION 2 Seawater
    units mg/L
    pH 8.1
    Cl 19000
MIX 1
    1 0.7
    2 0.3
END
SELECTED_OUTPUT 1
    -file cl.sel
    -reset false
    -high_precision true
    -user_punch true
USER_PUNCH 1
    -headings Cl_m
    10 PUNCH MOL("Cl-")
END
RUN_CELLS
    -cells 1
END
