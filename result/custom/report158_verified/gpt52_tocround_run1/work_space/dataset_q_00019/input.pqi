TITLE Albite kinetics pH2 200C with H2S(g)
SOLUTION 1
    temp 200
    pH 2 charge
    Fe(3) 4e-3
    Fe(2) 4e-3
    -water 1
GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5
KINETICS 1
    Albite
        -m0 1
        -m  1
        -parms 1.0 10
    -steps 100*10
    -tol 1e-12
USER_PUNCH
    -headings step Si_aq_species_count
    10 PUNCH STEP_NO
    20 cnt = 0
    30 FOR i = 1 TO NSPECIES
    40   s$ = SPECIES_NAME$(i)
    50   IF (TOT("Si") > 0) THEN
    60     IF (SPECIES_MOLALITY(i) > 0) THEN
    70       IF (SPECIES_ELEMENT(i, "Si") > 0) THEN cnt = cnt + 1
    80     ENDIF
    90   ENDIF
    100 NEXT i
    110 PUNCH cnt
SELECTED_OUTPUT
    -reset false
    -high_precision true
    -step true
    -user_punch true
END
