SOLUTION 1
    temp 100
    units mmol/kgw
    pH 7 charge
    Ca 50

EQUILIBRIUM_PHASES 1
    Calcite 0 0
    Gypsum 0 0
    Aragonite 0 0

GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    -temperature 25
    CO2(g) 1
    CH4(g) 5
    H2S(g) 10

SELECTED_OUTPUT
    -file sel.txt
    -reset false

USER_PUNCH
    -headings Ca_aq_species_count
-start
10 count = 0
20 FOR i = 1 TO SPECIES
30   s$ = SPECIES$(i)
40   IF (INSTR(s$, "Ca") = 1) THEN
50     IF (MOL(s$) > 0) THEN
60       count = count + 1
70     ENDIF
80   ENDIF
90 NEXT i
100 PUNCH count
-end

END
