TITLE 1D transport, 10 cells, exchange
SOLUTION 0 Infilling
    pH 7.0
    Na 1.0
    Cl 1.0
SOLUTION 1-10 Initial cells
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
    -equilibrate 1
TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 1
    -dispersivities 0
    -boundary_conditions flux flux
    -print_cells 4
    -punch_cells 4
SELECTED_OUTPUT
    -file sel.csv
    -reset false
USER_PUNCH
    -headings step NaX
10 PUNCH STEP_NO, MOL("NaX")
END
