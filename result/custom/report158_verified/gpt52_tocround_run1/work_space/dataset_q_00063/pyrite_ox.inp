TITLE Pyrite oxidation in pure water with fixed O2; allow goethite and gypsum
SOLUTION 1
    temp 25
    pH 7 charge
    units mol/kgw
    -water 1
EQUILIBRIUM_PHASES 1
    O2(g) -0.7 10
    Pyrite 0 0.1
    Goethite 0 0
    Gypsum 0 0
SELECTED_OUTPUT
    -file pyrite_ox.sel
    -reset false
USER_PUNCH
    -headings Fe2_molal Fe3_molal
    10 PUNCH TOT("Fe(+2)"), TOT("Fe(+3)")
END
