SOLUTION 1
    temp 100
    pH 5
    units mmol/kgw
    Ba 100
    -water 1

EQUILIBRIUM_PHASES 1
    Talc 0 10
    Rhodochrosite 0 10
    Sepiolite 0 10
    Sepiolite(d) 0 10
    Pb(OH)2 0 10

REACTION 1
    NaCl 1
    0.1

SELECTED_OUTPUT
    -file selected.csv
    -reset false
    -ionic_strength true
END
