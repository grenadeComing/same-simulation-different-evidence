SOLUTION 1
    temp      100
    pH        5
    units     mmol/kgw
    Ba        100
    -water    1

EQUILIBRIUM_PHASES 1
    Talc            0   10
    Rhodochrosite   0   10
    Sepiolite       0   10
    Sepiolite(d)    0   10
    Pb(OH)2         0   10

SELECTED_OUTPUT
    -file selected.tsv
    -reset false
USER_PUNCH
    -headings Talc_mol Rhodo_mol Sepiolite_mol Sepiolite_d_mol PbOH2_mol
    10 PUNCH EQUI_DELTA("Talc"), EQUI_DELTA("Rhodochrosite"), EQUI_DELTA("Sepiolite"), EQUI_DELTA("Sepiolite(d)"), EQUI_DELTA("Pb(OH)2")
END
