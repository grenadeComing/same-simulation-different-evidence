TITLE Pyrite oxidation using O2(g) equilibrium; allow up to 0.1 mol pyrite; precipitate goethite/gypsum
SOLUTION 1
    temp 25
    pH 7 charge
    units mol/kgw
    water 1
EQUILIBRIUM_PHASES 1
    O2(g) -0.7 10
    Pyrite 0 0.1
    Goethite 0 0
    Gypsum 0 0
SELECTED_OUTPUT
    -file selected3.txt
    -reset false
    -pH true
END
