TITLE viscosity of solution 1 at transport step 6
SOLUTION 1-10
  pH 7.0
  Ca 1.0
  Cl 2.0
SOLUTION 0
  pH 7.0
  Na 1.0
  Cl 1.0
EXCHANGE 1-10
  X 0.001
EQUILIBRATE 1-10 with_solution 1
TRANSPORT
  -cells 10
  -shifts 10
  -time_step 1
  -flow_direction forward
  -boundary_conditions flux flux
  -initial_time 0
  -print_frequency 1
  -punch_frequency 1
SELECTED_OUTPUT
  -file selected.txt
  -reset false
USER_PUNCH
  -headings shift mu_sol1
10 IF (SHIFT = 6 AND CELL_NO = 1) THEN PUNCH SHIFT, MU
END
