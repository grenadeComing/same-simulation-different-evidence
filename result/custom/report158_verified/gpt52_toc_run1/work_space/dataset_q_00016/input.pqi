TITLE Albite kinetics with H2S(g) at 200C
SOLUTION 1
  temp 200
  pH 2 charge
  units mmol/kgw
  Fe(3) 4
  Fe(2) 4
  -water 1

GAS_PHASE 1
  -fixed_pressure true
  -pressure 5
  H2S(g) 5

KINETICS 1
  Albite
    -m0 1
    -parms 1.0 10
    -steps 1000 in 100
    -tol 1e-12

SELECTED_OUTPUT
  -file selected.txt
  -reset false
  -time true
  -step true
  -totals Ba
END
