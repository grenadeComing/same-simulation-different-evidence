SOLUTION 1 DIC
    temp 20
    pH 7 charge
    units mmol/kgw
    C(4) 50

SOLUTION 2 Ca
    temp 20
    pH 7 charge
    units mmol/kgw
    Ca 50

MIX 1
    1 0.5
    2 0.5
SAVE solution 10
END

USE solution 10
REACTION_TEMPERATURE 1
    20 200 in 10

EQUILIBRIUM_PHASES 1
    Calcite 0 0

SELECTED_OUTPUT
    -file mix_heat_calcite.sel
    -reset false
    -simulation true
    -state true
    -solution true
    -temperature true
    -ionic_strength true
    -si Calcite

USER_PUNCH
    -headings sim_no temp ionic_strength si_calcite
10 PUNCH SIM_NO, TC, IONIC_STRENGTH, SI("Calcite")

END
