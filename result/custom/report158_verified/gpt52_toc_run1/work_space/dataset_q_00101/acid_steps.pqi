SOLUTION 1 Pure water
    pH 7 charge
    temp 25
    -water 1

REACTION 1
    H2SO4 1
    0.001 0.005 0.01 0.05 0.1

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -ionic_strength true
USER_PUNCH
    -headings step ionic_strength pH totS
    10 PUNCH RXN, IONIC_STRENGTH, -LA("H+"), TOT("S")
END
