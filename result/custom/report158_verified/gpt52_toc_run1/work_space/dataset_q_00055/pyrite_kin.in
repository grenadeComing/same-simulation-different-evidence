SOLUTION 1
  temp 25
  pH 7 charge
  units mol/kgw
  -water 1

GAS_PHASE 1
  -fixed_pressure
  -pressure 1
  O2(g) -0.7

KINETICS 1
  Pyrite
    -m0 0.1
    -m  0.1
    -parms 0.3 0.67 0.5 -0.11
    -steps 1e9 in 1

EQUILIBRIUM_PHASES 1
  Goethite 0 0
  Gypsum 0 0

SELECTED_OUTPUT
  -file sel3.txt
  -reset false
  -si Pyrite
END
