TITLE Albite kinetics pH2 200C with Fe2/Fe3 and fixed P H2S
SOLUTION 1
    temp 200
    pH 2 charge
    units mol/kgw
    Fe(3) 0.004
    Fe(2) 0.004
    -water 1
GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5
KINETICS 1
    Albite
        -m0 1
        -m  1
        -parms 1.0 10
    -steps 10 100
    -cvode true
SELECTED_OUTPUT
    -file albite_kin.sel
    -reset false
    -high_precision true
USER_PUNCH
    -headings step mol_Fe mol_Na mol_S mol_Al
    10 PUNCH TOT("Fe"), TOT("Na"), TOT("S"), TOT("Al")
END