SOLUTION 1 Pure water pH 7, 25C
    temp 25
    pH 7 charge
    -water 1

GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    O2(g) -0.7

EQUILIBRIUM_PHASES 1
    Pyrite 0 0.1
    Goethite 0 0
    Gypsum 0 0

REACTION 1
    O2 1
    1 1

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -molalities H+
END
