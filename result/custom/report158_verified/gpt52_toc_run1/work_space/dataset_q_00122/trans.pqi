TITLE 1D transport: Ca/Cl initial, Na/Cl inflow, exchange all cells

SOLUTION 0  Inflow
    pH 7.0
    Na 1.0
    Cl 1.0

SOLUTION 1-10 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions constant constant
    -lengths 1
    -dispersivities 0
    -diffusion_coefficient 0
    -time_step 1
    -correct_disp true
    -multi_d true

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -solution true
    -totals Na Ca Cl
END
