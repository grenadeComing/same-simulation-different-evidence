TITLE Calcite kinetic dissolution 100C pH 5 pe 4
SOLUTION 1
    temp 100
    pH 5
    pe 4
    units mmol/kgw
    C(4) 0.5
    Mn 1
    -water 1

KINETICS 1
    Calcite
        -m0 1
        -m  1
        -parms 10.0  0.001
        -steps 10 in 100
        -tol 1e-10

SELECTED_OUTPUT
    -file calcite_kin.sel
    -reset false
    -time true
    -step true
    -pH true
END
