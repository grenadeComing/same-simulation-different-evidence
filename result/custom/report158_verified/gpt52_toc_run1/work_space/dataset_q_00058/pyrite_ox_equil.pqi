SOLUTION 1 Pure water pH 7
    temp 25
    pH 7 charge
    units mol/kgw
    -water 1

EQUILIBRIUM_PHASES 1
    O2(g)   -0.7  10
    Pyrite  0     0.1
    Goethite 0    0
    Gypsum   0    0

SELECTED_OUTPUT
    -file pyrite_ox_equil.sel
    -reset false
    -pH true
    -alkalinity true
    -totals S(6) Fe Ca
END
