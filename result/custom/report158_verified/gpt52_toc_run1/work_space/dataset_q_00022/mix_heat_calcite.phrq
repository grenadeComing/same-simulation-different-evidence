TITLE Mix DIC and Ca solutions 1:1 and heat to 200C with calcite equil

SOLUTION 1 DIC_solution
    temp 20
    pH 7 charge
    units mmol/kgw
    C(4) 50

SOLUTION 2 Ca_solution
    temp 20
    pH 7 charge
    units mmol/kgw
    Ca 50

MIX 1
    1 0.5
    2 0.5

EQUILIBRIUM_PHASES 1
    Calcite 0 0

REACTION_TEMPERATURE 1
    20 200 in 10

SELECTED_OUTPUT
    -file selected.txt
    -reset false

USER_PUNCH
    -headings Temp_C Calcite_delta_mol
    10 PUNCH TC, -EQUI("Calcite")

END
