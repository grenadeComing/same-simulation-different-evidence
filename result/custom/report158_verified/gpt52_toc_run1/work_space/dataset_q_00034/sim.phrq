TITLE 100C Ca solution equilibrated with calcite+gypsum+aragonite and mixed gas phase
SOLUTION 1
    temp 100
    pH 7 charge
    units mmol/kgw
    Ca 50
EQUILIBRIUM_PHASES 1
    Calcite 0 0
    Gypsum 0 0
    Aragonite 0 0
GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    -temperature 25
    CO2(g) 1
    CH4(g) 5
    H2S(g) 10
SELECTED_OUTPUT
    -file sel.txt
    -reset false
USER_PUNCH
    -headings n_CO2g_diss n_CH4g_diss n_H2Sg_diss
10 PUNCH GAS("CO2(g)")
20 PUNCH GAS("CH4(g)")
30 PUNCH GAS("H2S(g)")
END
