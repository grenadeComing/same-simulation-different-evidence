TITLE Mix 50 mM DIC with 50 mM Ca, 1:1; heat 20->200C; allow calcite ppt/diss
SOLUTION 1 DIC
    temp 20
    pH 7 charge
    units mmol/kgw
    C(4) 50
SOLUTION 2 Ca
    temp 20
    pH 7 charge
    units mmol/kgw
    Ca 50
MIX 1
    1 0.5
    2 0.5
SAVE solution 10
END

USE solution 10
EQUILIBRIUM_PHASES 1
    Calcite 0 0
REACTION_TEMPERATURE 1
    20 38 56 74 92 110 128 146 164 182 200
SELECTED_OUTPUT
    -file selected.txt
    -reset false
    -temperature true
    -si Calcite
USER_PUNCH
    -headings log_IAP_Calcite
10 PUNCH LOG10(ACT("Ca+2")*ACT("CO3-2"))
END
