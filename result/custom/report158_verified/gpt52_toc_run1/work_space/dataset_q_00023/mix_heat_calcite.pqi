TITLE Mix 50 mmol/kg DIC with 50 mmol/kg Ca 1:1; heat 20 to 200C; allow calcite ppt/dissolve
SOLUTION 1 DIC
    temp 20
    pH 7 charge
    units mmol/kgw
    C(4) 50
SOLUTION 2 Ca
    temp 20
    pH 7 charge
    units mmol/kgw
    Ca 50
MIX 1
    1 1
    2 1
EQUILIBRIUM_PHASES 1
    Calcite 0 0
REACTION_TEMPERATURE 1
    20 200 in 10
SELECTED_OUTPUT
    -file mix_heat_calcite_sel.tsv
    -reset false
    -temperature true
    -equilibrium_phases Calcite
END
