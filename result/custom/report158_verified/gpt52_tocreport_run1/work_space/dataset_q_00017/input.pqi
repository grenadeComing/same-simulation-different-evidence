TITLE Albite kinetics + fixed-pressure H2S(g)

SOLUTION 1
    temp 200
    pH 2 charge
    Fe(3) 0.004
    Fe(2) 0.004
    -water 1

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    -volume 1
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1
        -parms 1.0 10.0
        -tol 1e-10
        -steps 10 in 100 steps

RATES
Albite
-start
10 SA = PARM(1)
20 k  = PARM(2)
30 rate = k * SA
40 moles = rate * TIME
50 SAVE moles
-end

SELECTED_OUTPUT
    -reset false
    -time true
    -step true
    -gas H2S(g)
END

END
