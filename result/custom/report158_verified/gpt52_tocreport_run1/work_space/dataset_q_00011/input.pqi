SOLUTION 1
    temp 200
    pH   2 charge
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1
        -m  1
        -parms 1.0 10
        -time 1000 in 100
        -tol 1e-12

SELECTED_OUTPUT
    -reset false
USER_PUNCH
    -headings Albite_remaining
    10 PUNCH KIN("Albite")
END
