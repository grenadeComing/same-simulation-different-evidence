SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 0
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1
    -time_step 1
    -diffusion_coefficient 0
    -dispersivities 0

SELECTED_OUTPUT
    -reset false
    -high_precision false

USER_PUNCH
    -headings shift cell Na
10 PUNCH STEP_NO, CELL_NO, TOT("Na")

PRINT
    -reset false
END
