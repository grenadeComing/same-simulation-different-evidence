SOLUTION 1 DIC
    temp 20
    units mmol/kgw
    pH 7 charge
    C(4) 50
    -water 1

SOLUTION 2 Ca
    temp 20
    units mmol/kgw
    pH 7 charge
    Ca 50
    -water 1

MIX 1
    1 0.5
    2 0.5

EQUILIBRIUM_PHASES 1
    Calcite 0 0

REACTION_TEMPERATURE 1
    20 200 in 10

SELECTED_OUTPUT
    -reset false

END
