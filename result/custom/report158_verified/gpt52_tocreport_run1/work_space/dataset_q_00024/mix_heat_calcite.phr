SOLUTION 1
    temp 20
    pH 7 charge
    units mmol/kgw
    C(4) 50

SOLUTION 2
    temp 20
    pH 7 charge
    units mmol/kgw
    Ca 50

MIX 1
    1 0.5
    2 0.5
SAVE solution 10

REACTION_TEMPERATURE 1
    20 40 60 80 100 120 140 160 180 200

EQUILIBRIUM_PHASES 1
    Calcite 0 0

SELECTED_OUTPUT
    -reset false
USER_PUNCH
    -headings step temp ionic_strength
    10 PUNCH STEP_NO, TC, IONIC_STRENGTH
END
