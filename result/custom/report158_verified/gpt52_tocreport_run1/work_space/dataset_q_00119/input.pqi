TITLE 1D transport, exchange in 10 cells
SOLUTION 0 Infilling
    pH 7.0
    pe 4
    Na 1.0
    Cl 1.0
SOLUTION 1-10 Initial
    pH 7.0
    pe 4
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
    -equilibrate 1
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1
    -time_step 1
    -diffusion_coefficient 0
    -dispersivities 0
    -punch_cells 10
END
SELECTED_OUTPUT
    -reset false
    -high_precision true
USER_PUNCH
    -headings step sol10_pe
    10 PUNCH STEP_NO, LA("e-")
END
