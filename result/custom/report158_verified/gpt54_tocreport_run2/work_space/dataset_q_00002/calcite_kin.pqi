TITLE Calcite kinetic dissolution at 100 C
SOLUTION 1
    temp 100
    pH 5
    pe 4
    units mmol/kgw
    C(4) 0.5
    Mn 1
RATES
Calcite_custom
-start
10 k = PARM(1)
20 sa = PARM(2)
30 rate = k * sa
40 moles = rate * TIME
50 if (moles > M) then moles = M
60 SAVE moles
-end
KINETICS 1
    Calcite_custom
        -formula CaCO3 1
        -m0 1
        -m 1
        -parms 0.001 10.0
        -steps 1000 in 100
SELECTED_OUTPUT
    -reset false
    -simulation true
    -state true
    -solution true
    -distance true
    -time true
    -step true
    -si Aragonite Calcite
END
