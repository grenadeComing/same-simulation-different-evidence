SOLUTION 1
    temp 200
    pH 2 charge
    Fe(3) 4e-3
    Fe(2) 4e-3

GAS_PHASE 1
    -fixed_pressure
    -temperature 200
    -pressure 5
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1.0
        -m 1.0
        -parms 1.0 10.0
        -steps 10 in 100

USER_PUNCH
    -headings step SI_Goethite
    -start
    10 PUNCH KIN_TIME, SI("Goethite")
    -end

SELECTED_OUTPUT
    -file albite_goethite.sel
    -reset false
    -user_punch true
