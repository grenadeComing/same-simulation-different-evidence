SOLUTION 0
    pH 7.0
    Na 1.0
    Cl 1.0

SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001

TRANSPORT
    -cells 10
    -shifts 10
    -lengths 1
    -flow_direction forward
    -boundary_conditions constant constant
    -print_cells 1-10
    -print_frequency 1
    -punch_cells 1
    -punch_frequency 1

SELECTED_OUTPUT
    -file transport.sel
    -reset false
    -user_punch true

USER_PUNCH
    -head step Ca_molality
    10 PUNCH STEP_NO, MOL("Ca+2")