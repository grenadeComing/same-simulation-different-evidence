SOLUTION 1
    temp 200
    pH 2
    pe 4
    units mmol/kgw
    Cu 10
    Ba 5
EQUILIBRIUM_PHASES 1
    Calcite 0 1
KINETICS 1
    Calcite
        -m0 1
        -m  0
        -parms 10 1.0
        -steps 10 100*10
RATES
Calcite
-start
  10 k = PARM(1)
  20 ssa = PARM(2)
  30 rate = k * ssa
  40 moles = rate * TIME
  50 SAVE moles
-end
SELECTED_OUTPUT
    -file result.sel
    -pH true
USER_PUNCH
    -headings step pH
    10 PUNCH KIN_TIME, -LA("H+")/-LOG(10)
END