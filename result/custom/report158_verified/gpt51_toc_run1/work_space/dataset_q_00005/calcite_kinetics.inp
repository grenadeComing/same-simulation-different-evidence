TITLE Calcite kinetics with Cu and Ba at 200C

SOLUTION 1
    temp      200
    pH        2.0   charge
    pe        4
    units     mmol/kgw
    Cu        10
    Ba        5

EQUILIBRIUM_PHASES 1
    Calcite  0 1

KINETICS 1
    Calcite_kin
        -formula  CaCO3 1
        -m0       1
        -parms    10 1.0
        -steps    10*10
        -cvode    false

RATES
Calcite_kin
    -start
    10 k  = PARM(1)
    20 ssa = PARM(2)
    30 m  = MOL("Calcite_kin")
    40 if (m <= 0) then goto 200
    50 rate = k * ssa
    60 moles = rate * TIME
    70 if (moles > m) then moles = m
    80 SAVE moles
    200 END
    -end

SELECTED_OUTPUT
    -file calcite_kinetics_selout.txt
    -reset false
    -time true
    -pH true
    -totals CO2

END
