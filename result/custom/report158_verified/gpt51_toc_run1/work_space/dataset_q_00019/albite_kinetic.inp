SOLUTION 1
    temp 200
    pH 2 charge
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    -temperature 200
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1
        -m 1
        -parms 1.0 10
        -steps 1000 in 100 steps

SELECTED_OUTPUT
    -file albite_kinetic.sel
    -reset false
    -time true
    -step true
    -molalities SiO2
    -molalities H4SiO4
    -molalities H3SiO4-
    -molalities H2SiO4-2
    -molalities HSiO4-3
