SOLUTION 1 Pure water 150C pH 7
    temp 150
    pH 7 charge
EQUILIBRIUM_PHASES 1
    Chrysotile 0 10
    Talc 0 10
SELECTED_OUTPUT
    -file q.sel
    -reset false
    -totals Mg Si H
    -si Talc Chrysotile
    -ionic_strength true
    -temperature true
    -alkalinity true
    -charge_balance true
    -water true
USER_PUNCH
    -headings sc
10 PUNCH SC
END