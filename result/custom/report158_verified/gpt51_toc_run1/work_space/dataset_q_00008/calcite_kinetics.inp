SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    Cu 0.01
    Ba 0.005

KINETICS 1
    Calcite
        -m0 1.0
        -m 1.0
        -parms 1.0 1.0
        -formula CaCO3 1
        -steps 10*10
        -step_divide 1
        -tol 1e-12

SELECTED_OUTPUT
    -file sel_out.csv
    -reset false
    -time true
    -kinetic_reactants true
    -step true
