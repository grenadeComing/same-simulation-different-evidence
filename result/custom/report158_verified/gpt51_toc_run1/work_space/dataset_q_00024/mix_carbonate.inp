SOLUTION 1
    temp      20
    pH        7 charge
    units     mmol/kgw
    C(4)      50

SOLUTION 2
    temp      20
    pH        7 charge
    units     mmol/kgw
    Ca        50

MIX 1
    1 0.5
    2 0.5

EQUILIBRIUM_PHASES 1
    Calcite 0 0

REACTION_TEMPERATURE 1
    20 200 in 10 steps

SELECTED_OUTPUT 1
    -reset false
    -high_precision true
    -temperature true
    -ionic_strength true

USER_PUNCH 1
    -headings Step Temp I
    10 PUNCH STEP_NO, TOT("temperature"), IONIC_STRENGTH
END