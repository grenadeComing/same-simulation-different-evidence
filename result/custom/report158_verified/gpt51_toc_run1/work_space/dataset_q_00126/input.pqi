SOLUTION 0 Inflow
    pH 7.0
    Na 1.0
    Cl 1.0
SOLUTION 1-10 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X- 0.001
SELECTED_OUTPUT
    -file sel.out
    -reset false
    -high_precision true
USER_PUNCH
    -headings viscosity
    10 PUNCH VISCOSITY
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -initial_time 0
    -time_step 1
    -print_cells 1-10
    -print_frequency 1
    -punch_cells 1-10
    -punch_frequency 1
END