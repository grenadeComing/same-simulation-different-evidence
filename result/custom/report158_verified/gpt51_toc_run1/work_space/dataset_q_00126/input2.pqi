SOLUTION 1 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0
SOLUTION 0 Inflow
    pH 7.0
    Na 1.0
    Cl 1.0
EXCHANGE 1-10
    X- 0.001
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -initial_time 0
    -time_step 1
    -print_cells 1
    -print_frequency 1
END