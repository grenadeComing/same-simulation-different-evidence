SOLUTION 1
    temp 100
    pH 3 charge
    units mol/kgw

EQUILIBRIUM_PHASES 1
    K-mica 0 10
    Kaolinite 0 10
    Dolomite 0 10
    Epsomite 0 10
    Fe(OH)3(a) 0 10
    Halite 0 10

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -totals Na Cl Ca Mg C(4) K Fe Al S(6) Si
    -si Dolomite Epsomite Halite Kaolinite K-mica Fe(OH)3(a)

USER_PUNCH
    -headings sc
    10 PUNCH SC

END
