SOLUTION 1
    temp 100
    pH 3 charge

EQUILIBRIUM_PHASES 1
    K-mica 0 10
    Kaolinite 0 10
    Dolomite 0 10
    Epsomite 0 10
    Fe(OH)3(a) 0 10
    Halite 0 10

SELECTED_OUTPUT
    -file sel.out
    -molalities Fe+2 Fe+3
    -totals Fe(+2) Fe(+3)
    -pH true
    -temperature true
    -high_precision true
    -equilibrium_phases true
    -saturation_indices true
END