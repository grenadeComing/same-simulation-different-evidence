SOLUTION 1
    temp 20
    units mmol/kgw
    C(4) 50

SOLUTION 2
    temp 20
    units mmol/kgw
    Ca 50

MIX 1
    1 1
    2 1

EQUILIBRIUM_PHASES 1
    Calcite 0 0

REACTION_TEMPERATURE 1
    20 200 in 10 steps

USE solution 1
USE equilibrium_phases 1

SELECTED_OUTPUT
    -file mix_calcite.sel
    -reset false
    -si Calcite
    -totals Ca C
    -equilibrium_phases Calcite
    -molalities Ca+2 CO3-2 HCO3-
