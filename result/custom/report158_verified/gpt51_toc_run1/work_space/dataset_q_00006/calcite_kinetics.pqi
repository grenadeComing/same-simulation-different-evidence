SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    Cu 10e-3
    Ba 5e-3

KINETICS 1
    Calcite_kin
        -formula CaCO3 1
        -m0 1
        -parms 10 1.0
        -steps 1000 in 100 steps
        -cvode false

RATES
Calcite_kin
-start
10 k = PARM(1)
20 ssa = PARM(2)
30 rate = k * ssa
40 moles = rate * (TIME - TIME_PREV)
50 SAVE moles
-end

USER_PUNCH
    -head step alkalinity
    10 PUNCH KIN_TIME, TOT("Alkalinity")

END
