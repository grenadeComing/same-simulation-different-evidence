SOLUTION 1
    temp 25
    pH 7.0
    pe 4
    redox pe

EQUILIBRIUM_PHASES 1
    Pyrite 0 0.1
    Goethite 0 0
    Gypsum 0 0

GAS_PHASE 1
    -fixed_pressure
    -temperature 25
    -pressure 1.0
    O2(g)  -0.7

SELECTED_OUTPUT
    -file pyrite_sel.out
    -pe true
    -pH true
    -totals Fe S O(0)
END