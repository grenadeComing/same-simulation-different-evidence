SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 0
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 0.001

EXCHANGE_SPECIES
    Ca+2 + 2X- = CaX2
        log_k     0.0
    Na+ + X- = NaX
        log_k     0.0

SELECTED_OUTPUT
    -file selout.txt
    -reset false
    -step true
    -totals Ca Na Cl

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 1
    -dispersivities 0
    -flow_direction forward
    -print_cells 1-10
    -print_frequency 1
    -punch_cells 1-10
    -punch_frequency 1
    -boundary_conditions constant constant
    -initial_time 0
    -warnings true
