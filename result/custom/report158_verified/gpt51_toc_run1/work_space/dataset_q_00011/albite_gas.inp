SOLUTION 1
    temp 200
    pH 2 charge
    Fe+3 0.004
    Fe+2 0.004

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    -temperature 200
    H2S(g) 1

KINETICS 1
    Albite
        -m0 1
        -m 1
        -parms 1.0 10.0
        -steps 10 in 100
        -cvode

SELECTED_OUTPUT
    -file albite_sel.out
    -reset false
    -high_precision true
    -time true
    -step true
    -kinetic_reactants Albite
