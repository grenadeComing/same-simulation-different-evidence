SOLUTION 1
    temp 150
    pH 7 charge
    pe 4
    water 1 # kg

GAS_PHASE 1
    -fixed_pressure
    -temperature 150
    -pressure 1
    -volume 1
    CH4(g)   10
    CO2(g)   10
    NH3(g)    5

SELECTED_OUTPUT
    -file sel.out
    -reset false
    -high_precision true
    -gases CH4(g) CO2(g) NH3(g)

USER_PUNCH
    -headings delta_CH4
    10 PUNCH GAS("CH4(g)") - 10.0
END