SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    Cu 0.01
    Ba 0.005
EQUILIBRIUM_PHASES 1
    Calcite 0 1
SAVE solution 1
SAVE equilibrium_phases 1

KINETICS 1
    Calcite 1 moles
    -steps 100*10
    -bad_step_max 100

RATES
Calcite
-start
10 k = 10
20 ssa = 1.0
30 m = M
40 IF (m <= 0) THEN GOTO 80
50 SIc = SI("Calcite")
60 rate = k * ssa * (1 - 10^SIc)
70 GOTO 90
80 rate = 0
90 moles = rate * TIME
-end

USER_PUNCH
    -headings step SI_Witherite
    10 PUNCH STEP_NO, SI("Witherite")

TRANSPORT
    -cells 1
    -shifts 100
    -time_step 10
    -lengths 1
    -dispersivities 0
    -correct_disp false
    -print_cells 1
    -print_frequency 1
    -punch_cells 1
    -punch_frequency 1

END