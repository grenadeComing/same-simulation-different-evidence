SOLUTION 0-10
    pH 7.0
    Ca 1.0
    Cl 2.0 charge

SOLUTION 11
    pH 7.0
    Na 1.0
    Cl 1.0 charge

EXCHANGE 0-10
    X- 0.001
    -equilibrate 1

TRANSPORT
    -cells               10
    -shifts              10
    -time_step           1
    -length              1
    -boundary_conditions flux flux
    -initial_time        0
    -print_cells         1-10
    -print_frequency     1

SELECTED_OUTPUT
    -file                selout2.txt
    -reset               false
    -step
    -time
    -totals              Na Ca Cl
    -molalities          NaX
