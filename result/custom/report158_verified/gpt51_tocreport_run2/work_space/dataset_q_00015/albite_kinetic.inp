SOLUTION 1
    temp 200
    pH 2 charge
    Fe(3) 0.004
    Fe(2) 0.004

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 1

KINETICS 1
    Albite
        -m0 1
        -m 1
        -parms 1.0 10
        -steps 10 sec in 100

SELECTED_OUTPUT
    -file sel.out
    -reset false
    -time true
    -high_precision true
    -step true
    -si true
    -ionic_strength true
END