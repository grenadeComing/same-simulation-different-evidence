TITLE 1D cation exchange transport problem with selected output

SOLUTION 0
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 11
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

SELECTED_OUTPUT
    -file sel.out
    -reset false
    -simulation true
    -state true
    -step true
    -cell true
    -totals Ca Na Cl
    -equilibrium_phases true
    -molalities Ca+2 Na+ CaX2 NaX
    -activities Ca+2 Na+ 

TRANSPORT
    -cells               10
    -shifts              10
    -time_step           1.0
    -flow_direction      forward
    -boundary_conditions constant flux
    -lengths             1*1.0
    -dispersivities      0.0
    -correct_disp        false
    -initial_time        0.0
    -print_frequency     1
    -punch_frequency     1
    -warnings            true

PRINT
    -reset false

END
