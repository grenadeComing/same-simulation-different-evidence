TITLE 1D cation exchange transport problem with printing

SOLUTION 0
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 11
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

USER_PRINT
    -start
    10 PRINT "Step ", KIN_TIME
    20 FOR I = 1 TO 10
    30 PRINT "Cell ", I, " EX CaX2 ", EXCHANGE("CaX2", I)
    40 NEXT I
    -end

TRANSPORT
    -cells               10
    -shifts              10
    -time_step           1.0
    -flow_direction      forward
    -boundary_conditions constant flux
    -lengths             1*1.0
    -dispersivities      0.0
    -correct_disp        false
    -initial_time        0.0
    -print_frequency     1
    -punch_frequency     1
    -warnings            true

PRINT
    -reset false

END
