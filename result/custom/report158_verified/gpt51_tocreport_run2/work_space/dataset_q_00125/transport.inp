SOLUTION 0
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 1
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 1e-3

EXCHANGE_SPECIES
    Ca+2 + 2X- = CaX2
        log_k 0
    Na+ + X- = NaX
        log_k 0

TRANSPORT
    -cells                 10
    -shifts                10
    -time_step             1.0
    -flow_direction        forward
    -boundary_conditions   constant constant
    -initial_time          0.0
    -lengths               10*1.0
    -dispersivities        10*0.0
    -print_cells           1-10
    -print_frequency       1

SELECTED_OUTPUT
    -file                  selout.txt
    -reset                 false

USER_PUNCH
    -head                  step cell equilfrac_CaX2
    10 PUNCH KIN_TIME, ICELL, EQUIFRACTION("CaX2")

END