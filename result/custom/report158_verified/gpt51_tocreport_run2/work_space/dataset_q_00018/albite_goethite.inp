SOLUTION 1
    temp 200
    pH 2 charge
    Fe(2) 4e-3
    Fe(3) 4e-3
    units mol/kgw

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    -temperature 200
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1
        -m 1
        -parms 1.0 10
        -steps 10 in 100
        -cvode

PRINT
    -reset false

USER_PRINT
    10 PRINT "Time step ", KIN_TIME, " s"
    20 PRINT "SI Goethite ", SI("Goethite")
END