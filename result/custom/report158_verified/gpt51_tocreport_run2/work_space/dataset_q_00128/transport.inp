TITLE Transport problem with exchange

SOLUTION 0-10
    pH 7.0
    Ca 1.0
    Cl 2.0
    units mmol/kgw
    water 1.0

SOLUTION 11
    pH 7.0
    Na 1.0
    Cl 1.0
    units mmol/kgw
    water 1.0

EQUILIBRIUM_PHASES 1
    Calcite 0 0

EXCHANGE 0-10
    X 0.001
    -equil 1

EXCHANGE_SPECIES
    Na+ + X- = NaX
        log_k 0.0
    Ca+2 + 2X- = CaX2
        log_k 0.0

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1.0
    -lengths 1*10
    -flow_direction forward
    -boundary_conditions flux flux
    -dispersivities 0.0
    -correct_disp true
    -initial_time 0.0
    -print_cells 1-10
    -print_frequency 1
    -punch_cells 1-10
    -punch_frequency 1
    -warnings false

PRINT
    -exchange true
    -selected_output false

END