TITLE 1D transport with Na-Ca exchange; want NaX at cell 4, step 10

SOLUTION 0
    pH 7.0
    Ca 1.0 mmol/kgw
    Cl 2.0 mmol/kgw
    water 1.0

SOLUTION 1-10
    pH 7.0
    Ca 1.0 mmol/kgw
    Cl 2.0 mmol/kgw
    water 1.0

SOLUTION 11
    pH 7.0
    Na 1.0 mmol/kgw
    Cl 1.0 mmol/kgw
    water 1.0

EXCHANGE_SPECIES
    Na+ + X- = NaX
        log_k 0.0
    Ca+2 + 2X- = CaX2
        log_k 0.0

EXCHANGE 1-10
    X 1.e-3

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1.0
    -lengths 10*1.0
    -flow_direction forward
    -boundary_conditions constant constant
    -dispersivities 10*0.0
    -correct_disp true
    -initial_time 0.0
    -print_cells 4
    -print_frequency 1
    -warnings false

PRINT
    -exchange true

END