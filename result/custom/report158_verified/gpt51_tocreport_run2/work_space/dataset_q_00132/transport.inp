SOLUTION 0-10
    temp 25
    pH 7.0
    units mol/kgw
    Ca 1.0
    Cl 2.0

SOLUTION 11
    temp 25
    pH 7.0
    units mol/kgw
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X- 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 10*1
    -boundary_conditions flux flux
    -flow_direction forward
    -initial_time 0
    -print_cells 1-10
    -print_frequency 10

END