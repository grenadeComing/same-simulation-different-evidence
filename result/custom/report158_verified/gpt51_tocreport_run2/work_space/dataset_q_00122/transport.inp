SOLUTION 0
    pH 7.0
    temp 25.0
    Na 1.0
    Cl 1.0

SOLUTION 1-10
    pH 7.0
    temp 25.0
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001

EXCHANGE_SPECIES
    Na+ + X- = NaX
    log_k 0.0
    Ca+2 + 2X- = CaX2
    log_k 0.0

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -length 1
    -punch_cells 1
    -punch_frequency 1
    -flow_direction forward
    -print_cells 1-10
    -print_frequency 1
    -correct_disp false

SELECTED_OUTPUT
    -file selout.csv
    -reset false
    -simulation true
    -state true
    -step true
    -time true
    -totals Na
