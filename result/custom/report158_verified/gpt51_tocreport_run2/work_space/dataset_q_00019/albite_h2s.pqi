SOLUTION 1
    temp 200
    pH 2 charge
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    -temperature 200
    -volume 1
    H2S(g) 1

KINETICS 1
    Albite
        -m0 1
        -m 1
        -parms 1.0 10
        -steps 10 in 100 steps

USER_PUNCH
    -headings step n_Si
    10 PUNCH STEP_NO, MOL("Si")

PRINT
    -reset false
    -status true
