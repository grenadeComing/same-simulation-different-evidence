SOLUTION 0
    pH 7 charge
    Ca 1
    Cl 2

SOLUTION 1-10
    pH 7 charge
    Ca 1
    Cl 2

EXCHANGE 1-10
    X- 0.001
    -equil 0

SOLUTION 0
    pH 7 charge
    Na 1
    Cl 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions constant closed
    -lengths 1
    -print_cells 8
    -print_frequency 1
    -punch_cells 8
    -punch_frequency 1
    -warnings false

END