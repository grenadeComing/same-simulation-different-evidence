SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    Cu 0.01
    Ba 0.005

KINETICS 1
    Calcite
        -m0 1
        -m 1
        -parms 1.0 1.0
        -steps 10 in 100 seconds
        -tol 1e-12

SELECTED_OUTPUT
    -reset false
    -time true
    -alkalinity true
    -molalities Ca+2 CO3-2 HCO3-
END