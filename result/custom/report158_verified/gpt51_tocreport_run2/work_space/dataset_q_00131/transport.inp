TITLE 1D transport with cation exchange
SOLUTION 0-9
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 0-9
    X 0.001
SOLUTION 10
    pH 7.0
    Na 1.0
    Cl 1.0
EXCHANGE 10
    X 0.001

TRANSPORT
    -cells               10
    -shifts              10
    -flow_direction      forward
    -boundary_conditions flux flux
    -initial_time        0
    -time_step           1
    -lengths             10*1
    -dispersivities      10*0
    -punch_cells         3
    -print_cells         3
    -print_frequency     1
    -correct_disp        false
    -warnings            false
SELECTED_OUTPUT
    -file transport.sel
    -reset false
    -time true
    -step true
    -distance true
    -solution true
    -pH true
    -totals Na Ca Cl
    -activities Na+
END