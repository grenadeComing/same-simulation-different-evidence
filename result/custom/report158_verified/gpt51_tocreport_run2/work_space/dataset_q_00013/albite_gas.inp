SOLUTION 1
    temp 200
    pH 2 charge
    Fe(3) 4e-3
    Fe(2) 4e-3
    units mol/kgw

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    -temperature 200
    H2S(g) 1

KINETICS 1
    Albite
        -m0 1
        -m 1
        -parms 1.0 10
        -steps 10 in 100
        -bad_step_max 500
        -cvode

SELECTED_OUTPUT
    -file selout.txt
    -reset false
    -time true
    -totals Si
    -step true
