SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    units mol/kgw
    Cu 0.01
    Ba 0.005

KINETICS 1
    Calcite
        -m0 1
        -m  1
        -parms 1.0 1.0
        -tol 1e-12
        -steps 10 seconds in 100 steps

SELECTED_OUTPUT
    -file sel.out
    -reset false
    -time
    -step
    -totals C(4) Cu(2)
END
