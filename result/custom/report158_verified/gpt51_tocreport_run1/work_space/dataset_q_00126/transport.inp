SOLUTION 0
    pH 7.0
    Na 1.0
    Cl 1.0

SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001

TRANSPORT
    -cells               10
    -shifts              10
    -time_step           1.0 days
    -length              1.0
    -punch_cells         1-10
    -flow_direction      forward
    -boundary_conditions flux flux
    -initial_time        0.0 days
    -print_cells         1-10
    -print_frequency     1
    -punch_frequency     1
    -correct_disp        true
    -dump                dump
    -dump_frequency      10
    -warnings            true
END