SOLUTION 0
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 11
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X- 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -length 1
    -flow_direction forward
    -boundary_conditions constant flux
    -dispersivities 0
    -correct_disp false
    -print_cells 3
    -print_frequency 10
    -punch_cells 3
    -punch_frequency 10

SELECTED_OUTPUT
    -file sel.out
    -reset false
    -solution true
    -totals Na
    -activities Na+
