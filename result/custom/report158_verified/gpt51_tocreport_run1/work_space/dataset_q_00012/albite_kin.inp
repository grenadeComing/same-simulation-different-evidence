SOLUTION 1
    temp 200
    pH 2 charge
    Fe(2) 4e-3
    Fe(3) 4e-3

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5

KINETICS 1
    Albite
    -m0 1.0
    -steps 1000 in 100 steps
    -cvode true

RATES
    Albite
    -start
    10 k = 10
    20 ssa = 1.0
    30 rate = k * ssa
    40 moles = rate * TIME
    50 SAVE moles
    -end

INCREMENTAL_REACTIONS true

SELECTED_OUTPUT
    -file albite_sel.out
    -reset false
    -step true
    -time true
    -pe true
