SOLUTION 0-10
    pH 7.0
    temp 25.0
    Ca 1.0
    Cl 2.0

SOLUTION 11
    pH 7.0
    temp 25.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 0.001

EQUILIBRIUM_PHASES 1-10
    Fix_H+ 0.0 7.0

SELECTED_OUTPUT
    -reset false
    -file selout.txt
    -exchange 1
    -step true

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 1
    -boundary_conditions influx closed
    -flow_direction forward
    -initial_time 0
    -print_frequency 1
    -punch_frequency 1
    -correct_disp false
    -diffc 0
    -dispersivities 0
    -stagnant 0
    -multi_D false

PRINT
    -reset false
    -echo true
    -status true
    -selected_output true
