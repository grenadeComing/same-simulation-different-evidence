SOLUTION 1
    temp      200
    pH        2.0 charge
    pe        4
    Cu        1e-2
    Ba        5e-3

KINETICS 1
    Calcite
        -formula CaCO3 1
        -m0 1
        -parms 10 1.0
        -steps 1000 in 10 steps

RATES
Calcite
    -start
    10 k = PARM(1)
    20 ssa = PARM(2)
    30 rate = k * ssa
    40 moles = rate * TIME
    50 SAVE moles
    -end

SELECTED_OUTPUT
    -file sel_out.txt
    -reset false
    -time true
    -totals CO2

END
