SOLUTION 1
    temp 200
    pH 2 charge
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    -temp 200
    H2S(g) 1

KINETICS 1
    Albite
        -m0 1
        -m 1
        -parms 1.0 10
        -steps 10 sec in 100

SELECTED_OUTPUT
    -reset false
    -time true
    -step true
    -totals Si

USER_PUNCH
    -headings step
    10 PUNCH STEP_NO

END