SOLUTION 1 Pure water
    temp 150
    pH 7 charge
    pe 4
    units mmol/kgw
    density 1

GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    -temperature 150
    -volume 1
    CH4(g) 10
    CO2(g) 10
    NH3(g) 5

EQUILIBRIUM_PHASES 1
    CO2(g)  -3.5 0
    CH4(g)  -3.5 0
    NH3(g)  -3.5 0

END