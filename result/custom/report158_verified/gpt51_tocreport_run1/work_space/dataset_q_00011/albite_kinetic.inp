SOLUTION 1
    temp 200
    pH 2 charge
    Fe(2) 4e-3
    Fe(3) 4e-3

GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1
        -m 1
        -parms 10 1.0
        -steps 1000 in 100 steps

RATES
    Albite
    -start
    10 k = PARM(1)
    20 ssa = PARM(2)
    30 rate = k * ssa
    40 moles = rate * (TIME - TIME_OLD)
    50 SAVE moles
    -end

SELECTED_OUTPUT
    -file selout.txt
    -reset false
    -time true
    -kinetic_reactants Albite

END
