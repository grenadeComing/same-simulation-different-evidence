SOLUTION 0-10
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 11
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE_SPECIES
    X- = X-
    Na+ + X- = NaX
    Ca+2 + 2X- = CaX2

EXCHANGE 1-10
    X- 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 1
    -flow_direction forward
    -boundary_conditions flux flux
    -print_cells 1-10
    -print_frequency 1

PRINT
    -reset false
    -echo_input false
    -status false
