SOLUTION 0-10
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 11
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 1
    -flow_direction forward
    -boundary_conditions flux flux
    -print_cells 1-10
    -print_frequency 1

USER_PUNCH
    -head step cell CaX2
    -start
    10 PUNCH STEP_NO, CELL_NO, MOL("CaX2", "e")
    -end
