SOLUTION 0
    pH 7.0
    units mmol/kgw
    Na 1.0
    Cl 1.0

SOLUTION 1-10
    pH 7.0
    units mmol/kgw
    Ca 1.0
    Cl 2.0

EXCHANGE_MASTER_SPECIES
    X   X-  0.0

EXCHANGE_SPECIES
    Na+ + X- = NaX
        log_k 0.0
    Ca+2 + 2X- = CaX2
        log_k 0.0

EXCHANGE 1-10
    X- 0.001
    -equilibrate 1

EQUILIBRIUM_PHASES 1

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -initial_time 0
    -time_step 1
    -print_cells 1
    -print_frequency 1
    -punch_cells 1
    -punch_frequency 1

SELECTED_OUTPUT
    -file selout.txt
    -time true
    -solution true
    -state true
    -step true
    -totals Na Ca Cl
    -ionic_strength true

END