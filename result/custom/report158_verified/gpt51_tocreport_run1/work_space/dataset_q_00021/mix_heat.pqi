SOLUTION 1
    temp 20
    pH 7
    units mmol/kgw
    C(4) 50

SOLUTION 2
    temp 20
    pH 7
    units mmol/kgw
    Ca 50

MIX 1
    1 0.5
    2 0.5

EQUILIBRIUM_PHASES 1
    Calcite 0 0

REACTION_TEMPERATURE 1
    20 200 in 10 steps

USE solution 1
USE equilibrium_phases 1
USE reaction_temperature 1

SELECTED_OUTPUT
    -reset false
    -temperature true
    -pH true
    -step true
END
