SOLUTION 0
    pH 7 charge
    Ca 1
    Cl 2

SOLUTION 1-10
    pH 7 charge
    Ca 1
    Cl 2

SOLUTION 11
    pH 7 charge
    Na 1
    Cl 1

EXCHANGE_SPECIES
    Na+ + X- = NaX
    Ca+2 + 2 X- = CaX2

EXCHANGE 1-10
    X- 0.001

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 1
    -boundary_conditions flux constant
    -dispersivities 0
    -punch_cells 1-10
    -punch_frequency 1
    -print_cells 1-10
    -print_frequency 1
    -initial_time 0
    -flow_direction forward

INVERSE_MODELING 11
    -solutions 11

END