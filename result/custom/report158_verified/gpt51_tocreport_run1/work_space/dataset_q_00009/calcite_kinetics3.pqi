SOLUTION 1
    temp 200
    pH 2
    pe 4
    Cu 0.01
    Ba 0.005
    units mol/kgw
    charge

KINETICS 1
    Calcite
        -m0 1
        -m  1
        -parms 1.0 1.0
        -steps 10 in 100
        -cvode

USER_PUNCH
    -headings step SI_Witherite
    -start
    10 PUNCH STEP_NO, SI("Witherite")
    -end

SELECTED_OUTPUT
    -file sel.out
    -time
    -step
    -si Witherite
    -reset false
END