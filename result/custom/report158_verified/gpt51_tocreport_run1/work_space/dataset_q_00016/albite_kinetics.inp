SOLUTION 1
    temp 200
    pH 2
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4

GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    -temperature 200
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1
        -parms 10 1.0
        -steps 100*10

RATES
Albite
-start
10 k = PARM(1)
20 ssa = PARM(2)
30 rate = k * ssa
40 moles = rate * TIME
50 SAVE moles
60 END
-end

INCREMENTAL_REACTIONS true

USE solution 1
USE gas_phase 1
USE kinetics 1

SELECTED_OUTPUT
    -file sel_out.txt
    -reset false
    -time true
    -step true
    -totals Ba

END