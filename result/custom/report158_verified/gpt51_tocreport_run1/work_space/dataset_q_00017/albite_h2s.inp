SOLUTION 1
    temp 200
    pH 2 charge
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    -temperature 200
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1
        -m  1
        -parms 1.0 10.0
        -step 10 in 100
        -cvode

SELECTED_OUTPUT
    -file sel.out
    -reset false
    -step true
    -gas H2S(g)
    -totals S(6) S(-2)
    -molalities HS- H2S
    -kinetic_reactants Albite
