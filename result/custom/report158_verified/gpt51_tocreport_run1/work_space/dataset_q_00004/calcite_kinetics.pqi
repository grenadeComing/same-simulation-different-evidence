SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    Cu 0.01
    Ba 0.005

KINETICS 1
    Calcite
        -m0 1
        -m 1
        -parms 1.0 1.0
        -steps 10 in 100
        -tol 1e-12

PRINT
    -reset false
    -selected_out true

SELECTED_OUTPUT
    -file sel.out
    -reset false
    -time true
    -step true
    -si Witherite

END