SOLUTION 1
    temp 20
    pH 7 charge
    C(4) 50 mmol/kgw
SOLUTION 2
    temp 20
    pH 7 charge
    Ca 50 mmol/kgw
MIX 1
    1 0.5
    2 0.5
EQUILIBRIUM_PHASES 1
    Calcite 0 0
REACTION_TEMPERATURE 1
    20 38 56 74 92 110 128 146 164 182 200
SELECTED_OUTPUT
    -reset false
    -temperature true
    -si Calcite
    -activities Ca+2 CO3-2
USER_PUNCH
    -headings log_iap
    10 PUNCH (LA("Ca+2") + LA("CO3-2"))
END
