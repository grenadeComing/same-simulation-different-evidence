SOLUTION 1
    temp 200
    pH 2
    pe 4
    units mmol/kgw
    Cu 10
    Ba 5

RATES
Calcite_rate
-start
10 si_cc = SI("Calcite")
20 if (M <= 0) then goto 200
30 area = PARM(1)
40 k = PARM(2)
50 rate = area * k * (1 - 10^(2/3*si_cc))
60 moles = rate * TIME
70 if (moles > M) then moles = M
200 SAVE moles
-end

KINETICS 1
    Calcite_rate
        -formula Calcite 1
        -m0 1
        -parms 1.0 10
    -cvode true
    -steps 1000 in 100 steps

SELECTED_OUTPUT
    -file selected.out
    -reset false
    -step true
    -kinetic_reactants Calcite_rate
END
