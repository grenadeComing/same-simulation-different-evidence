SOLUTION 0 Infilling
    temp 25
    pH 7.0
    pe 4
    units mmol/kgw
    Na 1.0
    Cl 1.0
SOLUTION 1-10 Initial
    temp 25
    pH 7.0
    pe 4
    units mmol/kgw
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
SAVE solution 1
SAVE exchange 1
END
USE solution 1
USE exchange 1
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -correct_disp true
SELECTED_OUTPUT
    -file selected.txt
    -reset false
    -step true
    -solution true
    -simulation true
    -state true
    -distance true
USER_PUNCH
    -headings step soln a_Na
10 PUNCH STEP_NO, SOLN_NO, ACT("Na+")
END
