TITLE Albite kinetics with H2S gas at 200C
SOLUTION 1
    temp 200
    pH 2 charge
    Fe(2) 0.004
    Fe(3) 0.004
GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5
KINETICS 1
    Albite
        -m0 1
        -m 1
        -parms 1.0 10
        -steps 1000 in 100
SELECTED_OUTPUT
    -reset false
    -high_precision true
    -totals Si
    -molalities H4SiO4 H3SiO4- H2SiO4-2 HSiO3- HSiO3+ NaH3SiO4 AlH3SiO4+ FeH3SiO4+2 FeH2SiO4+ HSO3- SiO2
END
