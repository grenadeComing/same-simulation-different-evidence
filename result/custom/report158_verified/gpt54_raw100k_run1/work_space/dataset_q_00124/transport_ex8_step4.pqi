TITLE Exchange transport test
SOLUTION 0 Infilling
    pH 7.0
    Na 1.0
    Cl 1.0
SOLUTION 1-10 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
    -equilibrate 1
SELECTED_OUTPUT
    -file selected.out
    -reset false
    -simulation true
    -state true
    -solution true
    -distance true
    -time true
    -step true
USER_PUNCH
    -headings CaX2_eqfrac
10 PUNCH EQUI("CaX2")/TOT("X")
TRANSPORT
    -cells 10
    -shifts 10
    -print_cells 8
    -punch_cells 8
    -print_frequency 1
    -punch_frequency 1
END
