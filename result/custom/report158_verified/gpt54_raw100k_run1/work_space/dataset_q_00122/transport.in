SOLUTION 0 Inflow
    pH 7.0
    units mmol/kgw
    Na 1.0
    Cl 1.0
SOLUTION 1-10 Initial
    pH 7.0
    units mmol/kgw
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
EQUILIBRIUM_PHASES 1-10
TRANSPORT
    -cells 10
    -shifts 10
    -print_cells 1
    -print_frequency 1
    -boundary_conditions flux flux
SELECTED_OUTPUT
    -file selected.out
    -reset false
    -step true
    -distance true
    -solution true
    -totals Na Ca Cl
END
