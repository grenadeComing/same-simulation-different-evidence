TITLE Exchange transport test
SOLUTION 0 Infilling
    pH 7.0
    units mmol/kgw
    Na 1.0
    Cl 1.0
SOLUTION 1-10 Initial
    pH 7.0
    units mmol/kgw
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -correct_disp true
    -diffusion_coefficient 0
    -dispersivities 0
    -punch_cells 1-10
    -punch_frequency 1
SELECTED_OUTPUT
    -file sel.out
    -reset false
    -simulation true
    -state true
    -solution true
    -distance true
    -time true
USER_PUNCH
    -headings CaX2
    10 PUNCH EQUI("CaX2")
END
