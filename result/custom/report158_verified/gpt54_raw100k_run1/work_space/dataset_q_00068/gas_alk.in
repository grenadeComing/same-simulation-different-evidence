SOLUTION 1
    temp 150
    pH 7
    pe 4
    redox pe
    units mol/kgw
    C(4) 1e-12
    N(-3) 1e-12
    C(-4) 1e-12
    water 1
GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    -volume 1
    -temperature 150
    CH4(g) 0.0 10
    CO2(g) 0.0 10
    NH3(g) 0.0 5
SELECTED_OUTPUT
    -file gas_alk.sel
    -reset false
    -high_precision true
    -alkalinity true
END
