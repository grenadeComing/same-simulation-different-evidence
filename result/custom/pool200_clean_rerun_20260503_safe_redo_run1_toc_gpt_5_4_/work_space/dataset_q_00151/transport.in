SOLUTION 0
    pH 7.0
    units mmol/kgw
    Na 1.0
    Cl 1.0
SOLUTION 1-10
    pH 7.0
    units mmol/kgw
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
    -equilibrate 1
TRANSPORT
    -cells 10
    -shifts 10
SELECTED_OUTPUT
    -file selected.out
    -reset false
    -step true
    -simulation true
    -state true
    -solution true
    -distance true
    -time true
    -ionic_strength true
    -pH true
USER_PUNCH
    -headings sim step soln sc
    10 PUNCH SIM_NO, STEP_NO, SOLN_NO, SC
END
