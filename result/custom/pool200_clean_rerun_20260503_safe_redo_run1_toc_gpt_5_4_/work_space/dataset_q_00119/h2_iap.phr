SOLUTION 1 Pure water
    temp 25
    pH 7 charge
REACTION 1
    H2SO4 1.0
    0.001 0.005 0.01 0.05 0.1
SELECTED_OUTPUT
    -file h2_iap.sel
    -reset false
    -high_precision true
    -reaction true
    -pH true
    -ionic_strength true
USER_PUNCH
    -headings logIAP_H2
10 PUNCH 2*LA("H+") - LA("H2")
END
