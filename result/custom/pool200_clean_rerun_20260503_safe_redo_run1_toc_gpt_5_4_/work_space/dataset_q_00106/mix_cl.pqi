SOLUTION 1 River
    temp      25
    pH        6.0
    units     mg/L
    Cl        10
SOLUTION 2 Seawater
    temp      25
    pH        8.1
    units     mg/L
    Cl        19000
MIX 1
    1 0.7
    2 0.3
SELECTED_OUTPUT
    -file selected.out
    -reset false
USER_PUNCH
    -headings Cl_molality
    10 PUNCH MOL("Cl-")
END
