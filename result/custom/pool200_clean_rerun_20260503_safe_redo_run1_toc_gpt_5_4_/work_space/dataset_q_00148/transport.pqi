SOLUTION 0
    pH 7.0
    Na 1.0
    Cl 1.0
SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    equilibrate 1
    X 0.001
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -print_cells 1
    -print_frequency 1
SELECTED_OUTPUT
    -file selected.out
    -reset false
    -step true
    -solution true
    -simulation true
    -distance true
    -time true
    -totals Na Ca Cl
END
