SOLUTION 0 Infilling
    temp 25
    pH 7.0
    pe 4
    redox pe
    units mmol/kgw
    Na 1.0
    Cl 1.0
SOLUTION 1-10 Initial
    temp 25
    pH 7.0
    pe 4
    redox pe
    units mmol/kgw
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
    -equilibrate 1
TRANSPORT
    -cells 10
    -shifts 10
USER_PUNCH
    -headings Conductivity
    10 PUNCH SC*1000000
SELECTED_OUTPUT
    -reset false
    -step true
    -solution true
    -simulation true
    -state true
    -distance true
    -time true
    -user_punch true
END
