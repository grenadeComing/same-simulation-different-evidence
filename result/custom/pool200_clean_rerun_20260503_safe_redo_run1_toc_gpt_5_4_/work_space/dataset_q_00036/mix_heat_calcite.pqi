SOLUTION 1
    temp 20
    units mmol/kgw
    pH 7 charge
    C(4) 50
SOLUTION 2
    temp 20
    units mmol/kgw
    pH 7 charge
    Ca 50
MIX 1
    1 0.5
    2 0.5
REACTION_TEMPERATURE 1
    20 200 in 10 steps
EQUILIBRIUM_PHASES 1
    Calcite 0 0
SELECTED_OUTPUT
    -file sel.txt
    -reset false
    -temperature true
    -si Calcite
    -activities Ca+2 CO3-2
USER_PUNCH
    -headings log_IAP
    10 PUNCH LA("Ca+2") + LA("CO3-2")
END
