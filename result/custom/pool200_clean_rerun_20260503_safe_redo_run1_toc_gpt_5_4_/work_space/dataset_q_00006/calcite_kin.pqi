SOLUTION 1
    temp 100
    pH 5
    pe 4
    units mol/kgw
    C(4) 5e-4
    Mn 1e-3
KINETICS 1
    Calcite
        -m0 1
        -m 1
        -parms 10.0 0.001
        -steps 1000 in 100
        -tol 1e-12
SELECTED_OUTPUT
    -file selected.out
    -reset false
    -step true
    -time true
    -totals C Ca Mn
END
