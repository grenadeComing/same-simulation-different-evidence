SOLUTION 1
    temp 25
    units mmol/kgw
    pH 7 charge
    Ca 50
EQUILIBRIUM_PHASES 1
    Calcite 0 10
    Gypsum 0 10
    Aragonite 0 10
GAS_PHASE 1
    -fixed_pressure
    -pressure 16
    -temperature 25
    CO2(g) 1
    CH4(g) 5
    H2S(g) 10
SELECTED_OUTPUT
    -reset false
    -high_precision true
USER_PUNCH
    -headings sc
    10 PUNCH SC
END
