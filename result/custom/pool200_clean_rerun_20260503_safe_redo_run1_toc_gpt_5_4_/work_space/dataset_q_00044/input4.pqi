SOLUTION 1
    temp 100
    units mmol/kgw
    pH 7 charge
    Ca 50 as Ca
EQUILIBRIUM_PHASES 1
    Calcite 0 10
    Gypsum 0 10
    Aragonite 0 10
GAS_PHASE 1
    -fixed_pressure
    -pressure 16
    -temperature 25
    CO2(g) 0 0.0625
    CH4(g) 0.69897 0.3125
    H2S(g) 1 0.625
SELECTED_OUTPUT
    -reset false
    -high_precision true
USER_PUNCH
    -headings sc
    10 PUNCH SC
END
