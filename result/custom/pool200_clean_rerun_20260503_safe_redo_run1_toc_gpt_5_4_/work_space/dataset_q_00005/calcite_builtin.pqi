TITLE Calcite kinetic dissolution
SOLUTION 1
    temp 100
    pH 5
    pe 4
    units mmol/kgw
    C(4) 0.5
    Mn 1
KINETICS 1
    Calcite
        -m0 1
        -m 1
        -parms 10.0 1
        -steps 1000 in 100 steps
        -tol 1e-8
SELECTED_OUTPUT
    -file selected_builtin.out
    -reset false
    -step true
    -time true
    -pH true
END
