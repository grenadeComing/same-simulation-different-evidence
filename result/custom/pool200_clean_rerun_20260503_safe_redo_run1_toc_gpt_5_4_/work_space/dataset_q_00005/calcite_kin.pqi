TITLE Calcite kinetic dissolution
SOLUTION 1
    temp 100
    pH 5
    pe 4
    units mmol/kgw
    C(4) 0.5
    Mn 1
RATES
Calcite_custom
-start
10 sa = PARM(1)
20 k = PARM(2)
30 if (M <= 0) then goto 200
40 rate = k * sa
50 moles = rate * TIME
200 SAVE moles
-end
KINETICS 1
    Calcite_custom
        -formula CaCO3 1
        -m0 1
        -m 1
        -parms 10.0 0.001
        -steps 1000 in 100 steps
SELECTED_OUTPUT
    -file selected.out
    -reset false
    -step true
    -time true
    -pH true
END
