SOLUTION 1
    temp 100
    pH 7 charge
    Ca 50 mmol/kgw
EQUILIBRIUM_PHASES 1
    Calcite 0 10
    Gypsum 0 10
    Aragonite 0 10
GAS_PHASE 1
    -fixed_pressure
    -pressure 16
    -temperature 25
    CO2(g) 1
    CH4(g) 5
    H2S(g) 10
SELECTED_OUTPUT
    -file selected.out
    -high_precision true
USER_PUNCH
    -headings gas_CO2 gas_CH4 gas_H2S
    10 PUNCH GAS("CO2(g)"), GAS("CH4(g)"), GAS("H2S(g)")
END
