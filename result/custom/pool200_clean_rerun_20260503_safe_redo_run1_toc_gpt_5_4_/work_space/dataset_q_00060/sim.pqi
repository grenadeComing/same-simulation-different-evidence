SOLUTION 1
    temp 100
    pH 5
    Ba 0.1
    units mol/kgw
EQUILIBRIUM_PHASES 1
    Talc 0 10
    Rhodochrosite 0 10
    Sepiolite 0 10
    Sepiolite(d) 0 10
    Pb(OH)2 0 10
SELECTED_OUTPUT
    -file selected.out
    -reset false
USER_PUNCH
    -headings Talc Rhodochrosite Sepiolite Sepiolite_d PbOH2
10 PUNCH EQUI("Talc"), EQUI("Rhodochrosite"), EQUI("Sepiolite"), EQUI("Sepiolite(d)"), EQUI("Pb(OH)2")
END
