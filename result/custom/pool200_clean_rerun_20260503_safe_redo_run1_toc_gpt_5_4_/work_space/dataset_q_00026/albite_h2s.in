TITLE Albite kinetic dissolution with H2S gas at 200 C
SOLUTION 1
    temp 200
    pH 2
    pe 4
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4
GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5
KINETICS 1
    Albite
        -m0 1
        -m 1
        -parms 1.0 10
        -steps 1000 in 100
SELECTED_OUTPUT
    -reset false
    -simulation true
    -state true
    -solution true
    -distance true
    -time true
    -totals Si
    -molalities H4SiO4 H3SiO4- H2SiO4-2 HSiO3- HSiO3- SiO2 H2SiO4
END
