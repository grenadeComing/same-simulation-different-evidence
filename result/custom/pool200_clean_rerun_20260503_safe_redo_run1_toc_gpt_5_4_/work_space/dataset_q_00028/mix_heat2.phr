SOLUTION 1 DIC
    temp 20
    units mmol/kgw
    pH 7 charge
    C(4) 50
SOLUTION 2 CA
    temp 20
    units mmol/kgw
    pH 7 charge
    Ca 50
MIX 1
    1 0.5
    2 0.5
USE solution 1
EQUILIBRIUM_PHASES 1
    Calcite 0 10
REACTION_TEMPERATURE 1
    20 40 60 80 100 120 140 160 180 200
SELECTED_OUTPUT
    -file selected2.out
    -reset false
    -temperature true
    -pH true
END
