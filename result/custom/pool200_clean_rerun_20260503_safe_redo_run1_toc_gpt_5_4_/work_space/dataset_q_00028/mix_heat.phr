SOLUTION 1
    temp 20
    units mmol/kgw
    pH 7
    Alkalinity 50 as HCO3
SOLUTION 2
    temp 20
    units mmol/kgw
    pH 7
    Ca 50
MIX 1
    1 0.5
    2 0.5
EQUILIBRIUM_PHASES 1
    Calcite 0 10
REACTION_TEMPERATURE 1
    20 40 60 80 100 120 140 160 180 200
SELECTED_OUTPUT
    -file selected.out
    -reset false
    -temperature true
    -pH true
END
