SOLUTION 1
    temp 20
    pH 7 charge
    C(4) 0.05
SOLUTION 2
    temp 20
    pH 7 charge
    Ca 0.05
MIX 1
    1 0.5
    2 0.5
EQUILIBRIUM_PHASES 1
    Calcite 0 0
REACTION_TEMPERATURE 1
    20 40 60 80 100 120 140 160 180 200
SELECTED_OUTPUT
    -file selected.txt
    -reset false
    -temperature true
    -totals Ca C(4)
    -molalities Ca+2 CaCO3 CaHCO3+ CaOH+ HCaO2-
    -saturation_indices Calcite
END
