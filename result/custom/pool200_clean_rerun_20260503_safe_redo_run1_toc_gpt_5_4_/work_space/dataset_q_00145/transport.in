TITLE Exchange transport test
SOLUTION 0
    pH 7.0
    pe 4
    units mmol/kgw
    Na 1.0
    Cl 1.0
SOLUTION 1-10
    pH 7.0
    pe 4
    units mmol/kgw
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
    -equilibrate 1
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
END
SELECTED_OUTPUT
    -file selected.out
    -reset false
    -step true
    -pH true
    -pe true
    -totals Ca Na Cl
