SOLUTION 1
    temp      100
    pH        5
    units     mmol/kgw
    Ba        100

EQUILIBRIUM_PHASES 1
    Talc            0  10
    Rhodochrosite   0  10
    Sepiolite(d)    0  10
    Pb(OH)2         0  10

SELECTED_OUTPUT
    -file   result5.out
    -reset  false
    -molalities  CO3-2

USER_PUNCH
    -headings  mol_CO3-2  mass_water_kg  moles_CO3-2_calc
    -start
10  PUNCH MOL("CO3-2")
20  PUNCH TOT("water")
30  PUNCH MOL("CO3-2") * TOT("water")
    -end

END
