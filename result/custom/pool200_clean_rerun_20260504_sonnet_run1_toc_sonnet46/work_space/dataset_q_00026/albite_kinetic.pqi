SOLUTION 1
    temp      200
    pH        2.0
    pe        4
    redox     pe
    units     mmol/kgw
    density   1.0
    Fe(2)     4.0
    Fe(3)     4.0
    -water    1.0 # kg

EQUILIBRIUM_PHASES 1
    # Fixed pressure gas phase handled in GAS_PHASE block

GAS_PHASE 1
    -fixed_pressure
    -pressure 5.0
    -volume   1.0
    -temperature 200.0
    H2S(g)    5.0

KINETICS 1
    Albite
        -m0   1.0
        -m    1.0
        -parms 1.0  10.0
        -step  10 in 100
        -tol   1e-8

SELECTED_OUTPUT 1
    -file   albite_out.sel
    -reset  false
    -step   true
    -time   true
    -totals Si Al Na Fe

USER_PUNCH 1
    -headings step Si_species_count
    -start
10 IF STEP_NO <> 100 THEN GOTO 9999
20 n = 0
30 FOR i = 1 TO 1000
40   sp$ = SPECIES$(i)
50   IF sp$ = "" THEN GOTO 200
60   IF INSTR(sp$, "Si") > 0 THEN n = n + 1
70 NEXT i
200 PUNCH STEP_NO, n
9999 END
    -end

END
