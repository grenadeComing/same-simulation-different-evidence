# Mixing of two solutions 1:1 and heating from 20°C to 200°C in 10 steps
# Solution 1: 50 mmol/kg dissolved inorganic carbon
# Solution 2: 50 mmol/kg calcium

SOLUTION 1
    temp      20
    pH        7.0 charge
    units     mmol/kgw
    C(4)      50

SOLUTION 2
    temp      20
    pH        7.0 charge
    units     mmol/kgw
    Ca        50

# Mix 1:1
MIX 1
    1   0.5
    2   0.5

# Save the mixed solution as solution 3
SAVE SOLUTION 3

END

# Now heat the mixed solution from 20 to 200°C in 10 steps
# Steps: 20, 38, 56, 74, 92, 110, 128, 146, 164, 182, 200
# Actually 10 discrete steps from 20 to 200 means:
# step size = (200-20)/10 = 18°C per step
# Temperatures: 38, 56, 74, 92, 110, 128, 146, 164, 182, 200
# But let's use REACTION_TEMPERATURE to go from 20 to 200 in 10 steps

USE SOLUTION 3

EQUILIBRIUM_PHASES 1
    Calcite   0.0   10.0

REACTION_TEMPERATURE 1
    20.0  38.0  56.0  74.0  92.0  110.0  128.0  146.0  164.0  182.0  200.0

SELECTED_OUTPUT
    -file   mixing_calcite.out
    -reset  false
    -temperature  true
    -pH           true
    -si           Calcite

END
