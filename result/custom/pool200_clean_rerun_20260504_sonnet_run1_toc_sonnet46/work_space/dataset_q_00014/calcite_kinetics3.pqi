SOLUTION 1
    temp      200
    pH        2.0
    pe        4.0
    units     mmol/kgw
    Cu        10.0
    Ba        5.0

KINETICS 1
Calcite
    -tol   1e-8
    -m0    1.0
    -m     1.0
    -parms 1.0   0.6
    -step  1000 in 100

SELECTED_OUTPUT
    -file   calcite_kinetics3.out
    -reset  false
    -time   true

USER_PUNCH
    -headings  time_s  Calcite_moles
    -start
10 PUNCH TIME
20 PUNCH KIN("Calcite")
    -end

END
