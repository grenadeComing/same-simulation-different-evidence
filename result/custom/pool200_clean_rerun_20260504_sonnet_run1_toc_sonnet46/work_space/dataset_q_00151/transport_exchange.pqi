# 1D Transport with Exchange
# Initial solution: pH 7.0, Ca 1.0 mmol/L, Cl 2.0 mmol/L
# Infilling solution: pH 7.0, Na 1.0 mmol/L, Cl 1.0 mmol/L
# 10 cells, 10 shifts, 0.001 mol exchange sites

SOLUTION 0   # Infilling solution (inlet)
    pH      7.0
    Na      1.0   # mmol/L
    Cl      1.0   # mmol/L
    units   mmol/L

SOLUTION 1-10  # Initial solution in all cells
    pH      7.0
    Ca      1.0   # mmol/L
    Cl      2.0   # mmol/L
    units   mmol/L

EXCHANGE 1-10
    X       0.001
    -equilibrate 1

TRANSPORT
    -cells          10
    -shifts         10
    -flow_direction forward
    -boundary_conditions flux flux
    -diffusion_coefficient 0.0
    -dispersivity  0.0
    -time_step     1.0
    -length        1.0
    -print_cells   1-10
    -punch_cells   8
    -punch_frequency 1

SELECTED_OUTPUT
    -file           transport_out.sel
    -reset          false
    -step           true
    -solution       true
    -totals         Na Ca Cl
    -pH             true

USER_PUNCH
    -headings  Spec_Cond
    -start
10 PUNCH SC
    -end

END
