SOLUTION 1
    temp      100
    pH        7 charge
    Ca        50 mmol/kgw

EQUILIBRIUM_PHASES 1
    Calcite    0 10
    Gypsum     0 10
    Aragonite  0 10

GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    -temperature 25
    CO2(g)    1.0
    CH4(g)    5.0
    H2S(g)    10.0

SAVE solution 1

END

USE solution 1
REACTION_TEMPERATURE 1
    25

SELECTED_OUTPUT
    -file     result5.out
    -reset    false
    -solution true
    -high_precision true

END
