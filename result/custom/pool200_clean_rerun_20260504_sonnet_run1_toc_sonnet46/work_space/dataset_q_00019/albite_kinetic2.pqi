SOLUTION 1
    temp      200
    pH        2.0
    pe        4.0
    units     mmol/kgw
    Fe(2)     4.0
    Fe(3)     4.0
    water     1.0

GAS_PHASE 1
    -fixed_pressure
    -pressure 5.0
    -volume   1.0
    -temp     200
    H2S(g)    5.0

KINETICS 1
Albite
    -m0   1.0
    -m    1.0
    -parms 1.0  10.0
    -steps 1000 in 100
    -tol  1e-12

SELECTED_OUTPUT 1
    -file   albite_out2.sel
    -reset  false
    -step   true
    -time   true
    -totals Si Al Na Fe

END
