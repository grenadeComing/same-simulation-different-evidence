TITLE 1D Transport Problem - 10 cells, 10 shifts

# Initial solution (in all 10 cells): pH 7.0, Ca 1.0 mmol/L, Cl 2.0 mmol/L
SOLUTION 1-10
    pH      7.0
    Ca      1.0
    Cl      2.0
    units   mmol/L

# Infilling solution (solution 0): pH 7.0, Na 1.0 mmol/L, Cl 1.0 mmol/L
SOLUTION 0
    pH      7.0
    Na      1.0
    Cl      1.0
    units   mmol/L

# Exchange sites for all 10 cells: 0.001 moles, equilibrate with solution 1
EXCHANGE 1-10
    X       0.001
    -equilibrate 1

# Transport: 10 cells, 10 shifts
TRANSPORT
    -cells          10
    -shifts         10
    -flow_direction forward
    -boundary_conditions flux flux
    -print_cells    1
    -print_frequency 5

SELECTED_OUTPUT
    -file           transport_out.sel
    -reset          false
    -solution       true
    -step           true
    -totals         Ca Na Cl

USER_PUNCH
    -headings  SC_uS_cm
    -start
10  PUNCH SC
    -end

END
