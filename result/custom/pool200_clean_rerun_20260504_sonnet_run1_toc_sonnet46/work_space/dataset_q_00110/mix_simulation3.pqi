TITLE River water and seawater mixing at 0.7:0.3 ratio - Full chemistry

# Solution 1: River water, pH 6.0, Cl 10 mg/L
SOLUTION 1 River Water
    temp      25
    pH        6.0
    pe        4
    units     mg/L
    Cl        10

# Solution 2: Seawater, pH 8.1, Cl 19000 mg/L
# Typical seawater composition
SOLUTION 2 Seawater
    temp      25
    pH        8.1
    pe        4
    units     mg/L
    Cl        19000
    Na        10556
    Mg        1272
    S(6)      2649
    Ca        400
    K         380
    C(4)      28
    B         4.6
    F         1.3
    Br        65

# Mix 70% river water and 30% seawater
MIX 1
    1    0.7
    2    0.3

SAVE SOLUTION 3

SELECTED_OUTPUT
    -file   mix_output3.sel
    -reset  false
    -solution
    -pH

USER_PUNCH
    -headings Viscosity
    -start
10  PUNCH VISCOSITY
    -end

END
