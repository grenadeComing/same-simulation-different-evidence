TITLE Mix river water (pH 6.0, Cl 10) and seawater (pH 8.1, Cl 19000) at 0.7:0.3 ratio

# Solution 1: River water - only pH and Cl specified
SOLUTION 1 River Water
    pH      6.0
    temp    25
    units   mg/L
    Cl      10

# Solution 2: Seawater with Cl = 19000 mg/L
# Using standard seawater ratios (Millero et al.)
# Standard seawater (S=35): Cl=19354, Na=10752, Mg=1295, S=905(as S), Ca=416, K=380
# Ratio Cl=19000/19354 = 0.98170
SOLUTION 2 Seawater
    pH      8.1
    temp    25
    units   mg/L
    Cl      19000
    Na      10540
    Mg      1272
    Ca      408
    K       373
    S(6)    2652   as SO4
    C       142    as HCO3
    Br      65.7
    B       4.5
    F       1.28
    Sr      12.8

# Mix 70% river water + 30% seawater
MIX 1
    1   0.7
    2   0.3

SAVE SOLUTION 3

END

USE SOLUTION 3

SELECTED_OUTPUT
    -file           mix_output3.sel
    -reset          false
    -solution       true
    -pH             true

END
