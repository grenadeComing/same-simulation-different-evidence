TITLE 1D Transport Problem - 10 cells, 10 shifts (mol/L units)

# Initial solution (solution 1-10): pH 7.0, Ca 1.0, Cl 2.0
SOLUTION 1-10
    pH      7.0
    Ca      1.0
    Cl      2.0

# Infilling solution (solution 0): pH 7.0, Na 1.0, Cl 1.0
SOLUTION 0
    pH      7.0
    Na      1.0
    Cl      1.0

# Exchange sites for all 10 cells
EXCHANGE 1-10
    X       0.001
    -equilibrate 1

TRANSPORT
    -cells          10
    -shifts         10
    -flow_direction forward
    -boundary_conditions flux flux
    -diffusion_coefficient 0
    -dispersivity 0
    -time_step      1
    -length         1

SELECTED_OUTPUT
    -file           transport_out2.sel
    -reset          false
    -solution       true
    -step           true
    -pH             true
    -pe             true

END
