SOLUTION 1
    pH      7.0
    temp    25.0
    units   mmol/L
    Ca      10
    Sr      10
    Alkalinity 40

SOLID_SOLUTION 1  Ca_Sr_carbonate
    -comp  Calcite      0.0
    -comp  Strontianite 0.0

SELECTED_OUTPUT
    -file   result2.out
    -reset  false
    -solution
    -pH
    -temperature

USER_PUNCH
    -headings  spec_cond
    10 PUNCH SC

END
