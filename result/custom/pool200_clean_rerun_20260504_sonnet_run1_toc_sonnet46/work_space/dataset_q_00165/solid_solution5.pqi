SOLUTION 1
    pH      7.0
    temp    25.0
    units   mmol/L
    Ca      1
    Sr      1
    Alkalinity 4

SOLID_SOLUTION 1  Ca_Sr_carbonate
    -comp  Calcite      0.0
    -comp  Strontianite 0.0

SELECTED_OUTPUT
    -file   result5.out
    -reset  false
    -solution
    -pH
    -temperature

USER_PUNCH
    -headings  spec_cond
    10 PUNCH SC

END
