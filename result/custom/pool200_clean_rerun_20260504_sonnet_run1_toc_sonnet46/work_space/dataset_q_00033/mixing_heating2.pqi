# Simulation: Mix two solutions 1:1, then heat from 20°C to 200°C in 10 steps
# Solution 1: 50 mmol/kg dissolved inorganic carbon
# Solution 2: 50 mmol/kg calcium
# Allow calcite to precipitate/dissolve

SOLUTION 1
    temp      20
    pH        7.0
    units     mmol/kgw
    C(4)      50

SOLUTION 2
    temp      20
    pH        7.0
    units     mmol/kgw
    Ca        50

# Mix 1:1
MIX 1
    1   0.5
    2   0.5

SAVE SOLUTION 3

END

# Now heat the mixed solution from 20 to 200°C in 10 steps
# 10 steps: 20 to 200, step size = (200-20)/10 = 18°C
# But if 10 discrete steps means 10 temperature points:
# linspace(20, 200, 10) = 20, 40, 60, 80, 100, 120, 140, 160, 180, 200

USE SOLUTION 3

EQUILIBRIUM_PHASES 1
    Calcite   0.0   10.0

REACTION_TEMPERATURE 1
    20.0  40.0  60.0  80.0  100.0  120.0  140.0  160.0  180.0  200.0

SELECTED_OUTPUT
    -file   mixing_heating2.sel
    -reset  false
    -temperature  true
    -si   Calcite  Aragonite

END
