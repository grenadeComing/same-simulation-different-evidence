# Simulation: Add sulfuric acid in steps to pure water at pH 7.0, pe=4
# Steps: 0.001, 0.005, 0.01, 0.05, 0.1 moles of H2SO4

SOLUTION 1  Pure water at pH 7.0
    pH      7.0
    pe      4.0
    temp    25.0
    units   mol/L

REACTION 1
    H2SO4   1.0
    0.001   0.005   0.01   0.05   0.1

SELECTED_OUTPUT
    -file   sulfuric_output4.sel
    -pH     true
    -pe     true
    -step   true
    -totals S(6)

END
