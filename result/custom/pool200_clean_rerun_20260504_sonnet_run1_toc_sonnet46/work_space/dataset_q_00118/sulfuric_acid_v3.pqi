# Simulation: Add sulfuric acid in cumulative steps to pure water at pH 7.0
# Cumulative steps: 0.001, 0.006, 0.016, 0.066, 0.166 moles total
# Each step adds: 0.001, 0.005, 0.01, 0.05, 0.1 moles

SOLUTION 1  Pure water at pH 7.0
    pH      7.0
    temp    25.0
    units   mol/L

REACTION 1
    H2SO4   1.0
    0.001   0.006   0.016   0.066   0.166

SELECTED_OUTPUT
    -file   sulfuric_output3.sel
    -pH     true
    -pe     true
    -step   true
    -totals S(6)

END
