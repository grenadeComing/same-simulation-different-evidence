# Simulation: Add sulfuric acid in steps to pure water at pH 7.0
# Steps: 0.001, 0.005, 0.01, 0.05, 0.1 moles of H2SO4

SOLUTION 1  Pure water at pH 7.0
    pH      7.0
    temp    25.0
    units   mol/L

REACTION 1  Add 0.001 mol H2SO4 (step 1)
    H2SO4   1.0
    0.001 moles

SAVE SOLUTION 1
END

USE SOLUTION 1
REACTION 2  Add 0.005 mol H2SO4 (step 2)
    H2SO4   1.0
    0.005 moles

SAVE SOLUTION 1
END

USE SOLUTION 1
REACTION 3  Add 0.01 mol H2SO4 (step 3)
    H2SO4   1.0
    0.01 moles

SAVE SOLUTION 1
END

USE SOLUTION 1
REACTION 4  Add 0.05 mol H2SO4 (step 4)
    H2SO4   1.0
    0.05 moles

SAVE SOLUTION 1
END

USE SOLUTION 1
REACTION 5  Add 0.1 mol H2SO4 (step 5)
    H2SO4   1.0
    0.1 moles

SAVE SOLUTION 1
END

USE SOLUTION 1
SELECTED_OUTPUT
    -file   sulfuric_output.sel
    -pH     true
    -pe     true
    -totals S(6)
END
