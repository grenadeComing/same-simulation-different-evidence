TITLE 1D Transport with Ion Exchange - 10 cells, 10 shifts

# Initial solution (in all 10 cells): pH 7.0, Ca 1.0 mmol/L, Cl 2.0 mmol/L
SOLUTION 1-10
    pH      7.0
    Ca      1.0
    Cl      2.0
    units   mmol/L

# Infilling solution (solution 0): pH 7.0, Na 1.0 mmol/L, Cl 1.0 mmol/L
SOLUTION 0
    pH      7.0
    Na      1.0
    Cl      1.0
    units   mmol/L

# Exchange assemblage for all 10 cells: 0.001 moles of exchange site, equilibrate with solution 1
EXCHANGE 1-10
    X       0.001
    -equilibrate 1

TRANSPORT
    -cells          10
    -shifts         10
    -flow_direction forward
    -boundary_conditions flux flux
    -diffusion_coefficient 0.0
    -dispersivity  0.0
    -time_step      1.0
    -length         1.0
    -punch_cells    1
    -punch_frequency 1

SELECTED_OUTPUT
    -file           transport_exchange3.sel
    -reset          false
    -step
    -solution

USER_PUNCH
    -headings  step cell EqFrac_CaX2 EqFrac_NaX mol_CaX2 mol_NaX
    10 PUNCH STEP_NO, CELL_NO, EQUI("CaX2"), EQUI("NaX"), MOL("CaX2"), MOL("NaX")

PRINT
    -selected_output true

END
