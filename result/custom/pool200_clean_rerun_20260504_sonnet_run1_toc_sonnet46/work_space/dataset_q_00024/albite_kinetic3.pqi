SOLUTION 1
    temp      200
    pH        2.0
    pe        4
    redox     pe
    units     mmol/kgw
    density   1.0
    Fe(2)     4.0
    Fe(3)     4.0
    -water    1.0

KINETICS 1
Albite
    -m0   1.0
    -m    1.0
    -parms 1.0  10.0
    -step  1000 in 100

GAS_PHASE 1
    -fixed_pressure
    -pressure 5.0
    -volume   1.0
    -temperature 200.0
    H2S(g)    5.0

SELECTED_OUTPUT
    -file     albite_kinetic3.out
    -reset    false
    -step     true
    -time     true
    -gases    H2S(g)
    -totals   S Na Al Si Fe S(6) S(-2)
    -kinetic_reactants Albite

USER_PUNCH
    -headings Step Time TotalS_mol S6_mol Sm2_mol H2S_dissolved Albite_moles
    -start
10 PUNCH STEP_NO
20 PUNCH TIME
30 PUNCH TOT("S") * MASS_WATER
40 PUNCH TOT("S(6)") * MASS_WATER
50 PUNCH TOT("S(-2)") * MASS_WATER
60 REM H2S dissolved = total S in solution (initial had no S)
70 PUNCH (TOT("S") * MASS_WATER)
80 PUNCH KIN("Albite")
    -end

END
