SOLUTION 1
    temp      100
    pH        5
    pe        4
    units     mmol/kgw
    C(4)      0.5
    Mn        1.0

KINETICS 1
Calcite
    -m0    1.0
    -m     1.0
    -parms 10.0  0.6
    -step  1000 in 100
    -tol   1e-8

SELECTED_OUTPUT
    -file   calcite_kinetic2.out
    -reset  false
    -time   true
    -pH     true
    -pe     true
    -si     Calcite
    -kinetic_reactants  Calcite

END
