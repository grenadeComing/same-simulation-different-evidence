TITLE Calcite kinetic dissolution in acidic solution with Cu and Ba - custom rate

SOLUTION 1
    temp      200
    pH        2.0
    pe        4.0
    units     mmol/kgw
    Cu        10.0
    Ba        5.0
    -water    1.0  # kg

RATES
Calcite
-start
10  SR_Calcite = SR("Calcite")
20  rate = PARM(2) * PARM(1) * (1 - SR_Calcite)
30  moles = rate * TIME
40  SAVE moles
-end

KINETICS 1
Calcite
    -tol    1e-8
    -m0     1.0
    -m      1.0
    -parms  1.0  10.0
    -step   1000 in 100

INCREMENTAL_REACTIONS true

SELECTED_OUTPUT
    -file   calcite_kinetics2.out
    -reset  false
    -step   true
    -time   true
    -pH     true

END
