# Simulation: Mix two solutions 1:1, then heat from 20°C to 200°C in 10 steps
# Solution 1: 50 mmol/kg dissolved inorganic carbon (DIC) - pure DIC solution
# Solution 2: 50 mmol/kg calcium - pure Ca solution
# Account for calcite precipitation/dissolution

SOLUTION 1  # 50 mmol/kg DIC - pure carbonate solution, charge balanced
    temp      20
    units     mmol/kgw
    C(4)      50
    -water    1  # kg

SOLUTION 2  # 50 mmol/kg Ca - pure calcium solution, charge balanced
    temp      20
    units     mmol/kgw
    Ca        50
    -water    1  # kg

# Mix solutions 1:1 with calcite equilibrium and heat
MIX 1
    1   0.5
    2   0.5

EQUILIBRIUM_PHASES 1
    Calcite   0   10

REACTION_TEMPERATURE 1
    20  200  in  10  steps

SELECTED_OUTPUT
    -file     mixing_heating4.sel
    -reset    false
    -temperature  true
    -pH           true
    -si           Calcite
    -equilibrium_phases  Calcite

END
