# Simulation: Mix two solutions 1:1, then heat from 20°C to 200°C in 10 steps
# Solution 1: 50 mmol/kg dissolved inorganic carbon (DIC)
# Solution 2: 50 mmol/kg calcium
# Account for calcite precipitation/dissolution

SOLUTION 1  # 50 mmol/kg DIC
    temp      20
    pH        7
    units     mmol/kgw
    C(4)      50

SOLUTION 2  # 50 mmol/kg Ca
    temp      20
    pH        7
    units     mmol/kgw
    Ca        50

# Mix solutions 1:1
MIX 1
    1   0.5
    2   0.5

# Save the mixed solution as solution 3
SAVE solution 3

END

# Now heat the mixed solution from 20°C to 200°C in 10 steps
# Step 1: 20°C (starting point)
USE solution 3

EQUILIBRIUM_PHASES 1
    Calcite   0   10

REACTION_TEMPERATURE 1
    20  200  in  10  steps

SELECTED_OUTPUT
    -file     mixing_heating.sel
    -reset    false
    -temperature  true
    -pH           true
    -si           Calcite
    -equilibrium_phases  Calcite

END
