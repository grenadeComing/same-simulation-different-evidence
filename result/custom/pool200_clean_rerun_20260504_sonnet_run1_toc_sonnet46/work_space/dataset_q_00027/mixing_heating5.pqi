# Simulation: Mix two solutions 1:1, then heat from 20°C to 200°C in 10 steps
# Solution 1: 50 mmol/kg dissolved inorganic carbon (DIC)
# Solution 2: 50 mmol/kg calcium
# Account for calcite precipitation/dissolution
# Using charge balance to determine pH naturally

SOLUTION 1  # 50 mmol/kg DIC - charge balanced with pH
    temp      20
    units     mmol/kgw
    C(4)      50
    pH        10  charge

SOLUTION 2  # 50 mmol/kg Ca - charge balanced with pH
    temp      20
    units     mmol/kgw
    Ca        50
    pH        7  charge

# Mix solutions 1:1 with calcite equilibrium and heat
MIX 1
    1   0.5
    2   0.5

EQUILIBRIUM_PHASES 1
    Calcite   0   10

REACTION_TEMPERATURE 1
    20  200  in  10  steps

SELECTED_OUTPUT
    -file     mixing_heating5.sel
    -reset    false
    -temperature  true
    -pH           true
    -si           Calcite
    -equilibrium_phases  Calcite

END
