SOLUTION 1
    temp      100
    pH        5.0
    pe        4.0
    units     mmol/kgw
    C(4)      0.5
    Mn        1.0

RATES
Calcite
-start
10  IF (M <= 0) THEN GOTO 200
20  si_cc = SI("Calcite")
30  rate = PARM(1) * PARM(2) * (1 - 10^si_cc) * M/M0
40  IF (rate < 0) THEN rate = 0
50  moles = rate * TIME
60  IF (moles > M) THEN moles = M
70  SAVE moles
80  END
200 SAVE 0
-end

KINETICS 1
Calcite
    -m0    1.0
    -m     1.0
    -parms 10.0  0.001
    -step  1000 in 100
    -tol   1e-8
    -bad_step_max 5000

SELECTED_OUTPUT
    -file   calcite_kinetic5.out
    -reset  false
    -step   true
    -time   true
    -pH     true
    -pe     true
    -si     Calcite

END
