SOLUTION 1
    temp      100
    pH        5.0
    pe        4.0
    units     mmol/kgw
    C(4)      0.5
    Mn        1.0

RATES
Calcite
-start
10  IF (M <= 0) THEN GOTO 200
20  rate = PARM(1) * PARM(2) * M/M0
30  moles = rate * TIME
40  IF (moles > M) THEN moles = M
50  SAVE moles
60  END
200 SAVE 0
-end

KINETICS 1
Calcite
    -m0    1.0
    -m     1.0
    -parms 10.0  0.001
    -step  1000 in 100
    -tol   1e-8

SELECTED_OUTPUT
    -file   calcite_kinetic6.out
    -reset  false
    -step   true
    -time   true
    -pH     true
    -pe     true
    -si     Calcite

END
