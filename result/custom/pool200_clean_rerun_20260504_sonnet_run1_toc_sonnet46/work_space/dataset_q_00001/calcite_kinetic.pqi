SOLUTION 1
    temp      100
    pH        5.0
    pe        4.0
    units     mmol/kgw
    C(4)      0.5
    Mn        1.0

KINETICS 1
    Calcite
        -m0    1.0
        -m     1.0
        -parms 10.0  0.001
        -steps 1000 in 100
        -tol   1e-8

INCREMENTAL_REACTIONS true

SELECTED_OUTPUT
    -file   calcite_kinetic.out
    -reset  false
    -step   true
    -time   true
    -pe     true
    -pH     true
    -si     Calcite

END
