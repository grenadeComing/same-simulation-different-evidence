TITLE Add sulfuric acid in steps to pure water at pH 7.0

# Create initial pure water at pH 7.0
SOLUTION 1
    pH      7.0
    temp    25.0
    units   mol/L

# Add all steps of H2SO4 in one REACTION block with multiple steps
# Steps: 0.001, 0.005, 0.01, 0.05, 0.1 moles cumulative
# Each step adds the incremental amount
# Total cumulative: 0.001, 0.006, 0.016, 0.066, 0.166 moles
REACTION 1
    H2SO4   1.0
    0.001   0.005   0.01   0.05   0.1   moles

SELECTED_OUTPUT
    -file   sulfuric_acid_steps2.sel
    -reset  false
    -step   true
    -pH     true
    -activities H+

END
