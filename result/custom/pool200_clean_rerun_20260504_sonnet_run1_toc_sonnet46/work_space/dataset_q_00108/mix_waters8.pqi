SOLUTION 1  River Water
    pH      6.0     charge
    pe      4.0
    Cl      10
    temp    25
    units   mg/L

SOLUTION 2  Seawater
    pH      8.1     charge
    pe      4.0
    Cl      19000
    temp    25
    units   mg/L

MIX 1
    1   0.7
    2   0.3

SELECTED_OUTPUT
    -file   mix_output8.sel
    -reset  false
    -pe     true
    -pH     true

END
