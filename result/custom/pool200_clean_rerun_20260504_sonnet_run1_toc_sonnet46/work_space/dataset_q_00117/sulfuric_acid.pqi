TITLE Sulfuric acid addition to pure water in steps

# Initial pure water at pH 7.0
SOLUTION 1
    pH 7.0
    temp 25
    units mol/L

# Add sulfuric acid in steps: 0.001, 0.005, 0.01, 0.05, 0.1 moles
REACTION 1
    H2SO4  1
    0.001  0.005  0.01  0.05  0.1

SELECTED_OUTPUT
    -file sulfuric_acid.out
    -reset false
    -step true
    -ionic_strength true
    -pH true

END
