TITLE River water and seawater mixing (0.7:0.3)
# pH and Cl specified, using default pe=4

# Solution 1: River water, pH 6.0, Cl 10 mg/L
SOLUTION 1 River Water
    temp      25
    pH        6.0
    pe        4.0
    units     mg/L
    Cl        10.0
    Na        10.0 charge

# Solution 2: Seawater, pH 8.1, Cl 19000 mg/L
SOLUTION 2 Seawater
    temp      25
    pH        8.1
    pe        4.0
    units     mg/L
    Cl        19000.0
    Na        10500.0 charge

# Mix 70% river water and 30% seawater
MIX 1
    1    0.7
    2    0.3

SELECTED_OUTPUT
    -file mix_output3.sel
    -reset false
    -si O2(g)

END
