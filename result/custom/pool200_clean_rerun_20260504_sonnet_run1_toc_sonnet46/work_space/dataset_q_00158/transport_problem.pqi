TITLE 1D Transport Problem with Ion Exchange

# Initial solution (in cells) - pH 7.0, Ca 1.0, Cl 2.0
SOLUTION 1-10
    pH      7.0
    Ca      1.0
    Cl      2.0

# Infilling solution (solution 0) - pH 7.0, Na 1.0, Cl 1.0
SOLUTION 0
    pH      7.0
    Na      1.0
    Cl      1.0

# Exchange sites for all 10 cells, equilibrated with solution 1
EXCHANGE 1-10
    X       0.001
    -equilibrate 1

TRANSPORT
    -cells          10
    -shifts         10
    -flow_direction forward
    -time_step      1
    -length         1
    -diffusion_coefficient 0
    -dispersivity   0
    -punch_cells    1-10
    -punch_frequency 10
    -print_cells    1-10
    -print_frequency 10

SELECTED_OUTPUT
    -file           transport_out.sel
    -reset          false
    -solution       true
    -saturation_indices H2O(g)

END
