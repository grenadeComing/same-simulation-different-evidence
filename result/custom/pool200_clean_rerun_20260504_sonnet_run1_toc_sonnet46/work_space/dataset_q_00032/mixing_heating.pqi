# Solution 1: 50 mmol/kg dissolved inorganic carbon
SOLUTION 1
    temp      20
    pH        7
    C(4)      50 mmol/kgw
    units     mmol/kgw

# Solution 2: 50 mmol/kg calcium
SOLUTION 2
    temp      20
    pH        7
    Ca        50 mmol/kgw
    units     mmol/kgw

# Mix 1:1
MIX 1
    1   0.5
    2   0.5

# Save the mixed solution as solution 3
SAVE SOLUTION 3

END

# Now heat the mixed solution from 20 to 200 C in 10 steps
# with calcite equilibrium
USE SOLUTION 3

EQUILIBRIUM_PHASES 1
    Calcite   0   0

REACTION_TEMPERATURE 1
    20 38 56 74 92 110 128 146 164 182 200

SELECTED_OUTPUT
    -file     mixing_heating.sel
    -reset    false
    -temperature  true
    -step         true
    -totals       Ca C(4)
    -molalities   Ca+2 CaHCO3+ CaCO3 CaOH+
    -saturation_indices  Calcite

END
