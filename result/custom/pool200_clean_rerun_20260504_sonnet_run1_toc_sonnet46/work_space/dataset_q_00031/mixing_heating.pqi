# Simulation: Mix two solutions 1:1, then heat from 20°C to 200°C in 10 steps
# Solution 1: 50 mmol/kg dissolved inorganic carbon (DIC)
# Solution 2: 50 mmol/kg calcium
# Allow calcite to precipitate/dissolve

SOLUTION 1
    temp      20
    pH        7.0 charge
    units     mmol/kgw
    C(4)      50

SOLUTION 2
    temp      20
    pH        7.0 charge
    units     mmol/kgw
    Ca        50

# Mix 1:1
MIX 1
    1   0.5
    2   0.5

EQUILIBRIUM_PHASES 1
    Calcite   0   0

REACTION_TEMPERATURE 1
    20   20   40   60   80   100   120   140   160   180   200

SELECTED_OUTPUT
    -file     mixing_heating.out
    -reset    false
    -temperature  true
    -ionic_strength true
    -equilibrium_phases  Calcite

END
