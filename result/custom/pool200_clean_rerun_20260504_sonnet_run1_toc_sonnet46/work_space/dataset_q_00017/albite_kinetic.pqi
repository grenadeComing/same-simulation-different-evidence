SOLUTION 1
    temp      200
    pH        2.0
    pe        4
    units     mmol/kgw
    Fe(2)     4.0
    Fe(3)     4.0

KINETICS 1
Albite
    -m0   1.0
    -m    1.0
    -parms 1.0  10.0
    -step  1000 in 100

GAS_PHASE 1
    -fixed_pressure
    -pressure 5.0
    -volume   1.0
    H2S(g)    5.0

SELECTED_OUTPUT
    -file   albite_out.sel
    -reset  false
    -step   true
    -time   true
    -kinetic_reactants  Albite

END
