# Simulation: Mix two solutions 1:1, then heat from 20°C to 200°C in 10 steps
# Solution 1: 50 mmol/kg dissolved inorganic carbon (1 kg water)
# Solution 2: 50 mmol/kg calcium (1 kg water)
# Allow calcite to precipitate/dissolve

SOLUTION 1
    temp      20
    pH        7
    units     mmol/kgw
    C(4)      50

SOLUTION 2
    temp      20
    pH        7
    units     mmol/kgw
    Ca        50

# Mix solutions 1 and 2 in 1:1 ratio with equilibrium phases
MIX 1
    1   1
    2   1

EQUILIBRIUM_PHASES 1
    Calcite   0   0

SAVE solution 3

END

# Now use the mixed solution (already equilibrated with calcite) and heat it
USE solution 3
USE equilibrium_phases 1

REACTION_TEMPERATURE 1
    20  38  56  74  92  110  128  146  164  182  200

SELECTED_OUTPUT
    -file   calcite_mixing_heating3.sel
    -reset  false
    -temperature    true
    -equilibrium_phases  Calcite

END
