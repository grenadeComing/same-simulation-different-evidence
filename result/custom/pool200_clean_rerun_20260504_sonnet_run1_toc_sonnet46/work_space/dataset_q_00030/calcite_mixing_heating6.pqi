# Simulation: Mix two solutions 1:1, then heat from 20°C to 200°C in 10 discrete steps
# Solution 1: 50 mmol/kg dissolved inorganic carbon
# Solution 2: 50 mmol/kg calcium
# Allow calcite to precipitate/dissolve
# 10 steps: 20, 40, 60, 80, 100, 120, 140, 160, 180, 200°C

SOLUTION 1
    temp      20
    pH        7   charge
    units     mmol/kgw
    C(4)      50

SOLUTION 2
    temp      20
    pH        7   charge
    units     mmol/kgw
    Ca        50

# Mix solutions 1 and 2 in 1:1 ratio
MIX 1
    1   1
    2   1

EQUILIBRIUM_PHASES 1
    Calcite   0   0

REACTION_TEMPERATURE 1
    20  40  60  80  100  120  140  160  180  200

SELECTED_OUTPUT
    -file   calcite_mixing_heating6.sel
    -reset  false
    -temperature    true
    -equilibrium_phases  Calcite

END
