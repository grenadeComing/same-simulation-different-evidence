# Simulation: Mix two solutions 1:1, then heat from 20°C to 200°C in 10 steps
# Solution 1: 50 mmol/kg dissolved inorganic carbon
# Solution 2: 50 mmol/kg calcium
# Allow calcite to precipitate/dissolve

SOLUTION 1
    temp      20
    pH        7
    units     mmol/kgw
    C(4)      50

SOLUTION 2
    temp      20
    pH        7
    units     mmol/kgw
    Ca        50

# Mix solutions 1 and 2 in 1:1 ratio (equal volumes/masses)
# Using fraction 1 for each gives 2 kg total, concentrations are averaged
MIX 1
    1   1
    2   1

SAVE solution 3

END

# Now use the mixed solution and heat it from 20 to 200°C in 10 steps
USE solution 3

EQUILIBRIUM_PHASES 1
    Calcite   0   0

REACTION_TEMPERATURE 1
    20  38  56  74  92  110  128  146  164  182  200

SELECTED_OUTPUT
    -file   calcite_mixing_heating2.sel
    -reset  false
    -temperature    true
    -equilibrium_phases  Calcite

END
