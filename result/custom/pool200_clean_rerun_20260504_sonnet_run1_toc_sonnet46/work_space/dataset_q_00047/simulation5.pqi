SOLUTION 1
    temp 100
    pH 3
    units mol/L
    water 1

EQUILIBRIUM_PHASES 1
    K-mica       0  10
    Kaolinite    0  10
    Dolomite     0  10
    Epsomite     0  1000
    Fe(OH)3(a)   0  10
    Halite       0  1000

SELECTED_OUTPUT
    -file result5.out
    -pH true
    -temperature true
    -si K-mica Kaolinite Dolomite Epsomite Fe(OH)3(a) Halite

END
