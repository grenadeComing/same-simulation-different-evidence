SOLUTION 1
    temp 15
    C(-4) 5.0 mmol/kgw

GAS_PHASE 1
    -fixed_pressure
    -pressure 1.0
    -temperature 15
    -volume 1.0
    CH4(g) 0.0

SELECTED_OUTPUT
    -file viscosity_sim.sel
    -reset false
    -solution true
    -temperature true

USER_PUNCH
    -headings viscosity
    -start
10 PUNCH VISCOSITY
    -end

END
