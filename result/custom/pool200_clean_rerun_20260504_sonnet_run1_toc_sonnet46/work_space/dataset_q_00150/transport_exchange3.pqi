# 1D Transport problem with exchange
# Initial solution: pH 7.0, Ca 1.0, Cl 2.0
# Infilling solution: pH 7.0, Na 1.0, Cl 1.0
# 10 cells, 10 shifts, 0.001 mol exchange sites

SOLUTION 0  # Infilling solution (inlet)
    pH      7.0
    Na      1.0
    Cl      1.0
    units   mmol/L

SOLUTION 1-10  # Initial solution in all cells
    pH      7.0
    Ca      1.0
    Cl      2.0
    units   mmol/L

EXCHANGE 1-10
    -equilibrate 1
    X       0.001

SELECTED_OUTPUT
    -file           transport_exchange3.sel
    -reset          false
    -step           true
    -solution       true

USER_PUNCH
    -headings  Step Cell EqFrac_CaX2 EqFrac_NaX
    10 PUNCH SIM_NO, CELL_NO, MOL("CaX2")/(MOL("CaX2")+MOL("NaX")/2), MOL("NaX")/(2*MOL("CaX2")+MOL("NaX"))

TRANSPORT
    -cells          10
    -shifts         10
    -flow_direction forward
    -boundary_conditions flux flux
    -diffusion_coefficient 0.0
    -dispersivity  0.0
    -time_step     1.0
    -length        1.0
    -print_cells   1-10

END
