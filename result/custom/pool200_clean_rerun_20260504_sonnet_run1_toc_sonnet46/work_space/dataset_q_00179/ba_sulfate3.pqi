SOLUTION 1
    temp      25
    pH        7
    pe        4
    units     mg/L
    Ba        2.0
    S(6)      15.0

REACTION_TEMPERATURE 1
    40.0  55.0  70.0  85.0  95.0

SELECTED_OUTPUT
    -file     ba_sulfate3.out
    -reset    false
    -temperature  true
    -step         true

USER_PUNCH
    -headings  spec_cond
    -start
10  PUNCH SPEC_COND
    -end

END
