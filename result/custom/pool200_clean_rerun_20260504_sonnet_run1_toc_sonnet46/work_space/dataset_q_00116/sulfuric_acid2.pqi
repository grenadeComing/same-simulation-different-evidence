TITLE Sulfuric acid addition to pure water - sequential steps

# Initial pure water at pH 7.0
SOLUTION 1
    pH      7.0
    temp    25.0
    units   mol/L

# Step 1: Add 0.001 mol H2SO4
REACTION 1
    H2SO4   1.0
    0.001 moles

SAVE SOLUTION 1
END

# Step 2: Add 0.005 mol H2SO4
USE SOLUTION 1
REACTION 2
    H2SO4   1.0
    0.005 moles

SAVE SOLUTION 1
END

# Step 3: Add 0.01 mol H2SO4
USE SOLUTION 1
REACTION 3
    H2SO4   1.0
    0.01 moles

SAVE SOLUTION 1
END

# Step 4: Add 0.05 mol H2SO4
USE SOLUTION 1
REACTION 4
    H2SO4   1.0
    0.05 moles

SAVE SOLUTION 1
END

# Step 5: Add 0.1 mol H2SO4
USE SOLUTION 1
REACTION 5
    H2SO4   1.0
    0.1 moles

SAVE SOLUTION 1
END

SELECTED_OUTPUT
    -file   selected.out
    -reset  false
    -pH     true
    -solution true
    -step    true

USER_PUNCH
    -headings  Step pH
    -start
10 PUNCH SIM_NO, -LA("H+")
    -end

END
