# Solution 1: 50 mmol/kg dissolved inorganic carbon (DIC)
SOLUTION 1
    temp      20
    pH        7
    units     mmol/kgw
    C(4)      50

# Solution 2: 50 mmol/kg calcium
SOLUTION 2
    temp      20
    pH        7
    units     mmol/kgw
    Ca        50

# Mix 1:1
MIX 1
    1   0.5
    2   0.5

# Save the mixed solution as solution 3
SAVE SOLUTION 3

END

# Now use the mixed solution and heat from 20 to 200 in 10 steps
# with calcite equilibrium
USE SOLUTION 3

EQUILIBRIUM_PHASES 1
    Calcite   0   0   # allow precipitation/dissolution, starting with 0 moles

REACTION_TEMPERATURE 1
    20  38  56  74  92  110  128  146  164  182  200

SELECTED_OUTPUT
    -file   mixing_calcite.sel
    -reset  false
    -temperature    true
    -totals         C Ca
    -equilibrium_phases  Calcite

END
