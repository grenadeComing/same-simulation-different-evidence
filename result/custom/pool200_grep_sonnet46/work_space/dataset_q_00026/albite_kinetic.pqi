SOLUTION 1
    temp      200
    pH        2.0
    pe        4.0
    redox     pe
    units     mmol/kgw
    density   1.0
    Fe(3)     4.0
    Fe(2)     4.0
    -water    1.0

KINETICS 1
Albite
    -m0   1.0
    -m    1.0
    -parms 1.0  10.0
    -step  10 in 100

GAS_PHASE 1
    -fixed_pressure
    -pressure 5.0
    -volume   1.0
    -temperature 200
    H2S(g)    5.0

SELECTED_OUTPUT
    -file     albite_kinetic.out
    -reset    false
    -step     true
    -time     true
    -pH       true
    -pe       true
    -totals   Si Al Na Fe S
    -si       Albite Quartz

USER_PUNCH
    -headings  Si_species_count
    -start
10 n = 0
20 FOR i = 1 TO TOTSPECIES
30   sp$ = SPECIESNAME(i)
40   IF INSTR(sp$, "Si") > 0 THEN n = n + 1
50 NEXT i
60 PUNCH n
    -end

END
