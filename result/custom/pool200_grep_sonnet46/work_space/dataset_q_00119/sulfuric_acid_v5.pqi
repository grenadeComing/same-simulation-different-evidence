TITLE Stepwise addition of H2SO4 to pure water at pH 7.0
# Using REACTION with incremental steps, pe fixed

SOLUTION 1
    pH      7.0
    pe      4.0
    temp    25
    units   mol/L

# Add H2SO4 in cumulative steps: 0.001, 0.006, 0.016, 0.066, 0.166 mol total
# (incremental: 0.001, 0.005, 0.01, 0.05, 0.1)
REACTION 1
    H2SO4   1
    0.001  0.006  0.016  0.066  0.166

SELECTED_OUTPUT
    -file   sulfuric_result_v5.sel
    -reset  false
    -step
    -si     H2(g)

END
