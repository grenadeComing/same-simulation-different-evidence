SOLUTION 1  River water
    units   mg/L
    pH      6.0
    pe      4.0
    Cl      10
    O(0)    8

SOLUTION 2  Seawater
    units   mg/L
    pH      8.1
    pe      4.0
    Cl      19000
    O(0)    8

MIX 1
    1   0.7
    2   0.3

SELECTED_OUTPUT
    -file mix_waters5.sel
    -pe     true
    -pH     true

END
