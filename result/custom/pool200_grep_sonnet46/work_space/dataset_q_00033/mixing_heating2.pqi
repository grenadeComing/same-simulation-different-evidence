
# Solution 1: 50 mmol/kg dissolved inorganic carbon (DIC)
SOLUTION 1
    temp      20
    pH        7.0
    C(4)      50  mmol/kgw
    units     mmol/kgw

# Solution 2: 50 mmol/kg calcium
SOLUTION 2
    temp      20
    pH        7.0
    Ca        50  mmol/kgw
    units     mmol/kgw

# Mix 1:1 and allow calcite to equilibrate, then heat in steps
MIX 1
    1   0.5
    2   0.5

EQUILIBRIUM_PHASES 1
    Calcite   0   0

# 10 discrete steps from 20 to 200 C: step size = (200-20)/9 = 20 C
# Steps: 20, 40, 60, 80, 100, 120, 140, 160, 180, 200
REACTION_TEMPERATURE 1
    20  40  60  80  100  120  140  160  180  200

SAVE solution 3

SELECTED_OUTPUT
    -file     mixing_heating2.sel
    -reset    false
    -temperature  true
    -si       Calcite Aragonite
    -totals   Ca C(4)

END
