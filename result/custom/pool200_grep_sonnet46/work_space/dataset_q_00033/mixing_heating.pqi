
# Solution 1: 50 mmol/kg dissolved inorganic carbon (DIC)
SOLUTION 1
    temp      20
    pH        7.0
    C(4)      50  mmol/kgw
    units     mmol/kgw

# Solution 2: 50 mmol/kg calcium
SOLUTION 2
    temp      20
    pH        7.0
    Ca        50  mmol/kgw
    units     mmol/kgw

# Mix 1:1 and allow calcite to equilibrate, then heat in steps
MIX 1
    1   0.5
    2   0.5

EQUILIBRIUM_PHASES 1
    Calcite   0   0

REACTION_TEMPERATURE 1
    20  38  56  74  92  110  128  146  164  182  200

SAVE solution 3

SELECTED_OUTPUT
    -file     mixing_heating.sel
    -reset    false
    -temperature  true
    -si       Calcite Aragonite
    -totals   Ca C(4)

END
