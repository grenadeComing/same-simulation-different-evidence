TITLE Add sulfuric acid in steps to pure water at pH 7.0

# Step 0: Initial pure water at pH 7.0
SOLUTION 1
    pH      7.0
    temp    25.0
    units   mol/L
    water   1.0

END

# Step 1: Add 0.001 mol H2SO4
USE SOLUTION 1
REACTION 1
    H2SO4   1.0
    0.001

SAVE SOLUTION 1

END

# Step 2: Add 0.005 mol H2SO4
USE SOLUTION 1
REACTION 1
    H2SO4   1.0
    0.005

SAVE SOLUTION 1

END

# Step 3: Add 0.01 mol H2SO4
USE SOLUTION 1
REACTION 1
    H2SO4   1.0
    0.01

SAVE SOLUTION 1

END

# Step 4: Add 0.05 mol H2SO4
USE SOLUTION 1
REACTION 1
    H2SO4   1.0
    0.05

SAVE SOLUTION 1

END

# Step 5: Add 0.1 mol H2SO4
USE SOLUTION 1
REACTION 1
    H2SO4   1.0
    0.1

SAVE SOLUTION 1

END
