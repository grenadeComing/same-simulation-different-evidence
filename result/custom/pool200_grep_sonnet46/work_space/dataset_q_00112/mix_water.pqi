SOLUTION 1  River Water
    pH      6.0
    Cl      10

SOLUTION 2  Seawater
    pH      8.1
    Cl      19000

MIX 1
    1   0.7
    2   0.3

SAVE SOLUTION 3

END

USE SOLUTION 3
EQUILIBRIUM_PHASES 1

END

USE SOLUTION 3
SELECTED_OUTPUT
    -file           mix_output.sel
    -saturation_indices   H2O(g)
END
