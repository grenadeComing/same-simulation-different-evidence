TITLE Equilibration of 1 kg pure water at 150C with fixed-pressure gas phase

SOLUTION 1
    temp      150
    pH        7
    pe        4
    units     mol/kgw
    water     1 kg

GAS_PHASE 1
    -fixed_pressure
    -pressure    1
    -temperature 150
    -volume      1
    CH4(g)       10
    CO2(g)       10
    NH3(g)       5

SELECTED_OUTPUT
    -file        gas_eq.sel
    -reset       false
    -temperature true
    -pH          true
    -pe          true
    -alkalinity  true
    -ionic_strength true
    -totals      C N

END
