
# Approach: Define the mixed solution directly with 25 mmol/kg each
# (result of 1:1 mixing of 50 mmol/kg solutions)
# Then heat from 20 to 200 C in 10 steps

SOLUTION 1
    temp      20
    pH        7.0
    C(4)      25  # 25 mmol/kg DIC (after 1:1 mixing)
    Ca        25  # 25 mmol/kg Ca (after 1:1 mixing)
    units     mmol/kgw

EQUILIBRIUM_PHASES 1
    Calcite   0   0

REACTION_TEMPERATURE 1
    20  200  in 10 steps

SAVE solution 2

SELECTED_OUTPUT
    -file     mixing_heating5.sel
    -reset    false
    -temperature  true
    -equilibrium_phases  Calcite
    -totals   C Ca

END
