
# Solution 1: 50 mmol/kg dissolved inorganic carbon
SOLUTION 1
    temp      20
    pH        7.0
    C(4)      50  # 50 mmol/kg DIC
    units     mmol/kgw

# Solution 2: 50 mmol/kg calcium
SOLUTION 2
    temp      20
    pH        7.0
    Ca        50  # 50 mmol/kg calcium
    units     mmol/kgw

# Mix 1:1 proportions - use fractions (0.5 each)
# This gives a mixed solution with 25 mmol/kg C and 25 mmol/kg Ca
# in 1 kg of water total
MIX 1
    1   0.5
    2   0.5

EQUILIBRIUM_PHASES 1
    Calcite   0   0

REACTION_TEMPERATURE 1
    20  200  in 10 steps

SAVE solution 3

SELECTED_OUTPUT
    -file     mixing_heating3.sel
    -reset    false
    -temperature  true
    -equilibrium_phases  Calcite
    -totals   C Ca

END
