SOLUTION 1
    temp      100
    pH        5
    pe        4
    units     mmol/kgw
    C(4)      0.5
    Mn        1.0

RATES
    Calcite
    -start
    10  sa = PARM(1)
    20  rate_const = PARM(2)
    30  SR_cal = SR("Calcite")
    40  rate = rate_const * sa * m * (1 - SR_cal)
    50  moles = rate * TIME
    60  SAVE moles
    -end

KINETICS 1
    Calcite
        -m0    1.0
        -m     1.0
        -parms 10.0  0.001
        -step  1000 in 100
        -tol   1e-8

SELECTED_OUTPUT
    -file   calcite_kinetic2.sel
    -reset  false
    -step   true
    -time   true
    -si     Aragonite Calcite

END
