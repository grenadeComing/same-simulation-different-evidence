SOLUTION 1
    temp      100
    pH        5
    pe        4
    units     mmol/kgw
    C(4)      0.5
    Mn        1.0

RATES
    Calcite
    -start
    10  sa = PARM(1)
    20  rate_const = PARM(2)
    30  SR_cal = SR("Calcite")
    40  IF (m <= 0) THEN GOTO 60
    50  rate = rate_const * sa * m * (1 - SR_cal)
    55  IF (rate < 0) THEN rate = 0
    60  moles = rate * TIME
    70  SAVE moles
    -end

KINETICS 1
    Calcite
        -m0    1.0
        -m     1.0
        -parms 10.0  0.001
        -step  1000 in 100
        -tol   1e-8
        -bad_step_max 500

SELECTED_OUTPUT
    -file   calcite_kinetic3.sel
    -reset  false
    -step   true
    -time   true
    -si     Aragonite Calcite

END
