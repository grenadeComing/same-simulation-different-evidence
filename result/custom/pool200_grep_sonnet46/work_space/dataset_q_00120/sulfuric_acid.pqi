TITLE Add sulfuric acid in steps to pure water at pH 7.0

# Initial solution: pure water at pH 7.0
SOLUTION 1
    pH      7.0
    temp    25.0
    units   mol/L

# Step 1: Add 0.001 mol H2SO4
REACTION 1
    H2SO4   1.0
    0.001

SOLUTION 2
    pH      7.0
    temp    25.0
    units   mol/L

# Step 2: Add 0.005 mol H2SO4
REACTION 2
    H2SO4   1.0
    0.005

SOLUTION 3
    pH      7.0
    temp    25.0
    units   mol/L

# Step 3: Add 0.01 mol H2SO4
REACTION 3
    H2SO4   1.0
    0.01

SOLUTION 4
    pH      7.0
    temp    25.0
    units   mol/L

# Step 4: Add 0.05 mol H2SO4
REACTION 4
    H2SO4   1.0
    0.05

SOLUTION 5
    pH      7.0
    temp    25.0
    units   mol/L

# Step 5: Add 0.1 mol H2SO4
REACTION 5
    H2SO4   1.0
    0.1

SELECTED_OUTPUT
    -file           sulfuric_acid.sel
    -reset          false
    -solution       true
    -pH             true
    -activities     H+

END
