SOLUTION 1
    temp 100
    pH 3
    pe 4
    units mol/L
    water 1

EQUILIBRIUM_PHASES 1
    K-mica          0  10
    Kaolinite       0  10
    Dolomite        0  10
    Epsomite        0  10
    Fe(OH)3(a)      0  10
    Halite          0  10
    O2(g)           -0.68  10

SELECTED_OUTPUT
    -file pe_simulation3.out
    -pe true
    -pH true
    -temperature true

END
