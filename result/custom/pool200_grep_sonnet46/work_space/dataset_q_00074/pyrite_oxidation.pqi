TITLE Equilibrium oxidation of Pyrite in pure water at 25C

SOLUTION 1
    temp      25
    pH        7.0
    pe        4.0
    units     mol/kgw
    water     1.0  # kg

EQUILIBRIUM_PHASES 1
    O2(g)     -0.7    10.0    # Constant atmospheric O2 source
    Pyrite     0.0    0.1     # Up to 0.1 moles of Pyrite can react
    Goethite   0.0    0.0     # Allow precipitation of Goethite
    Gypsum     0.0    0.0     # Allow precipitation of Gypsum

SELECTED_OUTPUT
    -file     pyrite_oxidation.sel
    -reset    false
    -pH       true
    -pe       true
    -molalities  H+  SO4-2  Fe+2  Fe+3

END
