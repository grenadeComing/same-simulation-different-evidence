TITLE Equilibrium oxidation of Pyrite in pure water at 25C

SOLUTION 1
    temp      25
    pH        7.0
    pe        4.0
    density   1.0
    units     mol/kgw
    water     1.0  # kg

EQUILIBRIUM_PHASES 1
    O2(g)     -0.7   10.0    # constant atmospheric oxygen source
    Pyrite     0.0   0.1     # allow up to 0.1 moles to react
    Goethite   0.0   0.0     # allow precipitation
    Gypsum     0.0   0.0     # allow precipitation

SELECTED_OUTPUT
    -file     pyrite_oxidation.sel
    -reset    false
    -si       Pyrite Goethite Gypsum

END
