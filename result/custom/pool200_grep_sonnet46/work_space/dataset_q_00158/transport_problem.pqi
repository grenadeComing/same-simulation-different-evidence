TITLE 1D Transport Problem - 10 cells, 10 shifts

# Initial solution (pH 7.0, Ca 1.0 mmol/L, Cl 2.0 mmol/L)
SOLUTION 1-10
    pH      7.0
    Ca      1.0
    Cl      2.0
    units   mmol/L

# Infilling solution (pH 7.0, Na 1.0 mmol/L, Cl 1.0 mmol/L)
SOLUTION 0
    pH      7.0
    Na      1.0
    Cl      1.0
    units   mmol/L

# Exchange sites for all 10 cells
EXCHANGE 1-10
    X       0.001
    equilibrate 1

TRANSPORT
    -cells          10
    -shifts         10
    -flow_direction forward
    -boundary_conditions flux flux
    -diffusion_coefficient 0.0
    -dispersivity      0.0
    -time_step         1.0
    -lengths           1.0
    -print_cells       1-10
    -print_frequency   10

SELECTED_OUTPUT
    -file           transport_out.sel
    -reset          false
    -solution       true
    -saturation_indices   H2O(g)

END
