TITLE Sulfuric acid addition to pure water in steps

# Step 0: Initial pure water at pH 7.0
SOLUTION 1
    pH 7.0
    temp 25.0
    units mol/L

# Add 0.001 mol H2SO4
REACTION 1
    H2SO4  1.0
    0.001

SAVE SOLUTION 1

END

# Add 0.005 mol H2SO4
USE SOLUTION 1
REACTION 2
    H2SO4  1.0
    0.005

SAVE SOLUTION 1

END

# Add 0.01 mol H2SO4
USE SOLUTION 1
REACTION 3
    H2SO4  1.0
    0.01

SAVE SOLUTION 1

END

# Add 0.05 mol H2SO4
USE SOLUTION 1
REACTION 4
    H2SO4  1.0
    0.05

SAVE SOLUTION 1

END

# Add 0.1 mol H2SO4
USE SOLUTION 1
REACTION 5
    H2SO4  1.0
    0.1

SAVE SOLUTION 1

END
