TITLE Calcite dissolution kinetics at 200C with Cu and Ba - custom rate with k=10

SOLUTION 1
    temp      200
    pH        2.0
    pe        4.0
    units     mmol/kgw
    Cu        10.0
    Ba        5.0

RATES
Calcite
-start
1  rem Calcite dissolution rate
2  rem PARM(1) = specific surface area (m^2/mol)
3  rem PARM(2) = rate constant
10 si_cc = SI("Calcite")
20 IF (M <= 0 AND si_cc < 0) THEN GOTO 200
30 area = PARM(1)
40 kf = PARM(2)
50 rate = kf * area * (1 - 10^si_cc)
60 moles = rate * TIME
70 IF (moles > M) THEN moles = M
80 SAVE moles
200 SAVE moles
-end

KINETICS 1
Calcite
    -tol   1e-8
    -m0    1.0
    -m     1.0
    -parms 1.0   10.0
    -step  1000 in 100
    -bad_step_max 2000

SELECTED_OUTPUT
    -file   calcite_kinetics4.sel
    -reset  false
    -step   true
    -time   true
    -alkalinity true
    -totals Ca C Ba Cu

END
