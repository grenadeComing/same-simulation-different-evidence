TITLE 1D Transport Problem - 10 cells, 10 shifts

# Initial solution (pH 7, Ca 1.0, Cl 2.0)
SOLUTION 1-10
    pH      7.0
    Ca      1.0
    Cl      2.0
    units   mmol/L

# Infilling solution (pH 7, Na 1.0, Cl 1.0)
SOLUTION 0
    pH      7.0
    Na      1.0
    Cl      1.0
    units   mmol/L

# Exchange sites for all 10 cells - 0.001 moles, equilibrate with solution 1
EXCHANGE 1-10
    X       0.001
    equilibrate 1

TRANSPORT
    cells           10
    shifts          10
    time_step       3600
    length          0.1
    dispersivity    0
    flow_direction  forward
    boundary_conditions  flux  flux
    print_cells     3
    print_frequency 10

END
