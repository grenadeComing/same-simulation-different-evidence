# Simulation: Mix two solutions 1:1, then heat from 20 to 200°C in 10 steps
# Solution 1: 50 mmol/kg dissolved inorganic carbon (DIC)
# Solution 2: 50 mmol/kg calcium
# Account for calcite precipitation/dissolution

SOLUTION 1
    temp      20
    pH        7.0
    units     mmol/kgw
    C(4)      50.0

SOLUTION 2
    temp      20
    pH        7.0
    units     mmol/kgw
    Ca        50.0

# Mix 1:1
MIX 1
    1   0.5
    2   0.5

# Save the mixed solution as solution 3
SAVE solution 3

END

# Now use the mixed solution and heat it from 20 to 200°C in 10 steps
# with calcite equilibrium
USE solution 3

EQUILIBRIUM_PHASES 1
    Calcite   0.0   0.0

REACTION_TEMPERATURE 1
    20.0  38.0  56.0  74.0  92.0  110.0  128.0  146.0  164.0  182.0  200.0

SELECTED_OUTPUT
    -file     mixing_calcite.sel
    -reset    false
    -temperature  true
    -equilibrium_phases  Calcite

END
