# Simulation: Mix two solutions 1:1, then heat from 20 to 200°C in 10 steps
# Solution 1: 50 mmol/kg dissolved inorganic carbon (DIC)
# Solution 2: 50 mmol/kg calcium
# Account for calcite precipitation/dissolution
# Using pure solutions with charge balance on pH

SOLUTION 1
    temp      20
    pH        7.0
    units     mmol/kgw
    C(4)      50.0
    -water    1.0

SOLUTION 2
    temp      20
    pH        7.0
    units     mmol/kgw
    Ca        50.0
    -water    1.0

END

# Mix 1:1 and equilibrate with calcite at 20°C first
MIX 1
    1   0.5
    2   0.5

EQUILIBRIUM_PHASES 1
    Calcite   0.0   10.0

SAVE solution 3

END

# Now heat from 20 to 200°C in 10 discrete steps
USE solution 3
USE equilibrium_phases 1

REACTION_TEMPERATURE 1
    20.0  40.0  60.0  80.0  100.0  120.0  140.0  160.0  180.0  200.0

SELECTED_OUTPUT
    -file     mixing_calcite4.sel
    -reset    false
    -temperature  true
    -equilibrium_phases  Calcite

END
