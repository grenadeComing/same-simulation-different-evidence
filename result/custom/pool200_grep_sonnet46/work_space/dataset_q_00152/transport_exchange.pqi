TITLE 1D Transport with Ion Exchange

# Infilling solution: pH 7.0, Na 1.0, Cl 1.0
SOLUTION 0  Infilling solution
    pH      7.0
    Na      1.0
    Cl      1.0
    units   mmol/L

# Initial solution in cells: pH 7.0, Ca 1.0, Cl 2.0
SOLUTION 1-10  Initial solution
    pH      7.0
    Ca      1.0
    Cl      2.0
    units   mmol/L

# Define exchange assemblage for all 10 cells
# 0.001 moles of exchange site, equilibrate with solution 1
EXCHANGE 1-10
    X       0.001
    equilibrate 1

TRANSPORT
    -cells          10
    -shifts         10
    -flow_direction forward
    -boundary_conditions   flux  flux
    -dispersivities 0.0
    -time_step      1.0
    -lengths        1.0
    -print_cells    1-10
    -print_frequency 1

END
