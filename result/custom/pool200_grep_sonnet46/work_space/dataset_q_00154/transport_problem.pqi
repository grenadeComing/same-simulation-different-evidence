TITLE 1D Transport Problem - 10 cells, 10 shifts

# Initial solution (fills all 10 cells): pH 7.0, Ca 1.0, Cl 2.0
SOLUTION 1-10
    pH      7.0
    Ca      1.0
    Cl      2.0

# Infilling solution (solution 0): pH 7.0, Na 1.0, Cl 1.0
SOLUTION 0
    pH      7.0
    Na      1.0
    Cl      1.0

# Exchange assemblage for all 10 cells, 0.001 moles, equilibrate with solution 1
EXCHANGE 1-10
    X       0.001
    -equilibrate 1

TRANSPORT
    -cells          10
    -shifts         10
    -time_step      3600
    -flow_direction forward
    -boundary_conditions   flux  flux
    -diffusion_coefficient 0.0
    -dispersivity   0.0
    -punch_cells    1
    -punch_frequency 1

SELECTED_OUTPUT
    -file           transport_out.sel
    -reset          false
    -solution       true
    -step           true

USER_PUNCH
    -headings  Viscosity
    -start
10  PUNCH VISCOSITY
    -end

END
