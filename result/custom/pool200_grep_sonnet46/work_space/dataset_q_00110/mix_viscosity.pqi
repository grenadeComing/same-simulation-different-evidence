SOLUTION 1  River water
    pH      6.0
    temp    25
    Cl      10      # mg/L
    Na      10      charge

SOLUTION 2  Seawater
    pH      8.1
    temp    25
    Cl      19000   # mg/L
    Na      19000   charge

MIX 1
    1   0.7
    2   0.3

SELECTED_OUTPUT
    -file   mix_viscosity.out
    -reset  false

USER_PUNCH
    -headings viscosity
    -start
10  PUNCH VISCOSITY
    -end

END
