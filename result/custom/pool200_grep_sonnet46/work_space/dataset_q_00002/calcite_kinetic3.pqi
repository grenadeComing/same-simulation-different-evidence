SOLUTION 1
    temp      100
    pH        5.0
    pe        4.0
    units     mmol/kgw
    C(4)      0.5
    Mn        1.0

RATES
Calcite
-start
10 si_cc = SI("Calcite")
20 IF (m <= 0 AND si_cc < 0) THEN GOTO 200
30 area = PARM(1) * (m/m0)^0.67
40 rate = area * PARM(2) * (1 - 10^si_cc)
50 moles = rate * TIME
60 IF (moles > m) THEN moles = m
70 IF (moles < 0) THEN moles = 0
80 SAVE moles
200 END
-end

KINETICS 1
    Calcite
        -m0    1.0
        -m     1.0
        -parms 10.0  0.001
        -step  1000 in 100
        -tol   1e-8

SELECTED_OUTPUT
    -file   calcite_kinetic3.sel
    -reset  false
    -step   true
    -time   true
    -pH     true
    -pe     true
    -si     Calcite

END
