TITLE Equilibrium of pure water with CO2 at log PCO2 = -3.4

SOLUTION 1
    temp      25
    pH        7.0
    pe        4
    units     mol/L
    water     1 # kg

EQUILIBRIUM_PHASES 1
    CO2(g)    -3.4    10

SELECTED_OUTPUT
    -file     co2_equilibrium.sel
    -reset    false
    -si       CO2(g)
    -saturation_indices true

END
