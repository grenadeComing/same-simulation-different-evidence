TITLE Mix river water and seawater 0.7:0.3 with O2 equilibrium

# Solution 1: River water, pH 6.0, Cl 10 mg/L
SOLUTION 1 River Water
    temp      25
    pH        6.0
    pe        4
    units     mg/L
    Cl        10
    O(0)      8  # dissolved oxygen ~8 mg/L (air-saturated)

# Solution 2: Seawater, pH 8.1, Cl 19000 mg/L
SOLUTION 2 Seawater
    temp      25
    pH        8.1
    pe        4
    units     mg/L
    Cl        19000
    O(0)      8  # dissolved oxygen ~8 mg/L (air-saturated)

# Mix 70% river water + 30% seawater
MIX 1
    1    0.7
    2    0.3

SELECTED_OUTPUT
    -file     mix_result2.sel
    -reset    false
    -si       O2(g)

END
