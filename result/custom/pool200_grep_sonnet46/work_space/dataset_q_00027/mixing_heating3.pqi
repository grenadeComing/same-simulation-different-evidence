# Mixing two solutions 1:1 and heating from 20°C to 200°C in 10 discrete steps
# Solution 1: 50 mmol/kg dissolved inorganic carbon (charge balanced with Na)
# Solution 2: 50 mmol/kg calcium (charge balanced with Cl or similar)

SOLUTION 1
    temp      20
    pH        7   charge
    pe        4
    units     mmol/kgw
    C(4)      50

SOLUTION 2
    temp      20
    pH        7   charge
    pe        4
    units     mmol/kgw
    Ca        50

MIX 1
    1   0.5
    2   0.5

EQUILIBRIUM_PHASES 1
    Calcite   0   0

REACTION_TEMPERATURE 1
    20   38   56   74   92   110   128   146   164   182   200

SELECTED_OUTPUT
    -file     mixing_heating3.sel
    -reset    false
    -temperature  true
    -pH       true
    -si       Calcite
    -step     true

END
