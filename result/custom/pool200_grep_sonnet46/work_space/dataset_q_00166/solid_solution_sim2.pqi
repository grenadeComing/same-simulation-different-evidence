SOLUTION 1
    pH      7.0
    temp    25.0
    units   mmol/kgw
    Ca      0.01
    Sr      0.01
    Alkalinity 0.04

SOLID_SOLUTION 1  Ca_Sr_carbonate
    -comp  Calcite      0.0
    -comp  Strontianite 0.0

SELECTED_OUTPUT
    -file   solid_solution_sim2.sel
    -pe     true
    -pH     true

END
