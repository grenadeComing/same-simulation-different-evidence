SOLUTION 1  River water
    pH      6.0
    units   mg/L
    Cl      10      charge
    temp    25

SOLUTION 2  Seawater
    pH      8.1
    units   mg/L
    Cl      19000
    Na      10000   charge
    temp    25

MIX 1
    1       0.7
    2       0.3

SAVE SOLUTION 3

END

SELECTED_OUTPUT
    -file           mix_output5.sel
    -reset          false
    -molalities     HCl

END
