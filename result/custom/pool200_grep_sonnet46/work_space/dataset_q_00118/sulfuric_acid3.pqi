TITLE Add sulfuric acid to pure water - cumulative totals as steps

# Initial pure water at pH 7.0
SOLUTION 1
    pH 7.0
    temp 25.0
    units mol/L

# Add H2SO4 with cumulative amounts as steps
# Steps represent cumulative moles added: 0.001, 0.006, 0.016, 0.066, 0.166
# But if steps are independent totals: 0.001, 0.005, 0.01, 0.05, 0.1
# Try: final solution has only 0.1 mol H2SO4 added total
REACTION 1
    H2SO4  1.0
    0.1

SELECTED_OUTPUT
    -file sulfuric_acid3.out
    -reset false
    -pH true
    -pe true

END
