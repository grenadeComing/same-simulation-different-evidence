TITLE Add sulfuric acid to pure water in steps - with fixed pe

# Initial pure water at pH 7.0, pe fixed at 4
SOLUTION 1
    pH 7.0
    pe 4.0
    temp 25.0
    units mol/L

REACTION 1
    H2SO4  1.0
    0.001  0.005  0.01  0.05  0.1

INCREMENTAL_REACTIONS true

SELECTED_OUTPUT
    -file sulfuric_acid6.out
    -reset false
    -step true
    -pH true
    -pe true
    -totals S(6)

END
