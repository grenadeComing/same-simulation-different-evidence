TITLE Add sulfuric acid to pure water in steps - sequential reactions

# Step 1: Initial pure water at pH 7.0
SOLUTION 1
    pH 7.0
    temp 25.0
    units mol/L

SAVE SOLUTION 1
END

# Add 0.001 mol H2SO4
USE SOLUTION 1
REACTION 1
    H2SO4  1.0
    0.001
SAVE SOLUTION 1
END

# Add 0.005 mol H2SO4
USE SOLUTION 1
REACTION 1
    H2SO4  1.0
    0.005
SAVE SOLUTION 1
END

# Add 0.01 mol H2SO4
USE SOLUTION 1
REACTION 1
    H2SO4  1.0
    0.01
SAVE SOLUTION 1
END

# Add 0.05 mol H2SO4
USE SOLUTION 1
REACTION 1
    H2SO4  1.0
    0.05
SAVE SOLUTION 1
END

# Add 0.1 mol H2SO4
USE SOLUTION 1
REACTION 1
    H2SO4  1.0
    0.1

SELECTED_OUTPUT
    -file sulfuric_acid2.out
    -reset false
    -pH true
    -pe true

END
