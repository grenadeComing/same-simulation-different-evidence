
# Solution 1: 50 mmol/kg dissolved inorganic carbon
SOLUTION 1
    temp      20
    pH        7.0
    C(4)      50 mmol/kgw
    units     mmol/kgw

# Solution 2: 50 mmol/kg calcium
SOLUTION 2
    temp      20
    pH        7.0
    Ca        50 mmol/kgw
    units     mmol/kgw

# Mix solutions 1 and 2 in 1:1 ratio
MIX 1
    1   0.5
    2   0.5

# Save the mixed solution as solution 3
SAVE solution 3

END

# Now use the mixed solution and heat from 20 to 200 in 10 steps
# 10 steps: 20, 40, 60, 80, 100, 120, 140, 160, 180, 200
USE solution 3

EQUILIBRIUM_PHASES 1
    Calcite   0.0   10.0

REACTION_TEMPERATURE 1
    20.0  40.0  60.0  80.0  100.0  120.0  140.0  160.0  180.0  200.0

SELECTED_OUTPUT
    -file     mixing_calcite2.sel
    -reset    false
    -temperature  true
    -pH           true
    -si           Calcite

END
