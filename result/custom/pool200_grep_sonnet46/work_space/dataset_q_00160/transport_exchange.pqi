TITLE 1D Transport with Exchange - 10 cells, 10 shifts

# Initial solution (pH 7, Ca 1.0, Cl 2.0) mmol/L
SOLUTION 1-10
    units   mmol/L
    pH      7.0
    Ca      1.0
    Cl      2.0

# Infilling solution (pH 7, Na 1.0, Cl 1.0) mmol/L
SOLUTION 0
    units   mmol/L
    pH      7.0
    Na      1.0
    Cl      1.0

# Exchange sites for all 10 cells, equilibrated with solution 1
EXCHANGE 1-10
    X       0.001
    equilibrate 1

SELECTED_OUTPUT 1
    file            transport_exchange.sel
    reset           false
    step            true
    solution        true

USER_PUNCH 1
    headings  SI_H2g
    10 PUNCH SI("H2(g)")

TRANSPORT
    cells           10
    shifts          10
    time_step       3600
    length          0.1
    dispersivity    0.0
    flow_direction  forward
    boundary_conditions  flux  flux
    print_cells     3

END
