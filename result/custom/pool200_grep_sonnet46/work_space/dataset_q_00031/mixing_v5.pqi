# Solution 1: 50 mmol/kg dissolved inorganic carbon
# No pH specified - PHREEQC will use default
SOLUTION 1
    temp      20
    units     mmol/kgw
    C(4)      50

# Solution 2: 50 mmol/kg calcium
SOLUTION 2
    temp      20
    units     mmol/kgw
    Ca        50

# Mix 1:1 and allow calcite to precipitate/dissolve
MIX 1
    1    0.5
    2    0.5

EQUILIBRIUM_PHASES 1
    Calcite   0   0

# Save the mixed solution as solution 3
SAVE solution 3

END

# Now heat from 20 to 200°C in 10 discrete steps
USE solution 3
USE equilibrium_phases 1

REACTION_TEMPERATURE 1
    20 40 60 80 100 120 140 160 180 200

SELECTED_OUTPUT
    -file   mixing_v5.sel
    -reset  false
    -temperature  true
    -ionic_strength  true
    -equilibrium_phases  Calcite

END
