# Solution 1: 50 mmol/kg dissolved inorganic carbon
SOLUTION 1
    temp      20
    pH        7
    units     mmol/kgw
    C(4)      50

# Solution 2: 50 mmol/kg calcium
SOLUTION 2
    temp      20
    pH        7
    units     mmol/kgw
    Ca        50

# Mix 1:1 and allow calcite to precipitate/dissolve
MIX 1
    1    0.5
    2    0.5

EQUILIBRIUM_PHASES 1
    Calcite   0   0

# Save the mixed solution as solution 3
SAVE solution 3

END

# Now heat from 20 to 200°C in 10 steps
USE solution 3
USE equilibrium_phases 1

REACTION_TEMPERATURE 1
    20 38 56 74 92 110 128 146 164 182 200

SELECTED_OUTPUT
    -file   mixing_heating.sel
    -reset  false
    -temperature  true
    -ionic_strength  true
    -equilibrium_phases  Calcite

END
