# Simulation: Mix two solutions 1:1, then heat from 20°C to 200°C in 10 discrete steps
# Solution 1: 50 mmol/kg dissolved inorganic carbon
# Solution 2: 50 mmol/kg calcium
# Account for calcite precipitation/dissolution

SOLUTION 1
    temp      20
    pH        7
    units     mmol/kgw
    C(4)      50

SOLUTION 2
    temp      20
    pH        7
    units     mmol/kgw
    Ca        50

# Mix 1:1
MIX 1
    1   0.5
    2   0.5

# Save the mixed solution as solution 3
SAVE solution 3

END

# Now use REACTION_TEMPERATURE to heat from 20 to 200°C in 10 steps (10 points)
USE solution 3

EQUILIBRIUM_PHASES 1
    Calcite   0   0

REACTION_TEMPERATURE 1
    20 40 60 80 100 120 140 160 180 200

SELECTED_OUTPUT
    -file     mixing_heating2.sel
    -reset    false
    -temperature  true
    -pH           true
    -si           Calcite

END
