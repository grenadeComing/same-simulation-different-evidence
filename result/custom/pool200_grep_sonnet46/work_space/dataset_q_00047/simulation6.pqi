SOLUTION 1
    temp 100
    pH 3
    units mol/kgw
    water 1 kg

EQUILIBRIUM_PHASES 1
    K-mica       0  10
    Kaolinite    0  10
    Dolomite     0  10
    Epsomite     0  10
    Fe(OH)3(a)   0  10
    Halite       0  10

USER_PUNCH
    -headings pH_precise
    -start
10 PUNCH -LA("H+")
    -end

SELECTED_OUTPUT
    -file simulation6.out
    -pH true
    -si K-mica Kaolinite Dolomite Epsomite Fe(OH)3(a) Halite
    -user_punch true
    -high_precision true

END
