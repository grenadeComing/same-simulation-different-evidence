SOLUTION 1
    temp 100
    pH 3
    units mol/L
    water 1

EQUILIBRIUM_PHASES 1
    K-mica       0  10
    Kaolinite    0  10
    Dolomite     0  10
    Epsomite     0  10
    Fe(OH)3(a)   0  10
    Halite       0  10

SELECTED_OUTPUT
    -file simulation3.out
    -pH true
    -temperature true
    -si K-mica Kaolinite Dolomite Epsomite Fe(OH)3(a) Halite
    -totals Na Cl Mg Ca K Fe Al Si S C

USER_PUNCH
    -headings pH_precise pe_precise
    -start
10 PUNCH -LA("H+"), -LA("e-")
    -end

END
