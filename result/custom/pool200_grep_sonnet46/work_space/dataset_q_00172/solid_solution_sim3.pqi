SOLUTION 1
    pH      7.0
    temp    25.0
    Ca      10.0   # mmol/L = 0.01 mol/L
    Sr      10.0   # mmol/L = 0.01 mol/L
    Alkalinity 40.0  # mmol/L = 0.04 mol/L as HCO3

SOLID_SOLUTION 1  Ca_Sr_carbonate
    -comp  Calcite      0.0
    -comp  Strontianite 0.0
    -Gugg_nondim  0 0

SELECTED_OUTPUT
    -file   solid_solution_sim3.out
    -reset  false
    -si     Calcite Strontianite
    -solid_solutions  Ca_Sr_carbonate

END
