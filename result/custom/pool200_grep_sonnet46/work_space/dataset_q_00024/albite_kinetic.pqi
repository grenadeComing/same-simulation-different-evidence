SOLUTION 1
    temp      200
    pH        2.0
    pe        4
    redox     pe
    units     mmol/kgw
    density   1.0
    Fe(2)     4.0
    Fe(3)     4.0
    -water    1.0

KINETICS 1
Albite
    -m0   1.0
    -m    1.0
    -parms 1.0  10.0
    -step 10 in 100

GAS_PHASE 1
    -fixed_pressure
    -pressure 5.0
    -volume   1.0
    -temperature 200.0
    H2S(g)    5.0

SELECTED_OUTPUT 1
    -file     albite_kinetic.sel
    -reset    false
    -step
    -time
    -totals   S

USER_PUNCH 1
    -headings Step Time moles_H2S_dissolved
    -start
10 PUNCH STEP_NO, TIME, GAS("H2S(g)")
    -end

END
