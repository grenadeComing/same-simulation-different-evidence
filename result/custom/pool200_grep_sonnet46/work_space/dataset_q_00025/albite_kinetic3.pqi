SOLUTION 1
    temp      200
    pH        2.0
    pe        4
    units     mmol/kgw
    Fe(2)     4.0
    Fe(3)     4.0

GAS_PHASE 1
    -fixed_pressure
    -pressure 5.0
    -volume   1.0
    -temperature 200
    H2S(g)    5.0

RATES
Albite_custom
-start
10 SR_Albite = SR("Albite")
20 if (SR_Albite >= 1) then goto 200
30 rate = PARM(1) * PARM(2) * (1 - SR_Albite)
40 moles = rate * TIME
50 if (moles > M) then moles = M
200 SAVE moles
-end

KINETICS 1
Albite_custom
    -formula NaAlSi3O8 1
    -m0   1.0
    -m    1.0
    -parms 1.0  10.0
    -step 1000 in 100

INCREMENTAL_REACTIONS true

SELECTED_OUTPUT
    -file albite_kinetic3.sel
    -reset false
    -step true
    -time true
    -si Goethite

END
