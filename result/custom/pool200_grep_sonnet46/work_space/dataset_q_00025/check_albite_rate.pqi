SOLUTION 1
    temp      200
    pH        2.0
    pe        4
    units     mmol/kgw
    Fe(2)     4.0
    Fe(3)     4.0

GAS_PHASE 1
    -fixed_pressure
    -pressure 5.0
    -volume   1.0
    -temperature 200
    H2S(g)    5.0

KINETICS 1
Albite
    -m0   1.0
    -m    1.0
    -parms 1.0  10.0
    -step 1000 in 100
    -tol 1e-8

INCREMENTAL_REACTIONS true

SELECTED_OUTPUT
    -file check_albite_rate.sel
    -reset false
    -step true
    -time true
    -si Goethite Albite
    -m Albite

END
