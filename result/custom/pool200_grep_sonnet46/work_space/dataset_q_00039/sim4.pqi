SOLUTION 1
    temp      100
    pH        7 charge
    Ca        50 mmol/kgw

EQUILIBRIUM_PHASES 1
    Calcite    0 10
    Gypsum     0 10
    Aragonite  0 10
    CO2(g)     0 1.0
    CH4(g)     0 5.0
    H2S(g)     0 10.0

SELECTED_OUTPUT
    -file sim4.out
    -reset false
    -pe true
    -pH true
    -temperature true

END
