SOLUTION 1
    temp 150
    pH 7
    pe 4
    units mol/kgw
    water 1 # kg

GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    -temperature 150
    -volume 1
    CH4(g)   10
    CO2(g)   10
    NH3(g)   5

SELECTED_OUTPUT
    -file simulation.out
    -reset false
    -solution true
    -totals C N
    -molalities CO3-2 HCO3- H2CO3 CO2 CH4

END
