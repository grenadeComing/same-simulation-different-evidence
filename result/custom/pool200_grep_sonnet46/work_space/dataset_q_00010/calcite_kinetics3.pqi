TITLE Calcite kinetic dissolution in acidic solution at 200C - custom rate

SOLUTION 1
    temp      200
    pH        2.0
    pe        4.0
    units     mmol/kgw
    Cu        10.0
    Ba        5.0
    -water    1.0

RATES
Calcite
-start
1  REM Calcite dissolution rate based on Plummer et al. 1978
2  REM PARM(1) = specific surface area (m^2/mol)
3  REM PARM(2) = rate constant
10 si_cc = SI("Calcite")
20 IF (M <= 0 AND si_cc < 0) THEN GOTO 200
30 k = PARM(2)
40 rate = k * PARM(1) * (M/M0) * (1 - 10^si_cc)
50 moles = rate * TIME
60 IF (moles > M) THEN moles = M
200 SAVE moles
-end

KINETICS 1
Calcite
    -tol    1e-8
    -m0     1.0
    -m      1.0
    -parms  1.0  10.0
    -step   1000 in 100

INCREMENTAL_REACTIONS true

SELECTED_OUTPUT
    -file   calcite_kinetics3.sel
    -reset  false
    -step   true
    -time   true
    -si     Witherite

END
