TITLE Calcite kinetic dissolution - custom rate with k=10 mmol/m2/s

SOLUTION 1
    temp      200
    pH        2.0
    pe        4.0
    units     mmol/kgw
    Cu        10.0
    Ba        5.0
    -water    1.0

RATES
Calcite
-start
10 si_cc = SI("Calcite")
20 IF (M <= 0 AND si_cc < 0) THEN GOTO 200
30 sa = PARM(1)
40 k = PARM(2)
50 rate = k * sa * (M/M0)^0.6 * (1 - 10^si_cc) * 1e-3
60 moles = rate * TIME
70 IF (moles > M) THEN moles = M
80 IF (moles < 0) THEN moles = 0
200 SAVE moles
-end

KINETICS 1
Calcite
    -tol    1e-8
    -m0     1.0
    -m      1.0
    -parms  1.0  10.0
    -step   1000 in 100

INCREMENTAL_REACTIONS true

SELECTED_OUTPUT
    -file   calcite_kinetics8.sel
    -reset  false
    -step   true
    -time   true
    -si     Witherite

END
