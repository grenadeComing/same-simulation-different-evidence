SOLUTION 1
    temp      25
    pH        7 charge
    Ca        50 mmol/kgw

EQUILIBRIUM_PHASES 1
    Calcite    0 10
    Gypsum     0 10
    Aragonite  0 10
    CO2(g)     0.0 1000
    CH4(g)     0.69897 1000
    H2S(g)     1.0 1000

SELECTED_OUTPUT
    -file     result6.out
    -totals   S Ca C
    -molalities SO4-2 HS- H2S
    -si       Calcite Gypsum Aragonite
    -pH       true
    -temperature true

END
