
# Solution 1: 50 mmol/kg dissolved inorganic carbon
SOLUTION 1
    temp      20
    pH        7
    C(4)      50 mmol/kgw
    units     mmol/kgw

# Solution 2: 50 mmol/kg calcium
SOLUTION 2
    temp      20
    pH        7
    Ca        50 mmol/kgw
    units     mmol/kgw

# Mix 1:1 and allow calcite to equilibrate, then heat in steps
MIX 1
    1   0.5
    2   0.5

EQUILIBRIUM_PHASES 1
    Calcite   0   0

REACTION_TEMPERATURE 1
    20 40 60 80 100 120 140 160 180 200

SAVE solution 1

END

# Now use the saved mixed solution and step through temperatures
USE solution 1

EQUILIBRIUM_PHASES 2
    Calcite   0   0

REACTION_TEMPERATURE 2
    20 40 60 80 100 120 140 160 180 200

SELECTED_OUTPUT
    -file   mixing_heating2.sel
    -reset  false
    -temperature true
    -step    true
    -totals  Ca C(4)
    -molalities Ca+2 CaHCO3+ CaCO3 CaOH+
    -equilibrium_phases Calcite

END
