TITLE Equilibrium oxidation of Pyrite in pure water at 25C

SOLUTION 1
    temp      25
    pH        7.0
    pe        4.0
    units     mol/kgw
    water     1.0  # kg

EQUILIBRIUM_PHASES 1
    O2(g)     -0.7    10.0   # Constant atmospheric O2 source
    Pyrite     0.0    0.1    # Up to 0.1 moles of Pyrite can react
    Goethite   0.0    0.0    # Allow Goethite to precipitate
    Gypsum     0.0    0.0    # Allow Gypsum to precipitate

SELECTED_OUTPUT
    -file     pyrite_oxidation.out
    -reset    false
    -pH       true
    -pe       true
    -si       Pyrite Goethite Gypsum O2(g)
    -totals   S(6) Fe Ca

END
