SOLUTION 1
    temp      100
    pH        3
    pe        4
    units     mol/kgw
    water     1
    -water    1

EQUILIBRIUM_PHASES 1
    K-mica        0  10
    Kaolinite     0  10
    Dolomite      0  10
    Epsomite      0  10
    Fe(OH)3(a)    0  10
    Halite        0  10

SAVE solution 1

END

USE solution 1

SELECTED_OUTPUT
    -file        result5.out
    -reset       false
    -solution    true
    -pH          true
    -temperature true

END
