SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    units mmol/kgw
    Cu 10
    Ba 5

KINETICS 1
    Calcite
        -m0 1
        -m 1
        -parms 1.0 1.0
        -steps 10 seconds in 100 steps
        -tol 1e-12

SELECTED_OUTPUT
    -file calcite_kinetics.sel
    -reset false
    -time true
    -pH true
    -step true
END