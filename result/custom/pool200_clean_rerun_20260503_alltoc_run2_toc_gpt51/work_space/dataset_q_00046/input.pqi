SOLUTION 1
    temp 100
    units mmol/kgw
    pH 7 charge
    Ca 50

EQUILIBRIUM_PHASES 1
    Calcite 0 0
    Gypsum 0 0
    Aragonite 0 0

GAS_PHASE 1
    -fixed_pressure
    -temperature 25
    -pressure 1
    CO2(g) 1.0
    CH4(g) 5.0
    H2S(g) 10.0

SELECTED_OUTPUT
    -file sel.out
    -molalities   Ca+2 CaCO3 CaHCO3+ CaOH+ CaSO4 CaHSO3+ CaHS+ CaCH3COO+ CaHCOO+ CaF+ CaCl+ CaH2PO4+ CaPO4- CaPO4- CaPO4H CaSO4 HCaPO4 CaCO3(aq)
    -high_precision true
END
