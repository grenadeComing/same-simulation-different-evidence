SOLUTION 0-10
    pH 7.0 charge
    Ca 1.0
    Cl 2.0

SOLUTION 11
    pH 7.0 charge
    Na 1.0
    Cl 1.0

EXCHANGE_SPECIES
    Ca+2 + 2X- = CaX2
        log_k 0

EXCHANGE 1-10
    X- 0.001
    -equilibrate 1

EXCHANGE 0
    X- 0.0

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 1
    -boundary_conditions flux flux
    -initial_time 0
    -print_cells 1
    -print_frequency 1

SELECTED_OUTPUT
    -file exch.sel
    -reset false
    -step true
    -totals Ca
