SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    Cu 0.01
    Ba 0.005
    units mol/kgw

KINETICS 1
    Calcite
        -m0 1
        -parms 1.0 1.0
        -m 1
        -tol 1e-12
        -steps 10*100

SELECTED_OUTPUT
    -file calcite_kinetics_sel.tab
    -reset false
    -step true
    -totals C(4) Cu(2)
