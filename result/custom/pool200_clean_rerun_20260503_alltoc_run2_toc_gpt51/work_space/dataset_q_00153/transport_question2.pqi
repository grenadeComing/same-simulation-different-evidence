SOLUTION 0-10
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 11
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -lengths 10*1.0
    -time_step 1.0
    -boundary_conditions flux flux
    -print_cells 1-10
    -print_frequency 1
    -punch_frequency 1
    -punch_cells 1-10
    -correct_disp false

SELECTED_OUTPUT
    -file exch1_step6.sel
    -reset false
    -step
    -totals Na

END