SOLUTION 1
    temp 200
    pH 2 charge
    Fe(2) 4e-3
    Fe(3) 4e-3

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1.0
        -m  1.0
        -parms 1.0 10.0
        -steps 10 100

SELECTED_OUTPUT
    -file albite_h2s.sel
    -reset false
    -pH true
    -pe true
    -time true
USER_PUNCH
    -headings step
    10 PUNCH KIN_TIME
END