SOLUTION 1
    temp      25
    pH        7    charge
    units     mg/L
    Ba        2.0
    S(6)      15.0

REACTION_TEMPERATURE 1
    25 95 in 5 steps

USER_PUNCH
    -headings step temp sc
    10 PUNCH STEP_NO, TOT("S(6)"), SC

SELECTED_OUTPUT
    -file ba_so4_sc.sel
    -reset false
    -user_punch true
END