SOLUTION 0
    pH 7 charge
    Na 1
    Cl 1

SOLUTION 1-10
    pH 7 charge
    Ca 1
    Cl 2

EXCHANGE 1-10
    X- 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 1
    -flow_direction forward
    -boundary_conditions flux flux
    -print_cells 3
    -print_frequency 1
    -punch_cells 3
    -punch_frequency 1

SELECTED_OUTPUT
    -file trans.sel
    -reset false
    -simulation true
    -state true
    -step true
    -dist true
    -si Halite
END
