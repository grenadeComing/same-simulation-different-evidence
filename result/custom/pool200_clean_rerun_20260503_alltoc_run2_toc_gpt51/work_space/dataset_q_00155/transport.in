SOLUTION 0-10
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 100
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 0-10
    X- 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 1
    -boundary_conditions flux closed
    -initial_time 0
    -print_cells 1
    -print_frequency 1
    -punch_cells 1
    -punch_frequency 1

INVERSE_MODELING 1
    -solutions 100 0

SELECTED_OUTPUT
    -file ca_step.out
    -time true
    -molalities Ca+2