SOLUTION 1
    temp 25
    pH 7.0 charge
    pe 4
    units mol/kgw

EQUILIBRIUM_PHASES 1
    Pyrite 0 0.1
    Goethite 0 0
    Gypsum 0 0

GAS_PHASE 1
    -fixed_pressure
    -pressure 1.0
    -temperature 25
    O2(g) -0.7

SELECTED_OUTPUT
    -file pyrite_pe.sel
    -pH true
    -pe true
    -totals Fe S O Ca
    -equilibrium_phases Pyrite Goethite Gypsum
    -si Goethite Gypsum
END