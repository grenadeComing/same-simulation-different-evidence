SOLUTION 0-10
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 11
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X- 0.001
    -equilibrate 1

EXCHANGE_SPECIES
    H+ + X- = HX
        log_k 0

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 1
    -boundary_conditions flux flux
    -dispersivities 0
    -punch_cells 1-10
    -print_cells 1-10
    -print_frequency 1
    -initial_time 0
    -flow_direction forward
    -correct_disp default

USER_PUNCH
    -headings cell step log_IAP_H2g
    -start
    10 PUNCH CELL_NO, STEP_NO,
    20 PUNCH LOG10( IAP("H2(g)") )
    -end
