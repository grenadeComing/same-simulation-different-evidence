SOLUTION 1
    temp 20
    units mmol/kgw
    C(4) 50

SOLUTION 2
    temp 20
    units mmol/kgw
    Ca 50

MIX 1
    1 0.5
    2 0.5

EQUILIBRIUM_PHASES 1
    Calcite 0 0

REACTION_TEMPERATURE 1
    20 200 in 10 steps

SELECTED_OUTPUT
    -file sel.out
    -reset false
    -temperature true
    -molalities Ca+2
    -high_precision true
    -step true
END
