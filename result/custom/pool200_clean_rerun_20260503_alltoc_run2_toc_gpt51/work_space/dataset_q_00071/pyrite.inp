SOLUTION 1
    temp 25
    pH 7 charge
    pe 4
    units mol/kgw
    water 1 # kg

EQUILIBRIUM_PHASES 1
    Pyrite 0 0.1
    Goethite 0 0
    Gypsum 0 0

GAS_PHASE 1
    -fixed_pressure
    -temperature 25
    -pressure 1.0
    -volume 1.0
    O2(g)  -0.7

SELECTED_OUTPUT
    -file pyrite_sel.out
    -alkalinity true
    -totals O(0) Fe S(6) S(-2) Ca
    -si Goethite Gypsum Pyrite
END