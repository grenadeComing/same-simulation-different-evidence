SOLUTION 1
    temp 100
    units mmol/kgw
    pH 7 charge
    Ca 50
    C(4) 1e-2

EQUILIBRIUM_PHASES 1
    Calcite 0 0
    Gypsum 0 0
    Aragonite 0 0

GAS_PHASE 1
    -fixed_pressure
    -temperature 25
    -pressure 1
    CO2(g)  -1.0
    CH4(g)   0.6990
    H2S(g)   1.0

SELECTED_OUTPUT
    -file sel.out
    -molalities S
END
