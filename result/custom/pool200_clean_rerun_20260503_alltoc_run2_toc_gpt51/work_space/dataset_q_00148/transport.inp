SOLUTION 1-10
    pH 7.0
    units mol/kgw
    Ca 1.0
    Cl 2.0

SOLUTION 0
    pH 7.0
    units mol/kgw
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X- 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 1
    -dispersivities 0
    -correct_disp false
    -initial_time 0
    -print_cells 1
    -print_frequency 1
    -punch_cells 1
    -punch_frequency 1
    -boundary_conditions flux flux

SELECTED_OUTPUT
    -file tran.sel
    -reset false
    -time true
    -distance true
    -solution true
    -totals Na
END