SOLUTION 1
    temp 150
    pH 7 charge
    pe 4
    units mol/kgw
    density 1

GAS_PHASE 1
    -fixed_pressure
    -temperature 150
    -pressure 1
    CH4(g) 10
    CO2(g) 10
    NH3(g) 5

SELECTED_OUTPUT
    -file sel.out
    -reset false
    -totals CH4 CO2 NH3 C N
    -ionic_strength true
END