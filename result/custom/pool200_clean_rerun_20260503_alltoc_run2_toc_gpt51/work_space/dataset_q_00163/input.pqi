SOLUTION 1
    temp 25
    pH 7 charge
    Ca 0.01
    Sr 0.01
    Alkalinity 0.04 as HCO3

EQUILIBRIUM_PHASES 1
    Ca_Sr_carbonate 0 10

SOLID_SOLUTIONS 1
    Ca_Sr_carbonate
        -comp Calcite 1
        -comp Strontianite 1

SELECTED_OUTPUT
    -file sel.out
    -reset false
    -solid_solutions true
