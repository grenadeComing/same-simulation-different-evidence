SOLUTION 0-10
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 11
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X- 0.001

EQUILIBRIUM_PHASES 1-10
    Calcite 0 0

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -boundary_conditions flux flux
    -lengths 1
    -dispersivities 0
    -punch_cells 3
    -punch_frequency 1
    -print_cells 3
    -print_frequency 1
    -initial_time 0
    -flow_direction forward
    -inflow 11

SELECTED_OUTPUT
    -file sel3.out
    -reset false
    -solution 3
    -step true
    -activities Na+
