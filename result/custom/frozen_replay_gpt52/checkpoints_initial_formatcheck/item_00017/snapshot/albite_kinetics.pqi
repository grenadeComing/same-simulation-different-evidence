SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    Fe(+3) 4e-3
    Fe(+2) 4e-3

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 1.0

KINETICS 1
    Albite
        -m0 1.0
        -m  1.0
        -parms 1.0 10.0
        -steps 1000 in 100
        -tol 1e-12

SELECTED_OUTPUT
    -file albite_sel.tsv
    -reset false
    -time true
    -step true
    -kinetic_reactants Albite
END
