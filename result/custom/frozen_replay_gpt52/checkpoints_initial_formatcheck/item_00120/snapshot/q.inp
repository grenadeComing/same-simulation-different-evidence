SOLUTION 1 Pure_water
    pH 7.0
    temp 25
    units mol/kgw
    -water 1

REACTION 1
    H2SO4 1
    0.001 0.005 0.01 0.05 0.1

SELECTED_OUTPUT
    -file sel.txt
    -reset false
    -high_precision true
USER_PUNCH
    -headings step mol_H2SO4 pH a_Hplus
10 PUNCH RXN, TOT("H2SO4"), -LA("H+"), ACT("H+")
END
