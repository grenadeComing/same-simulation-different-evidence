TITLE Pyrite oxidation in pure water with fixed atmospheric O2
SOLUTION 1
    temp 25
    pH 7 charge
    units mol/kgw
    -water 1
EQUILIBRIUM_PHASES 1
    Pyrite 0 0.1
    Goethite 0 0
    Gypsum 0 0
GAS_PHASE 1
    -fixed_pressure true
    -pressure 1
    -volume 1
    O2(g) -0.7
SELECTED_OUTPUT
    -file pyrite_ox.sel
    -reset false
    -pH true
END
