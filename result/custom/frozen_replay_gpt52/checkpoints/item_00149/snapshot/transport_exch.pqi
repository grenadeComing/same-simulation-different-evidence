TITLE 1D transport, 10 cells, 10 shifts, exchange in all cells

SOLUTION 0  Infilling
    pH 7.0
    Na 1.0
    Cl 1.0

SOLUTION 1-10 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

SELECTED_OUTPUT
    -file sel.csv
    -reset false
USER_PUNCH
    -headings step cell NaX
10 PUNCH STEP_NO, CELL_NO, MOL("NaX")

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions constant constant
    -diffusion_coefficient 0
    -dispersivities 0
    -correct_disp true
    -print_cells 1-10
    -punch_cells 1-10
END
