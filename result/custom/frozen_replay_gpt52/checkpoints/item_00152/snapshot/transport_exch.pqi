TITLE 1D transport with exchange
SOLUTION 0  Infilling
    pH 7.0
    Na 1.0
    Cl 1.0
SOLUTION 1-10 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
    -equilibrate 1
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions constant constant
    -lengths 1
    -dispersivities 0
    -time_step 1
    -diffusion_coefficient 0
    -multi_d true
SELECTED_OUTPUT
    -file sel.tsv
    -reset false
    -high_precision true
USER_PUNCH
    -headings step cell CaX2_eqfrac
10 PUNCH SIM_NO, CELL_NO, EQUIV_FRACTION(CaX2)
END
