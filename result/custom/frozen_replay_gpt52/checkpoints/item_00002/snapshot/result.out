	TITLE Calcite kinetic dissolution, 100C, pe 4, pH 5
	SOLUTION 1 Hydrothermal
	    temp 100
	    pH 5
	    pe 4
	    units mmol/kgw
	    C(4) 0.5
	    Mn 1
	    water 1
	RATES
	Calcite
	start
	10 k = 0.001
	20 sa = 10.0
	30 rate = k*sa
	40 moles = rate*TIME
	50 SAVE moles
	end
	KINETICS 1
	    Calcite
	        m0 1.0
	        formula CaCO3 1
	        steps 10 100
	        cvode false
	SELECTED_OUTPUT
	    file calcite_kin.sel
	    reset false
	    time true
	    step true
	    ph true
	END
