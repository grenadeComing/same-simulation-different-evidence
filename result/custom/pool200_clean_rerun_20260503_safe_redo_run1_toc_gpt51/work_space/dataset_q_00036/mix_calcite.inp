SOLUTION 1
    temp 20
    pH 7 charge
    C(4) 0.05
    units mol/kgw

SOLUTION 2
    temp 20
    pH 7 charge
    Ca 0.05
    units mol/kgw

MIX 1
    1 0.5
    2 0.5

EQUILIBRIUM_PHASES 1
    Calcite 0 0

REACTION_TEMPERATURE 1
    20 200 in 10 steps

SELECTED_OUTPUT
    -file mix_calcite.sel
    -reset false
    -temperature true
    -si Calcite
    -ionic_strength true
    -molalities Ca+2 CO3-2 H+ HCO3-
    -saturation_indices Calcite
    -activities Ca+2 CO3-2

USER_PUNCH
    -start
    10 PUNCH TOT("Ca"), TOT("C(4)"), SI("Calcite"), LOG10(ACT("Ca+2")*ACT("CO3-2"))
    -end
