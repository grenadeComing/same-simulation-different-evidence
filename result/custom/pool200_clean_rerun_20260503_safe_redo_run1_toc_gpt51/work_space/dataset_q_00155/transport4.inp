SOLUTION 0
    pH 7.0
    Na 1.0
    Cl 1.0

SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X- 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 1
    -boundary_conditions constant flux
    -flow_direction forward
    -dispersivities 0
    -correct_disp true
    -punch_cells 1
    -punch_frequency 1

SELECTED_OUTPUT
    -file ca_cell1.txt
    -reset false
    -time true
    -step true
    -state true
    -molalities Ca+2

PRINT
    -reset false
    -selected_output true
