SOLUTION 1 Pure water at 150C
    temp 150
    pH 7 charge
    pe 4
    units mol/kgw

GAS_PHASE 1 Fixed P gas mix
    -pressure 1.0
    -temperature 150
    -fixed_pressure true
    -volume 1.0
    CH4(g) 10
    CO2(g) 10
    NH3(g) 5

SELECTED_OUTPUT
    -file q1.sel
    -alkalinity true
    -high_precision true
END
