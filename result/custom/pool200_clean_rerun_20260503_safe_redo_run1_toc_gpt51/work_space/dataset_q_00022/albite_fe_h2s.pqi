SOLUTION 1
    temp 200
    pH 2 charge
    Fe(3) 0.004
    Fe(2) 0.004

GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1.0
        -m 1.0
        -parms 1.0 10.0
        -time 1000 in 100
        -steps 10

SELECTED_OUTPUT
    -file albite_fe_h2s.sel
    -reset false
    -time true
    -totals Fe(2) Fe(3)
