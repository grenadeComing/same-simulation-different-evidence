SOLUTION 1 Pure water
    temp 150
    pH 7 charge
    pe 4
    units mol/kgw
    water 1

GAS_PHASE 1 Fixed P gas mix
    -fixed_pressure
    -temperature 150
    -pressure 1
    -volume 1
    CH4(g) 10
    CO2(g) 10
    NH3(g) 5

EQUILIBRIUM_PHASES 1
    CH4(g) 0 0
    CO2(g) 0 0
    NH3(g) 0 0

SELECTED_OUTPUT
    -reset false
    -pH true
    -si CO2(g) CH4(g) NH3(g)
    -totals C N
END