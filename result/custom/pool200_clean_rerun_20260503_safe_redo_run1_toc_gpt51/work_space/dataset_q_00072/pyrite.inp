SOLUTION 1
    temp 25
    pH 7 charge
    pe 4
    redox pe

EQUILIBRIUM_PHASES 1
    Pyrite 0 0.1
    Goethite 0 0
    Gypsum 0 0

GAS_PHASE 1
    -fixed_pressure
    -pressure 1.0
    -temperature 25
    -volume 1
    O2(g) -0.7

SELECTED_OUTPUT
    -file pyrite.sel
    -reset false
    -high_precision true
    -molalities Fe+3 Fe(OH)2+ Fe(OH)2+ Fe(OH)3 Fe(OH)4- FeSO4+ FeH2PO4+ FeHPO4 Fe(CO3)+ Fe(CO3)2- FeCl+ FeCl2+ FeCl3 FeF+ FeF2+ Fe(OH)2+ Fe(OH)3 Fe(OH)4-

PRINT
    -species true
    -reset false
