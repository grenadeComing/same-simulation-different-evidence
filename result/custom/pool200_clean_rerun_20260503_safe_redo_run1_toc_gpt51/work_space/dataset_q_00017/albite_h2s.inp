SOLUTION 1
    temp 200
    pH 2 charge
    Fe(3) 4e-3
    Fe(2) 4e-3

GAS_PHASE 1
    -pressure 5
    -fixed_pressure true
    H2S(g) 1

KINETICS 1
    Albite
        -m0 1.0
        -m  1.0
        -parms 1.0 10.0
        -steps 1000 in 100

SELECTED_OUTPUT
    -file albite_h2s.sel
    -reset false
    -time true
    -step true
    -totals Na Al Si
    -kinetic_reactants Albite
    -pH true

USER_PUNCH
    -headings step time Albite_moles
    10 PUNCH STEP_NO, TOTAL_TIME, M
END