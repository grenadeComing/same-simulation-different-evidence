TITLE Na-Ca exchange transport problem

SOLUTION 0
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 11
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X- 0.001
    -equilibrate 1

USER_PUNCH
    -headings step cell NaX
    10 PUNCH STEP_NO, CELL_NO, MOL("NaX")

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions constant  flux
    -initial_time 0
    -print_cells 1-10
    -print_frequency 1
    -punch_cells 1-10
    -punch_frequency 1

SELECTED_OUTPUT
    -file transport_sel.out
    -reset false
