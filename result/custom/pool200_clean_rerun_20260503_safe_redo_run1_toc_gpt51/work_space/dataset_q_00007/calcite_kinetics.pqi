SOLUTION 1
    temp 100
    pH 5 charge
    pe 4
    units mmol/kgw
    C(4) 0.5
    Mn 1

KINETICS 1
    Calcite
        -m0 1
        -m 1
        -parms 10.0 1.0
        -tol 1e-12
        -steps 10 seconds in 100 steps

SELECTED_OUTPUT
    -file sel.out
    -reset false
    -time true
    -si Aragonite
    -step true
END