SOLUTION 1
    temp 25
    pH 7 charge
    Ca 0.01
    Sr 0.01
    Alkalinity 0.04 as HCO3

EQUILIBRIUM_PHASES 1
    Calcite 0 0
    Strontianite 0 0

SOLID_SOLUTIONS 1
    Ca_Sr_carbonate
        -comp1 Calcite 0.0
        -comp2 Strontianite 0.0

SELECTED_OUTPUT
    -file sel.out
    -reset false
USER_PUNCH
    -headings sc
    10 PUNCH SC
END
