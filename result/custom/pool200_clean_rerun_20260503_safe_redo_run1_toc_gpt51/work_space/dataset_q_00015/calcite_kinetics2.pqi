SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    units mmol/kgw
    Cu 1e-6
    Ba 5
    C 0
    Ca 0

KINETICS 1
    Calcite
        -m0 1
        -m 1
        -parms 1.0 1.0
        -steps 10*10
        -bad_step_max 1000

SELECTED_OUTPUT
    -file witherite_si2.csv
    -reset false
    -time true
    -step true
    -si Witherite
