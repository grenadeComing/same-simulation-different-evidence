SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    Cu 0.01
    Ba 0.005
    C 0

KINETICS 1
    Calcite
        -m0 1
        -m 1
        -parms 1.0 1.0
        -formula CaCO3 1
        -steps 10*0.1 90*0.1

SELECTED_OUTPUT
    -file sel.out
    -reset false
    -time true
    -totals C(4) Cu(2)
    -step true
