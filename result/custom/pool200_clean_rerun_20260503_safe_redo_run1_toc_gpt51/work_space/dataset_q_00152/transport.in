TITLE Transport exchange problem
SOLUTION 0
    pH 7.0
    Ca 1.0
    Cl 2.0
SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0
SOLUTION 11
    pH 7.0
    Na 1.0
    Cl 1.0
EXCHANGE 1-10
    X- 0.001
    -equilibrate 1
END
BOUNDARY_CONDITIONS
    1 0 11
END
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -time_step 1
    -boundary_conditions constant constant
    -print_cells 1-10
    -print_frequency 1
    -punch_cells 1-10
    -punch_frequency 1
USER_PUNCH
    -headings step cell CaX2_frac
    10 PUNCH KIN_TIME, CELL_NO, TOT("CaX2")/TOT("X")
END
PRINT
    -reset false
END