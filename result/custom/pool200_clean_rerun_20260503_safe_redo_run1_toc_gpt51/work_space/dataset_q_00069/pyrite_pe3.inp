SOLUTION 1
    temp 25
    pH 7 charge

EQUILIBRIUM_PHASES 1
    Pyrite 0 0.1
    Goethite 0 0
    Gypsum 0 0

GAS_PHASE 1
    -fixed_pressure
    -pressure 1.0
    O2(g) -0.7

USE solution 1
USE equilibrium_phases 1
USE gas_phase 1

REACTION 1
    O2 1
    -equilibrium_phase O2(g)
    1 moles

SELECTED_OUTPUT
    -file pyrite_pe3.sel
    -reset false
    -pH true
    -pe true
END