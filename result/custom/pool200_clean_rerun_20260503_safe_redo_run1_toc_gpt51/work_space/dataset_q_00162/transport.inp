SOLUTION 0-10
    pH 7
    Ca 1
    Cl 2

SOLUTION 11
    pH 7
    Na 1
    Cl 1

EXCHANGE 0-10
    X- 0.001
    -equilibrate 1

EXCHANGE_SPECIES
    X- = X-
        log_k 0
    Na+ + X- = NaX
        log_k 0
    Ca+2 + 2 X- = CaX2
        log_k 0

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -length 1
    -print_cells 3
    -print_frequency 1
    -punch_cells 3
    -punch_frequency 1
    -flow_direction forward
    -boundary_conditions flux flux

SELECTED_OUTPUT
    -file transport.sel
    -reset false
    -alkalinity true
