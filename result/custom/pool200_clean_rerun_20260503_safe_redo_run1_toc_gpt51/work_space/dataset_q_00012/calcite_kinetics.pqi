SOLUTION 1
    temp 200
    pH 2
    pe 4
    units mmol/kgw
    Cu 10
    Ba 5

EQUILIBRIUM_PHASES 1
    Calcite 0 1

KINETICS 1
    Calcite
        -m0 1
        -m  1
        -parms 1.0 1.0
        -steps 10 in 100

SELECTED_OUTPUT
    -file calcite_sel.out
    -reset false
    -time true
    -alk true
END