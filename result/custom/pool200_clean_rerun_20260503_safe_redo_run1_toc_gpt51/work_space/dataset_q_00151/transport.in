SOLUTION 0
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 1
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 2-10
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 11
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X- 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 1
    -boundary_conditions flux flux
    -initial_time 0
    -print_cells 1-10
    -print_frequency 1
    -punch_cells 1-10
    -punch_frequency 1
    -correct_disp false
    -multi_D true
    -stagnant 0
    -flow_direction forward

SELECTED_OUTPUT
    -file transport.sel
    -reset false
    -totals Ca Na Cl
    -si Halite
    -ionic_strength true

USER_PUNCH
    -headings cell step sc8
    10 PUNCH CELL_NO, STEP_NO, SC
