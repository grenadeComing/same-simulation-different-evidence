SOLUTION 1
    temp 25
    pH 7 charge
    pe 4
    redox pe
    units mol/kgw
    water 1

GAS_PHASE 1
    -fixed_pressure
    -pressure 1.0
    -temperature 25
    -volume 1
    O2(g)  -0.7

EQUILIBRIUM_PHASES 1
    Pyrite  0  0.1
    Goethite  0  0
    Gypsum  0  0

SELECTED_OUTPUT
    -file pyrite_sc.sel
    -reset false
    -solution  true
    -si        true
    -pH        true
    -totals    Fe  S  Ca  O(0)
    -equilibrium_phases true
    -ionic_strength true
    -activities O2(aq)
    -high_precision true
END