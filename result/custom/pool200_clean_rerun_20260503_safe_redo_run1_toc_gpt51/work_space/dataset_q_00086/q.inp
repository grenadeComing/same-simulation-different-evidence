SOLUTION 1 Pure water
    temp 150
    pH 7 charge
    pe 4
    units mmol/kgw

GAS_PHASE 1 Fixed pressure
    -pressure 1
    -temperature 150
    -fixed_pressure true
    -volume 1
    CH4(g) 10
    CO2(g) 10
    NH3(g) 5

EQUILIBRIUM_PHASES 1
    CH4(g) 0 10
    CO2(g) 0 10
    NH3(g) 0 5

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -pH true
    -pe true
    -totals O H C N
END