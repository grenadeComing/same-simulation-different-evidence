SOLUTION 1
    temp 200
    pH 2 charge
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4
    Ba 1e-6

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    -temperature 200
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1
        -m 1
        -parms 1.0 10
        -steps 10*10

SELECTED_OUTPUT
    -file albite_h2s.sel
    -reset false
    -time true
    -totals Ba
    -step true
