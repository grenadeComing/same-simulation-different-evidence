SOLUTION 0
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 1
    pH 7.0
    Na 1.0
    Cl 1.0

SOLUTION 2-10
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 0
    X- 0.001
    -equilibrate 1

EXCHANGE 1-10
    X- 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1
    -dispersivities 0
    -punch_cells 3
    -punch_frequency 10

SELECTED_OUTPUT
    -file sel3.out
    -reset false
    -time true
    -solution true
    -step true
    -totals Na
    -activities Na+
    -high_precision true
