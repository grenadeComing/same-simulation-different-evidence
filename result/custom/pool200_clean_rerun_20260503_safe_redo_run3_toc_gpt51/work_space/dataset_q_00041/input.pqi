SOLUTION 1
    temp 100
    units mmol/kgw
    Ca 50
    pH 7 charge

EQUILIBRIUM_PHASES 1
    Calcite 0 0
    Gypsum 0 0
    Aragonite 0 0

GAS_PHASE 1
    -fixed_pressure
    -temperature 25
    -pressure 1
    CO2(g) 1
    CH4(g) 5
    H2S(g) 10

SELECTED_OUTPUT
    -file sel.out
    -reset false
    -totals C(-4)
    -equilibrium_phases
    -si Calcite Aragonite Gypsum
END