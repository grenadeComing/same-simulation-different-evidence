SOLUTION 1 River
    temp 25
    pH 6.0
    units mg/L
    Cl 10

SOLUTION 2 Seawater
    temp 25
    pH 8.1
    units mg/L
    Cl 19000

MIX 1
    1 0.7
    2 0.3

SELECTED_OUTPUT 1
    -file mix_viscosity.sel
    -reset false
    -user_punch true

USER_PUNCH 1
    -head Viscosity
    10 PUNCH VISKIN
END
