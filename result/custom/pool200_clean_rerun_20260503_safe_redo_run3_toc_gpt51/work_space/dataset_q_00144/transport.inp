TITLE 1D transport with exchange

SOLUTION 0-10
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 11
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 0-10
    X- 0.001
    -equilibrate 1

EXCHANGE_SPECIES
    X- = X-
        log_k 0

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1*1
    -dispersivities 0
    -correct_disp false
    -initial_time 0
    -print_cells 10
    -print_frequency 1
    -punch_cells 10
    -punch_frequency 1

SELECTED_OUTPUT
    -file transport.sel
    -reset false
    -time
    -distance
    -pH
    -pe
    -totals Na Ca Cl
