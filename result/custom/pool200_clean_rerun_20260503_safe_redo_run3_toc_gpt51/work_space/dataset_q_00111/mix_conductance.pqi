SOLUTION 1 River water
    pH      6.0
    units   mg/L
    Cl      10

SOLUTION 2 Seawater
    pH      8.1
    units   mg/L
    Cl      19000

MIX 1
    1 0.7
    2 0.3

SELECTED_OUTPUT
    -file mix_conductance.sel
    -reset false
    -solution true
    -totals Cl

USER_PUNCH
    -headings sc
    -start
    10 PUNCH SC
    -end
