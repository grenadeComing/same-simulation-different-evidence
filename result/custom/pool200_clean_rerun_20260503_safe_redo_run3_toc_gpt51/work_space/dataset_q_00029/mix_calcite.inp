SOLUTION 1
    temp 20
    pH 7 charge
    C(4) 50 mmol/kgw

SOLUTION 2
    temp 20
    pH 7 charge
    Ca 50 mmol/kgw

MIX 1
    1 1
    2 1

EQUILIBRIUM_PHASES 1
    Calcite 0 0

REACTION_TEMPERATURE 1
    20 200 in 10 steps

USER_PUNCH
    -head   Step  Temp  Calcite_moles
    -start
    10 PUNCH STEP_NO, TC, MOL("Calcite")
    -end

SELECTED_OUTPUT
    -file mix_calcite.sel
    -reset false
    -user_punch true
