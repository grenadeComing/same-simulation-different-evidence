SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    redox pe
    units mmol/kgw
    Cu 10
    Ba 5
    C 0
    Ca 0

KINETICS 1
    Calcite
        -m0 1
        -m  1
        -parms 1.0 1.0
        -steps 1000 in 100
        -cvode
        -tol 1e-8

SELECTED_OUTPUT
    -file witherite_si.txt
    -reset false
    -time true
    -step true
    -si Witherite
