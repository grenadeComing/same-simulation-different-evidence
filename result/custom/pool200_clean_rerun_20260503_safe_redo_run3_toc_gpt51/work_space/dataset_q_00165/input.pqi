SOLUTION 1
    temp 25
    pH 7
    Ca 0.01
    Sr 0.01
    Alkalinity 0.04

SOLID_SOLUTIONS 1
    Ca_Sr_carbonate
        -comp Calcite 0.0
        -comp Strontianite 0.0

PRINT
    -equilibria false
    -selected_output true

SELECTED_OUTPUT
    -file sel.out
    -user_punch true

USER_PUNCH
    -headings sc
    10 PUNCH SC
END