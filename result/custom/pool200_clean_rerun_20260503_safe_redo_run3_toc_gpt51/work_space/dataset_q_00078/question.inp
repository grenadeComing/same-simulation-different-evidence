SOLUTION 1
    temp 150
    pH 7 charge
    pe 4
    units mol/kgw
    water 1

GAS_PHASE 1
    -fixed_pressure
    -temperature 150
    -pressure 1
    CH4(g) 10
    CO2(g) 10
    NH3(g) 5

SELECTED_OUTPUT
    -file question.sel
    -reset false
    -totals C N
    -gases CH4(g) CO2(g) NH3(g)
    -si CO2(g)
    -pH true
    -temperature true
    -ionic_strength true
END