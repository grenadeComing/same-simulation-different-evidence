SOLUTION 1 Pure water 150C
    temp 150
    pH 7 charge
    pe 4
    units mol/kgw
    water 1
GAS_PHASE 1 Fixed P
    -temperature 150
    -pressure 1
    -fixed_pressure true
    CH4(g) 10
    CO2(g) 10
    NH3(g) 5
EQUILIBRIUM_PHASES 1
    CH4(g) 0 0
    CO2(g) 0 0
    NH3(g) 0 0
END
SELECTED_OUTPUT
    -file q.sel
    -reset false
    -solution 1
    -pH true
    -pe true
END