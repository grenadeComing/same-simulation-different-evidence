TITLE 1D transport problem

SOLUTION 0-10
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 1
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 0.001

EQUILIBRIUM_PHASES 1-10
    H2O(g) 0 0

EXCHANGE_SPECIES
    X- = X-
        -log_k 0

TRANSPORT
    -cells               10
    -shifts              10
    -time_step           1
    -flow_direction      forward
    -boundary_conditions flux flux
    -lengths             1*1.0
    -dispersivities      1*0.0
    -punch_cells         1-10
    -print_cells         1-10
    -print_frequency     1
    -punch_frequency     1

SELECTED_OUTPUT
    -file                trans.sel
    -reset               false
    -solution            true
    -si                  H2O(g)
