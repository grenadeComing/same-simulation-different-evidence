SOLUTION 1
    temp 25
    pH 7 charge
    pe 4
    units mol/kgw

GAS_PHASE 1
    -fixed_pressure
    -pressure 1.0
    -temperature 25
    O2(g)   -0.7

EQUILIBRIUM_PHASES 1
    Pyrite   0.0  0.1
    Goethite 0.0  0.0
    Gypsum   0.0  0.0

SELECTED_OUTPUT
    -reset false
    -solution 1
    -high_precision true
    -molalities S(6)
    -pH true
    -totals S(6)
END