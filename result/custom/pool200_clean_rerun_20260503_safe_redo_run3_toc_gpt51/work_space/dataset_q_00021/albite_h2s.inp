SOLUTION 1
    temp 200
    pH 2 charge
    units mol/kgw
    Fe(3) 4e-3
    Fe(2) 4e-3

GAS_PHASE 1
    -pressure 5
    -fixed_pressure true
    H2S(g) 1

KINETICS 1
    Albite
        -m0 1
        -m 1
        -parms 1.0 1.0
        -steps 10 in 100

SELECTED_OUTPUT
    -file albite_h2s_sel.out
    -reset false
    -pH true
    -ionic_strength true
    -step true
END
