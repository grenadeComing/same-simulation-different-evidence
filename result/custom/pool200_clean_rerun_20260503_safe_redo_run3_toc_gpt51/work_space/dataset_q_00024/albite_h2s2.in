SOLUTION 1
    temp 200
    pH 2 charge
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    -temperature 200
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1
        -m 1
        -parms 1.0 10
        -steps 10 in 100
        -bad_step_max 5000

SELECTED_OUTPUT
    -file albite_h2s2.sel
    -reset false
    -time true
    -step true
USER_PUNCH
    -headings H2S_moles
    10 PUNCH MOL("H2S(g)")
