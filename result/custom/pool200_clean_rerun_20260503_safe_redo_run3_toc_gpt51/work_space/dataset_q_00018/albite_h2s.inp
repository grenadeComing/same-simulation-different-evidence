SOLUTION 1
    temp 200
    pH 2 charge
    Fe(3) 4e-3
    Fe(2) 4e-3

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    -temperature 200
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1.0
        -m 1.0
        -parms 1.0 10.0
        -steps 10 seconds in 100 steps
        -cvode

SELECTED_OUTPUT
    -file albite_h2s.sel
    -reset false
    -time true
    -pH true
    -pe true
    -step true
    -totals Fe(2) Fe(3)

END
