TITLE Sulfuric acid titration with steps
SOLUTION 1 Pure water
    pH 7 charge
    temp 25
    units mol/kgw
END

REACTION 1
    H2SO4 1
    0.001 moles
END
USE solution 1
REACTION 1
    H2SO4 1
    0.005 moles
END
USE solution 1
REACTION 1
    H2SO4 1
    0.01 moles
END
USE solution 1
REACTION 1
    H2SO4 1
    0.05 moles
END
USE solution 1
REACTION 1
    H2SO4 1
    0.1 moles
END

SELECTED_OUTPUT
    -file acid_pe2.sel
    -reset false
    -solution true
    -pH true
    -pe true
END
