SOLUTION 0
    pH 7 charge
    Na 1
    Cl 1

SOLUTION 1-10
    pH 7 charge
    Ca 1
    Cl 2

EXCHANGE 1-10
    X- 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -boundary_conditions flux flux
    -lengths 1
    -dispersivities 0
    -punch_cells 1-10
    -print_cells 1-10
    -print_frequency 1

SELECTED_OUTPUT
    -file transport.sel
    -reset false
    -time true
    -step true
    -state true
    -totals Na Ca Cl
    -equilibrium_phases false
    -kinetic_reactants false
    -solid_solutions false
    -gases false
    -saturation_indices false
    -molalities NaX CaX2 X-
