SOLUTION 1
    temp 25
    pH 7 charge
    units mol/kgw

EQUILIBRIUM_PHASES 1
    O2(g)  -0.7  10
    Pyrite 0  0.1
    Goethite 0 0
    Gypsum 0 0

SELECTED_OUTPUT
    -file pyrite_fe3.sel
    -reset false
    -pH true
    -totals Fe(3)
    -molalities Fe+3 FeOH+2 Fe(OH)2+ Fe(OH)3 Fe(SO4)+ Fe(SO4)2- FeHSO4+ FeH2PO4+ FePO4 aq

END
