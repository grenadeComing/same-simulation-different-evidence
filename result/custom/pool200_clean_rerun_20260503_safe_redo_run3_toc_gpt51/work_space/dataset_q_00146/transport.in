SOLUTION 0-10
    pH 7
    Ca 1
    Cl 2

SOLUTION 11
    pH 7
    Na 1
    Cl 1

EXCHANGE 1-10
    X- 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1
    -dispersivities 0
    -correct_disp false
    -diffc 0

SELECTED_OUTPUT 1
    -file exch_step5.sel
    -reset false
    -time true
    -step true
    -state true
    -distance true
    -totals Ca Na Cl
    -high_precision true

USER_PUNCH 1
    -headings step cell CaX2
    10 PUNCH STEP_NO, CELL_NO, MOL("CaX2")

PRINT
    -selected_output  true
