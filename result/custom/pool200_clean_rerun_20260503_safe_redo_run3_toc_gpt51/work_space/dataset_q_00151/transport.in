SOLUTION 0-10
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 1
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 0.001

SELECTED_OUTPUT
    -file tran.sel
    -reset false
    -solution true
    -totals Na Ca Cl
    -step true
    -distance true

USER_PUNCH
    -headings sc
    10 PUNCH SC

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -length 1
    -boundary_conditions flux flux
    -dispersivities 0
    -correct_disp false
    -initial_time 0
    -print_cells 1-10
    -print_frequency 1
    -punch_cells 1-10
    -punch_frequency 1
