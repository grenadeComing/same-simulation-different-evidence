SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    units mmol/kgw
    Cu 10
    Ba 5
    C(4) 1e-9
    Cl 0.1
    -water 1

KINETICS 1
    Calcite
        -m0 1
        -m 1
        -parms 1.0 1.0
        -steps 10*10

SELECTED_OUTPUT
    -file calcite_kinetics.sel
    -high_precision true
    -reset false
    -time true
    -alkalinity true
    -step true
END
