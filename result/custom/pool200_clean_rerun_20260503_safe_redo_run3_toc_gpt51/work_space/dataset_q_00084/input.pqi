SOLUTION 1
    temp 150
    pH 7 charge
    pe 4
    units mol/kgw
    water 1

GAS_PHASE 1
    -fixed_pressure
    -temperature 150
    -pressure 1
    -volume 1
    CH4(g) 10
    CO2(g) 10
    NH3(g) 5

SELECTED_OUTPUT
    -file selected.out
    -high_precision true
    -totals H(0) CH4 C(4) C(-4) C N(0) N(-3) N
END