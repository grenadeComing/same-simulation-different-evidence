SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    Cu 0.01
    Ba 0.005

KINETICS 1
    Calcite
        -m0 1.0
        -m  1.0
        -parms 1.0 1.0
        -steps 10 in 100
        -step_divide 1
        -cvode
        -tol 1e-12

SELECTED_OUTPUT
    -file calcite_kinetics.sel
    -time
    -kinetic_reactants
