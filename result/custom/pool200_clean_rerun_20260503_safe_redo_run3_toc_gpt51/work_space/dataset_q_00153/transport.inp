TITLE 1D cation exchange transport problem

SOLUTION 0
    pH 7.0
    Ca 1.0
    Cl 2.0
    units mol/kgw

SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0
    units mol/kgw

SOLUTION 11
    pH 7.0
    Na 1.0
    Cl 1.0
    units mol/kgw

EXCHANGE 1-10
    X- 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions constant constant
    -initial_time 0
    -print_cells 1-10
    -print_frequency 1
    -punch_cells 1-10
    -punch_frequency 1
    -dump dump_tr
    -dump_frequency 1

SELECTED_OUTPUT
    -file selout.txt
    -reset false
    -time true
    -step true
    -state true
    -distance true
    -solution true
    -totals Na
    -totals Ca
END
