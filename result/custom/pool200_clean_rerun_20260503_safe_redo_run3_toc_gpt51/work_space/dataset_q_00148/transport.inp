TITLE 1D cation exchange transport
SOLUTION 0
    pH 7.0
    Ca 1.0
    Cl 2.0
SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0
SOLUTION 11
    pH 7.0
    Na 1.0
    Cl 1.0
EXCHANGE 1-10
    X- 0.001
    -equilibrate 1
TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -length 10
    -dispersivities 0
    -boundary_conditions flux flux
    -initial_time 0
    -punch_cells 1
    -print_cells 1
    -print_frequency 1
    -inlet_solution 11
USER_PUNCH
    -headings Na
    -start
    10 PUNCH TOT("Na")
    -end
END