SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    Cu 0.01
    Ba 0.005
    C 1e-9

KINETICS 1
    Calcite
        -m0 1
        -m  1
        -parms 1.0 1.0
        -tol 1e-12
        -steps 10*10

SELECTED_OUTPUT
    -file sel.out
    -reset false
    -time true
    -step true
    -totals C(4) Cu(2)
