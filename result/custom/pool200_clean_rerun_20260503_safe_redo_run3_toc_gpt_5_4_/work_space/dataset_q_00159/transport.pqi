TITLE 1D transport with exchange
SOLUTION 0
    pH 7.0
    Na 1.0
    Cl 1.0
SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
    -equilibrate 1
TRANSPORT
    -cells 10
    -shifts 10
SELECTED_OUTPUT
    -file selected.out
    -reset false
    -step true
    -simulation true
    -state true
    -solution true
    -distance true
    -time true
    -pH true
    -ionic_strength true
    -totals Na Cl Ca
    -molalities Na+ Cl-
    -si Halite
END
