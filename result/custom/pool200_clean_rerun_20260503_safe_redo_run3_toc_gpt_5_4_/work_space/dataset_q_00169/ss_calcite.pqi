SOLUTION 1
    temp      25
    pH        7
    units     mol/kgw
    Ca        0.01
    Sr        0.01
    Alkalinity 0.04
SOLID_SOLUTION 1
    Ca_Sr_carbonate
        -comp1 Calcite       0.0
        -comp2 Strontianite  0.0
SELECTED_OUTPUT
    -file selected.txt
    -reset false
USER_PUNCH
    -headings Calcite_moles Strontianite_moles
10 PUNCH EQUI("Calcite"), EQUI("Strontianite")
END
