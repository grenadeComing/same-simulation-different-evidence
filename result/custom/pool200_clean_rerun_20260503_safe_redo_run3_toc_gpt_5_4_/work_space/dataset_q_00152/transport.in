SOLUTION 0 Initial
    pH 7.0
    units mmol/kgw
    Ca 1.0
    Cl 2.0
SOLUTION 1-10 Initial
    pH 7.0
    units mmol/kgw
    Ca 1.0
    Cl 2.0
SOLUTION 11 Infilling
    pH 7.0
    units mmol/kgw
    Na 1.0
    Cl 1.0
EXCHANGE 1-10
    equilibrate 1
    X 0.001
COPY solution 11 0
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1
    -dispersivities 0
    -time_step 1
    -print_cells 1
    -print_frequency 1
END
