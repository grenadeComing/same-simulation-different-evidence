TITLE Exchange transport test
SOLUTION 0
    pH 7.0 charge
    temp 25
    units mol/kgw
    Na 1.0
    Cl 1.0
SOLUTION 1-10
    pH 7.0 charge
    temp 25
    units mol/kgw
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    equilibrate 1
    X 0.001
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -print_cells 4
    -print_frequency 1
SELECTED_OUTPUT
    -file selected.out
    -reset false
    -step true
    -distance true
    -totals H Cl
    -molalities H+ Cl- HCl
END
