TITLE pure water with fixed-pressure gas phase at 150 C
SOLUTION 1
    temp 150
    units mol/kgw
    pH 7 charge
    pe 4
GAS_PHASE 1
    -fixed_pressure
    -temperature 150
    -pressure 1
    CH4(g) 10
    CO2(g) 10
    NH3(g) 5
SELECTED_OUTPUT
    -file selected.out
    -reset false
    -high_precision true
    -simulation true
    -state true
    -solution true
    -pH true
    -pe true
    -ionic_strength true
    -water true
    -charge_balance true
    -totals C N
END
