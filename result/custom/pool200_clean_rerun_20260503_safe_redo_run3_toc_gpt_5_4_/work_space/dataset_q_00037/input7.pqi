SOLUTION 1
    temp 100
    pH 7 charge
    units mmol/kgw
    Ca 50
EQUILIBRIUM_PHASES 1
    Calcite 0 10
    Gypsum 0 10
    Aragonite 0 10
GAS_PHASE 1
    -fixed_pressure
    -pressure 16
    -temperature 25
    CO2(g) 0.0625
    CH4(g) 0.3125
    H2S(g) 0.625
SELECTED_OUTPUT
    -file selected7.out
    -reset false
    -pH true
END
