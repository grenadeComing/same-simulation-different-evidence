TITLE 1D transport exchange test

SOLUTION 0 Inflow
    pH 7.0 charge
    units mmol/kgw
    Na 1.0
    Cl 1.0

SOLUTION 1-10 Initial
    pH 7.0 charge
    units mmol/kgw
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001
    equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10

SELECTED_OUTPUT
    -file selected2.out
    -reset false
    -step true
    -simulation true
    -state true
USER_PUNCH
    -headings Step Cell M_CaX2 TOTX EqFrac_CaX2
10 PUNCH STEP_NO, CELL_NO, MOL("CaX2"), EQUI("X"), EQUI("CaX2")
END
