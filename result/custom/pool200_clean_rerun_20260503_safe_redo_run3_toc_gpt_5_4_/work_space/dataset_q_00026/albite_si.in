TITLE Albite kinetic dissolution with H2S gas at 200C
SOLUTION 1
    temp 200
    pH 2
    pe 4
    redox pe
    Fe(2) 0.004
    Fe(3) 0.004
    -water 1
GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5
KINETICS 1
    Albite
        -m0 1
        -m 1
        -parms 1.0 10
        -tol 1e-12
        -steps 1000 in 100
SELECTED_OUTPUT
    -file selected.txt
    -reset false
    -step true
    -totals Si Fe(2) Fe(3) Al Na S(-2)
    -molalities H4SiO4 H3SiO4- H2SiO4-2 HSiO3- HSiO3- SiO2 H2SiO4 H2SiO4- H6Si2O7 H3Si2O7-
USER_PUNCH
    -headings si_species_count
10 PUNCH TOT("Si")
END
