TITLE Exchange transport specific conductance
SOLUTION 0 Infilling
    pH 7.0
    temp 25
    units mmol/kgw
    Na 1.0
    Cl 1.0
SOLUTION 1-10 Initial
    pH 7.0
    temp 25
    units mmol/kgw
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
    -equilibrate 1
TRANSPORT
    -cells 10
    -shifts 10
SELECTED_OUTPUT
    -file selected.txt
    -reset false
    -step true
    -distance true
    -solution true
    -pH true
    -totals Ca Na Cl
    -molalities Ca+2 Na+ Cl-
USER_PUNCH
    -headings step dist soln sc
    10 PUNCH STEP_NO, DIST, SOLN_NO, SC
END
