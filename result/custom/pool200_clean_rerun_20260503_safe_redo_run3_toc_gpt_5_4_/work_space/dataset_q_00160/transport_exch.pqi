SOLUTION 0 Infilling
    pH 7.0
    temp 25
    units mmol/kgw
    Na 1.0
    Cl 1.0

SOLUTION 1-10 Initial
    pH 7.0
    temp 25
    units mmol/kgw
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    -equilibrate 1
    X 0.001

SELECTED_OUTPUT
    -file selected.txt
    -reset false
    -simulation true
    -state true
    -solution true
    -distance true
    -time true
    -step true
    -pH true
    -ionic_strength true

USER_PUNCH
    -headings sim state soln dist time step la_H2 molesX
    10 PUNCH SIM_NO, STATE$, SOLN_NO, DIST, TOTAL_TIME, STEP_NO, LA("H2"), TOT("X")

TRANSPORT
    -cells 10
    -shifts 10
    -lengths 1
    -dispersivities 0
    -print_frequency 1
    -punch_frequency 1
