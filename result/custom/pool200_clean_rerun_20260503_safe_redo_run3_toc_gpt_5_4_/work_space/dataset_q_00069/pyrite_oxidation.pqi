SOLUTION 1
    temp 25
    pH 7 charge
    pe 4
    units mol/kgw

EQUILIBRIUM_PHASES 1
    O2(g) -0.7 10
    Pyrite 0 0.1
    Goethite 0 0
    Gypsum 0 0

SELECTED_OUTPUT
    -file pyrite_sel.out
    -reset false
    -solution true
    -pH true
    -pe true
    -totals Fe S Ca
    -si Pyrite Goethite Gypsum O2(g)
END
