SOLUTION 1
    temp 25
    pH 7 charge
    units mol/kgw
    water 1
EQUILIBRIUM_PHASES 1
    O2(g) -0.7 10
    Pyrite 0 0.1
    Goethite 0 0
    Gypsum 0 0
SELECTED_OUTPUT
    -file selected.out
    -reset false
USER_PUNCH
    -headings Fe2_mol Fe3_mol pH pe
10 PUNCH TOTMOLE("Fe(2)"), TOTMOLE("Fe(3)"), -LA("H+"), -LA("e-")
END
