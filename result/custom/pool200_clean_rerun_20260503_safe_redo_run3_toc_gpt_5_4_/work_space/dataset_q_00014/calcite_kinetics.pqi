SOLUTION 1
    temp 200
    pH 2
    pe 4
    redox pe
    units mmol/kgw
    Cu 10
    Ba 5
    Cl 25

KINETICS 1
    Calcite
        -m0 1
        -m 1
        -parms 1.0 10
        -steps 1000 in 100
        -tol 1e-12

SELECTED_OUTPUT
    -file selected.out
    -reset false
    -time true
    -kinetic_reactants true
USER_PUNCH
    -headings m_calcite
    10 PUNCH KIN("Calcite")
END
