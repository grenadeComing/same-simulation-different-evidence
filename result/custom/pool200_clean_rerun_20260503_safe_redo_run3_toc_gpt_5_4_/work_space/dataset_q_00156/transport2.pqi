SOLUTION 0
    pH 7.0
    temp 25
    units mmol/kgw
    Na 1.0
    Cl 1.0
SOLUTION 1-10
    pH 7.0
    temp 25
    units mmol/kgw
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    equilibrate 1
    X 0.001
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
SELECTED_OUTPUT
    -file selected2.out
    -reset false
    -totals Na Ca Cl
    -molalities Na+ Ca+2
    -equilibrium_phases false
    -si false
    -step true
    -simulation false
    -state false
    -solution true
    -distance false
    -time false
USER_PUNCH
    -headings NaX
10 PUNCH MOL("NaX")
END
