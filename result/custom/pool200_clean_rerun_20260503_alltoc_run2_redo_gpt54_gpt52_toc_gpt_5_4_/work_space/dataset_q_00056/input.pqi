SOLUTION 1
    temp 100
    pH 3
    units mol/kgw
    water 1
EQUILIBRIUM_PHASES 1
    K-mica 0 10
    Kaolinite 0 10
    Dolomite 0 10
    Epsomite 0 10
    Fe(OH)3(a) 0 10
    Halite 0 10
SELECTED_OUTPUT
    -file selected.out
    -high_precision true
USER_PUNCH
    -headings kaolinite_dissolved
10 PUNCH 10 - EQUI("Kaolinite")
END
