TITLE 1D transport with exchange
SOLUTION 0
    pH 7.0
    Na 1.0
    Cl 1.0
SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
    -equilibrate 1
TRANSPORT
    -cells 10
    -shifts 10
SELECTED_OUTPUT
    -file selected.out
    -reset false
    -step true
    -simulation true
    -distance true
    -time true
USER_PUNCH
    -headings step cell molNaX molCaX2 mNa
10 PUNCH STEP_NO, CELL_NO, MOL("NaX"), MOL("CaX2"), MOL("Na+")
END
