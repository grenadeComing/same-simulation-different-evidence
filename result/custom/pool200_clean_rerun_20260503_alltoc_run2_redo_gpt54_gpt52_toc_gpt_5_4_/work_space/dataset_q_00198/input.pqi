SOLUTION 1
    temp 25
    units ppm
    pH 8.0
    Ca 50
    Mg 12
    Na 20
    K 2
    Alkalinity 150 as CaCO3
    S(6) 40
    Cl 15
EQUILIBRIUM_PHASES 1
    Calcite 0 0
    Gypsum 0 0
    Halite 0 0
REACTION 1
    H2O -1
    50.0 moles
SELECTED_OUTPUT
    -file selected.out
    -si Anhydrite
END
