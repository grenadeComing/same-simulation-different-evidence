TITLE Calcite kinetic dissolution custom law
SOLUTION 1
    temp 100
    pH 5
    pe 4
    units mmol/kgw
    C(4) 0.5
    Mn 1
RATES
Calcite_custom
-start
10 si_cc = SI("Calcite")
20 if (si_cc >= 0) then goto 200
30 area = PARM(1)
40 k = PARM(2)
50 rate = area * k * (1 - 10^si_cc)
60 moles = rate * TIME
200 SAVE moles
-end
KINETICS 1
    Calcite_custom
        -formula CaCO3 1
        -m0 1
        -m 1
        -parms 10 0.001
        -steps 1000 in 100
        -tol 1e-12
SELECTED_OUTPUT
    -file sel_custom.out
    -reset false
    -time true
    -pH true
    -si Calcite
    -totals Ca C(4) Mn
END
