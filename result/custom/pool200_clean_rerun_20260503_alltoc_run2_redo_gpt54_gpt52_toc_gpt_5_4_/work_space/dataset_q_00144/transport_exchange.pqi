SOLUTION 0 Infilling
    pH 7.0
    pe 4
    temp 25
    units mmol/kgw
    Na 1.0
    Cl 1.0
SOLUTION 1-10 Initial
    pH 7.0
    pe 4
    temp 25
    units mmol/kgw
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
    -equilibrate 1
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -correct_disp true
    -diffusion_coefficient 0
    -dispersivities 0
    -lengths 1
    -time_step 1
SELECTED_OUTPUT
    -file selected.out
    -reset false
    -high_precision true
    -simulation true
    -state true
    -solution true
    -distance true
    -time true
    -pH true
    -pe true
END
