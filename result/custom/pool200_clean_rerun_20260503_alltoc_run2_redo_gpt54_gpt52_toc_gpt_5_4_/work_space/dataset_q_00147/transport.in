TITLE 1D transport exchange test
SOLUTION 0
    pH 7.0
    Na 1.0
    Cl 1.0
SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
    -equilibrate 1
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -print_cells 1
    -print_frequency 1
    -punch_cells 1
    -punch_frequency 1
SELECTED_OUTPUT
    -file selected.out
    -reset false
    -simulation true
    -state true
    -solution true
    -distance true
    -time true
    -step true
    -pH true
    -ionic_strength true
END
USER_PUNCH
    -headings sc
    10 PUNCH SC
END
