TITLE 1D transport with exchange
SOLUTION 0 Infilling
    units mmol/kgw
    pH 7.0
    Na 1.0
    Cl 1.0
SOLUTION 1-10 Initial
    units mmol/kgw
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    equilibrate 1
    X 0.001
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1
    -dispersivities 0
    -correct_disp false
    -diffusion_coefficient 0
SELECTED_OUTPUT
    -file selected.out
    -reset false
    -step true
    -simulation true
    -state true
    -solution true
USER_PUNCH
    -headings HCl
    10 PUNCH MOL("H+")
END
