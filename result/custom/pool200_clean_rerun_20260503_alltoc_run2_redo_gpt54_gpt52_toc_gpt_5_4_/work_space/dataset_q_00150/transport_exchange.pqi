SOLUTION 0 Infilling
    pH 7.0 charge
    units mmol/kgw
    Na 1.0
    Cl 1.0

SOLUTION 1-10 Initial
    pH 7.0 charge
    units mmol/kgw
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward

SELECTED_OUTPUT
    -file selected.out
    -reset false
    -step true
    -simulation true
    -state true
    -solution true
    -distance true

USER_PUNCH
    -headings step sim soln eqfrac_CaX2
    10 PUNCH STEP_NO, SIM_NO, SOLN_NO, EQUI("CaX2")
END
