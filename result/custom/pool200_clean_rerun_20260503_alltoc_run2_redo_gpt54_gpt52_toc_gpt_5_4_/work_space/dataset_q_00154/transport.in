SOLUTION 0
    pH 7.0
    Na 1.0
    Cl 1.0
SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
    -equilibrate 1
SELECTED_OUTPUT
    -file selected.out
    -reset false
USER_PUNCH
    -headings step soln mu
    10 PUNCH STEP_NO, SOLN_NO, VISCOS
TRANSPORT
    -cells 10
    -shifts 10
END
