TITLE Exchange transport test
SOLUTION 0 Inflow
    pH 7.0
    Na 1.0
    Cl 1.0
SOLUTION 1-10 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -correct_disp true
    -lengths 1
    -dispersivities 0
    -punch_cells 1-10
    -punch_frequency 1
SELECTED_OUTPUT
    -file selected.out
    -reset false
USER_PUNCH
    -headings step cell NaX
10 PUNCH STEP_NO, CELL_NO, MOL("NaX")
END
