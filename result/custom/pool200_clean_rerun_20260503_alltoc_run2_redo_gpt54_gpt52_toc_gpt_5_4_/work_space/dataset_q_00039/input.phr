SOLUTION 1
    temp 100
    pH 7 charge
    Ca 50 mmol/kgw
EQUILIBRIUM_PHASES 1
    Calcite 0 10
    Gypsum 0 10
    Aragonite 0 10
GAS_PHASE 1
    -fixed_pressure
    -pressure 16
    -volume 1
    CO2(g) 0 1
    CH4(g) 0.69897 5
    H2S(g) 1 10
SELECTED_OUTPUT
    -file selected.out
    -reset false
    -high_precision true
    -solution true
USER_PUNCH
    -headings pe
10 PUNCH -LA("e-")
END
