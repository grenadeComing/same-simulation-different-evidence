TITLE 1D transport with exchange
SOLUTION 0 Infilling
    pH 7.0
    Na 1.0
    Cl 1.0
SOLUTION 1-10 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
    -equilibrate 1
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -correct_disp true
    -diffusion_coefficient 0
    -dispersivities 0
    -punch_cells 3
    -punch_frequency 1
SELECTED_OUTPUT
    -file selected.txt
    -reset false
USER_PUNCH
    -headings step cell log_iap_h2
10 PUNCH STEP_NO, CELL_NO, LA("H2")
END
