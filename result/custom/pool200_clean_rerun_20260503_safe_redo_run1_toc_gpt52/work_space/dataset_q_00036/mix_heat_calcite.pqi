SOLUTION 1 DIC_50mM
    temp 20
    pH 7 charge
    units mmol/kgw
    C(4) 50

SOLUTION 2 Ca_50mM
    temp 20
    pH 7 charge
    units mmol/kgw
    Ca 50

MIX 1
    1 0.5
    2 0.5
SAVE solution 1
END

USE solution 1
EQUILIBRIUM_PHASES 1
    Calcite 0 0

REACTION_TEMPERATURE 1
    20 200 in 10

SELECTED_OUTPUT
    -file mix_heat_calcite.sel
    -reset false
    -temperature true
    -si Calcite
    -activities Ca+2 CO3-2
USER_PUNCH
    -headings T_C SI_Calc logIAP_Calc
10 PUNCH TC, SI("Calcite"), LOG10(ACT("Ca+2")*ACT("CO3-2"))
END
