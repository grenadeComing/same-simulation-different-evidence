SOLUTION 1
    temp 100
    pH   5
    pe   4
    units mmol/kgw
    C(4) 0.5
    Mn   1

KINETICS 1
    Calcite
        -m0 1
        -m  1
        -parms 10.0 0.001
    -steps 10 100*10

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -totals Ca C Mn
    -saturation_indices Calcite
    -pH true

END
