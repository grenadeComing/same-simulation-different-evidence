TITLE 1D transport, 10 cells, exchange, initial Ca-Cl, inflow Na-Cl

SOLUTION 0  Inflow
    pH 7.0
    Na 1.0
    Cl 1.0

SOLUTION 1-10 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001

# Equilibrate each exchange with its corresponding solution initially
EQUILIBRATE 1-10 with_solution 1

SELECTED_OUTPUT
    -file selected.txt
    -reset false
    -high_precision true
USER_PUNCH
    -headings step cell NaX
    10 PUNCH TOTAL_TIME, CELL_NO, MOL("NaX")

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions flux flux
    -dispersivities 0
    -correct_disp true
    -diffusion_coefficient 0
    -punch_cells 4
    -punch_frequency 1
END
