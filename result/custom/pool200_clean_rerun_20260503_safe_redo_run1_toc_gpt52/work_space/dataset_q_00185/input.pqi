SOLUTION 1
    temp 15
    pH 7 charge
    C(-4) 5.0 mmol/kgw
END
GAS_PHASE 1
    -fixed_pressure
    -pressure 1.0
    -temperature 15
    CH4(g) 0
END
USE solution 1
USE gas_phase 1
SELECTED_OUTPUT
    -file selected.txt
    -reset false
    -high_precision true
USER_PUNCH
    -headings si_CO2g
    10 PUNCH SI("CO2(g)")
END
END
