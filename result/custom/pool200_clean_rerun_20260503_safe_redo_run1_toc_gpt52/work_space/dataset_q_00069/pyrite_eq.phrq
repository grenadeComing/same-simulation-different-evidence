TITLE Pyrite oxidation equilibrium, 1 kg pure water, pH 7, fixed O2(g)
SOLUTION 1
    temp 25
    pH 7 charge
    -water 1

GAS_PHASE 1
    -fixed_pressure true
    -pressure 1.0
    O2(g) -0.7

REACTION 1
    Pyrite 1
    0.1

EQUILIBRIUM_PHASES 1
    Goethite 0 0
    Gypsum 0 0

SELECTED_OUTPUT
    -file sel.txt
    -reset false
    -pH true
    -pe true
    -totals Fe S(6) S(-2)
END
