TITLE 1D transport 10 cells 10 shifts with exchange

SOLUTION 0  Initial solution
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 1  Infilling solution
    pH 7.0
    Na 1.0
    Cl 1.0

SOLUTION 2-11  Initial in cells
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 2-11
    X 0.001
    -equilibrate 1

SELECTED_OUTPUT
    -reset false
    -high_precision true

USER_PUNCH
    -headings step cell SI_H2Og
    10 PUNCH STEP_NO, CELL_NO, SI("H2O(g)")

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions flux flux
    -initial_time 0
    -print_cells 4
    -print_frequency 1
    -punch_cells 4
    -punch_frequency 1
END
