SOLUTION 0  Initial
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 1-10  Cells
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 11  Influent
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions flux flux
    -print_cells 1
    -print_frequency 1

SELECTED_OUTPUT
    -file selected.csv
    -reset false
    -high_precision true

USER_PUNCH
    -headings step cell Ca_free_m
10 PUNCH STEP_NO, CELL_NO, MOL("Ca+2")
END

KNOBS
    -iterations 200
