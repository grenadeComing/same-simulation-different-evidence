SOLUTION 1
    temp 200
    pH 2
    pe 4
    Cu 10 mmol/kgw
    Ba 5 mmol/kgw

KINETICS 1
    Calcite
        -m0 1
        -m  1
        -parms 1.0 10
        -steps 10 IN 100
        -tol 1e-12

SELECTED_OUTPUT
    -file selected.csv
    -reset false
    -time true
    -step true
    -totals Alkalinity
END
