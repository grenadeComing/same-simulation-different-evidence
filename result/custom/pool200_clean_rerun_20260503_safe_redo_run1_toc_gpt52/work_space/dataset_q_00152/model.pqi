TITLE 1D transport, 10 cells, 10 shifts, cation exchange

SOLUTION 0 Infilling
    pH 7.0
    Na 1.0
    Cl 1.0

SOLUTION 1-10 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

SELECTED_OUTPUT
    -file sel.txt
    -reset false
USER_PUNCH
    -headings step cell eqfrac_CaX2
10 PUNCH SIM_NO, CELL_NO, MOL("CaX2")/0.001

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1
    -dispersivities 0
    -diffusion_coefficient 0
    -punch_cells 1
    -punch_frequency 1
END
