SOLUTION 1
    temp 100
    pH 5 charge
    Ba 0.1
    -water 1

EQUILIBRIUM_PHASES 1
    Talc 0 10
    Rhodochrosite 0 10
    Sepiolite 0 10
    Sepiolite(d) 0 10
    Pb(OH)2 0 10

SELECTED_OUTPUT
    -reset false
    -high_precision true
USER_PUNCH
    -headings CO3_mol
10 PUNCH TOT("C")*MOL("CO3-2")/TOT("C")

END
