SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1
        -m  1
        -parms 1.0 10
        -steps 10 100
        -tol 1e-12

SELECTED_OUTPUT
    -file selected.csv
    -reset false
USER_PUNCH
    -headings step count_Si_aq
    10 PUNCH STEP_NO
    20 cnt = 0
    30 FOR i = 0 TO SYS("species") - 1
    40   s$ = SYS$("species", i)
    50   IF (INSTR(s$, "Si") > 0) AND (MOL(s$) > 0) THEN cnt = cnt + 1
    60 NEXT i
    70 PUNCH cnt
END
