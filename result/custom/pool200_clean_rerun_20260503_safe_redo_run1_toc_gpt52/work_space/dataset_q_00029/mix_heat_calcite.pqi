TITLE Mix 50 mmol/kg DIC with 50 mmol/kg Ca (1:1), heat 20 to 200 C in 10 steps, allow calcite ppt/dissolve

SOLUTION 1 C_solution
    temp 20
    pH 7 charge
    units mmol/kgw
    C(4) 50

SOLUTION 2 Ca_solution
    temp 20
    pH 7 charge
    units mmol/kgw
    Ca 50

MIX 1
    1 0.5
    2 0.5

EQUILIBRIUM_PHASES 1
    Calcite 0 0

REACTION_TEMPERATURE 1
    20 40 60 80 100 120 140 160 180 200

SELECTED_OUTPUT
    -file mix_heat_calcite.sel
    -reset false
    -high_precision true
    -temperature true

USER_PUNCH
    -headings Temp_C Calcite_moles
    10 PUNCH TC, EQUI("Calcite")
END
