SOLUTION 1
    temp 25
    pH 7
    units mol/kgw
    Ca 0.01
    Sr 0.01
    Alkalinity 0.04 as HCO3

SOLID_SOLUTION 1 Ca_Sr_carbonate
    -comp1 Calcite 0.0
    -comp2 Strontianite 0.0

USER_PUNCH
    -headings SpCond_uS_per_cm
10 PUNCH SC

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -user_punch true
END
