SOLUTION 1
    temp 25
    pH   7 charge
    units mg/L
    Ba   2.0
    S(6) 15.0
REACTION_TEMPERATURE 1
    25 95 in 5
USER_PUNCH
    -headings Step Temp_C SpCond_uS_cm
    10 PUNCH STEP_NO, TC, SC
SELECTED_OUTPUT
    -reset false
    -high_precision true
    -temperature true
    -step true
    -user_punch true
END
