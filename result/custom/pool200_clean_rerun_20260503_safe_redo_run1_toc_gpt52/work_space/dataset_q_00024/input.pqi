TITLE Albite kinetics + fixed P H2S(g), 200 C
SOLUTION 1
    temp 200
    pH 2 charge
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    -volume 1
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1
        -m  1
        -parms 1.0 10
        -tol 1e-12
    -steps 10 100

SELECTED_OUTPUT
    -file selected.tsv
    -reset false
    -high_precision true
USER_PUNCH
    -head step H2S_gas_mol
10 PUNCH STEP_NO, GAS("H2S(g)")
END
