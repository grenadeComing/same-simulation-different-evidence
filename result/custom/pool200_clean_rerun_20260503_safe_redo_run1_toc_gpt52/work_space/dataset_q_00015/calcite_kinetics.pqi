SOLUTION 1
    temp 200
    pH 2
    pe 4
    redox pe
    units mmol/kgw
    Cu 10
    Ba 5
    Cl 30

KINETICS 1
    Calcite
        -m0 1.0
        -m  1.0
        -parms 1.0 10
        -tol 1e-12
    -steps 10 100*10

SELECTED_OUTPUT
    -file selected.txt
    -reset false
    -time true
    -step true
    -si Witherite
END
