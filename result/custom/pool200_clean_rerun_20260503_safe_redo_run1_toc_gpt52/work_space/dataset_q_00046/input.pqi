TITLE Ca speciation with Calcite+Aragonite+Gypsum and CO2/CH4/H2S gas
SOLUTION 1
    temp 100
    units mmol/kgw
    pH 7 charge
    Ca 50
EQUILIBRIUM_PHASES 1
    Calcite 0 0
    Aragonite 0 0
    Gypsum 0 0
GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    -temperature 25
    CO2(g) 1
    CH4(g) 5
    H2S(g) 10
SELECTED_OUTPUT
    -file selected.csv
    -reset false
USER_PUNCH
    -headings Ca_species_count
    10 cnt = 0
    20 FOR i = 1 TO 200
    30 s$ = SPECIES$(i)
    40 IF s$ = "" THEN GOTO 80
    50 IF INSTR(s$, "Ca") = 1 THEN
    60   IF MOL(s$) > 0 THEN cnt = cnt + 1
    70 ENDIF
    75 NEXT i
    80 PUNCH cnt
END
