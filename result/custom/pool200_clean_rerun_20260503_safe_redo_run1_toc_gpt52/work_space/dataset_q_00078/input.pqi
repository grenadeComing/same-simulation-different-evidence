SOLUTION 1 Pure water, 150C
    temp 150
    pH 7 charge
    pe 4
    -water 1

GAS_PHASE 1 Fixed P, 1 atm, 150C
    -fixed_pressure true
    -pressure 1
    -temperature 150
    CH4(g) 0.4 10
    CO2(g) 0.4 10
    NH3(g) 0.2 5

SELECTED_OUTPUT
    -file selected.txt
    -reset false
    -high_precision true
USER_PUNCH
    -headings rho
10 PUNCH RHO
END
