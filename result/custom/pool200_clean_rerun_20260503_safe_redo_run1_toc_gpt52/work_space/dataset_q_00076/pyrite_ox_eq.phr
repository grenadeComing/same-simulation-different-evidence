TITLE Equilibrium oxidation of pyrite in pure water, pH 7, fixed PO2, allow goethite+gypsum
SOLUTION 1
    temp 25
    pH 7 charge
    -water 1
EQUILIBRIUM_PHASES 1
    O2(g) -0.7 10
    Pyrite 0 0.1
    Goethite 0 0
    Gypsum 0 0
SELECTED_OUTPUT
    -file pyrite_ox_eq.sel
    -reset false
    -pH true
    -pe true
    -totals Fe S(6) S(-2) Ca
END