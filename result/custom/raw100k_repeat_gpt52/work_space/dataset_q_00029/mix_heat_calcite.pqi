TITLE Mix DIC and Ca solutions 1:1, heat 20 to 200C in 10 steps, allow calcite ppt/diss

SOLUTION 1 DIC solution
    temp 20
    units mmol/kgw
    pH 7 charge
    C(4) 50

SOLUTION 2 Ca solution
    temp 20
    units mmol/kgw
    pH 7 charge
    Ca 50

MIX 1
    1 0.5
    2 0.5

# allow calcite to precipitate/dissolve to equilibrium
EQUILIBRIUM_PHASES 1
    Calcite 0 0

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -simulation true
    -state true
    -temperature true
    -ph true
    -totals Ca C(4)
    -equilibrium_phases Calcite

USER_PUNCH
    -headings step temp calcite_moles
10 PUNCH SIM_NO, TC, EQUI("Calcite")

REACTION_TEMPERATURE 1
    20 200 in 10 steps

END
