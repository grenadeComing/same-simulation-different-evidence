TITLE Albite kinetics + fixed-pressure H2S(g), track Fe(3)
SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4

GAS_PHASE 1
    -fixed_pressure true
    -pressure 5
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1
        -m  1
        -parms 1.0 10
        -tol 1e-12
    -steps 1000 in 100

SELECTED_OUTPUT
    -file selected.csv
    -reset false
    -time true
    -step true
    -pH true
    -totals Fe(2) Fe(3) S(-2)
END
