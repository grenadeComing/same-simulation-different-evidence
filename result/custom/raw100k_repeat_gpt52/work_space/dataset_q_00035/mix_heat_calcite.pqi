TITLE Mix DIC and Ca solutions 1:1; heat 20 to 200 C in 10 steps; allow calcite ppt/diss

SOLUTION 1 DIC
    temp 20
    pH 7 charge
    units mmol/kgw
    C(4) 50 as HCO3

SOLUTION 2 Ca
    temp 20
    pH 7 charge
    units mmol/kgw
    Ca 50

MIX 1
    1 0.5
    2 0.5

EQUILIBRIUM_PHASES 1
    Calcite 0 0

REACTION_TEMPERATURE 1
    20 40 60 80 100 120 140 160 180 200

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -temperature true
    -water true
    -ph true
    -totals Ca C(4)

USER_PUNCH
    -headings density_kg_L
    10 PUNCH RHO

END
