TITLE Count Ca aqueous species present (manual list)
SOLUTION 1
    temp 100
    pH 7 charge
    units mmol/kgw
    Ca 50
EQUILIBRIUM_PHASES 1
    Calcite 0 10
    Gypsum 0 10
    Aragonite 0 10
GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    -temperature 25
    CO2(g) 1
    CH4(g) 5
    H2S(g) 10
SELECTED_OUTPUT
    -file ca_count_fix.txt
    -reset false
USER_PUNCH
    -headings Ca_species_count
    10 cnt=0
    20 if MOL("Ca+2")>0 then cnt=cnt+1
    30 if MOL("CaOH+")>0 then cnt=cnt+1
    40 if MOL("CaSO4")>0 then cnt=cnt+1
    50 if MOL("CaHCO3+")>0 then cnt=cnt+1
    60 if MOL("CaCO3")>0 then cnt=cnt+1
    70 if MOL("CaHSO4+")>0 then cnt=cnt+1
    80 PUNCH cnt
END
