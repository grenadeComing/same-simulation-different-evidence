SOLUTION 1
    temp 25
    pH 7 charge
    units mol/kgw
    -water 1

REACTION 1
    Pyrite 1
    0.1

EQUILIBRIUM_PHASES 1
    Goethite 0 0
    Gypsum 0 0

GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    O2(g) -0.7

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -totals S(6)
END
