SOLUTION 1
    temp 200
    pH 2
    pe 4
    units mmol/kgw
    Cu 10
    Ba 5
    Cl 30 charge

KINETICS 1
    Calcite
        -m0 1.0
        -m  1.0
        -parms 1.0 1.0
        -tol 1e-12
    -steps 10 100*10

SELECTED_OUTPUT
    -file sel.txt
    -reset false
    -step true
    -time true
    -si Witherite
END
