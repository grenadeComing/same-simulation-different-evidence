TITLE 1D transport with exchange, 10 cells, 10 shifts
SOLUTION 0 Infilling
    pH 7.0
    Na 1.0
    Cl 1.0
SOLUTION 1-10 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
    -equilibrate 1
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -print_cells 1
    -print_frequency 1
    -punch_cells 1
    -punch_frequency 1
SELECTED_OUTPUT
    -file sel.csv
    -reset false
USER_PUNCH
    -headings step shift CaX2_mol
10 PUNCH STEP_NO, SHIFT_NO, MOL("CaX2")
END
