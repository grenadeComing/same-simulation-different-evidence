TITLE 1D transport, exchange, 10 cells 10 shifts

SOLUTION 0  # inflow
    pH 7.0
    Na 1.0
    Cl 1.0

SOLUTION 1-10  # initial in cells
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

SELECTED_OUTPUT
    -file selected.txt
    -reset false
USER_PUNCH
    -headings step sol1_Na
10 PUNCH TRANSPORT_STEP_NO, TOT("Na")

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions flux flux
    -print_cells 1
    -punch_cells 1
    -punch_frequency 1
    -print_frequency 1
END
