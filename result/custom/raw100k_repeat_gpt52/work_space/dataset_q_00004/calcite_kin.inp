TITLE Calcite kinetic dissolution hydrothermal 100C pH5 pe4
SOLUTION 1
    temp 100
    pH 5
    pe 4
    units mmol/kgw
    C(4) 0.5
    Mn 1
    -water 1

KINETICS 1
    Calcite
        -m0 1
        -m  1
        -parms 10.0 0.001
        -steps 10 in 100
        -tol 1e-12

SELECTED_OUTPUT
    -file sel.out
    -reset false
USER_PUNCH
    -headings time_s pH SI_Calcite Ca_molal Alk_molal
10 PUNCH TOTAL_TIME, -LA("H+"), SI("Calcite"), MOL("Ca+2"), TOT("Alkalinity")
END
