SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    Fe(2) 4e-3
    Fe(3) 4e-3
    units mol/kgw

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1
        -m  1
        -parms 1.0 10
        -steps 10 100
        -tol 1e-12

SELECTED_OUTPUT
    -file sel.txt
    -reset false
USER_PUNCH
    -headings step Si_species_count
    10 PUNCH STEP_NO, SYS("Si")
END
