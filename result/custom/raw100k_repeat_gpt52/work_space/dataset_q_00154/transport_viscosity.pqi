SOLUTION 1
    pH 7.0
    temp 25
    Ca 1.0
    Cl 2.0

SOLUTION 0
    pH 7.0
    temp 25
    Na 1.0
    Cl 1.0

COPY solution 1 2
COPY solution 1 3
COPY solution 1 4
COPY solution 1 5
COPY solution 1 6
COPY solution 1 7
COPY solution 1 8
COPY solution 1 9
COPY solution 1 10

EXCHANGE 1-10
    X 0.001

EQUILIBRATE 1-10 with_solution 1

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -time_step 1
    -lengths 1
    -dispersivities 0
    -punch_cells 1

SELECTED_OUTPUT
    -file selected.txt
    -reset false
    -high_precision true

USER_PUNCH
    -headings shift viscosity
10 PUNCH STEP_NO, VISCOSITY

END
