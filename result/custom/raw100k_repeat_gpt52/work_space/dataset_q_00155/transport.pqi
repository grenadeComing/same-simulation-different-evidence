SOLUTION 0  Initial (for exchange equilibration)
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 1-10  Initial cells
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 11  Influent
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions flux flux
    -initial_time 0
    -print_cells 1
    -print_frequency 1

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -pH true
    -molalities Ca+2

END
