SOLUTION 1 Pure water at 100C, pH 3
    temp 100
    pH 3 charge
    pe 4
    redox pe
    units mol/kgw
    density 1

EQUILIBRIUM_PHASES 1
    K-mica 0 10
    Kaolinite 0 10
    Dolomite 0 10
    Epsomite 0 10
    Fe(OH)3(a) 0 10
    Halite 0 10

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -molalities Mg+2
    -totals Mg
END
