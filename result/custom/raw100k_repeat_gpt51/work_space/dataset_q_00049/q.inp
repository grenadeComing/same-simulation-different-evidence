SOLUTION 1
    temp 100
    pH 3 charge
EQUILIBRIUM_PHASES 1
    K-mica 0 10
    Kaolinite 0 10
    Dolomite 0 10
    Epsomite 0 10
    Fe(OH)3(a) 0 10
    Halite 0 10

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -totals Na Cl K Mg Ca S(6) C(4) Al Si Fe
USER_PUNCH
    -start
    10 PUNCH SC
    -end
