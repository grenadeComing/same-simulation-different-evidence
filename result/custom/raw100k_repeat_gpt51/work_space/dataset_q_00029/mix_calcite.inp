SOLUTION 1
    temp 20
    pH 7 charge
    C(4) 50e-3

SOLUTION 2
    temp 20
    pH 7 charge
    Ca 50e-3

MIX 1
    1 0.5
    2 0.5

EQUILIBRIUM_PHASES 1
    Calcite 0 0

REACTION_TEMPERATURE 1
    20 200 in 10 steps

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -totals C(4) Ca
    -si Calcite
    -equilibrium_phases Calcite
    -temperature true
    -step true
    -file mix_calcite.sel