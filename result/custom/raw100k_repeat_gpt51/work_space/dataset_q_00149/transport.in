SOLUTION 0-10
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 11
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    Na 0
    Ca 0
    X 0.001

EXCHANGE_SPECIES
    Na+ + X- = NaX
        log_k 0
    Ca+2 + 2X- = CaX2
        log_k 0

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 1
    -flow_direction forward
    -boundary_conditions flux flux
    -dispersivities 0
    -correct_disp false
    -initial_time 0
    -print_cells 1-10
    -print_frequency 1
    -punch_cells 1-10
    -punch_frequency 1

SELECTED_OUTPUT
    -file transport_sel.out
    -reset false
    -totals Na Ca Cl
    -equilibrium_phases 1
    -equilibrium_phases 2
    -molalities NaX CaX2
