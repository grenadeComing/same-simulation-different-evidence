SOLUTION 1
    temp 25
    pH 8.0
    units ppm
    Ca 50
    Mg 12
    Na 20
    K 2
    Alkalinity 150 as HCO3
    S(6) 40 as SO4
    Cl 15

REACTION 1
    H2O -50.0
    1 moles

EQUILIBRIUM_PHASES 1
    Calcite 0 0
    Gypsum 0 0
    Halite 0 0

SELECTED_OUTPUT
    -reset false
    -activities Cl-
    -high_precision true
END
