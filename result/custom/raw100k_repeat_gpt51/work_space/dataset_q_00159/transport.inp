TITLE 1D exchange transport problem
SOLUTION 0
    pH 7.0
    Ca 1.0
    Cl 2.0
SOLUTION 1
    pH 7.0
    Na 1.0
    Cl 1.0
SOLUTION 2-10
    pH 7.0
EXCHANGE 1-10
    X- 0.001
TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 1
    -flow_direction forward
    -boundary_conditions flux flux
    -dispersivities 0
    -correct_disp false
    -print_cells 3
    -print_frequency 10
SELECTED_OUTPUT
    -file trans.sel
    -reset false
    -solution true
    -saturation_indices Halite
    -user_punch true
USER_PUNCH
    -head  exch_cell exch_Halite_SI
    10 PUNCH CELL, SI("Halite")
END