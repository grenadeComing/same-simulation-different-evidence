SOLUTION 0-10
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 11
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

SELECTED_OUTPUT
    -file selout.txt
    -reset false
    -solution true

USER_PUNCH
    -head step cell viscosity
    10 PUNCH SIM_NO, CELL_NO, VISCOSITY

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -length 1
    -flow_direction forward
    -boundary_conditions flux flux
    -initial_time 0
    -print_cells 1-10
    -print_frequency 1
    -punch_cells 1-10
    -punch_frequency 1
    -correct_disp true
    -dump dump.tst
