SOLUTION 1 Pure water at 150C
    temp 150
    pH 7 charge
    pe 4
    redox pe
    units mol/kgw
    water 1

GAS_PHASE 1 Fixed-pressure gas
    -fixed_pressure true
    -temperature 150
    -pressure 1
    CH4(g) 10
    CO2(g) 10
    NH3(g) 5

SELECTED_OUTPUT
    -file gas_pe.sel
    -reset false
    -solution true
    -pH true
    -pe true

END
