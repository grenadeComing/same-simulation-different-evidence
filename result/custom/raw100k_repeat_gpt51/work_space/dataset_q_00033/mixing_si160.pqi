SOLUTION 1
    temp 20
    units mmol/kgw
    C(4) 50
    pH 7 charge

SOLUTION 2
    temp 20
    units mmol/kgw
    Ca 50
    pH 7 charge

MIX 1
    1 1
    2 1

EQUILIBRIUM_PHASES 1
    Calcite 0 0

INCREMENTAL_REACTIONS true

REACTION_TEMPERATURE 1
    20 200 in 10 steps

SELECTED_OUTPUT
    -file mix_out.txt
    -reset false
    -temperature true
    -si Aragonite
    -step true
END