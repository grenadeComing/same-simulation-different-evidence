SOLUTION 1
    temp 200
    pH 2 charge
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4
    S(-2) 0

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1.0
        -m  1.0
        -parms 1.0 10.0
        -steps 10 100 step

SELECTED_OUTPUT
    -file albite_h2s.sel
    -reset false
    -solution true
    -gas true
    -time true
USER_PUNCH
    -headings step
    10 PUNCH STEP_NO
