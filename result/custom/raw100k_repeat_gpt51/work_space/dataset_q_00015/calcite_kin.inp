SOLUTION 1
    temp 200
    pH 2
    pe 4
    units mmol/kgw
    Cu 10
    Ba 5
    C 1 charge

KINETICS 1
    Calcite
        -m0 1
        -m 1
        -parms 1.0 1.0
        -steps 10 in 100

USER_PUNCH
    -headings step si_witherite
    -start
    10 PUNCH KIN_TIME, SI("Witherite")
    -end

SELECTED_OUTPUT
    -file witherite_si.txt
    -reset false
    -user_punch true
