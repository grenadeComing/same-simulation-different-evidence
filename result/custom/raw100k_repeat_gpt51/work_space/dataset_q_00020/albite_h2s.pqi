SOLUTION 1
    temp 200
    pH 2 charge
    Fe(3) 4e-3
    Fe(2) 4e-3
    units mol/kgw

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1
        -m 1
        -parms 1.0 10
        -steps 1000 in 100

SELECTED_OUTPUT
    -file sel.out
    -reset false
    -time true
    -step true
    -molalities Fe+2 Fe+3 Na+ S(6) S(-2) Al+3 Al(OH)4-

END
