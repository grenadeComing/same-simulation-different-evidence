SOLUTION 1
    temp 200
    pH 2 charge
    Fe(3) 4e-3
    Fe(2) 4e-3

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 1

KINETICS 1
    Albite
        -m0 1
        -m 1
        -parms 1.0 10
        -steps 10 in 100

SELECTED_OUTPUT
    -file si_species.txt
    -reset false
    -time true
    -step true
    -totals Si
    -species H4SiO4 SiO2 H3SiO4- H2SiO4-2 HSiO4-3 SiO(OH)3- SiO2(aq) SiO(OH)2 SiO2OH- Si2O(OH)6-2
END