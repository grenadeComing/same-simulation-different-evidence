SOLUTION 1
    temp 150
    pH 7 charge
    pe 4
    units mol/kgw

GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    -temperature 150
    -volume 1
    CH4(g) 10
    CO2(g) 10
    NH3(g) 5

PRINT
    -reset false

SELECTED_OUTPUT
    -file selout.txt
    -solution true
    -totals H C N O
    -molalities H+ HCO3- CO3-2 NH4+ NH3(aq) CO2(aq)
END