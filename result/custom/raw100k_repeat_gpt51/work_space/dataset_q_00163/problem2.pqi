SOLUTION 1
    temp 25
    pH 7 charge
    Ca 0.01
    Sr 0.01
    Alkalinity 0.04 as HCO3
EQUILIBRIUM_PHASES 1
    Calcite 0 0
    Strontianite 0 0
END

SOLUTION 2
    temp 25
    pH 7 charge
    Ca 0.01
    Sr 0.01
    Alkalinity 0.04 as HCO3
SOLID_SOLUTIONS 1
    Ca_Sr_carbonate
        -comp Calcite 0.0
        -comp Strontianite 0.0
EQUILIBRIUM_PHASES 2
    Ca_Sr_carbonate 0 10
END

SELECTED_OUTPUT
    -file ss2.out
    -solid_solutions true
END
