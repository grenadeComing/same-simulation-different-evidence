TITLE 1D cation exchange transport problem

SOLUTION 0
    pH 7.0
    Ca 1.0
    Cl 2.0
SOLUTION 1
    pH 7.0
    Ca 1.0
    Cl 2.0
SOLUTION 2-10
    -water 1 # kg
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 11
    -water 1
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X- 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 1
    -flow_direction forward
    -boundary_conditions flux flux
    -dispersivities 0
    -correct_disp true
    -print_cells 1-10
    -print_frequency 1
    -punch_cells 1-10
    -punch_frequency 1
    -initial_time 0
    -warnings
    -input_errors

BOUNDARY_CONDITIONS
    1 11

SELECTED_OUTPUT
    -file selout.txt
    -reset false
    -step true
    -cell true
    -molalities HCl
