SOLUTION 1
    temp 200
    pH 2 charge
    Fe(3) 4e-3
    Fe(2) 4e-3
    units mol/kgw

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1.0
        -m  1.0
        -parms 1.0 10.0
        -steps 10*10

SELECTED_OUTPUT
    -file sel.out
    -reset false
    -time true
    -step true
    -totals Fe(3)
END
