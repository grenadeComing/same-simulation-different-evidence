SOLUTION 1 Hydrothermal
    temp 100
    pH   5
    pe   4
    units mmol/kgw
    C(4) 0.5
    Mn   1

KINETICS 1
    Calcite
        -m0 1
        -m  1
        -parms 10.0 0.001
        -steps 10 in 100
        -tol 1e-12

SELECTED_OUTPUT
    -file calcite_sel.tsv
    -reset false
    -high_precision true
    -time true
    -step true
    -pH true
    -pe true
END
