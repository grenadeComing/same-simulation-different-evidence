SOLUTION 1
    temp 200
    pH 2
    pe 4
    units mmol/kgw
    Cu 10
    Ba 5

KINETICS 1
    Calcite
        -m0 1
        -m  1
        -parms 1.0 10
        -steps 1000 in 100
        -tol 1e-12

SELECTED_OUTPUT
    -file selected.csv
    -reset false
    -high_precision true
USER_PUNCH
    -headings step time CO2_m
10 PUNCH STEP_NO, TOTAL_TIME, MOL("CO2")
END
