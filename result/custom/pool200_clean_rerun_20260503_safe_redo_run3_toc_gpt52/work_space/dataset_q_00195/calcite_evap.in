SOLUTION 1
    temp 25
    pH 8.0
    units ppm
    Ca 50
    Mg 12
    Na 20
    K  2
    Alkalinity 150 as CaCO3
    S(6) 40
    Cl 15

# Remove 50 moles of water
REACTION 1
    H2O -50.0
    1

EQUILIBRIUM_PHASES 1
    Calcite 0 0
    Gypsum  0 0
    Halite  0 0

SELECTED_OUTPUT
    -file calcite_evap_sel.txt
    -reset false
    -pH true
    -totals Ca S(6) Cl C(4)
    -equilibrium_phases Calcite Gypsum Halite
END
