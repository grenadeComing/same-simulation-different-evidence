SOLUTION 1
    temp      100
    pH        5
    pe        4
    units     mmol/kgw
    C(4)      0.5
    Mn        1

KINETICS 1
    Calcite
        -formula CaCO3 1
        -m0     1.0
        -m      1.0
        -parms  10.0 0.001
        -tol    1e-12
    -steps 10 in 100

SELECTED_OUTPUT
    -reset false
    -high_precision true
USER_PUNCH
    -headings step time TOT_C
10 PUNCH STEP_NO, TOTAL_TIME, TOT("C(4)")
END
