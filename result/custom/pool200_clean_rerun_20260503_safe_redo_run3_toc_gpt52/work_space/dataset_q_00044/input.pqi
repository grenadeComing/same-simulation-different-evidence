TITLE 100C Ca solution equilibrated with calcite+gypsum+aragonite and mixed gas
SOLUTION 1
    temp 100
    pH 7 charge
    units mmol/kgw
    Ca 50
EQUILIBRIUM_PHASES 1
    Calcite 0 0
    Gypsum 0 0
    Aragonite 0 0
GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    -temperature 25
    CO2(g) 1
    CH4(g) 5
    H2S(g) 10
SELECTED_OUTPUT
    -file selected.tsv
    -reset false
    -high_precision true
    -totals Ca S(6) C S(-2)
USER_PUNCH
    -headings SpCond_uS_cm
10 PUNCH SC
END
