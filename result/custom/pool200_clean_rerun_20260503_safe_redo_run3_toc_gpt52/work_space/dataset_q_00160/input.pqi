TITLE 1D transport, exchange
SOLUTION 0  Infilling
    pH 7.0
    Na 1.0
    Cl 1.0
SOLUTION 1-10 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
    -equilibrate 1
SELECTED_OUTPUT
    -file selected.txt
    -reset false
USER_PUNCH
    -head step cell logIAP_H2g
10 PUNCH (STEP_NO-1), CELL_NO, SI("H2(g)")
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1
    -dispersivities 0
    -correct_disp true
END
