SOLUTION 1
    temp 25
    units mol/kgw
    Ca 0.01
    Sr 0.01
    Alkalinity 0.04 as HCO3
    pH 7

SOLID_SOLUTIONS 1
    Ca_Sr_carbonate
        -comp1 Calcite 0.0
        -comp2 Strontianite 0.0

SELECTED_OUTPUT
    -reset false
    -high_precision true
USER_PUNCH
    -headings pe
    10 PUNCH PE
END
