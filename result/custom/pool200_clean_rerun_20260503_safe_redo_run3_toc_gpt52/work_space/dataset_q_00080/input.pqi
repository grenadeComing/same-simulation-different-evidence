SOLUTION 1
    temp 150
    pH 7 charge
    pe 4
    -water 1

GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    -temperature 150
    CH4(g) 10
    CO2(g) 10
    NH3(g) 5

SELECTED_OUTPUT
    -file selected.csv
    -reset false

USER_PUNCH
    -headings C4_species_count
-start
10 count = 0
20 i = 1
30 s$ = SPECIES_NAME$(i)
40 IF (s$ = "") THEN GOTO 200
50 IF (INSTR(s$, "C") > 0) THEN GOTO 60 ELSE GOTO 150
60 IF (INSTR(s$, "+4") > 0 OR INSTR(s$, "(4)") > 0) THEN GOTO 100
70 IF (s$ = "CO2") THEN GOTO 100
80 IF (s$ = "HCO3-") THEN GOTO 100
90 IF (s$ = "CO3-2") THEN GOTO 100
95 GOTO 150
100 IF (MOL(s$) > 0) THEN count = count + 1
150 i = i + 1
160 GOTO 30
200 PUNCH count
-end
END
