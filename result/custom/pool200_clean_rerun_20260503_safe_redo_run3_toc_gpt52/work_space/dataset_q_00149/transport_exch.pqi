SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0
SOLUTION 0
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

SELECTED_OUTPUT
    -file sel.txt
    -reset false
USER_PUNCH
    -headings shift cell NaX
10 PUNCH STEP_NO, CELL_NO, MOL("NaX")

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -time_step 1
    -diffusion_coefficient 0
    -dispersivity 0
    -correct_disp false
    -print_cells 1-10
    -punch_cells 1-10
    -punch_frequency 1

END
