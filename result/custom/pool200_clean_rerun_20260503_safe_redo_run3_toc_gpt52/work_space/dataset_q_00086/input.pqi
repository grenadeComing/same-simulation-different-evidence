TITLE 150C water equilibrated with fixed-pressure CH4-CO2-NH3 gas
SOLUTION 1
  temp 150
  pH 7 charge
  pe 4
  redox pe
  -water 1
GAS_PHASE 1
  -fixed_pressure
  -pressure 1
  -temperature 150
  CH4(g) 10
  CO2(g) 10
  NH3(g) 5
SELECTED_OUTPUT
  -file selected.tsv
  -reset false
  -solution true
  -pH true
  -pe true
END
