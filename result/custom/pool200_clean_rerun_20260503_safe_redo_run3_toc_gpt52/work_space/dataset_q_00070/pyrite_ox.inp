SOLUTION 1
  temp 25
  pH 7 charge
  units mol/kgw
  -water 1

GAS_PHASE 1
  -fixed_pressure
  -volume 1
  O2(g) -0.7

EQUILIBRIUM_PHASES 1
  Pyrite 0 0.1
  Goethite 0 0
  Gypsum 0 0

SELECTED_OUTPUT
  -file pyrite_ox.sel
  -reset false
  -high_precision true
USER_PUNCH
  -headings SC_uS_per_cm
  10 PUNCH TOT("S(6)")
END
