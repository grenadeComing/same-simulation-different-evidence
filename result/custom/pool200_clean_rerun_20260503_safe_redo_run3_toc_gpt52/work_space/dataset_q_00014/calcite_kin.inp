SOLUTION 1
    temp 200
    pH   2
    pe   4
    units mmol/kgw
    Cu   10
    Ba   5
    -water 1

KINETICS 1
    Calcite
        -m0 1
        -m  1
        -parms 1.0 1.0
        -tol 1e-12
    -steps 10 in 100

SELECTED_OUTPUT
    -file calcite_kin.sel
    -reset false
    -time true
    -step true
    -kinetic_reactants Calcite
END
