SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    units mmol/kgw
    Fe(2) 4
    Fe(3) 4

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1
        -m  1
        -parms 1.0 10
    -steps 10 in 100

SELECTED_OUTPUT
    -file selected.txt
    -reset false
    -time
    -step
    -gas H2S(g)

END
