SOLUTION 1
    temp 200
    pH 2 charge
    Fe(3) 4 mmol/kgw
    Fe(2) 4 mmol/kgw
    -water 1

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1
        -m  1
        -parms 1.0 10
    -steps 10 in 100

SELECTED_OUTPUT
    -file sel.txt
    -reset false
USER_PUNCH
    -headings step time Ba_molal
10 PUNCH STEP_NO, TOTAL_TIME, MOL("Ba+2")
END
