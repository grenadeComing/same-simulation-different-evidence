TITLE CH4 dissolved during equilibration with minerals and gas phase
SOLUTION 1
    temp 100
    pH 7 charge
    units mmol/kgw
    Ca 50
    -water 1
EQUILIBRIUM_PHASES 1
    Calcite   0 0
    Gypsum    0 0
    Aragonite 0 0
GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    -temperature 25
    CO2(g)  1
    CH4(g)  5
    H2S(g) 10
SELECTED_OUTPUT
    -file ch4_sel.txt
    -reset false
    -gas true
USER_PUNCH
    -headings CH4_delta_mol
    10 PUNCH GAS("CH4(g)")
END
