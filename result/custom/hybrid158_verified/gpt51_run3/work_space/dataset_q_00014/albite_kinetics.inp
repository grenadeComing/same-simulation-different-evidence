SOLUTION 1
    temp 200
    pH 2 charge
    units mmol/kgw
    Fe(2) 4
    Fe(3) 4

GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    -temperature 200
    -volume 1
    H2S(g) 5

KINETICS 1
    Albite
    -formula NaAlSi3O8 1
    -m0 1
    -m 1
    -parms 10 1.0
    -steps 1000 in 100 steps

RATES
    Albite
    -start
    10 k = PARM(1)
    20 ssa = PARM(2)
    30 rate = k * ssa
    40 moles = rate * TIME
    50 SAVE moles
    -end

SELECTED_OUTPUT
    -file selected_output_1.sel
    -reset false
    -time true
    -step true
    -totals Na Fe S Al
END