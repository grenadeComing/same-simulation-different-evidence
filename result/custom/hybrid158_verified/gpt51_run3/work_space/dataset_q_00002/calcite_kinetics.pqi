SOLUTION 1
    temp      100
    pH        5
    pe        4
    units     mmol/kgw
    C(4)      0.5
    Mn        1
    -water    1 # kgw

EQUILIBRIUM_PHASES 1
    Calcite 0 1

KINETICS 1
    Calcite
        -formula   CaCO3 1
        -m0        1
        -parms     0.001 10.0
        -steps     10*100

RATES
    Calcite
    -start
10  k = PARM(1)
20  ssa = PARM(2)
30  rate = k * ssa
40  moles = rate * TIME
50  SAVE moles
    -end

SELECTED_OUTPUT
    -file              calcite_kinetics.sel
    -reset             false
    -time              true
    -step              true
    -si                Aragonite

END
