SOLUTION 1
    temp 20
    pH 7 charge
    C(4)  0.05

SOLUTION 2
    temp 20
    pH 7 charge
    Ca  0.05
    C(4) 0

MIX 1
    1 0.5
    2 0.5

EQUILIBRIUM_PHASES 1
    Calcite 0 10

SELECTED_OUTPUT
    -reset false
    -totals Ca C(4)
    -molalities
    -si Calcite
    -equilibrium_phases Calcite
    -high_precision true
    -user_punch false

END