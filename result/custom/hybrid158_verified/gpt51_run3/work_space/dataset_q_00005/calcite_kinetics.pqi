SOLUTION 1
    temp      200
    pH        2 charge
    pe        4
    units     mmol/kgw
    Cu        10
    Ba        5

EQUILIBRIUM_PHASES 1
    Calcite 0 1

KINETICS 1
    Calcite_kin
        -formula   CaCO3 1
        -m         1.0
        -m0        1.0
        -parms     10 1.0
        -steps     10*10

RATES
    Calcite_kin
    -start
    10 k  = PARM(1)
    20 sa = PARM(2)
    30 rate = k * sa
    40 moles = rate * TIME
    50 SAVE moles
    -end

SELECTED_OUTPUT
    -file calcite_kinetics.sel
    -reset false
    -time true
    -step true
    -tot CO2
END
