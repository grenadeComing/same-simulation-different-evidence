SOLUTION 0-10
    pH 7.0
    units mmol/kgw
    Ca 1.0
    Cl 2.0

SOLUTION 11
    pH 7.0
    units mmol/kgw
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

SELECTED_OUTPUT
    -file step5.sel
    -reset false
    -state true
    -distance true
    -solution true
    -step true
    -totals Na Ca Cl
    -ionic_strength true

USER_PUNCH
    -headings sc
    10 PUNCH SC

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -length 10
    -dispersivities 0
    -boundary_conditions flux flux
    -print_cells 1
    -print_frequency 1
    -punch_cells 1
    -punch_frequency 1
