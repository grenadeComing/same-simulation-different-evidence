SOLUTION 1
    temp 200
    pH 2 charge
    units mmol/kgw
    Fe(2) 4
    Fe(3) 4

GAS_PHASE 1
    fixed_pressure
    -pressure 5
    -temperature 200
    H2S(g) 1

KINETICS 1
    Albite 1.0
    -formula NaAlSi3O8 1
    -m0 1.0
    -m  1.0
    -parms 10 1.0
    -steps 10*10

RATES
    Albite
    -start
    10 k = PARM(1)
    20 ssa = PARM(2)
    30 rate = k * ssa
    40 moles = rate * TIME
    50 SAVE moles
    -end

SELECTED_OUTPUT
    -file albite.sel
    -time true
    -step true
    -molalities Si
    -totals Si

END
