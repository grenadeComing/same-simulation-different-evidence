SOLUTION 1 Pure water at 150C
    temp      150
    pH        7 charge
    pe        4
    units     mol/kgw

GAS_PHASE 1 Fixed, fixed_pressure
    -temperature 150
    -pressure    1.0
    -fixed_pressure true
    -volume     1.0
    CH4(g)  10
    CO2(g)  10
    NH3(g)  5

SELECTED_OUTPUT
    -reset false
    -solution  true
    -alkalinity  true
END
