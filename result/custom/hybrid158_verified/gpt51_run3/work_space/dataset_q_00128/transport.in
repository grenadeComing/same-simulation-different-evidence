SOLUTION 0-10
    pH 7.0
    units mmol/kgw
    Ca 1.0
    Cl 2.0

SOLUTION 11
    pH 7.0
    units mmol/kgw
    Na 1.0
    Cl 1.0

EXCHANGE 0-10
    X- 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 1
    -flow_direction forward
    -boundary_conditions flux flux
    -dispersivities 0
    -initial_time 0
    -print_cells 1-10
    -print_frequency 1
    -punch_cells 1-10
    -punch_frequency 1
    -warnings

SELECTED_OUTPUT
    -file transport.sel
    -reset false
    -time true
    -distance true
    -state true
    -equilibria true
