    -high_precision true
    -totals   Fe(3)
    -molalities   Fe+3 FeOH+2 Fe(OH)2+ Fe(OH)3 Fe(OH)4- FeSO4+ FeHSO4+ Fe(SO4)2- Fe(SO4)2- Fe3(OH)4+5
END