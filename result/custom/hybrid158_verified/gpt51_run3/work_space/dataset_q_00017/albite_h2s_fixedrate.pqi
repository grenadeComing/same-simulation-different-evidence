SOLUTION 1
    temp 200
    pH 2 charge
    Fe(3) 4e-3
    Fe(2) 4e-3

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g)  5

KINETICS 1
    Albite
    -m0 1
    -steps 10*10
    -tol 1e-12

RATES
Albite
    -start
    10 k = 10
    20 m0 = MOL("Albite")
    30 rate = k * 1 * m0
    40 moles = rate * TIME
    50 SAVE moles
    -end

INCREMENTAL_REACTIONS true
USER_PUNCH
    -head Step H2S_moles
    -start
    10 PUNCH SIM_NO, GAS("H2S(g)")
    -end
