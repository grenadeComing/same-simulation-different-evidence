SOLUTION 1
    temp      200
    pH        2 charge
    units     mmol/kgw
    Fe(2)     4
    Fe(3)     4

KINETICS 1
    Albite
    -formula NaAlSi3O8 1
    -m0      1
    -parms   10 1.0
    -steps   1000 in 100 steps

RATES
    Albite
    -start
    10 k = PARM(1)
    20 ssa = PARM(2)
    30 rate = k * ssa
    40 moles = rate * TIME
    50 SAVE moles
    -end

SELECTED_OUTPUT
    -file albite_kinetics_simple.sel
    -reset false
    -time true
    -kinetic_reactants true
    -high_precision true