SOLUTION 1
    temp      200
    pH        2
    pe        4
    units     mmol/kgw
    Cu        10
    Ba        5

KINETICS 1
    Calcite
        -formula  CaCO3 1
        -m0      1
        -parms   10 1.0
        -steps   100*10

RATES
Calcite
    -start
    10 k = PARM(1)
    20 ssa = PARM(2)
    30 m = SR("Calcite")
    40 si = SI("Calcite")
    50 rate = k * ssa * (1 - 10^si)
    60 moles = rate * TIME
    70 SAVE moles
    -end

INCREMENTAL_REACTIONS true

SELECTED_OUTPUT
    -file witherite_si.txt
    -reset false
    -time true
    -step true
    -si Witherite

END
