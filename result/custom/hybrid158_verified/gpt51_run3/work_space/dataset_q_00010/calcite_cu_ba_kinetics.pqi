SOLUTION 1
    temp      200
    pH        2 charge
    pe        4
    units     mmol/kgw
    Cu        10
    Ba        5

EQUILIBRIUM_PHASES 1
    Calcite  0 1

KINETICS 1
    Calcite
        -m0     1
        -m      1
        -parms  10 1.0
        -formula CaCO3 1
        -steps  1000 in 100 steps

RATES
Calcite
    -start
    10 k = PARM(1)
    20 ssa = PARM(2)
    30 m = MOL("Calcite")
    40 rate = k * ssa
    50 moles = rate * TIME
    60 if (moles > m) then moles = m
    70 SAVE moles
    -end

SELECTED_OUTPUT
    -file calcite_cu_ba_kinetics.sel
    -reset false
    -time true
    -step true
    -totals     C(4) Cu(2)

END