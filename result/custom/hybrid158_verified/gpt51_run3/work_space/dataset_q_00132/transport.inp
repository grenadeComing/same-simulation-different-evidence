SOLUTION 0-10
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 1
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 0-10
    X- 0.001

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 10*1
    -boundary_conditions flux flux
    -flow_direction forward
    -print_cells 3
    -print_frequency 10
    -punch_cells 3
    -punch_frequency 10

SELECTED_OUTPUT
    -file selout.txt
    -alkalinity true
END