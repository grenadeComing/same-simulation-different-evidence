SOLUTION 1
    temp 200
    pH 2 charge
    Fe(2) 4e-3
    Fe(3) 4e-3

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    -temperature 200
    H2S(g) 1

KINETICS 1
    Albite
        -formula NaAlSi3O8 1
        -m0 1
        -parms 10 1.0
        -steps 1000 in 10

RATES
    Albite
    -start
    10 k = PARM(1)
    20 ssa = PARM(2)
    30 rate = k * ssa
    40 SAVE rate
    -end

SELECTED_OUTPUT
    -file albite_kinetic_simple.sel
    -reset false
    -time true
    -si Goethite
    -step true

END
