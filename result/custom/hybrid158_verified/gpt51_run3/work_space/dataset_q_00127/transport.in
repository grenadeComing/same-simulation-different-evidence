SOLUTION 0-10
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001

TRANSPORT
    -cells                 10
    -shifts                10
    -time_step             1
    -flow_direction        forward
    -boundary_conditions   constant  flux
    -lengths               10
    -dispersivities        0
    -correct_disp          false
    -print_cells           1-10
    -print_frequency       1
    -punch_cells           1-10
    -punch_frequency       1
    -initial_time          0
    -boundary_solution     0

SELECTED_OUTPUT
    -file                  selout.txt
    -reset                 false
    -high_precision        true
    -time                  true
    -step                  true
    -distance              true
    -solution              true
    -molalities            Ca+2
END
