SOLUTION 0-10
    pH 7.0 charge
    Ca 1.0
    Cl 2.0

SOLUTION 11
    pH 7.0 charge
    Na 1.0
    Cl 1.0

EXCHANGE 0-10
    X 0.001

SELECTED_OUTPUT
    -file sel.out
    -reset false
    -step true
    -solution true
    -temperature true

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions flux flux
    -initial_time 0
    -dispersivities 1*0.0
    -punch_cells 1

END
