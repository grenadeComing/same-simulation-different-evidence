SOLUTION 1-10 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 0 Infill
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 1
    -flow_direction forward
    -boundary_conditions constant flux
    -dispersivities 0
    -correct_disp false
    -print_cells 4
    -print_frequency 10

SELECTED_OUTPUT
    -file selout.txt
    -reset false
    -solution 4
    -totals Na Ca Cl
    -si H2O(g)
