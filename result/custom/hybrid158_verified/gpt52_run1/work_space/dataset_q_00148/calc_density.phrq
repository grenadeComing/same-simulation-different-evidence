TITLE Density of solution with 5 mmol/kgw C(-4) as CH4 at 15C, gas phase fixed P=1 atm with 0 CH4(g)
SOLUTION 1
  temp 15
  pH 7 charge
  pe 4
  units mmol/kgw
  C(-4) 5.0
  -water 1
GAS_PHASE 1
  -fixed_pressure
  -pressure 1.0
  -temperature 15
  CH4(g) 0
USER_PRINT
  -start
  10 PRINT "density", RHO
  -end
END
