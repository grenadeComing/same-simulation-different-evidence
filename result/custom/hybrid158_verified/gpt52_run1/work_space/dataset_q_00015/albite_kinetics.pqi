TITLE Albite kinetic dissolution with H2S gas, pH 2, 200C

SOLUTION 1
    temp 200
    pH 2
    units mmol/kgw
    Fe(+3) 4
    Fe(+2) 4

GAS_PHASE 1
    -fixed_pressure true
    -pressure 5
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1
        -formula NaAlSi3O8 1
        -parm 1.0 10
    -steps 100*10

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -step true
    -time true
    -ionic_strength true
END
