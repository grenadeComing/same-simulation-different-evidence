TITLE Mix 50 mM DIC with 50 mM Ca 1:1, heat 20 to 200C, equilibrate with calcite

SOLUTION 1 DIC_50mM
    temp 20
    pH 7 charge
    units mmol/kgw
    C(4) 50

SOLUTION 2 Ca_50mM
    temp 20
    pH 7 charge
    units mmol/kgw
    Ca 50

MIX 1
    1 0.5
    2 0.5

EQUILIBRIUM_PHASES 1
    Calcite 0 0

REACTION_TEMPERATURE 1
    20 200 in 10

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -temperature true
    -pH true

USER_PUNCH
    -headings step temp pH
    10 PUNCH STEP_NO, TC, -LA("H+")

END
