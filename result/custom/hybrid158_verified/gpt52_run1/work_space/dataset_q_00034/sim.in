TITLE 100C Ca solution equilibrated with calcite+gypsum+aragonite and mixed gas phase
SOLUTION 1
    temp 100
    pH 7 charge
    units mmol/kgw
    Ca 50
EQUILIBRIUM_PHASES 1
    Calcite 0 0
    Gypsum 0 0
    Aragonite 0 0
GAS_PHASE 1
    -fixed_pressure
    -pressure 16.0
    -temperature 25
    CO2(g) 1.0
    CH4(g) 5.0
    H2S(g) 10.0
SELECTED_OUTPUT
    -file sel.tsv
    -reset false
USER_PUNCH
    -headings dCO2_mol dCH4_mol dH2S_mol
10 PUNCH GAS("CO2(g)")
20 PUNCH GAS("CH4(g)")
30 PUNCH GAS("H2S(g)")
END
