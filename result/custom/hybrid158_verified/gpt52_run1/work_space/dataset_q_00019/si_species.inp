TITLE Albite kinetics + H2S(g) fixed pressure; count Si species at step 100
SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    units mmol/kgw
    Fe(+3) 4
    Fe(+2) 4

GAS_PHASE 1
    -fixed_pressure true
    -pressure 5
    H2S(g) 1.0

KINETICS 1
    Albite
        -m0 1
        -m  1
        -parms 1.0 10
        -steps 10 100

SELECTED_OUTPUT
    -file si_sel.tsv
    -reset false
    -high_precision true
USER_PUNCH
    -headings step Si_aq_species_count
    10 PUNCH STEP_NO
    20 PUNCH MOL("H4SiO4")>0 + MOL("H3SiO4-")>0 + MOL("H2SiO4-2")>0
END
