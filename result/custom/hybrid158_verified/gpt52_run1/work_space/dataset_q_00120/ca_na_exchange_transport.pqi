TITLE 1D transport 10 cells, 10 shifts; Ca/Na solutions; exchange 0.001 mol sites

SOLUTION 0 Infilling
    pH 7.0
    Na 1.0
    Cl 1.0

SOLUTION 1-10 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

# Save exchange after each shift to examine step 5, cell 1
SELECTED_OUTPUT
    -file sel.txt
    -reset false
    -high_precision true
    -simulation true
    -state true
USER_PUNCH
    -headings step cell CaX2
10 PUNCH SHIFT_NUMBER, CELL_NO, MOL("CaX2")

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1
    -dispersivities 0
    -correct_disp true
    -punch_cells 1-10
    -punch_frequency 1
END
