SOLUTION 1
    temp 100
    pH   5 charge
    units mmol/kgw
    Ba   100
    -water 1

EQUILIBRIUM_PHASES 1
    Talc            0 10
    Rhodochrosite   0 10
    Sepiolite       0 10
    Sepiolite(d)    0 10
    Pb(OH)2         0 10

SELECTED_OUTPUT
    -file sel.txt
    -reset false
USER_PUNCH
    -headings Talc_moles
10  PUNCH EQUI("Talc")
END
