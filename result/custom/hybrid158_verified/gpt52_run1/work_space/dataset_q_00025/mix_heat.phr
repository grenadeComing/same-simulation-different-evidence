TITLE Mix 50 mM DIC with 50 mM Ca (1:1), heat 20 to 200C, allow calcite ppt/diss
SOLUTION 1 DIC
    temp 20
    units mmol/kgw
    pH 7 charge
    C(4) 50
SOLUTION 2 Ca
    temp 20
    units mmol/kgw
    pH 7 charge
    Ca 50
MIX 1
    1 0.5
    2 0.5
EQUILIBRIUM_PHASES 1
    Calcite 0 0
REACTION_TEMPERATURE 1
    20 40 60 80 100 120 140 160 180 200
SELECTED_OUTPUT
    -file mix_heat.sel
    -reset false
USER_PUNCH
    -headings step temp Ca_species_count
10 PUNCH STEP_NO, TC, SYS("species  Ca")
END
