TITLE Pyrite oxidation equilibrium in pure water with fixed O2(g)
SOLUTION 1
  temp 25
  pH 7 charge
  redox pe
  units mol/kgw
  -water 1
EQUILIBRIUM_PHASES 1
  O2(g) -0.7  10
  Pyrite 0    0.1
  Goethite 0  10
  Gypsum 0    10
SELECTED_OUTPUT
  -file pyrite_oxid_eq.sel
  -reset false
  -pH true
  -pe true
END
