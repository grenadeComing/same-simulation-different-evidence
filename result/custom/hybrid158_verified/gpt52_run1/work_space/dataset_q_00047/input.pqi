SOLUTION 1
    temp 100
    pH   5 charge
    units mmol/kgw
    Ba   100
    -water 1

EQUILIBRIUM_PHASES 1
    Talc             0 10
    Rhodochrosite    0 10
    Sepiolite        0 10
    Sepiolite(d)     0 10
    Pb(OH)2          0 10

SELECTED_OUTPUT
    -file selected.txt
    -reset false
    -totals Ba Mg Mn Pb Si C
USER_PUNCH
    -headings SpCond_uS_cm
    10 PUNCH SC
END
