TITLE 1D transport with exchange; specific conductance at step 5
SOLUTION 0  Infilling
    pH 7.0
    Na 1.0
    Cl 1.0
SOLUTION 1-10 Initial cells
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
SAVE exchange 1
END
COPY exchange 1 2-10
END
SELECTED_OUTPUT
    -file sel.txt
    -reset false
USER_PUNCH
    -headings step cell spcond
    10 PUNCH STEP_NO, CELL_NO, SC
END
TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions flux flux
    -diffusion_coefficient 0
    -dispersivities 0
    -punch_cells 1
END
