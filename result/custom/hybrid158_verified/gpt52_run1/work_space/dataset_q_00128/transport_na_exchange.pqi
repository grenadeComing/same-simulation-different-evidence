TITLE 1D transport with cation exchange
SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0
SOLUTION 0
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions constant constant
    -dispersivities 0
    -diffusion_coefficient 0

SELECTED_OUTPUT
    -reset false
    -file selected_transport.txt
USER_PUNCH
    -headings step NaX_ex4
10 PUNCH STEP_NO, MOL("NaX")
END
