SOLUTION 1
    temp      100
    pH        5 charge
    units     mmol/kgw
    Ba        100
    water     1

EQUILIBRIUM_PHASES 1
    Talc            0 10
    Rhodochrosite   0 10
    Sepiolite       0 10
    Sepiolite(d)    0 10
    Pb(OH)2         0 10

SELECTED_OUTPUT
    -file q1_sel.txt
    -reset false
USER_PUNCH
    -headings C4_species_count
10 PUNCH COUNT_SPECIES(C, 4)
END

PRINT
    -selected_output true
END
