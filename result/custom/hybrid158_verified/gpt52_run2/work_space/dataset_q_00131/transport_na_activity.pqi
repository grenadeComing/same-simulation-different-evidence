SOLUTION 1-10 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0
    -water 1

SOLUTION 0 Influent
    pH 7.0
    Na 1.0
    Cl 1.0
    -water 1

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -time_step 1
    -lengths 1
    -dispersivities 0
    -diffusion_coefficient 0
    -porosity 1
    -punch_cells 3
    -punch_frequency 10

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -solution true
    -activities Na+
END
