TITLE Equilibrium oxidation of pyrite in pure water, fixed O2(g)
SOLUTION 1
    temp 25
    pH 7 charge
    units mol/kgw
    water 1

GAS_PHASE 1
    -fixed_pressure true
    -pressure 1
    O2(g) -0.7

EQUILIBRIUM_PHASES 1
    Pyrite 0 0.1
    Goethite 0 0
    Gypsum 0 0

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -pH true
    -pe true
END
