SOLUTION 1
    temp 150
    pH 7
    pe 4
    units mol/kgw
    water 1

GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    -temperature 150
    CH4(g) 10
    CO2(g) 10
    NH3(g) 5

SELECTED_OUTPUT
    -reset false
    -high_precision true
USER_PUNCH
    -headings dCH4
10 PUNCH (GAS("CH4(g)") - 10)
END
