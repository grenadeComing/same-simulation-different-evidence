SOLUTION 1 Pure water
    temp 150
    pH 7 charge
    pe 4
    redox pe
    units mol/kgw
    water 1

GAS_PHASE 1 Fixed P gas mix
    -fixed_pressure
    -pressure 1
    -temperature 150
    CH4(g) 0.4
    CO2(g) 0.4
    NH3(g) 0.2

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -pH true
    -alkalinity true

END
