TITLE Albite kinetics pH 2, 200 C, Fe2/Fe3, fixed P H2S(g)

SOLUTION 1
    temp      200
    pH        2 charge
    units     mmol/kgw
    Fe(3)     4
    Fe(2)     4
    -water    1

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g)    5

KINETICS 1
    Albite
        -m0 1
        -m  1
        -parms 1.0 10
        -steps 10  in 100

SELECTED_OUTPUT
    -file albite_sel.tsv
    -reset false
    -high_precision true
USER_PUNCH
    -headings step SI_Goethite
10 PUNCH STEP_NO, SI("Goethite")
END
