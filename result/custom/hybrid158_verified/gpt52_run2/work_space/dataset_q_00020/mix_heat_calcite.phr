TITLE Mix 50 mmol/kg DIC with 50 mmol/kg Ca in 1:1; equilibrate with Calcite; step temperature 20 to 200 C
SOLUTION 1 DIC_solution
    temp 20
    pH   7 charge
    units mmol/kgw
    C(4) 50
SOLUTION 2 Ca_solution
    temp 20
    pH   7 charge
    units mmol/kgw
    Ca   50
MIX 1
    1 0.5
    2 0.5
EQUILIBRIUM_PHASES 1
    Calcite 0 0
REACTION_TEMPERATURE 1
    20 200 in 10
SELECTED_OUTPUT
    -reset false
    -high_precision true
    -sim true
    -state true
    -solution true
    -temperature true
    -pH true
END
