TITLE Albite kinetics with fixed-pressure H2S gas; report dissolved H2S at step 100

SOLUTION 1
    temp      200
    pH        2 charge
    units     mmol/kgw
    Fe(3)     4
    Fe(2)     4

RATES
Albite
-start
10 k = 10
20 sa = 1.0
30 rate = k*sa
40 moles = rate*TIME
50 if (moles > M) then moles = M
60 SAVE moles
-end

KINETICS 1
    Albite
        -m0 1.0
        -tol  1e-12
    -steps 10 in 100

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -time true
    -step true

USER_PUNCH
    -headings step time_s h2s_dissolved_mol
10 PUNCH STEP_NO, TOTAL_TIME, GAS("H2S(g)")
