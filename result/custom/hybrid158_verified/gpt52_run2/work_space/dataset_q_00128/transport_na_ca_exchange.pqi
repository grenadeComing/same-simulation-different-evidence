TITLE 1D transport, cation exchange, 10 cells 10 shifts

SOLUTION 0  Infilling
    pH 7.0
    Na 1.0
    Cl 1.0

SOLUTION 1-10 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions constant constant
    -diffusion_coefficient 0
    -dispersivities 0

SELECTED_OUTPUT
    -reset false
    -high_precision true
USER_PUNCH
    -headings NaX_ex4_step
    10 IF (STEP_NO = 10 AND CELL_NO = 4) THEN PUNCH MOL("NaX") ELSE PUNCH 0
END
