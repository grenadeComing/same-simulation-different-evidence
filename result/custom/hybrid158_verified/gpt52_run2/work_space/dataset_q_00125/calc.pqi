TITLE 1D transport with exchange; CaX2 equivalent fraction at exch 1, step 6
SOLUTION 0
    pH 7.0
    Na 1.0
    Cl 1.0
SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
    -equilibrate 1
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1
    -dispersivities 0
    -correct_disp true
    -diffusion_coefficient 0
    -initial_time 0
    -punch_cells 1
    -punch_frequency 1
SELECTED_OUTPUT
    -file sel.txt
    -reset false
    -time true
    -step true
    -distance true
USER_PUNCH
    -headings step dist eqfrac_CaX2
10 PUNCH STEP_NO, DIST, EQUI("CaX2")
END
