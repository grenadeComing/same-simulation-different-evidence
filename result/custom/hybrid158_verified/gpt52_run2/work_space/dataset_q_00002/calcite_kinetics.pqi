TITLE Calcite kinetic dissolution, 100 C, pH 5, pe 4; track SI(Aragonite)
SOLUTION 1
    temp 100
    pH   5
    pe   4
    units mmol/kgw
    C(4) 0.5
    Mn   1

RATES
Calcite_custom
-start
10 k = PARM(1)
20 SA = PARM(2)
30 si = SI("Calcite")
40 IF (si >= 0) THEN rate = 0 ELSE rate = k*SA ENDIF
50 moles = rate * TIME
60 SAVE moles
-end

KINETICS 1
    Calcite_custom
        -formula CaCO3 1
        -m0 1.0
        -m  1.0
        -parms 0.001 10.0
        -steps 1000 in 100
        -tol 1e-12

SELECTED_OUTPUT
    -reset false
    -time true
    -step true
    -si Aragonite

END
