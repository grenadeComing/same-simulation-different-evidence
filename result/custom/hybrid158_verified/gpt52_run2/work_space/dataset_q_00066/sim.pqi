SOLUTION 1 Pure_water_150C
    temp 150
    pH 7 charge
    pe 4
    units mol/kgw
    -water 1

GAS_PHASE 1 FixedP_1atm
    -fixed_pressure
    -pressure 1
    -temperature 150
    CH4(g) 0.4 10
    CO2(g) 0.4 10
    NH3(g) 0.2 5

SELECTED_OUTPUT
    -file sel.txt
    -reset false
END

PRINT
    -species true
END
