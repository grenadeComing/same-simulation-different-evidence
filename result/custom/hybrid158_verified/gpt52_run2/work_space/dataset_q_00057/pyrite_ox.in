TITLE Pyrite oxidation equilibrium in pure water, open to O2
SOLUTION 1
    temp 25
    pH 7 charge
    units mol/kgw
    -water 1
EQUILIBRIUM_PHASES 1
    Pyrite 0 0.1
    Goethite 0 0
    Gypsum 0 0
GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    O2(g) -0.7
SELECTED_OUTPUT
    -file pyrite_ox.sel
    -reset false
USER_PUNCH
    -headings SpCond_uS_cm
    10 PUNCH SC
END
