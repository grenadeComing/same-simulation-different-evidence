TITLE 1D transport, exchange, viscosity query

# Initial solutions in all 10 cells
SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0

# Inflow solution
SOLUTION 0
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 0.001

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions constant constant
    -print_cells 1
    -print_frequency 1

SELECTED_OUTPUT
    -file sel_visc.txt
    -reset false
    -high_precision true

USER_PUNCH
    -headings shift cell visc
    10 PUNCH SHIFT, CELL_NO, VISCOSITY
END
