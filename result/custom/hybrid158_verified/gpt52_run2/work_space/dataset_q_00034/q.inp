TITLE Gas dissolution comparison with minerals, T=100C
SOLUTION 1
    temp 100
    pH 7 charge
    Ca 50 mmol/kgw
EQUILIBRIUM_PHASES 1
    Calcite 0 10
    Gypsum 0 10
    Aragonite 0 10
GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    -temperature 25
    CO2(g) 1
    CH4(g) 5
    H2S(g) 10
SELECTED_OUTPUT
    -file sel.txt
    -reset false
USER_PUNCH
    -headings n_CO2_diss n_CH4_diss n_H2S_diss
    10 PUNCH GAS("CO2(g)")
    20 PUNCH GAS("CH4(g)")
    30 PUNCH GAS("H2S(g)")
END
