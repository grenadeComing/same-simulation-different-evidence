TITLE 1D transport with exchange, 10 cells, 10 shifts; query Ca in solution 1 step 6

SOLUTION 0 Infilling
    pH 7.0
    Na 1.0
    Cl 1.0

SOLUTION 1-10 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -time false
    -distance false
    -step true
    -simulation false
    -state false
    -solution true

USER_PUNCH
    -headings step soln Ca_m
10 PUNCH STEP_NO, SOLN, MOL("Ca+2")

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1
    -dispersivities 0
    -diffusion_coefficient 0
    -punch_cells 1
END
