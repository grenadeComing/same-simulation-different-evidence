TITLE 150C water equilibrated with fixed-pressure CH4-CO2-NH3 gas mixture
SOLUTION 1
  temp 150
  pH   7 charge
  pe   4
  -water 1
GAS_PHASE 1
  -fixed_pressure
  -pressure 1
  -temperature 150
  CH4(g)  0.4  10
  CO2(g)  0.4  10
  NH3(g)  0.2   5
SELECTED_OUTPUT
  -file sel.txt
  -reset false
  -high_precision true
  -pH true
  -pe true
END
