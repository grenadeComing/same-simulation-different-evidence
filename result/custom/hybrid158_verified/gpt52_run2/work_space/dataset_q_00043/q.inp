TITLE 100C pure water pH 3 eq with minerals, count Fe2 vs Fe3 species
SOLUTION 1
  temp 100
  pH 3 charge
  -water 1
EQUILIBRIUM_PHASES 1
  K-mica 0 10
  Kaolinite 0 10
  Dolomite 0 10
  Epsomite 0 10
  Fe(OH)3(a) 0 10
  Halite 0 10
SELECTED_OUTPUT
  -file sel.txt
  -reset false
  -high_precision true
USER_PUNCH
  -headings nFe2_species nFe3_species
  10 PUNCH EOL$("Fe+2")
  20 PUNCH EOL$("Fe+3")
END
