TITLE Transport with cation exchange; query CaX2 eq fraction at cell 1, step 6
SOLUTION 0 Inflow
    pH 7.0
    Na 1.0
    Cl 1.0
SOLUTION 1-10 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
EQUILIBRATE 1-10 with_solution 1
TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1
    -dispersivities 0
    -correct_disp true
    -punch_frequency 1
    -print_frequency 1
SELECTED_OUTPUT
    -file sel.txt
    -reset true
    -high_precision true
USER_PUNCH
    -headings step cell CaX2_eqfrac
10 PUNCH SIM_NO, CELL_NO, EQUI("CaX2")
END
KNOBS
    -user_punch false
END
