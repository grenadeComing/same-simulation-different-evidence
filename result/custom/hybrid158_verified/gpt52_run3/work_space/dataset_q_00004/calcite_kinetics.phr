TITLE Calcite kinetics in acidic Cu-Ba solution; compute SI(Witherite) at step 100
SOLUTION 1
    temp 200
    pH 2
    pe 4
    units mmol/kgw
    Cu 10
    Ba 5
    Cl 30 charge
    -water 1

RATES
Calcite_simple
-start
10 rate_const = PARM(2)
20 sa = PARM(1)
30 m = MOL("Calcite")
40 if (m <= 0) then goto 200
50 rate = rate_const * sa
60 moles = rate * TIME
70 SAVE moles
200 END
-end

KINETICS 1
    Calcite_simple
        -formula CaCO3 1
        -m0 1
        -m  1
        -parms 1.0 10
    -steps 10 100

SELECTED_OUTPUT
    -file sel.txt
    -reset false
    -time true
    -step true
    -si Witherite
END
