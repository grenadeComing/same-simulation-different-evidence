TITLE 1D transport, 10 cells, 10 shifts, exchange in all cells

SOLUTION 0 Infilling
    pH 7.0
    Na 1.0
    Cl 1.0

SOLUTION 1-10 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001

# Equilibrate exchangers with the initial solutions (cell by cell)
EQUILIBRATE 1-10 with_solution 1

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions constant constant
    -lengths 1
    -dispersivities 0
    -correct_disp true
    -print_cells 3
    -print_frequency 10
    -punch_cells 3
    -punch_frequency 10

SELECTED_OUTPUT
    -file selected.csv
    -reset false
    -high_precision true
    -pH true
    -alkalinity true

END
