TITLE 150C water + fixed P gas CH4 CO2 NH3; find specific conductance
SOLUTION 1
    temp 150
    pH 7
    pe 4
    units mol/kgw
    water 1
GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    -temperature 150
    CH4(g)  10
    CO2(g)  10
    NH3(g)  5
SELECTED_OUTPUT
    -file sel.txt
    -reset false
    -high_precision true
    -totals C N
    -pH true
    -pe true
    -temperature true
    -ionic_strength true
USER_PUNCH
    -headings SC_uS_cm
10 PUNCH SC
END
