TITLE 1D transport with cation exchange, 10 cells, 10 shifts
SOLUTION 0  Initial solution
    pH 7.0
    Ca 1.0
    Cl 2.0
SOLUTION 1-10  Initial in cells
    pH 7.0
    Ca 1.0
    Cl 2.0
SOLUTION 11  Influent
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions constant constant
    -initial_time 0
    -time_step 1
    -dispersivities 0
    -diffusion_coefficient 0
    -punch_frequency 1
    -punch_cells 1
END

SELECTED_OUTPUT
    -file selected.sel
    -reset true
    -high_precision true
    -simulation true
    -state true
    -solution true
    -step true
    -totals Na
END
