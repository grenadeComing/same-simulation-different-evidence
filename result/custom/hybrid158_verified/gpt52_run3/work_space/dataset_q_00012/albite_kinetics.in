TITLE Albite kinetics pH 2, 200C, Fe2/Fe3, H2S gas; find pe at step 100
SOLUTION 1
    temp 200
    pH 2 charge
    units mmol/kgw
    Fe(+3) 4
    Fe(+2) 4
    -water 1
GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5
KINETICS 1
    Albite
        -m0 1
        -m  1
        -parms 1.0 10
        -steps 10*100 seconds
        -tol 1e-12
SELECTED_OUTPUT
    -file albite_kinetics.sel
    -reset false
    -time true
    -step true
    -pH true
    -pe true
END
