TITLE Albite kinetics, pH 2, 200C, Fe2/Fe3, H2S(g)

SOLUTION 1
    temp 200
    pH   2 charge
    pe   4
    Fe(3) 4 mmol/kgw
    Fe(2) 4 mmol/kgw
    -water 1

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    -temperature 200
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1
        -m  1
        -parms 1.0 10
        -tol 1e-12
        -steps 1000 in 100

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -time true
    -step true
    -totals Na Al S Fe

END
