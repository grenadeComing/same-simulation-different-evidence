SOLUTION 1
    temp 200
    pH 2 charge
    units mmol/kgw
    Fe(+3) 4
    Fe(+2) 4

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 1

KINETICS 1
    Albite
        -m0 1
        -m  1
        -parms 1.0 10.0
        -steps 10 in 100
        -tol 1e-12

SELECTED_OUTPUT
    -file sel.txt
    -reset false
    -step true
    -time true
    -totals S(-2)

USER_PUNCH
    -headings step time_s n_H2S_gas
10 PUNCH STEP_NO, TOTAL_TIME, GAS("H2S(g)")
END
