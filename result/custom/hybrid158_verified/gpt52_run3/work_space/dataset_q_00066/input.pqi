TITLE 150C pure water + fixed P gas mix (CH4, CO2, NH3)
SOLUTION 1
    temp 150
    pH 7 charge
    pe 4
    -water 1
GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    -temperature 150
    CH4(g) 0.4 10
    CO2(g) 0.4 10
    NH3(g) 0.2 5
SELECTED_OUTPUT
    -reset false
    -high_precision true
USER_PUNCH
    -headings totC species_C4_in_soln
10 PUNCH TOT("C(4)")
20 PUNCH SYS("C(4)")
END