TITLE Calcite kinetics, pH 2, 200C, Cu and Ba; check totals at step 10
SOLUTION 1
    temp      200
    pH        2
    pe        4
    units     mmol/kgw
    Cu        10
    Ba        5
    Cl        25
    -water    1

KINETICS 1
    Calcite
        -m0     1.0
        -m      1.0
        -parms  1.0 10
        -tol    1e-12
    -steps 10 in 100

SELECTED_OUTPUT
    -file step10.sel
    -reset false
    -high_precision true
    -time true
    -step true
    -totals C Cu

USER_PUNCH
    -headings step time_s totC_mol totCu_mol
10 PUNCH STEP_NO, TOTAL_TIME, TOT("C"), TOT("Cu")
END
