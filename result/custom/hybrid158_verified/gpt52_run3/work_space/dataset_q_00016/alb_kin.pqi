TITLE Albite kinetics pH2 200C Fe2/Fe3 with H2S(g)
SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    units mmol/kgw
    Fe(2) 4
    Fe(3) 4
    -water 1
GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    -volume 1
    H2S(g) 5
KINETICS 1
    Albite
        -m0 1
        -m  1
        -parms 1.0 10
        -tol 1e-12
    -steps 1000 in 100
SELECTED_OUTPUT
    -file alb_sel.tsv
    -reset false
    -time true
    -step true
    -totals Ba
END
