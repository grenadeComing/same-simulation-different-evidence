SOLUTION 1
    temp 100
    units mmol/kgw
    pH 7 charge
    Ca 50

EQUILIBRIUM_PHASES 1
    Calcite 0 0
    Gypsum 0 0
    Aragonite 0 0

GAS_PHASE 1
    -fixed_pressure
    -pressure 16
    -temperature 25
    CO2(g) 1
    CH4(g) 5
    H2S(g) 10

SELECTED_OUTPUT
    -file aragonite_si.sel
    -reset false
USER_PUNCH
    -headings SI_Aragonite
    10 PUNCH SI("Aragonite")
END
