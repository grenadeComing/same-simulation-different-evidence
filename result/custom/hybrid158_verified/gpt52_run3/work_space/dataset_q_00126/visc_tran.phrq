TITLE 1D transport, 10 cells, 10 shifts, exchange 0.001 mol/cell
SOLUTION 0  # inflow
    pH 7.0
    Na 1.0
    Cl 1.0
SOLUTION 1-10  # initial in all cells
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
    -equilibrate 1
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions constant constant
    -lengths 1
    -dispersivities 0
    -time_step 1
    -diffusion_coefficient 0
    -punch_cells 1
SELECTED_OUTPUT
    -file visc_sel.txt
    -reset false
    -high_precision true
USER_PUNCH
    -headings step cell viscosity
10 PUNCH STEP_NO, CELL_NO, SOLN_VOL
END
