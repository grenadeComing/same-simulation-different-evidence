TITLE 1D transport with cation exchange; query specific conductance at step 5

SOLUTION 0 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 1-10 Initial_cells
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 11 Influent
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions constant constant
    -initial_time 0
    -print_frequency 1
    -punch_frequency 1

SELECTED_OUTPUT
    -file selected.csv
    -reset false
    -high_precision true
    -simulation true
    -state true
    -time true
    -distance true
    -step true
    -totals Na Ca Cl
    -pH true

USER_PUNCH
    -headings step cell sc
    10 PUNCH STEP_NO, CELL_NO, SC

END
