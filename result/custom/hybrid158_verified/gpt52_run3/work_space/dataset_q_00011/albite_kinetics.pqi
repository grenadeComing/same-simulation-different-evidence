TITLE Albite kinetics with fixed-pressure H2S gas phase

SOLUTION 1
    temp 200
    pH 2 charge
    Fe(+3) 4e-3
    Fe(+2) 4e-3
    -water 1

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1
        -m  1
        -parms 1.0 10
    -steps 10 in 100
    -tol 1e-12

SELECTED_OUTPUT
    -file albite_kinetics.sel
    -reset false
USER_PUNCH
    -head step time_s albite_m_remaining albite_m_dissolved
10  PUNCH STEP_NO, TOTAL_TIME, KIN("Albite"), (1 - KIN("Albite"))
END
