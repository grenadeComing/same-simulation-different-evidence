SOLUTION 1
    temp 100
    pH   5
    pe   4
    units mmol/kgw
    C(4) 0.5
    Mn   1

RATES
Calcite_custom
-start
10 sa = PARM(1)
20 k  = PARM(2)
30 rate = k * sa
40 moles = rate * TIME
50 if (moles > M) then moles = M
60 SAVE moles
-end

KINETICS 1
    Calcite_custom
        -formula CaCO3 1
        -m0 1.0
        -m  1.0
        -parms 10.0 0.001
        -steps 10 in 100

SELECTED_OUTPUT
    -reset false
    -step true
    -si Aragonite
END
