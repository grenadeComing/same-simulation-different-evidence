TITLE Albite kinetics + H2S gas; count Si aqueous species at step 100
SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    Fe(3) 0.004
    Fe(2) 0.004
    -water 1
GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5
KINETICS 1
    Albite
        -m0 1
        -m  1
        -parms 1.0 10
        -tol 1e-12
    -steps 10 100
SELECTED_OUTPUT
    -reset false
    -high_precision true
    -time true
    -totals Si
USER_PUNCH
    -headings step n_Si_aq_species
10 PUNCH STEP_NO, SYS("TOTAL_SPECIES", "Si")
END
