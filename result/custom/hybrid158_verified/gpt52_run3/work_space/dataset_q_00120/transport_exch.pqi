TITLE 1D transport with exchange

SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 0
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

SELECTED_OUTPUT
    -file sel_step5.txt
    -reset false
USER_PUNCH
    -headings step cell CaX2
10 PUNCH STEP_NO, CELL_NO, MOL("CaX2")

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1
    -dispersivities 0
    -time_step 1
    -diffusion_coefficient 0
    -print_cells 1
    -print_frequency 1
    -punch_cells 1-10
    -punch_frequency 1
END
