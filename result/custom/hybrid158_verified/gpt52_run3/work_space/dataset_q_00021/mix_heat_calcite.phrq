TITLE Mix 50 mmol/kg DIC with 50 mmol/kg Ca (1:1) and heat 20 to 200C; allow calcite equilibrium
SOLUTION 1 DIC
    temp 20
    pH 7 charge
    units mmol/kgw
    C(4) 50
SOLUTION 2 Ca
    temp 20
    pH 7 charge
    units mmol/kgw
    Ca 50
MIX 1
    1 0.5
    2 0.5
EQUILIBRIUM_PHASES 1
    Calcite 0 0
REACTION_TEMPERATURE 1
    20 40 60 80 100 120 140 160 180 200
SELECTED_OUTPUT
    -reset false
    -high_precision true
    -temperature true
    -pH true
USER_PUNCH
    -headings T_C pH
    10 PUNCH TK-273.15, -LA("H+")
END
