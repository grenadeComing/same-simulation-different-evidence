TITLE Transport exchange problem
SOLUTION 0
    pH 7.0
    Ca 1.0
    Cl 2.0
SOLUTION 1
    pH 7.0
    Na 1.0
    Cl 1.0
EXCHANGE_SPECIES
    NaX = Na+ + X-
    log_k 0.0
    CaX2 = Ca+2 + 2X-
    log_k 0.3
EXCHANGE 1-10
    X 0.001
USE solution 0
USE exchange 1
TRANSPORT
    -cells               10
    -shifts              10
    -time_step           1
    -length              1
    -flow_direction      forward
    -boundary_conditions constant
    -initial_time        0
    -print_cells         1-10
    -print_frequency     1
    -punch_cells         1-10
    -punch_frequency     1
USER_PUNCH
    -head step cell CaX2
    10 PUNCH TOT("CaX2")/TOT("X")
END