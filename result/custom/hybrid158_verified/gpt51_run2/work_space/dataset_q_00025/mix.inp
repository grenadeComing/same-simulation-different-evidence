SOLUTION 1
    temp 20
    pH 7 charge
    units mmol/kgw
    C(4) 50

SOLUTION 2
    temp 20
    pH 7 charge
    units mmol/kgw
    Ca 50

MIX 1
    1 0.5
    2 0.5

EQUILIBRIUM_PHASES 1
    Calcite 0 0

REACTION_TEMPERATURE 1
    20 200 in 10 steps

SELECTED_OUTPUT
    -file mix.sel
    -reset false
    -temperature true
    -molalities Ca+2 CaCO3 CaHCO3+ CaOH+
    -step true
END