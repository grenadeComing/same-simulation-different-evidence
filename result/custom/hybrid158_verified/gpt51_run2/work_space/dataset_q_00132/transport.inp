TITLE Transport alkalinity problem
SOLUTION 0
    pH 7.0
    Ca 1.0
    Cl 2.0
SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0
SOLUTION 11
    pH 7.0
    Na 1.0
    Cl 1.0
EXCHANGE 1-10
    X- 0.001
TRANSPORT
    -cells               10
    -shifts              10
    -time_step           1
    -length              1
    -flow_direction      forward
    -boundary_conditions flux flux
    -print_cells         1-10
    -print_frequency     10
    -punch_cells         1-10
    -punch_frequency     10
    -inflow_solution     11
USER_PUNCH
    -headings Alkalinity
    10 PUNCH TOT("Alkalinity")
END
