SOLUTION 1
    temp 200
    pH 2 charge
    Fe(2) 4e-3
    Fe(3) 4e-3

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 1.0

KINETICS 1
    Albite
        -formula NaAlSi3O8 1
        -m0 1
        -m 1
        -parms 10 1.0
        -steps 1000

RATES
    Albite
    -start
    10 k = PARM(1)
    20 ssa = PARM(2)
    30 rate = k * ssa
    40 moles = rate * TIME
    50 SAVE moles
    -end

INCREMENTAL_REACTIONS true

SELECTED_OUTPUT
    -file albite_kinetics.sel
    -reset false
    -time true
    -totals Si

END