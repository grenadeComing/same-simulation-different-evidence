SOLUTION 1
    temp 200
    pH 2
    pe 4
    units mmol/kgw
    Cu 10
    Ba 5

KINETICS 1
    Calcite_kin
        -formula CaCO3 1
        -m0 1
        -parms 10 1.0
        -steps 10 1000

RATES
Calcite_kin
-start
10 k = PARM(1)
20 sA = PARM(2)
30 rate = k * sA
40 moles = rate * TIME
-end

SELECTED_OUTPUT
    -file calcite_cu_ba_fixed.sel
    -reset false
    -time true
    -step true
    -totals C(4) Cu(2)

END
