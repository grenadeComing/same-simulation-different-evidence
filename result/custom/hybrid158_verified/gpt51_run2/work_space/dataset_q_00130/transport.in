SOLUTION 0
    pH 7.0
    units mmol/kgw
    Ca 1.0
    Cl 2.0

SOLUTION 1-10
    pH 7.0
    units mmol/kgw
    Ca 1.0
    Cl 2.0

SOLUTION 11
    pH 7.0
    units mmol/kgw
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 0.001

EQUILIBRIUM_PHASES 1-10
    H2O(g) 0 0

TRANSPORT
    -cells               10
    -shifts              10
    -time_step           1
    -length              1
    -boundary_conditions flux flux
    -initial_time        0
    -print_cells         1-10
    -print_frequency     10
    -punch_cells         1-10
    -punch_frequency     10
    -dump                 dump10
    -dump_frequency       10

SELECTED_OUTPUT
    -file transport.sel
    -reset false
    -solution true
    -si     H2O(g)

END
