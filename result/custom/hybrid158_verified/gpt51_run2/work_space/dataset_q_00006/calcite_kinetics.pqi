SOLUTION 1
    temp      200
    pH        2 charge
    pe        4
    units     mmol/kgw
    Cu        10
    Ba        5

KINETICS 1
    Calcite_kin
        -formula   CaCO3 1
        -m0        1
        -parms     10 1.0
        -steps     1000 in 100 steps

RATES
    Calcite_kin
    -start
    10 k = PARM(1)
    20 ssa = PARM(2)
    30 m = MOL("Calcite_kin")
    40 rate = k * ssa
    50 moles = rate * TIME
    60 SAVE moles
    -end

SELECTED_OUTPUT
    -file calcite_kinetics.sel
    -reset false
    -time true
    -alkalinity true
    -step true
END