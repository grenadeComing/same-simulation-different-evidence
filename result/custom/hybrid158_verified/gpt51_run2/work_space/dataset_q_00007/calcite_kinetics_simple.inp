SOLUTION 1
    temp      200
    pH        2.0
    units     mmol/kgw

KINETICS 1
    Calcite_kin
        -formula   CaCO3 1
        -m0        1.0
        -parm      10 1.0
        -tol       1e-12
        -steps     100*10

RATES
    Calcite_kin
    -start
    10 k = PARM(1)
    20 ssa = PARM(2)
    30 rate = k * ssa
    40 moles = rate * TIME
    50 SAVE moles
    -end

SELECTED_OUTPUT
    -file calcite_kinetics_simple.sel
    -reset false
    -time      true
    -pH        true

END