SOLUTION 1
    temp      200
    pH        2.0 charge
    pe        4
    units     mmol/kgw
    Cu        10
    Ba        5

EQUILIBRIUM_PHASES 1
    Calcite   0   1

KINETICS 1
    Calcite_kin
        -formula   CaCO3 1
        -m0        1.0
        -parm      10 1.0
        -tol       1e-12
        -steps     10*10

RATES
    Calcite_kin
    -start
    10 k = PARM(1)
    20 ssa = PARM(2)
    30 rate = k * ssa
    40 moles = rate * TIME
    50 SAVE moles
    -end

SELECTED_OUTPUT
    -file calcite_kinetics.sel
    -reset false
    -time      true
    -pH        true

END