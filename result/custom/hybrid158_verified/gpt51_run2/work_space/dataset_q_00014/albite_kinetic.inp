SOLUTION 1
    temp 200
    pH 2 charge
    units mmol/kgw
    Fe(2) 4
    Fe(3) 4

GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    H2S(g) 5

KINETICS 1
    Albite
        -formula NaAlSi3O8 1
        -m0 1
        -parms 10 1.0
        -steps 1000 in 100 steps
        -cvode

RATES
    Albite
    -start
    10 k = PARM(1)
    20 ssa = PARM(2)
    30 rate = k * ssa
    40 moles = rate * TIME
    50 SAVE moles
    -end

SELECTED_OUTPUT
    -file albite_kinetic.sel
    -reset false
    -time true
    -totals Na Fe S(6) Al
    -molalities Fe+2 Fe+3 Na+ S(-2) H2S(aq) Al+3
    -pH true
    -step true

END
