SOLUTION 1
    temp 200
    pH 2 charge
    Fe(2) 4e-3
    Fe(3) 4e-3

GAS_PHASE 1
    -fixed_pressure true
    -pressure 5
    -volume 1
    H2S(g) 1

KINETICS 1
    Albite
    -formula Albite 1
    -m0 1
    -parms 10 1.0
    -steps 100*10

RATES
    Albite
    -start
    10 k = PARM(1)
    20 ssa = PARM(2)
    40 rate = k * ssa
    50 moles = rate * TIME
    60 SAVE moles
    -end

SELECTED_OUTPUT
    -file albite_h2s_sel.txt
    -reset false
    -time true
    -step true
    -molalities Ba+2

END
