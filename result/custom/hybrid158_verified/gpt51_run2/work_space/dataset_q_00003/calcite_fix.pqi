SOLUTION 1
    temp      200
    pH        2.0    charge
    pe        4
    units     mmol/kgw
    Cu        0.01
    Ba        0.005

RATES
Calcite_kin
-start
10 k = 10
20 A = 1.0
30 moles = k * A * TIME
40 SAVE moles
-end

KINETICS 1
    Calcite_kin
        -formula   CaCO3 1
        -m0        1
        -m        1
        -steps     10 in 100 steps
        -cvode false

SELECTED_OUTPUT
    -file calcite_selout.csv
    -reset false
    -time true
    -step true
    -pH true
END