TITLE 1D transport exchange problem
SOLUTION 0
    pH 7.0
    Ca 1.0
    Cl 2.0
SOLUTION 1
    pH 7.0
    Na 1.0
    Cl 1.0
EXCHANGE 1
    X- 0.001
USE solution 0
USE exchange 1
EQUILIBRIUM_PHASES 1
END
TRANSPORT
    -cells               10
    -shifts              10
    -time_step           1
    -flow_direction      forward
    -boundary_conditions influx
    -lengths             10*1
    -shifts              10
    -print_cells         1-10
    -print_frequency     1
    -punch_cells         1-10
    -punch_frequency     1
INVERSE_MODELING 1
END
SELECTED_OUTPUT
    -file transport.sel
    -reset false
    -solution true
    -molalities HCl
END
RUN_CELLS
    -cells 1-10
END
