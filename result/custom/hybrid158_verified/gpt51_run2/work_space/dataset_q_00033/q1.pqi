SOLUTION 1
    temp      100
    units     mmol/kgw
    pH        7 charge
    Ca        50

EQUILIBRIUM_PHASES 1
    Calcite   0 0
    Gypsum    0 0
    Aragonite 0 0

GAS_PHASE 1
    -fixed_pressure  true
    -temperature     25
    -pressure        16
    CO2(g)  1
    CH4(g)  5
    H2S(g) 10

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -molalities CH4
    -equilibrium_phases
    -gases
END
