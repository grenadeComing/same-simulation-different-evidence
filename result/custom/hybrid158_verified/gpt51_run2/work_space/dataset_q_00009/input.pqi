SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    units mmol/kgw
    Cu 10
    Ba 5
    C 0
    Ca 0

EQUILIBRIUM_PHASES 1
    CO2(g) -3 10

KINETICS 1
    Calcite
        -m0 1
        -m 1
        -parms 1.0 1.0
        -steps 10*10

SELECTED_OUTPUT
    -file selout.txt
    -reset false
    -time true
    -step true
    -si Witherite
END