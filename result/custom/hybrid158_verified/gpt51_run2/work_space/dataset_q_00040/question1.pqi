SOLUTION 1 Pure water at pH 3, 100C
    temp 100
    pH 3 charge
    pe 4
    units mol/kgw
    water 1

EQUILIBRIUM_PHASES 1
    Muscovite 0 10
    Kaolinite 0 10
    Dolomite 0 10
    Epsomite 0 10
    Fe(OH)3(a) 0 10
    Halite 0 10

SELECTED_OUTPUT
    -file selected1.txt
    -high_precision true
    -specific_conductance  true
END
