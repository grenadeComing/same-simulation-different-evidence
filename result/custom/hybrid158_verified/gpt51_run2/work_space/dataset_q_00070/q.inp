SOLUTION 1
    temp 150
    pH 7 charge
    pe 4
    units mol/kgw
    water 1 # 1 kg of water

GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    -temperature 150
    -volume 1
    CH4(g) 10
    CO2(g) 10
    NH3(g) 5

SELECTED_OUTPUT
    -reset false
    -solution 1
    -temperature true
    -ionic_strength true
    -totals CO2 C N(5) NH4 N(-3)
    -si CO2(g) CH4(g) NH3(g)
    -charge_balance true
    -alkalinity true
    -conductivity true
END
