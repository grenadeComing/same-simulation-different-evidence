SOLUTION 1
    temp 150
    pH 7 charge
    pe 4
    units mol/kgw
    water 1

GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    -temperature 150
    -volume 1
    CH4(g) 10
    CO2(g) 10
    NH3(g) 5

SELECTED_OUTPUT
    -file q2.sel
    -reset false
    -solution 1
    -temperature true
    -ionic_strength true
    -totals C N(5) N(-3)
    -si CO2(g) CH4(g) NH3(g)
    -charge_balance true
    -alkalinity true
END
USER_PUNCH
    -headings kappa
    10 PUNCH SC
END
