SOLUTION 1
    units mmol/kgw
    temp 200
    pH 2 charge
    Fe+2 4
    Fe+3 4

GAS_PHASE 1
    -fixed_pressure
    -temperature 200
    -pressure 5
    H2S(g) 5

KINETICS 1
    Albite
        -m0 1
        -m 1
        -parms 1.0 10
        -steps 10 100 step
        -cvode

SELECTED_OUTPUT
    -file albite_h2s.sel
    -reset false
    -time true
    -step true
    -gas H2S(g)
    -totals S(6) S(-2)
END
