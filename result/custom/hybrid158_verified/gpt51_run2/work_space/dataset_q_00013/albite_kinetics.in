SOLUTION 1
    temp 200
    pH 2 charge
    units mmol/kgw
    Fe 8 redox Fe(3)/Fe(2)
    -water 1
GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    H2S(g) 5
KINETICS 1
    Albite
        -formula NaAlSi3O8 1
        -m 1
        -m0 1
        -parms 10 1.0
    -steps 10*10
RATES
    Albite
    -start
    10 k = PARM(1)
    20 ssa = PARM(2)
    30 rate = k * ssa
    40 moles = rate * TIME
    50 SAVE moles
    -end
SELECTED_OUTPUT
    -file albite_kinetics.sel
    -reset false
    -high_precision true
    -time true
    -step true
    -totals Si
END