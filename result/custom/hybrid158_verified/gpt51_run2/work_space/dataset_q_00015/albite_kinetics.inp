SOLUTION 1
    temp 200
    pH 2 charge
    Fe(2) 4e-3
    Fe(3) 4e-3

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    -temperature 200
    -volume 1
    H2S(g) 1

KINETICS 1
    Albite
        -m0 1.0
        -parms 10 1.0
        -steps 1000 in 100 steps
        -cvode

RATES
    Albite
    -start
        10 k = PARM(1)
        20 ssa = PARM(2)
        30 rate = k * ssa
        40 moles = rate * (TIME - TIME_PREV)
        50 SAVE moles
    -end

SELECTED_OUTPUT
    -file albite_kinetics.sel
    -reset false
    -time true
    -step true
    -ionic_strength true

END
