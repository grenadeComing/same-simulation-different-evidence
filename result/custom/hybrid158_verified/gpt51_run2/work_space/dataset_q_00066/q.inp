SOLUTION 1 Pure water at 150C
    temp 150
    pH 7
    pe 4
    units mol/kgw

GAS_PHASE 1 Fixed gas mix at 1 atm
    -fixed_pressure true
    -temperature 150
    -pressure 1
    -volume 1
    CH4(g) 10
    CO2(g) 10
    NH3(g) 5

EQUILIBRIUM_PHASES 1
    CO2(g) 0 0
    CH4(g) 0 0
    NH3(g) 0 0

SELECTED_OUTPUT
    -reset false
    -species   C(4)
    -high_precision true
    -molalities   CO3-2 HCO3- CO2 CO2(aq) H2CO3 HCO3- CO3-2
    -description   true
END
