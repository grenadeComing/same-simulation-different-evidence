SOLUTION 0-10
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 11
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 0-10
    X 0.001

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 1
    -flow_direction forward
    -boundary_conditions flux flux
    -initial_time 0
    -print_cells 1
    -print_frequency 1
    -punch_cells 1
    -punch_frequency 1
    -dump "dump" 10
    -dump_frequency 10

SELECTED_OUTPUT
    -file trans.sel
    -reset false
    -step true
    -totals Ca
    -molalities Ca+2
