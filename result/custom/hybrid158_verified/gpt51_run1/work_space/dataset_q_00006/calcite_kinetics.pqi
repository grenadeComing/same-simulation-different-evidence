SOLUTION 1
    temp      200
    pH        2 charge
    pe        4
    units     mmol/kgw
    Cu        10
    Ba        5

KINETICS 1
    Calcite
        -m      1
        -m0     1
        -parms  10 1.0
        -steps  1000 in 100 steps
        -cvode

RATES
    Calcite
    -start
    10 k = PARM(1)
    20 ssa = PARM(2)
    30 m = MOL("Calcite")
    40 if (m <= 0) then goto 200
    50 rate = k * ssa
    60 moles = rate * TIME
    70 if (moles > m) then moles = m
    80 SAVE moles
    200 END
    -end

INCREMENTAL_REACTIONS true

SELECTED_OUTPUT
    -reset false
    -time true
    -alkalinity true
    -step true

END