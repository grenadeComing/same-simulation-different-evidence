SOLUTION 1
    temp 25
    pH 7 charge
    pe 4
EQUILIBRIUM_PHASES 1
    Pyrite 0 0.1
    Goethite 0 0
    Gypsum 0 0
GAS_PHASE 1
    -fixed_pressure true
    -pressure 1.0
    -temperature 25
    O2(g) -0.7
SELECTED_OUTPUT
    -file pyrite_sel.out
    -molalities Fe+3 Fe+3OH Fe+3(OH)2 Fe+3(OH)3- Fe+3(OH)4-2
USER_PUNCH
    -head Fe3_count
10 PUNCH TOT("Fe(3)")
END
