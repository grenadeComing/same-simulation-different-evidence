SOLUTION 1
    temp 150
    pH 7 charge
    pe 4
    units mol/kgw
    density 1

GAS_PHASE 1
    -fixed_pressure
    -temperature 150
    -pressure 1
    -volume 1
    CH4(g) 10
    CO2(g) 10
    NH3(g) 5

SELECTED_OUTPUT
    -reset false
    -solution  true
    -si        false
    -gas       true
    -equilibrium_phases true
    -totals    true
    -ionic_strength  true
    -temperature true
    -pH true
    -pe true

USER_PUNCH
    -headings sc
    10 PUNCH SC
END
