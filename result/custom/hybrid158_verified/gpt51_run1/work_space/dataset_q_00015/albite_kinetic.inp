SOLUTION 1
    temp 200
    pH 2 charge
    Fe(2) 4e-3
    Fe(3) 4e-3
    units mol/kgw

GAS_PHASE 1
    fixed_pressure
    -pressure 5
    H2S(g) 1.0

KINETICS 1
    Albite
        -m0 1.0
        -m  1.0
        -parms 1.0 10.0
        -time 1000 in 100

INCREMENTAL_REACTIONS true

SELECTED_OUTPUT
    -file albite_kinetic.sel
    -reset false
    -time true
    -step true
    -ionic_strength true
