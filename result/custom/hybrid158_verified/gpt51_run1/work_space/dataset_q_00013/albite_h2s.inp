SOLUTION 1
    temp 200
    pH 2 charge
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 1

KINETICS 1
    Albite
        -m0 1
        -m 1
        -parms 1.0 10.0
        -steps 10 seconds in 100 steps
        -bad_step_max 500

USER_PUNCH
    -headings step Si_tot
    -start
        10 PUNCH STEP_NO, TOT("Si")
    -end

SELECTED_OUTPUT
    -file albite_h2s.sel
    -high_precision true
    -user_punch true
