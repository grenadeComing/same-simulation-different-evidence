SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    Cu 0.01
    Ba 0.005

EQUILIBRIUM_PHASES 1
    Calcite 0 1

KINETICS 1
    Calcite
        -formula CaCO3 1
        -m0 1.0
        -m    1.0
        -parms k s
        -parms 10 1.0
        -tol 1e-12

RATES
    Calcite
    -start
        10 rem moles = m
        20 k = PARM(1)
        30 s = PARM(2)
        40 rate = k * s
        50 moles = rate * TIME
    -end

INCREMENTAL_REACTIONS true

TRANSPORT
    -cells 1
    -shifts 100
    -time_step 10
    -flow_direction forward
    -boundary_conditions closed

SELECTED_OUTPUT
    -file calcite_selout.txt
    -time true
    -pH true
    -step true
END