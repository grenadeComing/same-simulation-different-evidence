SOLUTION 1
    temp 20
    units mmol/kgw
    C(4) 50

SOLUTION 2
    temp 20
    units mmol/kgw
    Ca 50

MIX 1
    1 0.5
    2 0.5

REACTION_TEMPERATURE 1
    20 200 in 10 steps

EQUILIBRIUM_PHASES 1
    Calcite 0 0

SELECTED_OUTPUT
    -file mix_heating.sel
    -reset false
    -temperature true
    -step true
    -simulation true
USER_PUNCH
    -headings density
    10 PUNCH RHO
END
