SOLUTION 1 Pure water at 150C
    temp 150
    pH 7 charge
    pe 4
    redox pe
    units mol/kgw
    water 1

GAS_PHASE 1 Fixed P gas mix at 1 atm, 150C
    -fixed_pressure true
    -temperature 150
    -pressure 1
    -volume 1
    CH4(g) 10
    CO2(g) 10
    NH3(g) 5

EQUILIBRIUM_PHASES 1
    CO2(g) 0
    CH4(g) 0
    NH3(g) 0

SELECTED_OUTPUT
    -file q1.sel
    -reset false
    -alkalinity true
END
