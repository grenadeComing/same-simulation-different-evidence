SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 0
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 0.001

SELECTED_OUTPUT
    -file selout.txt
    -reset false
    -step true
    -state true
    -solution true
    -totals Ca

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1*10
    -time_step 1
    -initial_time 0
    -print_cells 1-10
    -print_frequency 1
    -punch_cells 1-10
    -punch_frequency 1
    -correct_disp false
    -diffc 0
