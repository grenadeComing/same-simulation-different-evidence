SOLUTION 1 River
    pH      6.0
    units   mg/L
    temp    25
    Cl      10

SOLUTION 2 Seawater
    pH      8.1
    units   mg/L
    temp    25
    Cl      19000

MIX 1
    1 0.7
    2 0.3

EQUILIBRIUM_PHASES 1
    H2O(g) 0 0

SELECTED_OUTPUT
    -reset false
    -si H2O(g)
    -high_precision true
END
