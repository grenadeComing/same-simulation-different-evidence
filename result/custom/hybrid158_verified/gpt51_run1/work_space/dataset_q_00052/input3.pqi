SOLUTION 1
    temp 100
    pH 5 charge
    units mmol/kgw
    Ba 100
EQUILIBRIUM_PHASES 1
    Talc     0 10
    Rhodochrosite 0 10
    Sepiolite 0 10
    Sepiolite(d) 0 10
    Pb(OH)2 0 10
SELECTED_OUTPUT
    -reset false
    -high_precision true
    -molalities true
USER_PUNCH
    -start
10 PUNCH TOT("C(4)")
    -end
END