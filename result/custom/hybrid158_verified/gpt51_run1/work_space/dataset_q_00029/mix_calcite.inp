SOLUTION 1
    temp 20
    pH 7 charge
    C(4) 0.05

SOLUTION 2
    temp 20
    pH 7 charge
    Ca 0.05

MIX 1
    1 1
    2 1

EQUILIBRIUM_PHASES 1
    Calcite 0 0

REACTION_TEMPERATURE 1
    20 200 in 10 steps

SELECTED_OUTPUT
    -reset false
    -temperature true
    -si Calcite
    -ionic_strength true
    -molalities Ca+2 CO3-2
    -activities Ca+2 CO3-2
    -pH true
    -totals Ca C(4)
    -high_precision true

USER_PUNCH
    -headings step temp log_IAP_Calcite
    10 PUNCH STEP_NO, TOT("temperature"), LOG10(ACT("Ca+2")*ACT("CO3-2"))

END