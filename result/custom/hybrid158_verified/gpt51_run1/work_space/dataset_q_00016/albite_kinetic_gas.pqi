SOLUTION 1
    temp 200
    pH 2 charge
    units mmol/kgw
    Fe(2) 4
    Fe(3) 4
KINETICS 1
    Albite
        -formula NaAlSi3O8 1
        -m0 1
        -parms 10 1.0
        -steps 10*1 90*10
RATES
    Albite
    -start
    10 k = PARM(1)
    20 ssa = PARM(2)
    30 rate = k * ssa
    40 moles = rate * TIME
    50 SAVE moles
    -end
GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 1.0
REACTION_TEMPERATURE 1
    200
SELECTED_OUTPUT
    -file albite_sel.out
    -reset false
    -step true
    -molalities Ba+2
END