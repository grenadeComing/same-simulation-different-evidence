SOLUTION 1
    temp      200
    pH        2    charge
    units     mol/kgw
    Fe(2)     4e-3
    Fe(3)     4e-3

EQUILIBRIUM_PHASES 1
    H2O(g)  0  5

KINETICS 1
    Albite
        -m0 1.0
        -m  1.0
        -parms 1.0 10.0
        -time 1000 in 100

GAS_PHASE 1
    -fixed_pressure
    -temperature 200
    -pressure 5
    H2S(g) 5

SELECTED_OUTPUT
    -file albite_h2s_fixpH.sel
    -reset false
    -time true
    -totals S
    -gas true
END