SOLUTION 1
    temp      200
    pH        2
    pe        4
    units     mmol/kgw
    Cu        10
    Ba        5

KINETICS 1
    Calcite
        -m0      1.0
        -m       1.0
        -parm    10 1.0
        -steps   10*10
        -cvode   false

RATES
Calcite
    -start
    10 k = PARM(1)
    20 ssa = PARM(2)
    30 area = ssa
    40 rate = k * area
    50 moles = rate * TIME
    60 SAVE moles
    -end

SELECTED_OUTPUT
    -file     calcite_kinetics2.sel
    -reset    false
    -time     true
    -step     true
    -molalities CO2

END
