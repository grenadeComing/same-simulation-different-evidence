SOLUTION 0-10
    pH 7.0
    pe 4.0
    units   mmol/kgw
    Ca 1.0
    Cl 2.0

SOLUTION 1
    pH 7.0
    pe 4.0
    units   mmol/kgw
    Na 1.0
    Cl 1.0

EXCHANGE 0-10
    X 0.001

EQUILIBRIUM_PHASES 0-10
    O2(g)  -0.7 10.0

TRANSPORT
    -cells                 10
    -shifts                10
    -time_step             1.0 days
    -lengths               1*1.0
    -flow_direction        forward
    -boundary_conditions   flux
    -dispersivity          0.0
    -correct_disp          false
    -initial_time          0.0 days
    -punch_cells           10
    -punch_frequency       10
    -print_cells           10
    -print_frequency       10

SELECTED_OUTPUT
    -file                  trans.sel
    -reset                 false
    -time                  true
    -distance              true
    -solution              true
    -pH                    true
    -pe                    true