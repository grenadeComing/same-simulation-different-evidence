SOLUTION 1
	pH 2 charge
	pe 4
	temp 200
	Cu 0.01
	Ba 0.005

EQUILIBRIUM_PHASES 1
	Calcite 0 1

KINETICS 1
	Calcite
		-m0 1
		-parm 10 1.0
		-tol 1e-12

RATES
Calcite
	-start
	10 k = PARM(1)
	20 ssa = PARM(2)
	30 m = M
	40 if (m le 0) then goto 200
	50 rate = k * ssa
	60 moles = rate * TIME
	70 SAVE moles
	200 end
	-end

INCREMENTAL_REACTIONS true
TRANSPORT
 -cells 1
 -shifts 100
 -time_step 10
 -lengths 1
 -flow_direction forward
 -print_cells 1
 -print_frequency 1

SELECTED_OUTPUT
 -file calcite_kinetics2.sel
 -reset false
 -time true
 -step true
 -kinetic_reactants Calcite
