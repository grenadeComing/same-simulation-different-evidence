SOLUTION 1
    temp      25
    pH        7    charge
    units     mg/L
    Ba        2.0
    S(6)      15.0

USE solution 1
REACTION_TEMPERATURE 1
    14 5

SELECTED_OUTPUT
    -reset false
    -solution 1
    -step true
    -temperature true
USER_PUNCH
    -head step temp sc
    10 PUNCH STEP_NO, TOT("temp"), SC
END