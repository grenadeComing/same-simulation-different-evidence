SOLUTION 0-10
    pH 7 charge
    Ca 1
    Cl 2

SOLUTION 11
    pH 7 charge
    Na 1
    Cl 1

EXCHANGE 0-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells               10
    -shifts              10
    -time_step           1
    -length              10
    -boundary_conditions flux flux
    -flow_direction      forward
    -initial_time        0
    -print_cells         1-10
    -print_frequency     1

END
