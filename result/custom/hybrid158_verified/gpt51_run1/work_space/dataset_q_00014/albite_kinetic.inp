SOLUTION 1
    temp 200
    pH 2 charge
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4

GAS_PHASE 1
    -fixed_pressure
    -temperature 200
    -pressure 5
    H2S(g) 5

KINETICS 1
    Albite
    -formula NaAlSi3O8 1
    -m0 1.0
    -m 1.0
    -parms 10 1.0
    -steps 10 100

RATES
    Albite
    -start
    10 k = PARM(1)
    20 ssa = PARM(2)
    30 rate = k * ssa
    40 moles = rate * TIME
    50 SAVE moles
    -end

SELECTED_OUTPUT
    -file albite_kinetic.sel
    -reset false
    -time true
    -totals Na Fe S Al
    -step true

END
