	-file  sel_o$$$1.prn
	-tot   Na  Ca  Cl
TRANSPORT
	-cells     10
	-shifts    10     1
	-output_frequency      1
	-selected_output_frequency      1
	-bcon       3     3
	-timest   1.00000e+00
	-diffc    3.00000e-10
	-tempr    2.00000e+00
	-correct_disp False
	-length
   1.000e+00   1.000e+00   1.000e+00   1.000e+00   1.000e+00   1.000e+00   1.000e+00   1.000e+00
   1.000e+00   1.000e+00
