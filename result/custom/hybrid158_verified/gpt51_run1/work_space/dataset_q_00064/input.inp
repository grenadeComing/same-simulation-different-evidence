SOLUTION 1 Pure water
    temp      150
    pH        7    charge
    pe        4
    redox     pe
    units     mol/kgw
    water     1 # kg

GAS_PHASE 1 Fixed
    -fixed_pressure      true
    -temperature         150
    -pressure            1.0
    -volume              1.0
    CH4(g)   10
    CO2(g)   10
    NH3(g)    5

USE solution 1
USE gas_phase 1

END
