SOLUTION 1
    temp 200
    pH 2 charge
    pe 4
    units mmol/kgw
    Cu 10
    Ba 5
    C 0
KINETICS 1
    Calcite
        -m0 1.0
        -m  1.0
        -parms 1.0 1.0
        -steps 10 in 100
        -tol 1e-12
SELECTED_OUTPUT
    -file calcite_kinetics.sel
    -molalities CO2
    -step true
END
