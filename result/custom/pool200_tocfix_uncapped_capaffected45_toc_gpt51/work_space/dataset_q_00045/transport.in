SOLUTION 0-10
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 11
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE_SPECIES
    X- = X-

EXCHANGE 0-10
    X 0.001

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 1
    -boundary_conditions flux flux
    -flow_direction forward
    -dispersivities 0
    -correct_disp false
    -print_cells 3
    -print_frequency 1

SELECTED_OUTPUT
    -file trans.sel
    -reset false
    -pH true
    -alkalinity true
    -time true
    -simulation true
    -state true

RUN_CELLS
    -cells 0-11