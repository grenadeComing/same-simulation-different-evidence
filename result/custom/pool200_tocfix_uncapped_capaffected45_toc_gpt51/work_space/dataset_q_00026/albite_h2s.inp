SOLUTION 1
    temp 200
    pH 2 charge
    Fe(3) 4e-3
    Fe(2) 4e-3

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 1

KINETICS 1
    Albite
        -m0 1
        -m 1
        -parms 1.0 10
        -steps 10 in 100
        -cvode

SELECTED_OUTPUT
    -file sel.out
    -reset false
    -time
    -step
    -molalities H4SiO4 SiO2(aq) H3SiO4- H2SiO4-2 HSiO3- SiO3-2
