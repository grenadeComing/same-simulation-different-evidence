SOLUTION 0-10
    pH 7
    Ca 1
    Cl 2

SOLUTION 11
    pH 7
    Na 1
    Cl 1

EXCHANGE 0-10
    X 0.001
    -equilibrate 1

EXCHANGE 11
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 1
    -boundary_conditions flux flux
    -flow_direction forward
    -dispersivities 0
    -print_cells 1-10
    -print_frequency 1
    -punch_cells 1-10
    -punch_frequency 1

SELECTED_OUTPUT
    -file transport.sel
    -reset false
    -time true
    -step true

USER_PUNCH
    -headings cell step CaX2
    10 PUNCH CELL_NO
    20 PUNCH SIM_NO
    30 PUNCH MOL("CaX2")
