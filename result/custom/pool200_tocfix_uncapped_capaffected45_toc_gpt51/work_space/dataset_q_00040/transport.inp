SOLUTION 0
    pH 7.0
    Na 1.0
    Cl 1.0

SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X- 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -lengths 1*10
    -dispersivities 0
    -boundary_conditions flux flux
    -print_cells 4
    -print_frequency 10
    -punch_cells 4
    -punch_frequency 10

SELECTED_OUTPUT
    -file selected.out
    -molalities HCl
    -reset false
