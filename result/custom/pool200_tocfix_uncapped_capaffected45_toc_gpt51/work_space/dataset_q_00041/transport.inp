TITLE 1D transport with exchange

SOLUTION 0
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 1
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 2-10
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 11
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X- 0.001

EQUILIBRIUM_PHASES 1-10
    H2O(g) 0 0

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 1
    -flow_direction forward
    -boundary_conditions flux flux
    -dispersivities 0
    -correct_disp true
    -initial_time 0
    -print_cells 4
    -print_frequency 1
    -punch_cells 4
    -punch_frequency 1
    -dump dump
    -dump_frequency 0
    -diffusion_coefficient 1e-9

SELECTED_OUTPUT
    -file selout.txt
    -reset false
    -time true
    -dist true
    -solution true
    -si H2O(g)
