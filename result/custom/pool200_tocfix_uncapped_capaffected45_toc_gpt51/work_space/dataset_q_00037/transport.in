SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
SOLUTION 0
    pH 7.0
    Na 1.0
    Cl 1.0
TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions flux flux
SELECTED_OUTPUT
    -file trans.sel
    -reset false
    -high_precision true
    -state true
    -simulation true
    -totals Na Ca Cl
END