SOLUTION 1
    temp 100
    pH 5 charge
    pe 4
    C(4) 0.5e-3
    Mn 1e-3

EQUILIBRIUM_PHASES 1
    CO2(g) -3 10

KINETICS 1
    Calcite
        -m0 1.0
        -m  1.0
        -parms 10.0 1.0
        -steps 10 in 100
        -tol 1e-12

SELECTED_OUTPUT
    -file calcite_kin.sel
    -reset false
    -time true
    -step true
    -totals C
