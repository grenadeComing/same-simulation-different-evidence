TITLE Na-Ca exchange transport

SOLUTION 0
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 11
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X- 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -lengths 1
    -boundary_conditions flux flux
    -dispersivities 0
    -correct_disp false
    -initial_time 0
    -print_cells 1
    -print_frequency 1
    -punch_cells 1
    -punch_frequency 1
    -flow_direction forward

BOUNDARY_CONDITIONS
    0 11

SELECTED_OUTPUT
    -file transport_sel.out
    -reset false
    -user_punch true

USER_PUNCH
    -head Na_molal
    10 PUNCH MOL("Na+")
