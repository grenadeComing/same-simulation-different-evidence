SOLUTION 0-10
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 0-10
    X 0.001
EQUILIBRIUM_PHASES 0-10
    O2(g) -0.7 0
SOLUTION 1
    pH 7.0
    Na 1.0
    Cl 1.0
EXCHANGE 1
    X 0.001
EQUILIBRIUM_PHASES 1
    O2(g) -0.7 0
TRANSPORT
    cells 10
    shifts 10
    time_step 1
    boundary_conditions flux flux
    length 1
    dispersivities 0
    correct_disp false
    initial_time 0
    print_cells 10
    print_frequency 1
    dump_frequency 0
    punch_cells 10
    punch_frequency 1
SELECTED_OUTPUT
    -file selected.out
    -reset false
    -pH true
    -pe true
    -totals Ca Cl Na
END