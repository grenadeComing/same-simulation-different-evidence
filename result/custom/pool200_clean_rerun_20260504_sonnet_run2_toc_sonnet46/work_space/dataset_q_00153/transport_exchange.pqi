TITLE 1D Transport with Ion Exchange

# Initial solution in all 10 cells: pH 7, Ca 1.0, Cl 2.0
SOLUTION 1-10
    pH      7.0
    Ca      1.0
    Cl      2.0

# Infilling (inlet) solution: pH 7, Na 1.0, Cl 1.0
SOLUTION 0
    pH      7.0
    Na      1.0
    Cl      1.0

# Define exchange sites for all 10 cells: 0.001 mol, equilibrate with solution 1
EXCHANGE 1-10
    X       0.001
    -equilibrate 1

TRANSPORT
    -cells          10
    -shifts         10
    -flow_direction forward
    -boundary_conditions flux flux
    -diffusion_coefficient 0
    -dispersivity      0
    -time_step         1
    -length            1

SELECTED_OUTPUT
    -file           transport_exchange.sel
    -reset          false
    -step
    -solution
    -totals         Na Ca Cl

USER_PUNCH
    -headings  step cell Na_X
    -start
10  PUNCH STEP_NO, CELL_NO, MOL("NaX")
    -end

END
