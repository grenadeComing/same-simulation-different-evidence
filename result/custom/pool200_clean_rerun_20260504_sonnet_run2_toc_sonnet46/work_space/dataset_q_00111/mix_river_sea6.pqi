SOLUTION 1  River Water
    pH      6.0
    temp    25.0
    units   mmol/kgw
    Cl      10.0
    Na      10.0   charge

SOLUTION 2  Seawater
    pH      8.1
    temp    25.0
    units   mmol/kgw
    Cl      19000.0
    Na      19000.0   charge

MIX 1
    1   0.7
    2   0.3

USER_PUNCH
    -headings  Spec_Cond
    -start
10  PUNCH SC
    -end

SELECTED_OUTPUT
    -file           mix_output6.sel
    -reset          false
    -solution       true
    -pH             true

END
