SOLUTION 1  River Water
    pH      6.0
    temp    25.0
    units   mg/L
    Cl      10.0

SOLUTION 2  Seawater
    pH      8.1
    temp    25.0
    units   mg/L
    Cl      19000.0
    Na      10500.0
    Mg      1350.0
    S(6)    2700.0   as SO4
    Ca      400.0
    K       380.0
    C       142.0    as HCO3
    Br      65.0
    Sr      8.0
    B       4.5
    F       1.3

MIX 1
    1   0.7
    2   0.3

USER_PUNCH
    -headings  Spec_Cond
    -start
10  PUNCH SC
    -end

SELECTED_OUTPUT
    -file           mix_output2.sel
    -reset          false
    -solution       true
    -pH             true

END
