TITLE Pure water equilibrated with CO2 at log PCO2 = -3.4

SOLUTION 1
    temp      25
    pH        7.0
    pe        4.0
    units     mol/L
    water     1.0  # kg

EQUILIBRIUM_PHASES 1
    CO2(g)    -3.4    10.0

SELECTED_OUTPUT
    -file     co2_equilibrium.sel
    -reset    false
    -pH       true
    -pe       true
    -si       CO2(g)

END
