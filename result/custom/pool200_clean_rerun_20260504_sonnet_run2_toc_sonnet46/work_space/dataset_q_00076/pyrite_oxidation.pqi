TITLE Pyrite Oxidation in Pure Water at 25C with Atmospheric O2

SOLUTION 1
    temp      25
    pH        7.0
    pe        4.0
    redox     pe
    units     mol/kgw
    density   1.0
    water     1.0  # kg

EQUILIBRIUM_PHASES 1
    O2(g)     -0.7   10.0    # Constant atmospheric O2 source (log PO2 = -0.7)
    Pyrite     0.0   0.1     # Allow up to 0.1 mol Pyrite to dissolve
    Goethite   0.0   0.0     # Allow Goethite to precipitate
    Gypsum     0.0   0.0     # Allow Gypsum to precipitate

SELECTED_OUTPUT
    -file     pyrite_oxidation.out
    -reset    false
    -pH       true
    -pe       true
    -totals   Fe  S  O(0)
    -molalities  Fe+2  Fe+3  FeOH+  Fe(OH)2+  Fe(OH)3  Fe(OH)4-  FeSO4  FeSO4+  FeHSO4+2  FeHSO4+
    -equilibrium_phases  Pyrite  Goethite  Gypsum  O2(g)
    -si       Pyrite  Goethite  Gypsum

USER_PUNCH
    -headings  Fe2_total_mol  Fe3_total_mol  Fe2_gt_Fe3
    -start
10  PUNCH TOT("Fe(2)")
20  PUNCH TOT("Fe(3)")
30  IF TOT("Fe(2)") > TOT("Fe(3)") THEN PUNCH "Fe2>Fe3" ELSE PUNCH "Fe3>=Fe2"
    -end

END
