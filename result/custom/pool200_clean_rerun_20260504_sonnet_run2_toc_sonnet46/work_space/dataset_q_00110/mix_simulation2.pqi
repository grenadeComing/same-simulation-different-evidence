TITLE River water and Seawater Mixing - with charge balance

# Solution 1: River water (pH 6.0, Cl 10 mg/L)
SOLUTION 1 River Water
    temp      25
    pH        6.0
    pe        4
    units     mg/L
    Cl        10
    Na        10   charge

# Solution 2: Seawater (pH 8.1, Cl 19000 mg/L)
SOLUTION 2 Seawater
    temp      25
    pH        8.1
    pe        4
    units     mg/L
    Cl        19000
    Na        19000  charge

# Mix 70% river water and 30% seawater
MIX 1
    1    0.7
    2    0.3

SAVE solution 3

SELECTED_OUTPUT
    -file           mix_output2.sel
    -reset          false
    -solution       true
    -pH             true
    -ionic_strength true
    -temperature    true

USER_PUNCH
    -headings Viscosity Density pH Ionic_Strength
    -start
10  PUNCH VISCOSITY
20  PUNCH RHO
30  PUNCH -LA("H+")
40  PUNCH MU
    -end

END
