SOLUTION 1
    temp      100
    pH        5
    pe        4
    units     mmol/kgw
    C(4)      0.5
    Mn        1.0

RATES
Calcite
-start
 1  rem Custom Calcite kinetic dissolution
 2  rem PARM(1) = specific surface area
 3  rem PARM(2) = rate constant
 10 si_cc = SI("Calcite")
 20 if (m <= 0 and si_cc < 0) then goto 200
 30 area = PARM(1) * (m/m0)^0.67
 40 rate = PARM(2) * area * (1 - 10^si_cc)
 50 moles = rate * time
 60 if (moles > m) then moles = m
 200 save moles
-end

KINETICS 1
Calcite
    -m0   1.0
    -m    1.0
    -parms 10.0  0.001
    -step 1000 in 100
    -tol  1e-8
    -bad_step_max 5000

SELECTED_OUTPUT
    -file   calcite_kinetic.out
    -reset  false
    -step   true
    -time   true
    -pH     true
    -pe     true
    -si     Calcite

END
