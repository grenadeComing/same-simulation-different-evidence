TITLE 1D Transport with Ion Exchange

# Initial solution: pH 7.0, Ca 1.0 mmol/L, Cl 2.0 mmol/L
SOLUTION 1-10
    pH      7.0
    Ca      1.0
    Cl      2.0
    units   mmol/L

# Infilling (inlet) solution: pH 7.0, Na 1.0 mmol/L, Cl 1.0 mmol/L
SOLUTION 0
    pH      7.0
    Na      1.0
    Cl      1.0
    units   mmol/L

# Exchange sites for all 10 cells, 0.001 moles, equilibrate with solution 1
EXCHANGE 1-10
    X       0.001
    -equilibrate 1

TRANSPORT
    -cells          10
    -shifts         10
    -flow_direction forward
    -boundary_conditions flux flux
    -diffusion_coefficient 0.0
    -dispersivity  0.0
    -time_step      1.0
    -length         1.0

SELECTED_OUTPUT
    -file           transport_exchange.sel
    -reset          false
    -step
    -solution
    -pH
    -si             H2(g)

USER_PUNCH
    -headings  Step Cell logIAP_H2g
    10 PUNCH SIM_NO, CELL_NO, SI("H2(g)") + 0  # SI = log(IAP/K), so log IAP = SI + log K
    # Actually we need log IAP directly
    # log IAP = SI + log K for H2(g)
    # H2(g) reaction: H2 = H2, log K = 0 at 25C
    # So log IAP = SI("H2(g)") + log K("H2(g)")
    # Let's just print SI and also log_act("H2")
    10 PUNCH SIM_NO, CELL_NO, SI("H2(g)"), LM("H2"), LA("H2")

END
