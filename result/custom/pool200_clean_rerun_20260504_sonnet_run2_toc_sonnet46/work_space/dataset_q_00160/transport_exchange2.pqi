TITLE 1D Transport with Ion Exchange - mol/L units

# Initial solution: pH 7.0, Ca 1.0 mol/L, Cl 2.0 mol/L
SOLUTION 1-10
    pH      7.0
    Ca      1.0
    Cl      2.0

# Infilling (inlet) solution: pH 7.0, Na 1.0 mol/L, Cl 1.0 mol/L
SOLUTION 0
    pH      7.0
    Na      1.0
    Cl      1.0

# Exchange sites for all 10 cells, 0.001 moles, equilibrate with solution 1
EXCHANGE 1-10
    X       0.001
    -equilibrate 1

TRANSPORT
    -cells          10
    -shifts         10
    -flow_direction forward
    -boundary_conditions flux flux
    -diffusion_coefficient 0.0
    -dispersivity  0.0
    -time_step      1.0
    -length         1.0

SELECTED_OUTPUT
    -file           transport_exchange2.sel
    -reset          false
    -step
    -solution
    -pH
    -si             H2(g)

USER_PUNCH
    -headings  Step Cell SI_H2g LA_H2
    10 PUNCH SIM_NO, CELL_NO, SI("H2(g)"), LA("H2")

END
