SOLUTION 1
    temp      100
    pH        5
    pe        4
    units     mmol/kgw
    C(4)      0.5
    Mn        1.0

RATES
Calcite
-start
10  si_cc = SI("Calcite")
20  rate = PARM(1) * PARM(2) * (1 - 10^si_cc)
30  moles = rate * TIME
40  SAVE moles
-end

KINETICS 1
Calcite
    -tol    1e-8
    -m0     1.0
    -m      1.0
    -parms  10.0   0.001
    -steps  1000 in 100

SELECTED_OUTPUT
    -file   calcite_kinetic2.out
    -reset  false
    -step   true
    -time   true
    -totals C Mn Ca

END
