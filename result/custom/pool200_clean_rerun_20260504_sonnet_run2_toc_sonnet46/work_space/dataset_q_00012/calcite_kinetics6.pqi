TITLE Calcite kinetic dissolution in acidic solution at 200C

SOLUTION 1
    temp      200
    pH        2.0
    pe        4.0
    units     mmol/kgw
    Cu        10.0
    Ba        5.0

KINETICS 1
Calcite
    -tol    1e-8
    -m0     1.0
    -m      1.0
    -parms  1.0  10.0
    -bad_step_max 500
    -step   1000 in 100

RATES
Calcite
-start
10  si_cc = SI("Calcite")
20  if (m <= 0 and si_cc < 0) then goto 200
30  area = PARM(1)
40  k = PARM(2)
50  rate = k * area * (1 - 10^si_cc)
60  if rate < 0 and m <= 0 then rate = 0
70  moles = rate * TIME
200 save moles
-end

SELECTED_OUTPUT
    -file   calcite_kinetics6.out
    -reset  false
    -step   true
    -time   true
    -pH     true
    -alkalinity true
    -totals Ca Ba Cu C

END
