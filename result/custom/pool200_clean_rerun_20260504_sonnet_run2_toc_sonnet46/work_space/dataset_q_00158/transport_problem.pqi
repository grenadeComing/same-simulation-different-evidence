TITLE 1D Transport Problem - 10 cells, 10 shifts

# Infilling (inlet) solution - solution 0
SOLUTION 0
    units   mol/kgw
    pH      7.0
    Na      1.0
    Cl      1.0

# Initial solution (fills all 10 cells) - solutions 1-10
SOLUTION 1-10
    units   mol/kgw
    pH      7.0
    Ca      1.0
    Cl      2.0

# Exchange sites for all 10 cells - equilibrate with solution 1
EXCHANGE 1-10
    CaX2    5e-4
    X       0.0

TRANSPORT
    cells           10
    shifts          10
    time_step       3600
    length          0.1
    dispersivity    0.0
    flow_direction  forward
    boundary_conditions  flux  flux

SELECTED_OUTPUT
    file            transport_out.sel
    reset           false
    solution        true

USER_PUNCH
    headings  SI_H2O_g
    10 PUNCH SI("H2O(g)")

END
