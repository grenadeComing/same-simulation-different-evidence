SOLUTION 1
    pH      7.0
    temp    25.0
    units   mol/L
    Ca      0.01
    Sr      0.01
    Alkalinity 0.04

SOLID_SOLUTION 1  Ca_Sr_carbonate
    -comp   Calcite     1e-10
    -comp   Strontianite 1e-10

SELECTED_OUTPUT
    -file   solid_solution4.out
    -pH     true
    -si     Calcite Strontianite
    -solid_solutions Ca_Sr_carbonate

END
