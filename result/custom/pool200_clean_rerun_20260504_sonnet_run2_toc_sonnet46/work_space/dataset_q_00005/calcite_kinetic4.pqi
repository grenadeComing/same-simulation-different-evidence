SOLUTION 1
    temp      100
    pH        5.0
    pe        4.0
    units     mmol/kgw
    C(4)      0.5
    Mn        1.0

RATES
Calcite
-start
10  SR_calcite = SR("Calcite")
20  if (SR_calcite >= 1) then goto 60
30  rate = PARM(1) * PARM(2) * (1 - SR_calcite)
40  moles = rate * TIME * 1e-3
50  goto 70
60  moles = 0
70  if (M <= 0) then moles = 0
80  SAVE moles
-end

KINETICS 1
Calcite
    -m0    1.0
    -m     1.0
    -parms 10.0  0.001
    -step  1000 in 100
    -tol   1e-8
    -bad_step_max 5000

SELECTED_OUTPUT
    -file   calcite_kinetic4.out
    -reset  false
    -step   true
    -time   true
    -pH     true
    -pe     true
    -si     Calcite

END
