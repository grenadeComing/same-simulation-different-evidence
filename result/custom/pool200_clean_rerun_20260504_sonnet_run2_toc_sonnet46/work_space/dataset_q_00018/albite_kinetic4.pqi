SOLUTION 1
    temp      200
    pH        2.0
    pe        4.0
    units     mmol/kgw
    Fe(2)     4.0
    Fe(3)     4.0

KINETICS 1
Albite
    -m0   1.0
    -m    1.0
    -parms 1.0  10.0
    -step 1000 in 100

EQUILIBRIUM_PHASES 1
    H2S(g)   0.699  10.0

SELECTED_OUTPUT
    -file     albite_kinetic4.out
    -reset    false
    -step     true
    -pe       true
    -time     true

END
