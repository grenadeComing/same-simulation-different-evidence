TITLE Sulfuric acid addition to pure water - cumulative steps

# Initial pure water at pH 7.0
SOLUTION 1
    pH      7.0
    temp    25.0
    units   mol/L
    water   1.0  # 1 kg of water

# Add all steps of H2SO4 in one REACTION block
# Steps: 0.001, 0.005, 0.01, 0.05, 0.1 mol
# Total = 0.166 mol H2SO4
REACTION 1
    H2SO4   1.0
    0.001  0.006  0.016  0.066  0.166

SELECTED_OUTPUT
    -file   selected.out
    -reset  false
    -step   true
    -pH     true

END
