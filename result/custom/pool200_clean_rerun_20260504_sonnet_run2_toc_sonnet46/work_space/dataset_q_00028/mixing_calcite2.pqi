# Mixing of two solutions 1:1, then heating from 20°C to 200°C in 10 steps
# Solution 1: 50 mmol/kg dissolved inorganic carbon (DIC)
# Solution 2: 50 mmol/kg calcium
# Steps: 10 steps means 10 temperature points (not 11)
# If 10 steps from 20 to 200: step size = (200-20)/9 = 20°C
# Points: 20, 40, 60, 80, 100, 120, 140, 160, 180, 200

SOLUTION 1  DIC solution
    temp      20
    pH        7.0 charge
    units     mmol/kgw
    C(4)      50

SOLUTION 2  Calcium solution
    temp      20
    pH        7.0 charge
    units     mmol/kgw
    Ca        50

# Mix 1:1
MIX 1
    1   0.5
    2   0.5

# Save the mixed solution as solution 3
SAVE SOLUTION 3

END

# Now use the mixed solution and heat it from 20 to 200°C in 10 steps
# with calcite equilibrium
# 10 steps with 20°C increment: 20, 40, 60, 80, 100, 120, 140, 160, 180, 200

USE SOLUTION 3

EQUILIBRIUM_PHASES 1
    Calcite   0.0   0.0

REACTION_TEMPERATURE 1
    20.0  40.0  60.0  80.0  100.0  120.0  140.0  160.0  180.0  200.0

SELECTED_OUTPUT
    -file   mixing_calcite2.sel
    -reset  false
    -temperature  true
    -pH           true
    -si           Calcite
    -equilibrium_phases  Calcite

END
