# Simulation: Mix two solutions 1:1, then heat from 20°C to 200°C in 10 steps
# Solution 1: 50 mmol/kg dissolved inorganic carbon (DIC)
# Solution 2: 50 mmol/kg calcium
# Account for calcite precipitation/dissolution
# 10 discrete steps from 20 to 200°C

# Pure water solutions with specified components
SOLUTION 1
    temp      20
    pH        7.0 charge
    units     mmol/kgw
    C(4)      50.0

SOLUTION 2
    temp      20
    pH        7.0 charge
    units     mmol/kgw
    Ca        50.0

# Mix 1:1 and equilibrate with calcite, then heat in steps
MIX 1
    1   0.5
    2   0.5

EQUILIBRIUM_PHASES 1
    Calcite   0.0   0.0

REACTION_TEMPERATURE 1
    20.0  40.0  60.0  80.0  100.0  120.0  140.0  160.0  180.0  200.0

SELECTED_OUTPUT
    -file   mixing_heating3.out
    -reset  false
    -temperature    true
    -ionic_strength true
    -equilibrium_phases  Calcite

END
