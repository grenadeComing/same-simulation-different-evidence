TITLE Equilibration of pure water with fixed-pressure gas phase at 150C

SOLUTION 1
    temp    150
    pH      7
    pe      4
    units   mol/kgw
    water   1 kg

GAS_PHASE 1
    -fixed_pressure
    -pressure 1.0
    -temperature 150
    -volume 1
    CH4(g)  10
    CO2(g)  10
    NH3(g)  5

SELECTED_OUTPUT
    -file   sim_gas_equilibrium.out
    -reset  false
    -totals N C

END
