SOLUTION 1
    pH      7.0
    temp    25.0
    units   mmol/kgw
    Ca      1.0
    Sr      1.0
    Alkalinity 4.0

SOLID_SOLUTIONS 1
    Ca_Sr_carbonate
        -comp Calcite 0.0
        -comp Strontianite 0.0

SELECTED_OUTPUT
    -file solid_solution_sim5.pqo
    -saturation_indices Calcite Strontianite

END
