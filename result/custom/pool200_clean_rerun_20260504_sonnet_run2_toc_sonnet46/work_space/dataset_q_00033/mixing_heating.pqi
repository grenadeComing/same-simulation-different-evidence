# Simulation: Mix two solutions 1:1, then heat from 20°C to 200°C in 10 steps
# Solution 1: 50 mmol/kg dissolved inorganic carbon (DIC)
# Solution 2: 50 mmol/kg calcium
# Equilibrium with calcite during heating

SOLUTION 1  DIC solution
    temp      20
    pH        7.0 charge
    units     mmol/kgw
    C(4)      50

SOLUTION 2  Calcium solution
    temp      20
    pH        7.0 charge
    units     mmol/kgw
    Ca        50

# Mix 1:1
MIX 1
    1   0.5
    2   0.5

SAVE SOLUTION 3

END

# Now heat the mixed solution from 20 to 200°C in 10 steps
# Steps: 20, 38, 56, 74, 92, 110, 128, 146, 164, 182, 200
# 10 discrete steps means 10 intervals: 20 to 200 = 180°C range / 10 = 18°C per step
# Temperatures: 20, 38, 56, 74, 92, 110, 128, 146, 164, 182, 200

USE SOLUTION 3

EQUILIBRIUM_PHASES 1
    Calcite   0.0  10.0

REACTION_TEMPERATURE 1
    20.0  38.0  56.0  74.0  92.0  110.0  128.0  146.0  164.0  182.0  200.0

SELECTED_OUTPUT
    -file   mixing_heating.out
    -reset  false
    -temperature  true
    -si   Calcite Aragonite
    -totals  Ca C(4)

END
