# Simulation: Add sulfuric acid in steps to pure water at pH 7.0
# Using REACTION with cumulative steps, pe fixed

SOLUTION 1  Pure water at pH 7.0
    pH      7.0
    pe      4.0
    temp    25.0
    units   mol/L
    -water  1.0

# Add all steps cumulatively: 0.001, 0.005, 0.01, 0.05, 0.1
# Total = 0.166 mol H2SO4
REACTION 1
    H2SO4   1.0
    0.166

SELECTED_OUTPUT
    -file   selected_output6.txt
    -reset  false
    -pH     true
    -pe     true
    -totals S

END
