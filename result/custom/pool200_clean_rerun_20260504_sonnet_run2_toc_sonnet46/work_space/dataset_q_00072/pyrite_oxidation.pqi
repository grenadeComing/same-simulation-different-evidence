TITLE Pyrite Oxidation in Pure Water at 25C

SOLUTION 1
    temp      25
    pH        7.0
    pe        4
    redox     pe
    units     mol/kgw
    density   1
    water     1 # kg

EQUILIBRIUM_PHASES 1
    O2(g)     -0.7    10      # Constant atmospheric O2 source
    Pyrite    0.0     0.1     # Allow up to 0.1 mol pyrite to react
    Goethite  0.0     0.0     # Allow Goethite to precipitate
    Gypsum    0.0     0.0     # Allow Gypsum to precipitate

SELECTED_OUTPUT
    -file     pyrite_output.sel
    -reset    false
    -pH       true
    -pe       true
    -totals   Fe S
    -molalities Fe+3 Fe(OH)+2 Fe(OH)2+ Fe(OH)3 Fe(OH)4- FeSO4+ FeHSO4+2 FeF+2 FeF2+ FeCl+2 FeCl2+

END
