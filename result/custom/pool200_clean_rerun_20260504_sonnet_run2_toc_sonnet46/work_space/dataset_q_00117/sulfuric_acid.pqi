TITLE Sulfuric acid addition to pure water in cumulative steps

# Initial solution: pure water at pH 7.0
SOLUTION 1
    pH 7.0
    temp 25
    units mol/L

# Add H2SO4 in steps: 0.001, 0.005, 0.01, 0.05, 0.1 moles
# Total = 0.001 + 0.005 + 0.01 + 0.05 + 0.1 = 0.166 moles
# Use REACTION with multiple steps
REACTION 1
    H2SO4  1
    0.001  0.006  0.016  0.066  0.166

SELECTED_OUTPUT
    -file sulfuric_acid.sel
    -reset false
    -step true
    -pH true
    -ionic_strength true
    -totals S(6)

END
