# Mixing of two solutions in 1:1 proportions
# Solution 1: 50 mmol/kg dissolved inorganic carbon (DIC)
# Solution 2: 50 mmol/kg calcium
# Heated from 20°C to 200°C in 10 discrete steps
# with calcite equilibrium

# Solution 1: 50 mmol/kg DIC - charge balanced with Na
SOLUTION 1
    temp      20
    pH        7   charge
    units     mmol/kgw
    C(4)      50

# Solution 2: 50 mmol/kg Ca - charge balanced with Cl
SOLUTION 2
    temp      20
    pH        7   charge
    units     mmol/kgw
    Ca        50

SELECTED_OUTPUT 1
    -file   mixing_calcite2.out
    -reset  false
    -temperature  true
    -pH           true
    -si           Calcite

END

# Mix 1:1 and equilibrate with calcite
# Temperature steps: 20, 40, 60, 80, 100, 120, 140, 160, 180, 200
# That's 10 steps from 20 to 200 with step size of 20

MIX 1
    1   0.5
    2   0.5

EQUILIBRIUM_PHASES 1
    Calcite   0   0

REACTION_TEMPERATURE 1
    20  40  60  80  100  120  140  160  180  200

SELECTED_OUTPUT 2
    -file   mixing_calcite2b.out
    -reset  false
    -temperature  true
    -pH           true
    -si           Calcite

END
