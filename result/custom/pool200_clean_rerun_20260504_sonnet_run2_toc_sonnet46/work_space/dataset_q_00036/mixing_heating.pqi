# Simulation: Mix two solutions 1:1, then heat from 20°C to 200°C in 10 steps
# Solution 1: 50 mmol/kg dissolved inorganic carbon (DIC)
# Solution 2: 50 mmol/kg calcium
# Account for calcite precipitation/dissolution

SOLUTION 1  # 50 mmol/kg DIC
    temp      20
    pH        7.0 charge
    units     mmol/kgw
    C(4)      50

SOLUTION 2  # 50 mmol/kg Ca
    temp      20
    pH        7.0 charge
    units     mmol/kgw
    Ca        50

# Mix 1:1
MIX 1
    1   0.5
    2   0.5

# Save the mixed solution as solution 3
SAVE solution 3

END

# Now heat the mixed solution from 20°C to 200°C in 10 steps
# with calcite equilibrium
# Steps: 20, 38, 56, 74, 92, 110, 128, 146, 164, 182, 200
# That's 10 increments of 18°C each (20 to 200 = 180°C range, 10 steps)

USE solution 3

EQUILIBRIUM_PHASES 1
    Calcite   0   0   # SI target = 0, initial amount = 0 mol

REACTION_TEMPERATURE 1
    20   38   56   74   92   110   128   146   164   182   200

SELECTED_OUTPUT
    -file   mixing_heating.sel
    -reset  false
    -temperature   true
    -si    Calcite
    -activities    Ca+2  CO3-2

END
