SOLUTION 1
    temp      100
    pH        5
    units     mmol/kgw
    Ba        100

EQUILIBRIUM_PHASES 1
    Talc             0  10
    Rhodochrosite    0  10
    Sepiolite        0  10
    Sepiolite(d)     0  10
    Pb(OH)2          0  10

SELECTED_OUTPUT
    -file   result.out
    -reset  false
    -solution

USER_PUNCH
    -headings C_species_count
    -start
10 count = 0
20 FOR i = 1 TO TOTSPECIES
30   sp$ = SPECIESNAME(i)
40   IF ELEMENT(sp$, "C") > 0 THEN count = count + 1
50 NEXT i
60 PUNCH count
    -end

END
