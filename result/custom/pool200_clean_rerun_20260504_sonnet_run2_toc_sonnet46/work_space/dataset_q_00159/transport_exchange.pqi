
# 1D Transport problem with 10 cells, 10 shifts
# Initial solution: pH 7.0, Ca 1.0, Cl 2.0
# Infilling solution: pH 7.0, Na 1.0, Cl 1.0
# Exchange: 0.001 mol X, equilibrated with solution 1

SOLUTION 0   # Infilling solution (boundary)
    pH      7.0
    Na      1.0
    Cl      1.0
    units   mmol/kgw

SOLUTION 1-10   # Initial solution in all 10 cells
    pH      7.0
    Ca      1.0
    Cl      2.0
    units   mmol/kgw

EXCHANGE 1-10
    X       0.001
    -equilibrate 1

SELECTED_OUTPUT
    -file   transport_exchange.sel
    -reset  false
    -step   true
    -solution true
    -si     Halite

TRANSPORT
    -cells          10
    -shifts         10
    -flow_direction forward
    -boundary_conditions flux flux
    -diffusion_coefficient 0.0
    -dispersivity  0.0
    -time_step     1.0
    -punch_cells   1-10
    -punch_frequency 10

END
