TITLE Mix river water (70%) and seawater (30%)

# Solution 1: River water, pH 6.0, Cl 10 mg/L
SOLUTION 1 River Water
    temp      25
    pH        6.0
    pe        4
    units     mg/L
    Cl        10

# Solution 2: Seawater, pH 8.1, Cl 19000 mg/L
SOLUTION 2 Seawater
    temp      25
    pH        8.1
    pe        4
    units     mg/L
    Cl        19000

# Mix 70% river water and 30% seawater
MIX 1
    1    0.7
    2    0.3

SAVE SOLUTION 3

END

# Equilibrate the mixed solution
USE SOLUTION 3

SELECTED_OUTPUT
    -file           mix_output.sel
    -reset          false
    -saturation_indices   H2O(g)

END
