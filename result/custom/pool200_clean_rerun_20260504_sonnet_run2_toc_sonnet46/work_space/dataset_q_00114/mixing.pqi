TITLE Mixing River Water and Seawater

# Solution 1: River Water - pH 6.0, Cl 10 mg/L
SOLUTION 1 River Water
    pH      6.0
    temp    25.0
    Cl      10.0   # mg/L (ppm)

# Solution 2: Seawater - pH 8.1, Cl 19000 mg/L
SOLUTION 2 Seawater
    pH      8.1
    temp    25.0
    Cl      19000.0   # mg/L (ppm)

# Mix 70% river water and 30% seawater
MIX 1
    1   0.7
    2   0.3

SAVE SOLUTION 3

END

# Now analyze the mixed solution
USE SOLUTION 3

SELECTED_OUTPUT
    -file           mixing_output.sel
    -reset          false
    -molalities     HCl

END
