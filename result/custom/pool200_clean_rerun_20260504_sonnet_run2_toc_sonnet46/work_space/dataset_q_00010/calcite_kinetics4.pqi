TITLE Calcite kinetic dissolution at 200C with Cu and Ba - custom rate

SOLUTION 1
    temp      200
    pH        2.0
    pe        4.0
    units     mmol/kgw
    Cu        10.0
    Ba        5.0
    -water    1.0  # kg

RATES
Calcite
    -start
10  si_cal = SI("Calcite")
20  if (si_cal >= 0) then goto 50
30  rate = PARM(2) * PARM(1) * (m/m0)^0.6 * (1 - 10^si_cal)
40  goto 60
50  rate = 0
60  moles = rate * time
70  save moles
    -end

KINETICS 1
Calcite
    -tol    1e-8
    -m0     1.0
    -m      1.0
    -parms  1.0  10.0
    -step   1000 in 100

INCREMENTAL_REACTIONS true

SELECTED_OUTPUT
    -file   calcite_kinetics4.out
    -reset  false
    -step
    -time
    -pH
    -pe
    -si     Witherite Calcite

END
