SOLUTION 1
    pH      7.0
    temp    25.0
    Ca      10.0   # mmol/L = 0.01 mol/L
    Sr      10.0   # mmol/L = 0.01 mol/L
    Alkalinity 40.0 # mmol/L = 0.04 mol/L

SOLID_SOLUTION 1  Ca_Sr_carbonate
    -comp  Calcite      0.0
    -comp  Strontianite 0.0
    -Gugg_nondimensional  0.0  0.0

SELECTED_OUTPUT
    -file   solid_solution4.out
    -reset  false
    -totals C(4)
    -solid_solution Ca_Sr_carbonate

END
