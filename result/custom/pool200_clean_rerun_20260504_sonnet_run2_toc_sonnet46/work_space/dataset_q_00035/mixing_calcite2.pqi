# Mixing of two solutions 1:1, then heating from 20°C to 200°C in 10 steps
# Solution 1: 50 mmol/kg dissolved inorganic carbon
# Solution 2: 50 mmol/kg calcium

SOLUTION 1
    temp      20
    pH        7   charge
    units     mmol/kgw
    C(4)      50

SOLUTION 2
    temp      20
    pH        7   charge
    units     mmol/kgw
    Ca        50

# Mix 1:1
MIX 1
    1   0.5
    2   0.5

# Save the mixed solution as solution 3
SAVE SOLUTION 3

END

# Now use the mixed solution and heat from 20 to 200°C in 10 steps
USE SOLUTION 3

EQUILIBRIUM_PHASES 1
    Calcite   0   0

REACTION_TEMPERATURE 1
    20   200   in 10 steps

SELECTED_OUTPUT
    -file     mixing_calcite2.sel
    -reset    false
    -temperature  true
    -si           Calcite

USER_PUNCH
    -headings  Density
    -start
10  PUNCH RHO
    -end

END
