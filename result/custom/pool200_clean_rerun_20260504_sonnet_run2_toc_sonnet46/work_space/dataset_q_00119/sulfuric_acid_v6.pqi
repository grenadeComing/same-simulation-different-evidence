TITLE Stepwise addition of H2SO4 to pure water at pH 7.0 - single simulation

# Initial solution: pure water at pH 7.0
SOLUTION 1
    temp      25
    pH        7.0
    pe        4.0
    units     mol/L
    water     1.0 # kg

# Add H2SO4 in steps: 0.001, 0.005, 0.01, 0.05, 0.1 moles
# Total = 0.166 moles
REACTION 1
    H2SO4     1.0
    0.001  0.005  0.01  0.05  0.1

SELECTED_OUTPUT
    -file     sulfuric_acid_v6.sel
    -reset    false
    -step     true
    -pH       true
    -pe       true
    -si       H2(g)

END
