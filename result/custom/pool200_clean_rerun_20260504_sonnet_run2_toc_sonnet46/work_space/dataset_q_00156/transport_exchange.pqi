
# 1D Transport with Ion Exchange
# Initial solution: pH 7.0, Ca 1.0 mmol/L, Cl 2.0 mmol/L
# Infilling solution: pH 7.0, Na 1.0 mmol/L, Cl 1.0 mmol/L
# 10 cells, 10 shifts, 0.001 mol exchange sites per cell

SOLUTION 0   # Infilling solution (inlet)
    pH      7.0
    Na      1.0
    Cl      1.0
    units   mmol/L

SOLUTION 1-10  # Initial solution in all 10 cells
    pH      7.0
    Ca      1.0
    Cl      2.0
    units   mmol/L

EXCHANGE 1-10
    -equilibrate 1
    X        0.001

TRANSPORT
    -cells          10
    -shifts         10
    -flow_direction forward
    -boundary_conditions flux flux
    -diffusion_coefficient 0.0
    -dispersivity  0.0
    -time_step      1.0
    -length         1.0
    -print_cells    4
    -print_frequency 10

END
