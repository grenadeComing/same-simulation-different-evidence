TITLE River water and seawater mixing (0.7:0.3) - minimal solutions

# Solution 1: River water, pH 6.0, Cl 10 mg/L
SOLUTION 1 River Water
    temp      25
    pH        6.0
    pe        4.0
    units     mg/L
    Cl        10.0

# Solution 2: Seawater, pH 8.1, Cl 19000 mg/L
SOLUTION 2 Seawater
    temp      25
    pH        8.1
    pe        4.0
    units     mg/L
    Cl        19000.0

# Mix 70% river water and 30% seawater
MIX 1
    1    0.7
    2    0.3

SAVE SOLUTION 3

END

USE SOLUTION 3

SELECTED_OUTPUT
    -file mix_output3.sel
    -reset false
    -si O2(g)

USER_PUNCH
    -headings logIAP_O2g SI_O2g
    -start
    10 PUNCH LOG10(ACT("O2"))
    20 PUNCH SI("O2(g)")
    -end

END
