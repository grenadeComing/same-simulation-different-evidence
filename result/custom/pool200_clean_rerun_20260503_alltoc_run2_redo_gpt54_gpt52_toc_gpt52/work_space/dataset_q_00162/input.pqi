TITLE 1D transport 10 cells 10 shifts with exchange
SOLUTION 0  # inflow
    pH 7.0
    Na 1.0
    Cl 1.0
SOLUTION 1-10  # initial
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
    -equilibrate 1
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1
    -time_step 1
    -diffusion_coefficient 0
    -dispersivities 0
    -punch_frequency 10
SELECTED_OUTPUT
    -file selected.csv
    -reset false
USER_PUNCH
    -headings step sol3_alk
10 PUNCH STEP_NO, ALK(3)
END
