TITLE Equilibrate pure water with fixed-pressure gas mix at 150C
SOLUTION 1
    temp 150
    pH 7 charge
    pe 4
    -water 1
GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    -temperature 150
    CH4(g)  0.4
    CO2(g)  0.4
    NH3(g)  0.2
SELECTED_OUTPUT
    -file sel.tsv
    -reset false
USER_PUNCH
    -headings C4_species_count
10 PUNCH TOT("C(4)")
END
