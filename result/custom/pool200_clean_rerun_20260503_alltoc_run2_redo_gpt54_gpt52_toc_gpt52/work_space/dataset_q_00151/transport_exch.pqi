TITLE 1D transport with exchange; query specific conductance at cell 8, step 4
SOLUTION 0  Infilling
    pH 7.0
    Na 1.0
    Cl 1.0
SOLUTION 1-10  Initial
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
    -equilibrate 1
SELECTED_OUTPUT
    -file selected.csv
    -reset false
    -high_precision true
USER_PUNCH
    -headings step cell sc
10 IF (TRANSPORT_STEP_NO = 4 AND CELL_NO = 8) THEN PUNCH TRANSPORT_STEP_NO, CELL_NO, SC
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -dispersivities 0
    -correct_disp true
END
