SOLUTION 1 DIC
    temp 20
    pH 7 charge
    units mmol/kgw
    C(4) 50
SOLUTION 2 CA
    temp 20
    pH 7 charge
    units mmol/kgw
    Ca 50
MIX 1
    1 0.5
    2 0.5
EQUILIBRIUM_PHASES 1
    Calcite 0 0
REACTION_TEMPERATURE 1
    20 200 in 10
SELECTED_OUTPUT
    -reset false
    -high_precision true
USER_PUNCH
    -headings step temp n_Ca_aq_species
-start
10 PUNCH STEP_NO, TC, (MOL("Ca+2")>0) + (MOL("CaHCO3+")>0) + (MOL("CaCO3")>0) + (MOL("CaOH+")>0) + (MOL("CaSO4")>0) + (MOL("CaCl+")>0)
-end
END
