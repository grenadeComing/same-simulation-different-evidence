TITLE 150C water + fixed-pressure gas (CH4/CO2/NH3)
SOLUTION 1
    temp 150
    pH 7 charge
    pe 4
    redox pe
    units mol/kgw
    water 1

GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    -volume 1
    -temperature 150
    CH4(g)  10
    CO2(g)  10
    NH3(g)  5

SELECTED_OUTPUT
    -file selected.csv
    -reset false
USER_PUNCH
    -headings dCH4
10 PUNCH GAS("CH4(g)")
END
