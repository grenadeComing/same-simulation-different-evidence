SOLUTION 0  Infilling
    pH 7.0
    Na 1.0
    Cl 1.0

SOLUTION 1-10 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1
    -dispersivities 0
    -correct_disp true
    -diffusion_coefficient 0
    -punch_cells 3

SELECTED_OUTPUT
    -file sel.txt
    -reset false
    -high_precision true

USER_PUNCH
    -headings step logIAP_H2g
10 PUNCH STEP_NO, SI("H2(g)")

END
