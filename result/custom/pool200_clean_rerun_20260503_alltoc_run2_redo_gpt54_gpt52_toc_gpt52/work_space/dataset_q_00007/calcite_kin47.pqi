SOLUTION 1
    temp 100
    pH 5
    pe 4
    units mmol/kgw
    C(4) 0.5
    Mn 1

KINETICS 1
    Calcite
        -m0 1
        -m  1
        -parms 10.0 0.001
        -steps 10 in 100

SELECTED_OUTPUT
    -file sel.txt
    -reset false
    -user_punch true

USER_PUNCH
    -head step time SI_Aragonite
    10 PUNCH STEP_NO, TOTAL_TIME, SI("Aragonite")
END
