TITLE 1D transport, exchange; find SI H2O(g) at cell 4 step 10

SOLUTION 0  Initial solution
    pH 7.0
    temp 25
    Ca 1.0
    Cl 2.0

SOLUTION 1-10  Initial in all cells
    pH 7.0
    temp 25
    Ca 1.0
    Cl 2.0

SOLUTION 11  Infilling solution
    pH 7.0
    temp 25
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

SELECTED_OUTPUT
    -reset false
    -high_precision true
USER_PUNCH
    -headings step cell si_h2og
    10 PUNCH STEP_NO, CELL_NO, SI("H2O(g)")

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1
    -time_step 1
    -diffusion_coefficient 0
    -dispersivities 0
    -correct_disp true
    -print_cells 4
    -print_frequency 1
    -punch_cells 4
    -punch_frequency 1
    -initial_time 0
    -warnings false

END
