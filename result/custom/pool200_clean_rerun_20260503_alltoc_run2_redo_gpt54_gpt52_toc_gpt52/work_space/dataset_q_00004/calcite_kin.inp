TITLE Calcite kinetic dissolution 100C pH5 pe4
SOLUTION 1
    temp 100
    pH 5 charge
    pe 4
    units mmol/kgw
    C(4) 0.5
    Mn 1
    -water 1

RATES
Calcite_custom
-start
10 k = PARM(1)
20 SA = PARM(2)
30 SIc = SI("Calcite")
40 IF (SIc >= 0) THEN rate = 0
50 IF (SIc < 0) THEN rate = k*SA*(1 - 10^SIc)
60 moles = rate*TIME
70 SAVE moles
-end

KINETICS 1
    Calcite_custom
        -m0 1
        -m  1
        -parms 0.001 10.0
        -steps 10 in 100
        -tol 1e-12
    -formula Ca 1 C 1

SELECTED_OUTPUT
    -file calcite_kin.sel
    -reset false
    -time true
    -pH true
    -pe true
    -totals Ca C Mn
    -si Calcite
END
