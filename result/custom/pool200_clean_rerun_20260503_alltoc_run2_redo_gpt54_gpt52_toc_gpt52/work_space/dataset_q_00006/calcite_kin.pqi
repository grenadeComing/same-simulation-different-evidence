SOLUTION 1
    temp 100
    pH   5
    pe   4
    units mol/kgw
    C(4) 5e-4
    Mn   1e-3

RATES
Calcite_custom
-start
10 k = 0.001
20 sa = 10.0
30 moles = k * sa * TIME
40 SAVE moles
-end

KINETICS 1
    Calcite_custom
        -formula CaCO3 1
        -m0 1
        -m  1
        -tol 1e-12
        -steps 1000 in 100

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -step true
    -totals C
END