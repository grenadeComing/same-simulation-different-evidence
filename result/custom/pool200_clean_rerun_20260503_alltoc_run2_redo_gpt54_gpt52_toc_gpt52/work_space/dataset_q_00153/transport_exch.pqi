SOLUTION 0  Infilling
    pH 7.0
    units mol/kgw
    Na 1.0
    Cl 1.0

SOLUTION 1-10  Initial cells
    pH 7.0
    units mol/kgw
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

SELECTED_OUTPUT
    -reset false
    -high_precision true
USER_PUNCH
    -headings step cell NaX_molality
    10 PUNCH SIM_NO, CELL_NO, MOL("NaX")

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions flux flux
    -diffusion_coefficient 0
    -dispersivity 0
    -correct_disp true
    -punch_frequency 1
END
