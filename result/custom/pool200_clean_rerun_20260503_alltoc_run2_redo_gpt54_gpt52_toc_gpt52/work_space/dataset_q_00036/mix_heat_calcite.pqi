TITLE Mix 50 mmol/kg DIC with 50 mmol/kg Ca, 1:1, heat 20 to 200 C in 10 steps, allow calcite eq

SOLUTION 1  DIC
    temp 20
    pH 7 charge
    units mmol/kgw
    C(4) 50

SOLUTION 2  Ca
    temp 20
    pH 7 charge
    units mmol/kgw
    Ca 50

MIX 1
    1 0.5
    2 0.5

# Heat in 10 discrete steps from 20 to 200 C inclusive (20,40,...,200)
REACTION_TEMPERATURE 1
    20 40 60 80 100 120 140 160 180 200

EQUILIBRIUM_PHASES 1
    Calcite 0 0

SELECTED_OUTPUT
    -file selected.txt
    -reset false
    -temperature true
    -si Calcite
    -activities Ca+2 CO3-2
    -ionic_strength true

USER_PUNCH
    -headings Log_IAP_Calcite
10 PUNCH (LA("Ca+2") + LA("CO3-2"))

END
