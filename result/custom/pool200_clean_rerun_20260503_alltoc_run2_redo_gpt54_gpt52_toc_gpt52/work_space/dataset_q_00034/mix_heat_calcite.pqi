SOLUTION 1 DIC
    temp 20
    pH   7 charge
    units mmol/kgw
    C(4) 50

SOLUTION 2 Ca
    temp 20
    pH   7 charge
    units mmol/kgw
    Ca   50

MIX 1
    1 0.5
    2 0.5

EQUILIBRIUM_PHASES 1
    Calcite 0 0

REACTION_TEMPERATURE 1
    20 200 in 10 steps

SELECTED_OUTPUT
    -file mix_heat_calcite.sel
    -reset false
USER_PUNCH
    -headings step temp tot_C4 tot_Ca
10 PUNCH STEP_NO, TC, TOT("C(4)"), TOT("Ca")
END
