SOLUTION 0 Infilling
    pH 7.0
    Na 1.0
    Cl 1.0

SOLUTION 1-10 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -time_step 1
    -lengths 1
    -dispersivities 0
    -diffusion_coefficient 0
    -boundary_conditions flux flux
    -initial_time 0
    -print_cells 1
    -print_frequency 1

END
