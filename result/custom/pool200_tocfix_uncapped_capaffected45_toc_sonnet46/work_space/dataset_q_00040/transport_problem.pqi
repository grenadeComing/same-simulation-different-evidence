TITLE 1D Transport Problem - 10 cells, 10 shifts

# Infilling solution (solution 0) - the inlet solution
SOLUTION 0
    pH 7.0
    Na 1.0
    Cl 1.0

# Initial solution for all 10 cells
SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0

# Define exchange assemblage for all 10 cells, equilibrate with solution 1
EXCHANGE 1-10
    X   0.001
    -equilibrate 1

END

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -diffusion_coefficient 0.0
    -dispersivity 0.0
    -time_step 1.0
    -lengths 1.0

SELECTED_OUTPUT
    -file transport_out.sel
    -reset false
    -solution
    -step
    -molalities HCl

END
