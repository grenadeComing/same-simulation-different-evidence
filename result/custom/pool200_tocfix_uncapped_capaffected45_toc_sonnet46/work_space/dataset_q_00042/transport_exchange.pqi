TITLE 1D Transport with Exchange - 10 cells, 10 shifts

# Initial solution (in all 10 cells): pH 7.0, Ca 1.0 mmol/L, Cl 2.0 mmol/L
SOLUTION 1-10
    pH      7.0
    Ca      1.0
    Cl      2.0

# Infilling (inlet) solution: pH 7.0, Na 1.0 mmol/L, Cl 1.0 mmol/L
SOLUTION 0
    pH      7.0
    Na      1.0
    Cl      1.0

# Exchange sites for all 10 cells: 0.001 mol, equilibrated with solution 1
EXCHANGE 1-10
    X       0.001
    -equilibrate 1

SELECTED_OUTPUT
    -file   transport_exchange.sel
    -reset  false
    -step
    -si     Halite

USER_PUNCH
    -headings Cell Step SI_Halite
    -start
10 PUNCH CELL_NO, STEP_NO, SI("Halite")
    -end

TRANSPORT
    -cells          10
    -shifts         10
    -flow_direction forward
    -boundary_conditions flux flux
    -diffusion_coefficient 0.0
    -dispersivity  0.0
    -time_step      1.0
    -lengths        1.0

END
