TITLE 1D Transport with Exchange - 10 cells, 10 shifts

# Initial solution in all cells: pH 7.0, Ca 1.0 mmol/L, Cl 2.0 mmol/L
SOLUTION 1-10
    pH      7.0
    Ca      1.0
    Cl      2.0
    units   mmol/L

# Infilling (inlet) solution: pH 7.0, Na 1.0 mmol/L, Cl 1.0 mmol/L
SOLUTION 0
    pH      7.0
    Na      1.0
    Cl      1.0
    units   mmol/L

# Exchange sites: 0.001 mol per cell, equilibrated with solution 1
EXCHANGE 1-10
    X       0.001
    -equilibrate 1

SELECTED_OUTPUT
    -file           transport_exchange.sel
    -reset          false
    -solution       true
    -step           true
    -totals         Ca Na Cl

USER_PUNCH
    -headings  Step Cell SC
    10 PUNCH STEP_NO, CELL_NO, SC

TRANSPORT
    -cells          10
    -shifts         10
    -flow_direction forward
    -boundary_conditions flux flux
    -diffusion_coefficient 0
    -dispersivity  0
    -time_step      1
    -punch_cells    1-10
    -punch_frequency 1

END
