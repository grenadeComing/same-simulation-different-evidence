SOLUTION 1
    temp      200
    pH        2.0
    pe        4.0
    units     mmol/kgw
    Cu        10.0
    Ba        5.0
    -water    1.0

KINETICS 1
Calcite
    -tol   1e-8
    -m0    1.0
    -m     1.0
    -parms 1.0   0.6
    -step  10 in 100

SELECTED_OUTPUT
    -file   calcite_kinetics.out
    -reset  false
    -step   true
    -time   true
    -totals C Ba Cu Ca
    -molalities CO3-2 HCO3- H2CO3 CaCO3 CuCO3 Cu+2 Cu+1 CuOH+ Ba+2 BaCO3

END
