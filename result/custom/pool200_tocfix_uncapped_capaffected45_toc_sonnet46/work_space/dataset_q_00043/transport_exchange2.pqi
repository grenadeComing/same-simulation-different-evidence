TITLE 1D Transport with Exchange - 10 cells, 10 shifts (mol/L units)

# Initial solution in cells (pH 7, Ca 1.0, Cl 2.0 mmol/L)
SOLUTION 1-10
    pH      7.0
    Ca      1.0
    Cl      2.0

# Infilling (inlet) solution (pH 7, Na 1.0, Cl 1.0 mmol/L)
SOLUTION 0
    pH      7.0
    Na      1.0
    Cl      1.0

# Exchange assemblage for all 10 cells, equilibrated with solution 1
EXCHANGE 1-10
    X       0.001
    equilibrate 1

TRANSPORT
    -cells           10
    -shifts          10
    -time_step       3600
    -length          0.1
    -dispersivity    0.0
    -flow_direction  forward
    -boundary_conditions flux flux

SELECTED_OUTPUT
    -file            transport_exchange2.sel
    -reset           false
    -step            true
    -solution        true
    -si              H2(g)

USER_PUNCH
    -headings  Cell Step SI_H2g
    -start
    10 PUNCH CELL_NO, STEP_NO, SI("H2(g)")
    -end

END
