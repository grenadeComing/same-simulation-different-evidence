TITLE Calcite kinetic dissolution in acidic solution at 200C with custom rate

SOLUTION 1
    temp      200
    pH        2.0
    pe        4.0
    units     mmol/kgw
    Cu        10.0
    Ba        5.0

RATES
Calcite
-start
10 si_cc = SI("Calcite")
20 if (M <= 0 AND si_cc < 0) then goto 200
30 k = PARM(2)
40 area = PARM(1)
50 rate = k * area * M * (1 - 10^si_cc)
60 moles = rate * TIME
70 if (moles > M) then moles = M
200 SAVE moles
-end

KINETICS 1
Calcite
    -tol    1e-8
    -m0     1.0
    -m      1.0
    -parms  1.0  10.0
    -step   1000 in 100

INCREMENTAL_REACTIONS true

SELECTED_OUTPUT
    -file   calcite_kinetics2.out
    -reset  false
    -step   true
    -time   true
    -pH     true
    -kinetic_reactants  true

END
