TITLE 1D Transport Problem - 10 cells, 10 shifts

# Initial solution (fills all 10 cells)
SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0
    units mmol/L

# Infilling solution (solution 0 - the inlet)
SOLUTION 0
    pH 7.0
    Na 1.0
    Cl 1.0
    units mmol/L

# Exchange sites for all 10 cells
EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -diffusion_coefficient 0.0
    -dispersivity 0.0
    -time_step 3600
    -length 0.1

SELECTED_OUTPUT
    -file transport_out.sel
    -reset false

USER_PUNCH
    -headings SimNo CellNo Step pH Na Ca Cl Viscosity
    -start
10 PUNCH SIM_NO, CELL_NO, STEP_NO, -LA("H+"), TOT("Na"), TOT("Ca"), TOT("Cl"), VISCOS
    -end

END
