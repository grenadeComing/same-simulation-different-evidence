SOLUTION 1
    temp      100
    pH        5.0
    pe        4.0
    units     mmol/kgw
    C(4)      0.5
    Mn        1.0

RATES
Calcite
-start
10  si_cc = SI("Calcite")
20  IF (M <= 0) THEN GOTO 200
30  rate = PARM(1) * PARM(2) * (1 - 10^si_cc)
40  IF (rate < 0) THEN rate = 0
50  moles = rate * TIME
60  IF (moles > M) THEN moles = M
70  SAVE moles
200 END
-end

KINETICS 1
Calcite
    -m0    1.0
    -m     1.0
    -parms 10.0  0.001
    -steps 1000 in 100
    -tol   1e-8

SELECTED_OUTPUT
    -file   calcite_kinetic2.out
    -reset  false
    -step   true
    -time   true
    -pH     true
    -pe     true
    -si     Calcite

END
