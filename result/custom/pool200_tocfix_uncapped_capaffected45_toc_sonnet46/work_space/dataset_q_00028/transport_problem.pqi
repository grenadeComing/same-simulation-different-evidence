TITLE 1D Transport Problem - 10 cells, 10 shifts

# Initial solution (pH 7.0, Ca 1.0 mmol/L, Cl 2.0 mmol/L)
SOLUTION 1-10
    pH      7.0
    Ca      1.0
    Cl      2.0
    units   mmol/L

# Infilling (inlet) solution (pH 7.0, Na 1.0 mmol/L, Cl 1.0 mmol/L)
SOLUTION 0
    pH      7.0
    Na      1.0
    Cl      1.0
    units   mmol/L

# Exchange sites for all 10 cells, equilibrated with solution 1
EXCHANGE 1-10
    X       0.001
    -equilibrate 1

TRANSPORT
    -cells          10
    -shifts         10
    -flow_direction forward
    -boundary_conditions flux flux
    -diffusion_coefficient 0.0
    -dispersivity  0.0
    -time_step      3600
    -length         0.1

SELECTED_OUTPUT
    -file           transport_out.sel
    -reset          false
    -solution       true
    -step           true
    -pe             true
    -pH             true

USER_PUNCH
    -headings  Step  Solution  pH  pe
    10 PUNCH STEP_NO, SOLN_VOL, -LA("H+"), -LA("e-")

END
