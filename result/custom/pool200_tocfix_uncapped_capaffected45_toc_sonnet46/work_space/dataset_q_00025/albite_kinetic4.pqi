SOLUTION 1
    temp      200
    pH        2.0
    pe        4
    units     mmol/kgw
    Fe(2)     4.0
    Fe(3)     4.0

RATES
Albite_custom
-start
10 rate = PARM(1) * PARM(2) * M
20 moles = rate * TIME
30 SAVE moles
-end

KINETICS 1
Albite_custom
    -formula NaAlSi3O8
    -m0   1.0
    -m    1.0
    -parms 1.0  10.0
    -step 10 in 100

GAS_PHASE 1
    -fixed_pressure
    -pressure 5.0
    -volume 1.0
    -temperature 200
    H2S(g)   5.0

SELECTED_OUTPUT
    -file albite_kinetic4.out
    -reset false
    -step true
    -si Goethite

END
