SOLUTION 1
    temp      100
    pH        5.0
    pe        4.0
    units     mmol/kgw
    C(4)      0.5
    Mn        1.0

RATES
Calcite
-start
10  si_cc = SI("Calcite")
20  if (m <= 0 and si_cc < 0) then goto 200
30  if (si_cc > 0 and m <= 0) then goto 200
40  rate = PARM(1) * PARM(2) * (1 - 10^si_cc)
50  moles = rate * TIME
60  if (moles > m) then moles = m
70  if (moles < 0) then moles = 0
200 save moles
-end

KINETICS 1
Calcite
    -m0   1.0
    -m    1.0
    -parms 10.0  0.001
    -steps 1000 in 100
    -tol  1e-8

SELECTED_OUTPUT
    -file   calcite_kinetic.out
    -reset  false
    -step   true
    -time   true
    -pH     true
    -pe     true
    -si     Calcite

END
