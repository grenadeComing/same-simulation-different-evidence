SOLUTION 1
    temp 200
    pH 2
    pe 4
    units mmol/kgw
    Cu 10
    Ba 5
    Cl 25

RATES
Calcite
-start
10 k = 10
20 sa = 1.0
30 moles = k*sa*TIME
40 SAVE moles
-end

KINETICS 1
    Calcite
        -m0 1
        -formula CaCO3 1
        -steps 1000 in 100 steps
        -cvode true

USER_PUNCH
    -headings step C_mol Cu_mol
10 PUNCH STEP_NO, TOT("C"), TOT("Cu")

SELECTED_OUTPUT
    -reset false
    -user_punch true
END
