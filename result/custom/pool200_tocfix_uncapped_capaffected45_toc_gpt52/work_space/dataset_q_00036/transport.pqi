SOLUTION 0
    pH 7.0
    Na 1.0
    Cl 1.0
END

SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0
END

EXCHANGE 1-10
    X 0.001
    -equilibrate 1
END

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions constant constant
    -time_step 1
    -lengths 1
    -dispersivities 0
    -diffusion_coefficient 0
    -punch_frequency 1
    -print_frequency 1
END

SELECTED_OUTPUT
    -file selected.csv
    -reset false
USER_PUNCH
    -headings step cell exch_Na
10 PUNCH TRANSPORT_STEP_NO, CELL_NO, MOL("X-Na")
END
