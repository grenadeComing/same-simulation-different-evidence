SOLUTION 1
    temp 100
    pH 5
    pe 4
    units mol/kgw
    C(4) 5e-4
    Mn  1e-3

RATES
Calcite_custom
-start
10 sa = PARM(1)
20 k = PARM(2)
30 rate = sa*k
40 moles = rate*TIME
50 SAVE moles
-end

KINETICS 1
    Calcite_custom
        -formula CaCO3 1
        -m0 1
        -parms 10.0 0.001
        -steps 10 in 100

SELECTED_OUTPUT
    -reset false
    -time true
    -step true
    -totals C Ca Mn
END
