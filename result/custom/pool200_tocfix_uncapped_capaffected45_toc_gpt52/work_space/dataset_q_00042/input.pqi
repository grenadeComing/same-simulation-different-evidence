SOLUTION 0  Initial
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 1-10  Cells
    pH 7.0
    Ca 1.0
    Cl 2.0

SOLUTION 11  Infilling
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions flux flux
    -initial_time 0

SELECTED_OUTPUT
    -file selected.out
    -reset false

USER_PUNCH
    -headings step cell SI_Halite
10 PUNCH STEP_NO, CELL_NO, SI("Halite")
END

KNOBS
    -print true
