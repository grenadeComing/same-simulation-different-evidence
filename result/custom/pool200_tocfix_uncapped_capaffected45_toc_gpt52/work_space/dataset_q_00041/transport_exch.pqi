TITLE 1D transport, exchange, compute SI(H2O(g)) at cell 4 step 10

SOLUTION 0  Infilling
    pH      7.0
    Na      1.0
    Cl      1.0

SOLUTION 1-10 Initial
    pH      7.0
    Ca      1.0
    Cl      2.0

EXCHANGE 1-10
    X  0.001
    -equilibrate 1

TRANSPORT
    -cells               10
    -shifts              10
    -time_step           1
    -flow_direction      forward
    -boundary_conditions constant constant
    -lengths             1
    -dispersivities      0
    -punch_cells         4
    -punch_frequency     1

SELECTED_OUTPUT
    -file selected.csv
    -reset false
    -high_precision true

USER_PUNCH
    -headings step cell SI_H2Og
10 PUNCH TOT("step"), TOT("cell"), SI("H2O(g)")

END
