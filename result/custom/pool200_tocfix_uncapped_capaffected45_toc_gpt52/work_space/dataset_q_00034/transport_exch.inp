TITLE 1D transport 10 cells 10 shifts with exchange
SOLUTION 0  Infilling
    pH 7.0
    Na 1.0
    Cl 1.0
END
SOLUTION 1-10 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0
END
EXCHANGE 1-10
    X 0.001
END
EQUILIBRATE 1-10 with_exchange 1
SELECTED_OUTPUT
    -file sc.sel
    -reset false
    -high_precision true
USER_PUNCH
    -headings step sc
    10 PUNCH STEP_NO, SC
END
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -diffusion_coefficient 0
    -dispersivities 0
    -punch_cells 8
    -punch_frequency 1
END
