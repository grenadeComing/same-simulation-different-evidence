SOLUTION 0  Initial_solution
    pH 7.0
    units mol/kgw
    Ca 1.0
    Cl 2.0

SOLUTION 1-10  Initial_cells
    pH 7.0
    units mol/kgw
    Ca 1.0
    Cl 2.0

SOLUTION 11  Infilling_solution
    pH 7.0
    units mol/kgw
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 0.001

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions constant constant
    -initial_time 0
    -print_cells 1
    -punch_cells 1

SELECTED_OUTPUT
    -file sel.txt
    -reset false
    -high_precision true
    -solution true
    -time true
    -step true

USER_PUNCH
    -headings Na_molal
10 PUNCH TOT("Na")
END

END
