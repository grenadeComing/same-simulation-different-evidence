TITLE 1D transport, 10 cells, 10 shifts, exchange 0.001 mol sites per cell

SOLUTION 0  Infilling
    pH 7.0
    Na 1.0
    Cl 1.0

SOLUTION 1-10 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -totals Na Ca Cl Alkalinity
USER_PUNCH
    -headings step sol alkalinity
10 PUNCH STEP_NO, SOLN, TOT("Alkalinity")

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions flux flux
    -diffusion_coefficient 0
    -dispersivities 0
    -lengths 1
    -punch_frequency 1
END
