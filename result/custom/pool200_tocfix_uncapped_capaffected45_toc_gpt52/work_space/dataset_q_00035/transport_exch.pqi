SOLUTION 0  Initial solution
    pH 7.0
    Ca 1.0
    Cl 2.0
END

SOLUTION 1-10  Initial in cells
    pH 7.0
    Ca 1.0
    Cl 2.0
END

SOLUTION 11  Influent solution
    pH 7.0
    Na 1.0
    Cl 1.0
END

EXCHANGE 1-10
    X 0.001
    -equilibrate 1
END

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -initial_time 0
END
