TITLE Calcite kinetic dissolution at 100C, pH 5, pe 4

SOLUTION 1
    temp 100
    pH 5
    pe 4
    units mmol/kgw
    C(4) 0.5
    Mn   1

RATES
Calcite_simple
-start
10 k = PARM(2)
20 SA = PARM(1)
30 rate = k*SA
40 moles = rate*TIME
50 if (moles > M) then moles = M
60 SAVE moles
-end

KINETICS 1
    Calcite_simple
        -formula CaCO3 1
        -m0 1
        -m  1
        -parms 10.0 0.001
        -steps 10 in 100

SELECTED_OUTPUT
    -reset false
USER_PUNCH
    -headings step pe
10 PUNCH STEP_NO, -LA("e-")
END
