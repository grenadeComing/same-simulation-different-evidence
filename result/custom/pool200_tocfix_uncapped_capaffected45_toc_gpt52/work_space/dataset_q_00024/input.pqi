SOLUTION 1
    temp 200
    pH 2 charge
    Fe(3) 4 mmol/kgw
    Fe(2) 4 mmol/kgw

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 1

KINETICS 1
    Albite
        -m0 1
        -m  1
        -parms 1.0 10
        -time 1000 in 100
        -tol 1e-12

SELECTED_OUTPUT
    -reset false
    -high_precision true
USER_PUNCH
    -headings step H2S_dissolved_mol
10 PUNCH STEP_NO, TOT("S(-2)")
END
