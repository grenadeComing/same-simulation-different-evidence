TITLE Albite kinetics in pH 2, 200C, Fe2/Fe3, fixed-pressure H2S gas
SOLUTION 1
    temp      200
    pH        2 charge
    pe        0
    redox     pe
    units     mmol/kgw
    Fe(2)     4
    Fe(3)     4
    -water    1

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5

KINETICS 1
    Albite
        -m0    1
        -m     1
        -parms 1.0 10
        -steps 10 in 100
        -tol   1e-12

SELECTED_OUTPUT
    -reset false
    -high_precision true
    -time true
    -step true
    -ionic_strength true
END
