TITLE 1D transport, cation exchange (equilibrate via EXCHANGEs block)
SOLUTION 0
    pH 7.0 charge
    Na 1.0
    Cl 1.0
SOLUTION 1
    pH 7.0 charge
    Ca 1.0
    Cl 2.0
SOLUTION 1-10
    -units mol/kgw
    -water 1
EXCHANGE 1-10
    X 0.001
EXCHANGEs 1
    -equilibrate 1
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions constant constant
    -lengths 1
    -dispersivities 0
    -correct_disp true
    -punch_cells 10
    -punch_frequency 10
SELECTED_OUTPUT
    -file selected.txt
    -reset false
    -high_precision true
    -pH true
    -pe true
END
