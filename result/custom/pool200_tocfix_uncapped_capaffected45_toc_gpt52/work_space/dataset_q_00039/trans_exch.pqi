TITLE 1D transport with cation exchange
SOLUTION 0  Infilling
    pH 7.0
    units mol/kgw
    Na 1.0
    Cl 1.0
SOLUTION 1-10  Initial
    pH 7.0
    units mol/kgw
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
    -equilibrate 1
TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1
    -dispersivities 0
    -correct_disp true
    -punch_cells 4
SELECTED_OUTPUT
    -file selected.out
    -reset false
    -high_precision true
USER_PUNCH
    -headings shift NaX_ex4
    10 PUNCH STEP_NO
    20 PUNCH MOL("NaX")
END
