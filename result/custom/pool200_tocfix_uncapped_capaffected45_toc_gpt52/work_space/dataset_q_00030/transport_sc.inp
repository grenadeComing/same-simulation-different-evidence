TITLE 1D transport, 10 cells, 10 shifts, cation exchange

SOLUTION 0  Infilling solution
    pH 7.0
    units mol/kgw
    Na 1.0
    Cl 1.0

SOLUTION 1-10 Initial solution
    pH 7.0
    units mol/kgw
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

SELECTED_OUTPUT
    -reset true
    -high_precision true
USER_PUNCH
    -headings step cell sc_uS_cm
10 PUNCH TOT("shifts"), CELL_NO, SC

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions constant constant
    -time_step 1
    -lengths 1
    -dispersivities 0
    -diffusion_coefficient 0
    -punch_cells 1
    -punch_frequency 1
END
