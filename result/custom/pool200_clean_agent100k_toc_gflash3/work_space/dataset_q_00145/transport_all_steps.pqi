TITLE Transport Problem
SOLUTION 0  # Infilling solution
    units mmol/L
    pH 7.0
    Na 1.0
    Cl 1.0
SOLUTION 1-10 # Initial solution
    units mmol/L
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    -equilibrate 1
    X 0.001
TRANSPORT
    -cells 10
    -shifts 10
    -lengths 10*1
    -dispersivity 10*0
    -punch_cells 1
    -punch_frequency 1
SELECTED_OUTPUT
    -file output_all_steps.sel
    -reset false
    -pe true
    -step true
    -solution true
    -high_precision true
END
