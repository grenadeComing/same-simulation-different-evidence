SOLUTION 1
    temp 200
    pH 2
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4
    Cl 100 charge

RATES
    Albite_custom
    -start
    10 k = 0.0005
    20 area = 1.0
    30 rate = k * area * (1 - SR("Albite"))
    40 moles = rate * TIME
    50 SAVE moles
    -end

KINETICS 1
    Albite_custom
    -formula NaAlSi3O8 1.0
    -m 1.0
    -m0 1.0
    -step 1000 in 100
    -cvode true

EQUILIBRIUM_PHASES 1
    H2S(g) 0.69897 10.0

SELECTED_OUTPUT 1
    -file results_slow.sel
    -reset false
    -step true
    -totals Fe(3) Fe(2)
    -pH true
END
