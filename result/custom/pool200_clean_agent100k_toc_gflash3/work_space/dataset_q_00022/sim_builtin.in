SOLUTION 1
    temp 200
    pH 2
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4
    Cl 100 charge

KINETICS 1
    Albite
    -m 1.0
    -m0 1.0
    -parms 1.0 10.0
    -step 1000 in 100
    -cvode true

EQUILIBRIUM_PHASES 1
    H2S(g) 0.69897 10.0

SELECTED_OUTPUT 1
    -file results_builtin.sel
    -reset false
    -step true
    -totals Fe(3) Fe(2)
    -pH true
    -m Albite
END
