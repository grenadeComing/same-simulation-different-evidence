SOLUTION 1
    temp      100
    pH        5
    pe        4
    units     mmol/kgw
    C         0.5
    Mn        1
RATES
    Calcite_Custom
    -start
    10 k = 0.001
    20 ssa = 10.0
    30 rate = k * ssa * (1 - SR("Calcite"))
    40 save rate * TIME
    -end
KINETICS 1
    Calcite_Custom
    -formula CaCO3
    -m0 1.0
    -m  1.0
    -time 1000 in 100
SELECTED_OUTPUT
    -file output.sel
    -reset true
    -totals Ca Mn C
    -si Calcite Rhodochrosite
    -ph
    -kinetics Calcite_Custom
END
