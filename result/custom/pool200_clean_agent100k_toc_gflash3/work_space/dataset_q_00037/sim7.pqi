SOLUTION 1
    temp 25
    pH 7 charge
    units mmol/kgw
    Ca 50
END

EQUILIBRIUM_PHASES 1
    Calcite 0 10
    Aragonite 0 10
    Gypsum 0 10
    CO2(g) -1.20412 10  # log10(1/16)
    CH4(g) -0.50515 10  # log10(5/16)
    H2S(g) -0.20412 10  # log10(10/16)
END

USE solution 1
USE equilibrium_phases 1
SELECTED_OUTPUT
    -file selected.out
    -pH true
END
