SOLUTION 1
    temp      25
    pH        7
    units     mol/L
    Ca        0.01
    Sr        0.01
    Alkalinity 0.04
EQUILIBRIUM_PHASES 1
    Fix_pH 7.0 HCl 10.0
    -force_equality
SOLID_SOLUTIONS 1
    Ca_Sr_carbonate
        -comp Calcite 0.0
        -comp Strontianite 0.0
PHASES
Fix_pH
    H+ = H+
    log_k 0
SELECTED_OUTPUT
    -file out.sel
    -si Strontianite
END
