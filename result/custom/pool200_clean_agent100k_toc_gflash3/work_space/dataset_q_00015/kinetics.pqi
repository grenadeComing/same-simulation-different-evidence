SOLUTION 1
    temp      200
    pH        2
    pe        4
    units     mmol/kgw
    Cu        10
    Ba        5
    Cl        40 charge
RATES
MyCalcite
-start
10 if (m <= 0) then goto 50
20 sr_c = SR("Calcite")
30 rate = 10 * (1 - sr_c)
40 save rate * TIME
50 end
KINETICS 1
MyCalcite
    -formula  CaCO3 1.0
    -m0       1
    -m        1
    -step     1000 in 100
    -cvode    true
INCREMENTAL_REACTIONS true
SELECTED_OUTPUT 1
    -file output.sel
    -reset false
    -step
    -si witherite calcite
    -totals Ca Ba C(4)
    -pH
END
