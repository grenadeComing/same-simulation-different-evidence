SOLUTION 0
    pH 7.0
    units mmol/L
    Na 1.0
    Cl 1.0

SOLUTION 1-10
    pH 7.0
    units mmol/L
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    -equilibrate 1
    X 0.001

TRANSPORT
    -cells 10
    -shifts 10
    -lengths 1
    -punch_cells 4
    -punch_frequency 10

SELECTED_OUTPUT
    -file output.sel
    -reset false
    -step
    -si H2O(g)
    -high_precision true
END
