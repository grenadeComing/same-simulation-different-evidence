SOLUTION 1
    temp 200
    pH 2
    units mmol/kgw
    Fe(2) 4
    Fe(3) 4
    Cl 40 charge
END

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5
END

RATES
Albite
-start
10 rate = 2.294e-7 * (1 - SR("Albite"))
20 SAVE rate * TIME
-end

KINETICS 1
    Albite
    -m 1.0
    -m0 1.0
    -steps 1000 in 100
END

SELECTED_OUTPUT
    -file result.sel
    -reset false
    -step
    -totals Si
END

RUN_CELLS
    -cells 1
    -steps 100
END
