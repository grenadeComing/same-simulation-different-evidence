SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0
END

SOLUTION 0
    pH 7.0
    Na 1.0
    Cl 1.0
END

EXCHANGE 1-10
    X 0.001
    EQUILIBRATE 1
END

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1.0
    -dispersivities 0.0
    -diffusion_coefficient 0.0

SELECTED_OUTPUT
    -file output.sel
    -reset false
    -step
    -solution
    -molalities HCl
END
