SOLUTION 1
    temp 25
    units mmol/kgw
    Ca 50
    pH 7 charge
END

USE solution 1
EQUILIBRIUM_PHASES 1
    Calcite 0 10
    Gypsum 0 10
    Aragonite 0 10
GAS_PHASE 1
    -fixed_pressure
    -pressure 1.0
    CO2(g) 1.0
    CH4(g) 5.0
    H2S(g) 10.0
END

USE solution 1
USE equilibrium_phases 1
USE gas_phase 1
REACTION_TEMPERATURE 1
    100
SELECTED_OUTPUT
    -file result.sel
    -pe true
END
