SOLUTION 1
    temp 20
    units mmol/kgw
    C(4) 50
    Na 50 charge

SOLUTION 2
    temp 20
    units mmol/kgw
    Ca 50
    Cl 100 charge

MIX 1
    1 0.5
    2 0.5

EQUILIBRIUM_PHASES 1
    Calcite 0.0 0.0

REACTION_TEMPERATURE 1
    20 200 in 10 steps

SELECTED_OUTPUT
    -file solution_results.sel
    -reset false
    -temp true
    -totals C(4) Ca
END
