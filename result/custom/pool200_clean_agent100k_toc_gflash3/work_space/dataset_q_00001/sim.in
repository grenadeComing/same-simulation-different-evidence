SOLUTION 1
    temp    100
    pH      5
    pe      4
    C(4)    0.5 mmol/kgw
    Mn      1 mmol/kgw
    units   mol/kgw

RATES
    Calcite_custom
    -start
    10 si_c = SI("Calcite")
    20 rate = 0.001 * (1 - 10^si_c)
    30 moles = rate * TIME
    40 SAVE moles
    -end

KINETICS 1
    Calcite_custom
    -formula CaCO3 1.0
    -m0 1.0
    -m  1.0
    -steps 1000 in 100
    -cvode true

SELECTED_OUTPUT 1
    -file output.sel
    -reset false
    -step true
    -pe true
    -pH true

END
