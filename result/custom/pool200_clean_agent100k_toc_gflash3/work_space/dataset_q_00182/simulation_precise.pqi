TITLE Question Simulation
SOLUTION 1
    temp 15
    units mmol/kgw
    C(-4) 5.0
END
GAS_PHASE 1
    -fixed_pressure
    -pressure 1.0
    -temp 15
    CH4(g) 0.0
END
USE solution 1
USE gas_phase 1
SELECTED_OUTPUT
    -file selected.out
USER_PUNCH
    -headings visc
    -start
10 PUNCH STR_FORMAT$(VISCOSITY, 10, 7)
    -end
END
