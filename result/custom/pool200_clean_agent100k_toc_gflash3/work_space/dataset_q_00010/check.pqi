SOLUTION 1
    temp 200
    pH 2
    pe 4
    units mmol/kgw
    Cu 10
    Ba 5
    Cl 50 charge
END

SELECTED_OUTPUT
    -file final_check.txt
    -reset false
    -step
    -time
    -si Witherite
    -m Calcite
END

USE solution 1
KINETICS 1
Calcite
    -m 1.0
    -m0 1.0
    -parms 1.0 10.0
    -steps 1000 in 100
END
