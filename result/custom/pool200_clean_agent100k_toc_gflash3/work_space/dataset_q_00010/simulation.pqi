SOLUTION 1
    temp 200
    pH 2
    pe 4
    units mmol/kgw
    Cu 10
    Ba 5
    Cl 50 charge
END

RATES
Calcite
-start
10 k = PARM(2)
20 ssa = PARM(1)
30 rate = k * ssa * (1 - SR("Calcite"))
40 moles = rate * TIME
50 SAVE moles
-end

SELECTED_OUTPUT
    -file results.txt
    -reset false
    -step
    -time
    -si Witherite
END

USE solution 1
KINETICS 1
Calcite
    -m 1.0
    -m0 1.0
    -parms 1.0 10.0
    -steps 1000 in 100
END
