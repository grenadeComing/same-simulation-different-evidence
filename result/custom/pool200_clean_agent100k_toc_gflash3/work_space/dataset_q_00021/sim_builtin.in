
SOLUTION 1
    temp 200
    pH 2 charge
    Fe(2) 4 mmol/kgw
    Fe(3) 4 mmol/kgw
    Cl 1.0
    units mmol/kgw

GAS_PHASE 1
    -fixed_pressure
    -pressure 5.0
    H2S(g) 5.0

KINETICS 1
    Albite
    -m 1.0
    -parms 1.0 10.0
    -steps 1000 in 100
    -cvode true

SELECTED_OUTPUT
    -file output.sel
    -reset false
    -step true
    -ionic_strength true

END
