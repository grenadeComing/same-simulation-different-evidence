SOLUTION 0
    pH 7.0
    units mmol/kgw
    Na 1.0
    Cl 1.0
SOLUTION 1-10
    pH 7.0
    units mmol/kgw
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    -equilibrate 1
    X 0.001
TRANSPORT
    -cells 10
    -shifts 10
    -lengths 1.0
    -time_step 1.0
SELECTED_OUTPUT
    -file output.sel
    -reset false
    -step true
    -distance true
    -high_precision true
    -molalities Ca+2
    -totals Ca
END
