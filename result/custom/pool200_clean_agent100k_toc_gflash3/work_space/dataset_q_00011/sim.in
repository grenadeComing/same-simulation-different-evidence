
SOLUTION 1
    temp 200
    pH 2
    pe 4
    Cu 0.01
    Ba 0.005
    Cl 1.0 charge
    units mol/kgw

RATES
    Calcite_kinetic
    -start
    10 k = PARM(2)
    20 ssa = PARM(1)
    30 rate = k * ssa * (1 - SR("Calcite"))
    40 moles = rate * TIME
    50 SAVE moles
    -end

KINETICS 1
    Calcite_kinetic
    -formula CaCO3 1.0
    -m 1.0
    -parms 1.0 10
    -steps 1000 in 100
    -runge_kutta 4

SELECTED_OUTPUT
    -file result.sel
    -reset false
    -time true
    -molalities CO2
    -step

END
