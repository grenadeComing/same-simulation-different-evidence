SOLUTION 1
    temp      25
    pH        8.0
    pe        12  # Equilibrium with air?
    redox     pe
    units     ppm
    Ca        50
    Mg        12
    Na        20
    K         2
    Alkalinity 150 as CaCO3
    S(6)      40
    Cl        15
    water     1 # kg

REACTION 1
    H2O -1.0
    50.0 moles

EQUILIBRIUM_PHASES 1
    Calcite 0 0
    Gypsum  0 0
    Halite  0 0

SELECTED_OUTPUT
    -file output_pe12.sel
    -reset false
    -pe true
    -pH true

END
