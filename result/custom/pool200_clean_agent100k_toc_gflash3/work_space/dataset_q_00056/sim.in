PHASES
Fix_H+
    H+ = H+
    log_k 0
END

SOLUTION 1
    temp 100
    pH 3
    Cl 1e-3
    water 1
END

USE solution 1
EQUILIBRIUM_PHASES 1
    Fix_H+ -3.0 HCl 10.0
    K-mica 0 10
    Kaolinite 0 10
    Dolomite 0 10
    Epsomite 0 10
    Fe(OH)3(a) 0 10
    Halite 0 10
END
KNOBS
    -iterations 1000
    -step_size 10
    -diagonal_scale true
END
