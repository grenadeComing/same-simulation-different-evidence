
TITLE 1D Transport with Cation Exchange

SOLUTION 0  # Infilling solution
    pH      7.0
    units   mmol/kgw
    Na      1.0
    Cl      1.0

SOLUTION 1-10  # Initial solution in cells 1-10
    pH      7.0
    units   mmol/kgw
    Ca      1.0
    Cl      2.0

EXCHANGE 1-10
    equilibrate with solution 1
    X       0.001

TRANSPORT
    -cells  10
    -shifts 5
    -lengths 1.0
    -dispersivity 0.0
    -punch_cells 1-10
    -punch_frequency 5

SELECTED_OUTPUT
    -file results_all_cells.sel
    -reset false
    -step
    -solution
    
USER_PUNCH
    -headings SC
    10 PUNCH SC

END
