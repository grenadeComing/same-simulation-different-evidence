PHASES
Fix_pH
H+ = H+
log_k 0

SOLUTION 1
    temp 25
    pH 5.0
    units mol/kgw
    Ba 0.1
    Cl 0.2 charge
    water 1

EQUILIBRIUM_PHASES 1
    Fix_pH -5.0 HCl 10.0
    Talc 0 10
    Rhodochrosite 0 10
    Sepiolite 0 10
    Sepiolite(d) 0 10
    Pb(OH)2 0 10

SELECTED_OUTPUT 1
    -file output.sel
    -mol CO3-2
    -pH
    -water
END
