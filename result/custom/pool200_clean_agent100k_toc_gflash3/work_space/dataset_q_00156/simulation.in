SOLUTION 0
    units mmol/kgw
    pH 7.0
    Na 1.0
    Cl 1.0

SOLUTION 1-10
    units mmol/kgw
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001
    equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -lengths 1.0
    -time_step 1.0
    -flow_direction forward
    -boundary_conditions flux flux

SELECTED_OUTPUT
    -file output.txt
    -reset false
    -step true
    -distance true
USER_PUNCH
    -headings cell NaX_moles
    -start
10 PUNCH CELL, MOL("NaX")
    -end

END
