RATES
Albite
-start
10 rate = 1e-6 * (1 - SR("Albite"))
20 moles = rate * TIME
30 SAVE moles
-end

SOLUTION 1
    temp 200
    pH 2
    units mmol/kgw
    Fe(+3) 4
    Fe(+2) 4
    Na 1e-6
    Al 1e-6
    Si 1e-6
    -water 1

EQUILIBRIUM_PHASES 1
    H2S(g) 0.69897

KINETICS 1
    Albite
        -formula NaAlSi3O8
        -m 1.0
        -m0 1.0
        -steps 1000 in 100
    -runge_kutta 4

SELECTED_OUTPUT 1
    -file result.sel
    -reset false
    -step
    -si Goethite
    -ph

END
