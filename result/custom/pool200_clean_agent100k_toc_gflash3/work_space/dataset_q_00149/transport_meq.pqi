SOLUTION 0
    pH 7.0
    units mmol/kgw
    Na 1.0
    Cl 1.0
SOLUTION 1-10
    pH 7.0
    units mmol/kgw
    Ca 0.5
    Cl 1.0
EXCHANGE 1-10
    X 0.001
    equilibrate 1
TRANSPORT
    -cells 10
    -shifts 10
    -lengths 1
    -boundary_conditions flux flux
    -dispersivity 0
    -time_step 1
SELECTED_OUTPUT
    -file output.sel
    -reset false
    -step true
    -molalities NaX
END
