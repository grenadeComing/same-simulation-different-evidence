
SOLUTION 1
    temp 200
    pH 2.0
    units mmol/kgw
    Fe(+3) 4.0
    Fe(+2) 4.0
    Cl 10.0 charge

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2Sg(g) 5

RATES
Albite
-start
10 k = 10
20 area = 1.0 * M
30 if (M <= 0) then goto 100
40 rate = k * area * (1 - SR("Albite"))
50 moles = rate * TIME
60 if (moles > M) then moles = M
70 SAVE moles
100 END
-end

KINETICS 1
Albite
    -m 1.0
    -m0 1.0
    -steps 1000 in 100

SELECTED_OUTPUT
    -file output.sel
    -reset false
    -step true
    -pe true
    -ph true
    -kin Albite
END
