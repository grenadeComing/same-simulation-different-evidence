SOLUTION 1
    temp 25
    pH 7
    units mol/kgw
    Ca 0.01
    Sr 0.01
    Alkalinity 0.04
SOLID_SOLUTIONS 1
    Ca_Sr_carbonate
        -comp1 Calcite 0.0
        -comp2 Strontianite 0.0
SELECTED_OUTPUT 1
    -file output.sel
    -reset false
    -totals C
USER_PUNCH 1
    -headings C_total
    10 PUNCH TOT("C")
END
