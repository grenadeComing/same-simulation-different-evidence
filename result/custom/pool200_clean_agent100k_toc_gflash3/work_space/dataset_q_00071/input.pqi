# No changes, just testing a different database (mentally).
# Since I can only use the default, I will stick to it.
SOLUTION 1
    temp 25
    units mol/kgw
    pH 7.0
    water 1
EQUILIBRIUM_PHASES 1
    Pyrite 0.0 0.1
    O2(g) -0.7 10.0
    Goethite 0.0 0.0
    Gypsum 0.0 0.0
SELECTED_OUTPUT
    -file result.sel
    -high_precision true
    -alkalinity true
END
