SOLUTION 1 River
    pH 6.0
    pe 12 # Start with something reasonable for air-saturated
    units mg/L
    Cl 10
    Na 10 charge # Use Na to balance Cl
    O(0) 1 O2(g) -0.7

SOLUTION 2 Seawater
    pH 8.1
    pe 12
    units mg/L
    Cl 19000
    Na 19000 charge # Use Na to balance Cl
    O(0) 1 O2(g) -0.7

MIX 1
    1 0.7
    2 0.3

END
