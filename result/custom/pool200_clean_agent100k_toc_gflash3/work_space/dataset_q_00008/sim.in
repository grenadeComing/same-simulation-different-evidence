SOLUTION 1
    temp 100
    pH 5
    pe 4
    C(4) 0.5 mmol/kgw
    Mn 1 mmol/kgw
    units mmol/kgw

RATES
    Calcite_custom
    -start
    10 k = 0.001
    20 ssa = 10.0
    30 rate = k * ssa * (1 - SR("Calcite"))
    40 save rate * TIME
    -end

KINETICS 1
    Calcite_custom
    -formula CaCO3 1.0
    -m 1
    -steps 1000 in 1000
    -bad_step_max 10000

SELECTED_OUTPUT
    -file result.sel
    -reset false
    -step true
    -pe true
    -time true

USER_PUNCH
    -headings pH Calcite_moles
    10 PUNCH -LA("H+"), KIN("Calcite_custom")
END
