SOLUTION 1-10
    pH 7.0
    units mmol/kgw
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

SOLUTION 0
    pH 7.0
    units mmol/kgw
    Na 1.0
    Cl 1.0

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1
    -dispersivity 0
    -time_step 1

SELECTED_OUTPUT
    -file output.sel
    -reset false
    -step true
    -soln true
    -si Halite

END
