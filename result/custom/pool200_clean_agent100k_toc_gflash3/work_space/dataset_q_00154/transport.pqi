SOLUTION 0
    temp 25
    pH 7.0
    units mmol/kgw
    Na 1.0
    Cl 1.0

SOLUTION 1-10
    temp 25
    pH 7.0
    units mmol/kgw
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -lengths 1.0
    -dispersivities 0.0
    -punch_cells 1
    -punch_frequency 1

SELECTED_OUTPUT
    -file viscosity_results.sel
    -reset false
    -high_precision true
    -step
USER_PUNCH
    -headings viscosity
    10 PUNCH VISCOSITY
END
