SOLUTION 0
    units mol/L
    pH 7.0
    Na 1.0
    Cl 1.0
SOLUTION 1-10
    units mol/L
    pH 7.0
    Ca 0.5
    Cl 1.0
EXCHANGE 1-10
    -equilibrate 1
    X 0.001
TRANSPORT
    -cells 10
    -shifts 10
    -punch_cells 1
    -punch_frequency 1
SELECTED_OUTPUT
    -file output.sel
    -reset false
    -step
    -molalities NaX CaX2
END
