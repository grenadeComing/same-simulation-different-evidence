RATES
    Calcite
    -start
    10 k = 0.001
    20 ssa = 10.0
    30 rate = k * ssa * ACT("H+") * (1 - SR("Calcite"))
    40 moles = rate * TIME
    50 SAVE moles
    -end
SOLUTION 1
    temp 100
    pH 5
    pe 4
    units mmol/kgw
    C(4) 0.5
    Mn 1
KINETICS 1
    Calcite
    -m 1.0
    -steps 1000 in 100
SELECTED_OUTPUT
    -file res.sel
    -reset false
    -totals C
    -step
END
