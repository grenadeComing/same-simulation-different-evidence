SOLUTION 1-10
    pH 7.0
    units mmol/kgw
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    -equilibrate 1
    X 0.001
END

SOLUTION 0
    pH 7.0
    units mmol/kgw
    Na 1.0
    Cl 1.0
END

TRANSPORT
    -cells 10
    -shifts 10
    -lengths 1.0
    -dispersivities 0.0
    -punch_cells 1
    -punch_frequency 5

SELECTED_OUTPUT
    -file results.sel
    -reset false
    -step true
USER_PUNCH
    -headings Na_exact
    10 PUNCH TOT("Na")
END
