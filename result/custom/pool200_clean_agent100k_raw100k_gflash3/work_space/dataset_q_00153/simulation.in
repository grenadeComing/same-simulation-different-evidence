SOLUTION 0
    units   mmol/kgw
    pH      7.0
    Na      100.0
    Cl      100.0

SOLUTION 1-10
    units   mmol/kgw
    pH      7.0
    Ca      1.0
    Cl      2.0

EXCHANGE 1-10
    -equilibrate 1
    X 0.001

TRANSPORT
    -cells 10
    -shifts 10
    -lengths 1
    -timest 1

SELECTED_OUTPUT
    -file results.sel
    -reset true
    -molalities NaX

END
