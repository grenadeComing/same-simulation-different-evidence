SOLUTION 1
    temp 200
    pH 2
    pe 4
    units mmol/kgw
    Cu 10
    Ba 5
    Cl 100 charge
END

USE solution 1
KINETICS 1
Calcite
    -m 1.0
    -m0 1.0
    -parms 1.0 10 # SSA=1.0, k=10
    -steps 1000 in 100
END

SELECTED_OUTPUT
    -file output.sel
    -reset false
    -step
    -pH
    -time
END
