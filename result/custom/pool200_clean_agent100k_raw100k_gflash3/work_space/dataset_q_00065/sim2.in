PHASES
Fix_pH
    H+ = H+
    log_k 0
SOLUTION 1
    temp 100
    pH 5
    units mmol/kgw
    Ba 100
EQUILIBRIUM_PHASES 1
    Talc 0 10
    Rhodochrosite 0 10
    Sepiolite 0 10
    Sepiolite(d) 0 10
    Pb(OH)2 0 10
    Fix_pH -5.0 HCl 10.0
KNOBS
    -iterations 500
SELECTED_OUTPUT 1
    -file SI_results.txt
    -si Sepiolite(d) Sepiolite Talc Rhodochrosite Pb(OH)2
    -pH true
END
