SOLUTION 1 River water
    pH      6.0
    Cl      10
    units   mg/L
    temp    25
    Na      10 charge

SOLUTION 2 Seawater
    pH      8.1
    Cl      19000
    units   mg/L
    temp    25
    Na      19000 charge

MIX 1
    1   0.7
    2   0.3

USER_PRINT
10 PRINT "Viscosity: ", VISCOSITY
END
