SOLUTION 1
    temp 200
    pH 2
    Fe(+2) 4 mmol/kgw
    Fe(+3) 4 mmol/kgw
    Cl 1 charge
END

RATES
    Albite_custom
    -start
    10 rate = 10 * 1.0 * (1 - SR("Albite"))
    20 moles = rate * TIME
    30 SAVE moles
    -end

USE solution 1
GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5
KINETICS 1
    Albite_custom
    -formula NaAlSi3O8 1.0
    -m 1
    -m0 1
    -steps 1000 in 100
    -step_divide 1
SELECTED_OUTPUT
    -file albite_pe.sel
    -reset false
    -step
    -pe
END
