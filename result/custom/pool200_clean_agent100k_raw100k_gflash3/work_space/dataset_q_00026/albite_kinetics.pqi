SOLUTION 1
    temp 200
    pH 2
    units mmol/kgw
    Fe(2) 4
    Fe(3) 4
    Cl 10 charge
END

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5
END

RATES
    Albite
    -start
    10 k = 10
    20 area = 1.0
    30 rate = k * area * (1 - SR("Albite"))
    40 SAVE rate * TIME
    -end

KINETICS 1
    Albite
    -m 1.0
    -m0 1.0
    -step 1000 in 100
    -bad_step_max 1000000
USE solution 1
USE gas_phase 1
END
