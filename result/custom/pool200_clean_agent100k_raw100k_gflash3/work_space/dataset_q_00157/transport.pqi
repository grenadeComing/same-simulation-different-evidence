SOLUTION 0
    pH 7
    Na 1
    Cl 1
    units mmol/kgw

SOLUTION 1-10
    pH 7
    Ca 1
    Cl 2
    units mmol/kgw

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -lengths 1
    -time_step 1
    -punch_cells 4
    -punch_frequency 10

SELECTED_OUTPUT
    -file solution_4.sel
    -reset false
    -step
    -molalities HCl
END
