SOLUTION 0
    pH 7
    Na 1
    Cl 1
    units mmol/L

SOLUTION 1-10
    pH 7
    Ca 1
    Cl 2
    units mmol/L

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -lengths 1
    -time_step 1
    -punch_cells 4
    -punch_frequency 10

SELECTED_OUTPUT
    -file solution_4_mmolL.sel
    -reset false
    -high_precision true
    -step
    -molalities HCl
END
