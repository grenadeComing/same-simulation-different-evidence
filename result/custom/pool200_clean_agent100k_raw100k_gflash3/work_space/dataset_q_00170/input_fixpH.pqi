SOLUTION 1
    temp 25
    pH 7
    units mol/kgw
    Ca 0.01
    Sr 0.01
    Alkalinity 0.04
SOLID_SOLUTIONS 1
    Ca_Sr_carbonate
        -comp1 Calcite 0.0
        -comp2 Strontianite 0.0
EQUILIBRIUM_PHASES 1
    Fix_pH -7.0 NaOH 10.0
PHASES
    Fix_pH
    H+ = H+
    log_k 0.0
SELECTED_OUTPUT
    -file output_fixpH.sel
    -reset false
USER_PUNCH
    -headings C_molality
    10 PUNCH TOT("C")
END
