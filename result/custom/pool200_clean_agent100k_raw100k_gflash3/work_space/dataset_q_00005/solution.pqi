SOLUTION 1
    temp      100
    pH        5
    pe        4
    C(4)      0.5 mmol/kgw
    Mn        1 mmol/kgw
    units     mmol/kgw

RATES
    Calcite
    -start
    10 k = 0.001
    20 area = 10.0
    30 rate = k * area * (1 - SR("Calcite"))
    40 save rate
    -end

KINETICS 1
    Calcite
    -m        1.0
    -m0       1.0
    -steps    1000 in 100
    -runge_kutta 4

SELECTED_OUTPUT
    -file     output.sel
    -reset    false
    -step
    -pH

END
