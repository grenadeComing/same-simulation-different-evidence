SOLUTION 1
    temp      100
    pH        5
    pe        4
    C(4)      0.5 mmol/kgw
    Mn        1 mmol/kgw
    units     mmol/kgw

KINETICS 1
    Calcite
    -m        1.0
    -m0       1.0
    -parms    10.0 0.67
    -steps    1000 in 100
    -cvode    true

SELECTED_OUTPUT
    -file     output.sel
    -reset    false
    -step     true
    -pH       true

END
