SOLUTION 1 River Water
    pH        6.0
    units     mg/l
    Alkalinity 50
    Ca        15
    Mg        5
    Na        5
    Cl        10
    S(6)      10

SOLUTION 2 Seawater
    pH        8.1
    units     mg/l
    Alkalinity 141.682
    B         4.442
    Br        67.3
    Ca        412.3
    Cl        19000
    F         1.3
    K         399.1
    Mg        1291.8
    Na        10768
    S(6)      2712
    Sr        7.9

MIX 1
    1       0.7
    2       0.3

SELECTED_OUTPUT
    -file output.sel
    -reset false
    -molalities HCl
END
