SOLUTION 1
    temp 100
    pH 5
    pe 4
    C 0.5 mmol/kgw
    Mn 1 mmol/kgw
    Cl 2.0 charge
    units mmol/kgw

KINETICS 1
    Calcite
    -m 1.0
    -m0 1.0
    -parms 10.0 0.001
    -steps 1000 in 100 steps
    -tol 1e-10

SELECTED_OUTPUT
    -file solution_results_plummer.txt
    -reset false
    -step
    -time
    -pe
    -pH

END
