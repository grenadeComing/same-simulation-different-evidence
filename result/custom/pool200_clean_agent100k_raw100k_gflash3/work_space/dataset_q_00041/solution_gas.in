SOLUTION 1
    temp 100
    units mmol/kgw
    Ca 50
    pH 7 charge
END
GAS_PHASE 1
    -fixed_volume
    -volume 1.0
    -temp 25
    CO2(g) 1.0
    CH4(g) 5.0
    H2S(g) 10.0
EQUILIBRIUM_PHASES 1
    Calcite 0 10
    Gypsum 0 10
    Aragonite 0 10
USE solution 1
USE gas_phase 1
USE equilibrium_phases 1
SELECTED_OUTPUT
    -file gas_phase.sel
    -molalities CH4
END
