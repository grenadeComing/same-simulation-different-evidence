SOLUTION 1
    units mmol/kgw
    temp 20
    pH 7 charge
    C(4) 50
    Na 50
SOLUTION 2
    units mmol/kgw
    temp 20
    pH 7 charge
    Ca 50
    Cl 100
MIX 1
    1 0.5
    2 0.5
EQUILIBRIUM_PHASES 1
    Calcite 0 10.0
REACTION_TEMPERATURE 1
    20 200 in 10 steps
SELECTED_OUTPUT 1
    -file output.sel
    -reset false
    -temperature true
USER_PUNCH 1
    -headings logIAP logK SI
    10 PUNCH SI("Calcite") + LK_PHASE("Calcite")
    20 PUNCH LK_PHASE("Calcite")
    30 PUNCH SI("Calcite")
END
