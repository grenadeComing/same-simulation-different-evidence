SOLUTION 1
    temp 200
    pH 7.0 # Initial pH, will change
    units mmol/kgw
    Fe(3) 4.0
    Fe(2) 4.0
    Cl 20.0 # From FeCl3 and FeCl2
END

USE solution 1
EQUILIBRIUM_PHASES 1
    H2S(g) 0.69897 10.0
    Fix_pH -2.0 HCl
    -force_equality
PHASES
Fix_pH
    H+ = H+
    log_k 0.0
END

KINETICS 1
    Albite
    -m0 1.0
    -m 1.0
    -parms 1.0 10
    -steps 1000 in 100
    -runge_kutta 4

USER_PUNCH 1
    -headings step moles_dissolved
    -start
    10 PUNCH STEP_NO, 1.0 - KIN("Albite")
    -end
END
