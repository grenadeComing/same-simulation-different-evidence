SOLUTION 0
    pH 7.0
    Na 1.0
    Cl 1.0

SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    -equilibrate 1
    X 0.001

TRANSPORT
    -cells 10
    -shifts 10
    -lengths 1
    -dispersivity 0
    -punch_cells 8
    -punch_frequency 1

SELECTED_OUTPUT
    -file output.sel
    -reset false

USER_PUNCH
    -headings shift cell CaX2_frac
    10 PUNCH TRANSPORT_STEP, CELL_NO, 2 * MOL("CaX2") / 0.001

END
