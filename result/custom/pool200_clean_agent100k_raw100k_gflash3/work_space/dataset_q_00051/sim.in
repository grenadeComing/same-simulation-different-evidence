PHASES
Fix_pH
    H+ = H+
    log_k 0.0
END

SOLUTION 1
    temp 100
    pH 3
    pe 4
    units mol/kgw
    water 1
END

USE solution 1
EQUILIBRIUM_PHASES 1
    K-mica 0 10
    Kaolinite 0 10
    Dolomite 0 10
    Epsomite 0 10
    Fe(OH)3(a) 0 10
    Halite 0 10
    Fix_pH -3.0 HCl 100
END

USE equilibrium_phases 1
USE solution 1
SELECTED_OUTPUT 1
    -file results.txt
    -molalities Fe+2 Fe+3
END
