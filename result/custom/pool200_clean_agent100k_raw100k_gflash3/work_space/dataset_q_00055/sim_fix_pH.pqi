PHASES
Fix_pH
    H+ = H+
    log_k 0
SOLUTION 1
    temp 100
    pH 7
    units mol/kgw
EQUILIBRIUM_PHASES 1
    K-mica 0 10
    Kaolinite 0 10
    Dolomite 0 10
    Epsomite 0 10
    Fe(OH)3(a) 0 10
    Halite 0 10
    Fix_pH -3 HCl 10
SELECTED_OUTPUT 1
    -file results_fix_pH.sel
    -si Mirabilite
END
