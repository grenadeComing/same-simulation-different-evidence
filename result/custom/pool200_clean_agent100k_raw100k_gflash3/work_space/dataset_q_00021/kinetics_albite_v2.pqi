SOLUTION 1
    temp 200
    pH 2
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4
    Cl 1 charge
END

RATES
Albite
    -start
    10 rate = 10 * 1.0 * (1 - SR("Albite"))
    20 moles = rate * TIME
    30 SAVE moles
    -end

KINETICS 1
Albite
    -m 1.0
    -m0 1.0
    -steps 1000 in 100
END

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5
END

SELECTED_OUTPUT 1
    -file solution_results.txt
    -step
    -ionic_strength
    -pH
    -mol Na Al Si Fe(2) Fe(3)
    -kinetic_moles Albite
    -time
END

USE solution 1
USE kinetics 1
USE gas_phase 1
END
