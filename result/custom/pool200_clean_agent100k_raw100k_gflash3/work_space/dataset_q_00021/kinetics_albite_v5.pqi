SOLUTION 1
    temp 200
    pH 2
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4
    Cl 1 charge
END

RATES
Albite
    -start
    10 rate = 10 * 1.0 * (1 - SR("Albite"))
    20 moles = rate * TIME
    30 SAVE moles
    -end

KINETICS 1
Albite
    -m 1.0
    -m0 1.0
    -steps 1000 in 100
    -cvode true
END

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5
END

EQUILIBRIUM_PHASES 1
    Pyrite 0 0
    Mackinawite 0 0
    Sulfur 0 0
    Quartz 0 0
    Gibbsite 0 0
END

SELECTED_OUTPUT 1
    -file solution_results_v5.txt
    -step
    -ionic_strength
    -pH
    -kin Albite
END

USE solution 1
USE kinetics 1
USE gas_phase 1
USE equilibrium_phases 1
END
