SOLUTION 1
    temp 200
    pH 2
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4
    Cl 1 charge
END

KINETICS 1
Albite
    -m 1.0
    -m0 1.0
    -parms 1.0 10.0
    -steps 1000 in 100
END

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5
END

SELECTED_OUTPUT 1
    -file solution_results_v8.txt
    -step
    -ionic_strength
    -pH
END

USE solution 1
USE kinetics 1
USE gas_phase 1
END
