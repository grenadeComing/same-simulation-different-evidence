SOLUTION 1
    temp 20
    units mmol/kgw
    Ca 50
    pH 7 charge
SOLUTION 2
    temp 20
    units mmol/kgw
    C(4) 50
    pH 7 charge
MIX 1
    1 1.0
    2 1.0
EQUILIBRIUM_PHASES 1
    Calcite 0.0 0.0
REACTION_TEMPERATURE 1
    20 40 60 80 100
SELECTED_OUTPUT 1
    -file output.sel
    -reset false
    -high_precision true
    -temperature true
    -equi Calcite
END
