SOLUTION 1
    temp 100
    pH 7
    water 1
EQUILIBRIUM_PHASES 1
    K-mica 0 10
    Kaolinite 0 10
    Dolomite 0 10
    Epsomite 0 10
    Fe(OH)3(a) 0 10
    Halite 0 10
    Fix_pH -3.0 HCl 100
PHASES
Fix_pH
    H+ = H+
    log_k 0.0
SELECTED_OUTPUT 1
    -file sim1.sel
    -totals Mg
USER_PUNCH 1
    -headings Total_Moles_Mg Mass_H2O
    10 PUNCH TOT("Mg") * MASS
    20 PUNCH MASS
END
