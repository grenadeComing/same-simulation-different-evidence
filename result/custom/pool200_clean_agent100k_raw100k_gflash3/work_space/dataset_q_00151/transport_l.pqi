SOLUTION 0
    pH 7.0
    units mmol/L
    Na 1.0
    Cl 1.0

SOLUTION 1-10
    pH 7.0
    units mmol/L
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001
    equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -lengths 1.0
    -disp 0.0

SELECTED_OUTPUT
    -file output_l.sel
    -reset false
    -solution
    -step
USER_PUNCH
    -headings sc
    10 PUNCH SC

END
