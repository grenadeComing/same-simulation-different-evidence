SOLUTION 1
    temp 100
    pH 5
    pe 4
    C(4) 0.5 mmol/kgw
    Mn 1.0 mmol/kgw
    N(5) 2.01 mmol/kgw # Perfect balance
KINETICS 1
    Calcite
    -m 1.0
    -parms 10.0 0.67
    -step 1000 in 100
SELECTED_OUTPUT
    -file result_no3_balanced.sel
    -reset false
    -step
    -pH
    -time
END
