SOLUTION 1
    temp 200
    pH 2
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4
    -water 1

KINETICS 1
    Albite
    -m 1.0
    -m0 1.0
    -parms 1.0 10
    -steps 1000 in 100

EQUILIBRIUM_PHASES 1
    H2S(g) 0.69897 100.0

SELECTED_OUTPUT 1
    -file results.txt
    -reset false
    -step
    -mol Fe+3
    -mol Fe+2
    -ph

END
