
SOLUTION 1
    temp 200
    pH 2
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4
    Cl 20 charge # Approximate balancing
GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 5
KINETICS 1
    Albite
    -m0 1.0
    -parms 1.0 10
    -steps 1000 in 100
SELECTED_OUTPUT
    -file albite.sel
    -reset false
    -step
    -totals Si
END
