
SOLUTION 1
    temp 200
    pH 2
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4
    Cl 20 charge
EQUILIBRIUM_PHASES 1
    H2S(g) 0.69897 10 # log10(5)
KINETICS 1
    Albite
    -m0 1.0
    -parms 1.0 10
    -steps 1000 in 100
SELECTED_OUTPUT
    -file albite_eq.sel
    -reset false
    -step
    -totals Si
END
