SOLUTION 1
    temp 25
    pH 8.0
    units ppm
    Ca 50
    Mg 12
    Na 20
    K 2
    Alkalinity 150 as CaCO3
    S(6) 40 as SO4
    Cl 15
END

SELECTED_OUTPUT 1
    -file output_v3.sel
    -reset false
    -equilibrium_phases Calcite
END

USE solution 1
EQUILIBRIUM_PHASES 1
    Calcite 0.0 0.0
    Gypsum 0.0 0.0
    Halite 0.0 0.0
REACTION 1
    H2O -1.0
    50.0 moles
END
