SOLUTION 1
    temp 150
    pH 7
    pe 4
    units mol/kgw
    water 1
END

GAS_PHASE 1
    -fixed_pressure
    -pressure 1.0
    -temperature 150
    CH4(g) 10
    CO2(g) 10
    NH3(g) 5
END

SELECTED_OUTPUT
    -file output.txt
    -alkalinity true
    -high_precision true
END

USE solution 1
USE gas_phase 1
END
