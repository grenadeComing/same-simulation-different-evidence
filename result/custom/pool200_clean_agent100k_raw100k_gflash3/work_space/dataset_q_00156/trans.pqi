SOLUTION 0
    pH 7.0
    Na 1.0
    Cl 1.0
SOLUTION 1-10
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    -equilibrate 1
    X 0.001
TRANSPORT
    -cells 10
    -shifts 10
    -lengths 1.0
    -flow_direction forward
    -boundary_conditions flux flux
    -dispersivities 0
SELECTED_OUTPUT
    -file output.sel
    -reset false
    -high_precision true
    -user_punch true
USER_PUNCH
    -headings step cell NaX
    -start
10 PUNCH STEP_NO, CELL_NO, MOL("NaX")
    -end
END
