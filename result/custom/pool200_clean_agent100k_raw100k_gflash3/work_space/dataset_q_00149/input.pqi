SOLUTION 0
    units mmol/kgw
    pH 7.0
    Na 1.0
    Cl 1.0

SOLUTION 1-10
    units mmol/kgw
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    -equilibrate 1
    X 0.001

TRANSPORT
    -cells 10
    -shifts 10
    -lengths 1.0
    -flow_direction forward
    -boundary_conditions flux flux
    -dispersivity 0.0
    -time_step 1.0
    -correct_disp true

SELECTED_OUTPUT
    -file output.sel
    -reset false
    -step true
    -molalities NaX
    -solution true

END
