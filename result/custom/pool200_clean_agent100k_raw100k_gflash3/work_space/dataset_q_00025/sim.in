SOLUTION 1
    temp 200
    pH 2
    units mmol/kgw
    Fe(3) 4
    Fe(2) 4
    Cl 10 charge
END

USE solution 1
KINETICS 1
Albite
    -m 1.0
    -m0 1.0
    -parms 1.0 10
    -steps 1000 in 100 steps
    -cvode true

GAS_PHASE 1
    -fixed_pressure
    -pressure 5.0
    H2S(g) 5.0

SELECTED_OUTPUT 1
    -file output.sel
    -reset false
    -step
    -si Goethite
END
