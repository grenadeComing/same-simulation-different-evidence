SOLUTION 1
    temp 100
    pH 5
    pe 4
    units mmol/kgw
    C(4) 0.5
    Mn 1.0
END
KINETICS 1
    Calcite
        -m0 1.0
        -m 1.0
        -parms 10.0 0.0
    -step 1000 in 100
END
SELECTED_OUTPUT 1
    -file output.sel
    -reset false
    -step true
    -totals C
END
USE solution 1
USE kinetics 1
END
