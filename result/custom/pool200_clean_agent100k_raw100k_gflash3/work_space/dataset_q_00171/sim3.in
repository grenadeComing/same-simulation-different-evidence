SOLUTION 1
    pH 7
    temp 25
    units mol/kgw
    Ca 0.01
    Sr 0.01
    Alkalinity 0.04
END

PHASES
Fix_pH
    H+ = H+
    log_k 0.0
END

SOLID_SOLUTIONS 1
    Ca_Sr_carbonate
        -comp1 Calcite 0.0
        -comp2 Strontianite 0.0
END

USE solution 1
USE solid_solution 1
EQUILIBRIUM_PHASES 1
    Fix_pH -7.0 NaOH 10.0
END
