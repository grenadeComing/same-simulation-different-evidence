SOLUTION 1
    temp      200
    pH        2.0
    pe        4
    redox     pe
    units     mmol/kgw
    density   1.0
    Fe(3)     4.0
    Fe(2)     4.0
    -water    1.0 # kg

GAS_PHASE 1
    -fixed_pressure
    -pressure 5.0
    -volume   1.0
    -temperature 200
    H2S(g)    5.0

RATES
Albite
-start
10 si_alb = SI("Albite")
20 if (M <= 0 and si_alb < 0) then goto 200
30 k_H = PARM(2) * (ACT("H+"))^0.5
40 k_OH = 10^(-12.96) * (ACT("OH-"))^0.3
50 k_H2O = 10^(-12.56)
60 rate = PARM(1) * (k_H + k_OH + k_H2O) * (1 - 10^si_alb)
70 moles = rate * TIME
80 if (moles > M) then moles = M
200 SAVE moles
-end

KINETICS 1
Albite
    -m0   1.0
    -m    1.0
    -parms 1.0  10.0
    -step  1000 in 100

INCREMENTAL_REACTIONS true

SELECTED_OUTPUT 1
    -file   albite_kinetic2.sel
    -reset  false
    -step   true
    -time   true
    -totals Si

END
