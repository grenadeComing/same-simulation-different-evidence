SOLUTION 1
    temp      200
    pH        2.0
    pe        4.0
    units     mmol/kgw
    Cu        10.0
    Ba        5.0

RATES
Calcite
-start
10 si_cc = SI("Calcite")
20 k = PARM(2)
30 A = PARM(1)
40 rate = k * A * (M/M0)^0.6 * (1 - 10^si_cc)
50 moles = rate * TIME
60 if (moles > M) then moles = M
70 if (moles < 0) then moles = 0
80 SAVE moles
-end

KINETICS 1
Calcite
    -tol   1e-8
    -m0    1.0
    -m     1.0
    -parms 1.0  10.0
    -bad_step_max 5000
    -step  1000 in 100

SELECTED_OUTPUT
    -file   calcite_kinetics7.out
    -reset  false
    -step   true
    -time   true
    -si     Witherite

END
