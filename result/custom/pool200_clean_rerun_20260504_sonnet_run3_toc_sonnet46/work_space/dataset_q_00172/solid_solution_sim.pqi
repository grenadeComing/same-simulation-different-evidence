SOLUTION 1
    pH      7.0
    temp    25.0
    Ca      0.01  # mmol/L -> mol/L handled by PHREEQC (units default mmol/L)
    Sr      0.01
    Alkalinity 0.04

SOLID_SOLUTIONS 1
    Ca_Sr_carbonate
        -comp Calcite      0.0
        -comp Strontianite 0.0

SELECTED_OUTPUT
    -file   solid_solution_sim.out
    -si     Calcite Strontianite

END
