# Solution 1: 50 mmol/kg dissolved inorganic carbon (DIC)
SOLUTION 1
    temp      20
    pH        7.0 charge
    C(4)      50 mmol/kgw

# Solution 2: 50 mmol/kg calcium
SOLUTION 2
    temp      20
    pH        7.0 charge
    Ca        50 mmol/kgw

# Mix solutions 1 and 2 in 1:1 ratio
MIX 1
    1   0.5
    2   0.5

# Save the mixed solution as solution 3
SAVE solution 3

END

# Now heat the mixed solution from 20 to 200 C in 10 steps
# with calcite equilibrium
USE solution 3

EQUILIBRIUM_PHASES 1
    Calcite   0.0   10.0

REACTION_TEMPERATURE 1
    20.0  38.0  56.0  74.0  92.0  110.0  128.0  146.0  164.0  182.0  200.0

SELECTED_OUTPUT
    -file   mixing_heating.sel
    -reset  false
    -temperature true
    -step    true
    -totals  Ca C(4)
    -molalities Ca+2 CaHCO3+ CaCO3 CaOH+
    -equilibrium_phases Calcite

END
