SOLUTION 1
    temp      100
    pH        7 charge
    Ca        50 mmol/kgw

EQUILIBRIUM_PHASES 1
    Calcite   0 0
    Gypsum    0 0
    Aragonite 0 0

GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    -temperature 25
    CO2(g)    1.0
    CH4(g)    5.0
    H2S(g)    10.0

SELECTED_OUTPUT
    -file selected_output.txt
    -equilibrium_phases Calcite Gypsum Aragonite

END
