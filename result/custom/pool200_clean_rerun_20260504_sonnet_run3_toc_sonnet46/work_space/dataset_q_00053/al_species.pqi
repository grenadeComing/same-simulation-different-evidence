TITLE Al species in solution at 100C, pH 3, equilibrium with minerals

SOLUTION 1
    temp    100
    pH      3
    water   1  # kg

EQUILIBRIUM_PHASES 1
    K-mica          0  10
    Kaolinite       0  10
    Dolomite        0  10
    Epsomite        0  10
    Fe(OH)3(a)      0  10
    Halite          0  10

SELECTED_OUTPUT
    -file           al_species.out
    -reset          false
    -totals         Al
    -molalities     Al+3 AlOH+2 Al(OH)2+ Al(OH)3 Al(OH)4- AlSO4+ Al(SO4)2-

END
