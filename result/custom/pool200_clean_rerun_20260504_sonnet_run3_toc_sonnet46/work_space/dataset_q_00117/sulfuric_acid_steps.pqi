# Initial pure water at pH 7.0
SOLUTION 1
    pH      7.0
    temp    25.0
    units   mol/L

# Add H2SO4 in steps: 0.001, 0.005, 0.01, 0.05, 0.1 moles
# Total = 0.166 moles of H2SO4

# Step 1: Add 0.001 mol H2SO4
REACTION 1
    H2SO4   1.0
    0.001

SAVE SOLUTION 1

# Step 2: Add 0.005 mol H2SO4
REACTION 2
    H2SO4   1.0
    0.005

SAVE SOLUTION 1

# Step 3: Add 0.01 mol H2SO4
REACTION 3
    H2SO4   1.0
    0.01

SAVE SOLUTION 1

# Step 4: Add 0.05 mol H2SO4
REACTION 4
    H2SO4   1.0
    0.05

SAVE SOLUTION 1

# Step 5: Add 0.1 mol H2SO4
REACTION 5
    H2SO4   1.0
    0.1

SAVE SOLUTION 1

SELECTED_OUTPUT
    -file   sulfuric_acid_steps.sel
    -reset  false
    -ionic_strength  true
    -pH     true
    -step   true

END
