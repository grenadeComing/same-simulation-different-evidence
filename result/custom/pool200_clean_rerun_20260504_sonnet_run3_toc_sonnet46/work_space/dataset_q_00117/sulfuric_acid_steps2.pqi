# Initial pure water at pH 7.0
SOLUTION 1
    pH      7.0
    temp    25.0
    units   mol/L

# Add H2SO4 in steps using multiple reaction amounts
# Steps: 0.001, 0.005, 0.01, 0.05, 0.1 moles
REACTION 1
    H2SO4   1.0
    0.001  0.005  0.01  0.05  0.1

SELECTED_OUTPUT
    -file   sulfuric_acid_steps2.sel
    -reset  false
    -ionic_strength  true
    -pH     true
    -step   true

END
