TITLE Pyrite oxidation in pure water at 25C with atmospheric O2

SOLUTION 1
    temp      25
    pH        7.0
    pe        4
    redox     pe
    units     mol/kgw
    density   1
    water     1 # kg

EQUILIBRIUM_PHASES 1
    Pyrite       0.0   0.1    # allow up to 0.1 mol to dissolve
    O2(g)       -0.7   10.0   # constant atmospheric O2 source
    Goethite     0.0   0.0    # allow precipitation
    Gypsum       0.0   0.0    # allow precipitation

SELECTED_OUTPUT
    -file       pyrite_out.sel
    -reset      false
    -pH         true
    -pe         true
    -molalities SO4-2 Fe+2 Fe+3 H+
    -totals     S(6) Fe S

END
