SOLUTION 1
    pH      7.0
    temp    25.0
    Ca      0.01    # mmol/L? No, mol/L as default in PHREEQC is mmol/L
    Sr      0.01
    Alkalinity 0.04

SOLID_SOLUTIONS 1
    Ca_Sr_carbonate
        -comp Calcite      0.0
        -comp Strontianite 0.0

SELECTED_OUTPUT
    -file   solid_solution.out
    -reset  false
    -activities Ca+2 Sr+2

END
