SOLUTION 1
    temp 150
    pH 7
    pe 4
    units mol/kgw
    water 1 # kg

GAS_PHASE 1
    -fixed_pressure
    -pressure 1.0
    -temperature 150
    -volume 1
    CH4(g)   10
    CO2(g)   10
    NH3(g)   5

SELECTED_OUTPUT
    -file gas_eq_output.sel
    -reset false
    -gases CH4(g) CO2(g) NH3(g)

END
