TITLE River water and seawater mixing with dissolved O2

# Solution 1: River water, pH 6.0, Cl 10 mg/L
# Dissolved O2 = 8 mg/L (typical river water)
SOLUTION 1 River Water
    temp      25
    pH        6.0
    units     mg/L
    Cl        10.0
    Na        10.0  charge
    O(0)      8.0

# Solution 2: Seawater, pH 8.1, Cl 19000 mg/L
# Dissolved O2 = 8 mg/L (typical seawater)
SOLUTION 2 Seawater
    temp      25
    pH        8.1
    units     mg/L
    Cl        19000.0
    Na        19000.0  charge
    O(0)      8.0

# Mix 70% river water and 30% seawater
MIX 1
    1    0.7
    2    0.3

SAVE SOLUTION 3

USE MIX 1

SELECTED_OUTPUT
    -file mix_output6.sel
    -reset false
    -si O2(g)
    -pH
    -pe

END
