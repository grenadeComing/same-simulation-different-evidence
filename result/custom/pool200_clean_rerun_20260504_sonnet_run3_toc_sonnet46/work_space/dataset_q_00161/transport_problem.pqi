TITLE 1D Transport Problem - 10 cells, 10 shifts

# Initial solution: pH 7.0, Ca 1.0, Cl 2.0
SOLUTION 1-10
    pH      7.0
    Ca      1.0
    Cl      2.0

# Infilling solution: pH 7.0, Na 1.0, Cl 1.0
SOLUTION 0
    pH      7.0
    Na      1.0
    Cl      1.0

# Exchange sites: 0.001 moles, equilibrate with solution 1
EXCHANGE 1-10
    X       0.001
    -equilibrate 1

TRANSPORT
    -cells          10
    -shifts         10
    -flow_direction forward
    -boundary_conditions flux flux
    -diffusion_coefficient 0.0
    -dispersivity 0.0
    -time_step      1.0
    -length         1.0

SELECTED_OUTPUT
    -file           transport_out.sel
    -reset          false
    -solution       true
    -step           true

USER_PUNCH
    -headings  Step  Cell  pH  Na_act  Ca_act  Cl_act
    -start
10  PUNCH STEP_NO, CELL_NO, -LA("H+"), ACT("Na+"), ACT("Ca+2"), ACT("Cl-")
    -end

END
