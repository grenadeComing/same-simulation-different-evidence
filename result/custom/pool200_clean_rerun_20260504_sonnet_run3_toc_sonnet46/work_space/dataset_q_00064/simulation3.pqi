SOLUTION 1
    temp      100
    pH        5
    units     mmol/kgw
    Ba        100

EQUILIBRIUM_PHASES 1
    Talc            0  10
    Rhodochrosite   0  10
    Sepiolite       0  10
    Sepiolite(d)    0  10
    Pb(OH)2         0  10

SELECTED_OUTPUT
    -file   result3.out
    -reset  false
    -molalities  CO3-2

USER_PUNCH
    -headings mol_CO3-2 mass_water moles_CO3-2
    -start
10 PUNCH MOL("CO3-2")
20 PUNCH MASS_WATER
30 PUNCH MOL("CO3-2") * MASS_WATER
    -end

END
