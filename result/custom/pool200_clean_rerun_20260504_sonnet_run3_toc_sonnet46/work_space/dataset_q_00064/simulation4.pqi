SOLUTION 1
    temp      100
    pH        5
    units     mmol/kgw
    Ba        100

EQUILIBRIUM_PHASES 1
    Talc            0  10
    Rhodochrosite   0  10
    Sepiolite       0  10
    Sepiolite(d)    0  10
    Pb(OH)2         0  10

USER_PUNCH
    -headings mol_CO3-2 soln_vol soln_mass moles_CO3-2_x_vol
    -start
10 PUNCH MOL("CO3-2")
20 PUNCH SOLN_VOL
30 PUNCH SOLN_MASS
40 PUNCH MOL("CO3-2") * SOLN_VOL
    -end

SELECTED_OUTPUT
    -file   result4.out
    -reset  false
    -user_punch true

END
