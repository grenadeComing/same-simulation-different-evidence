SOLUTION 1
    temp      100
    pH        7 charge
    Ca        50 mmol/kgw

EQUILIBRIUM_PHASES 1
    Calcite    0 10
    Gypsum     0 10
    Aragonite  0 10
    CO2(g)     0.0 10    # log(1 atm) = 0
    CH4(g)     0.699 10  # log(5 atm) = 0.699
    H2S(g)     1.0 10    # log(10 atm) = 1.0

SELECTED_OUTPUT
    -file     result4.out
    -reset    false
    -pe       true
    -pH       true
    -temperature true

END
