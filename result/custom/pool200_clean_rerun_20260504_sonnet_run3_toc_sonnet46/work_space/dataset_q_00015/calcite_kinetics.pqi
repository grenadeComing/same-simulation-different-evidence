TITLE Calcite dissolution kinetics with Cu and Ba at 200C, pH 2

SOLUTION 1
    temp      200
    pH        2.0
    pe        4.0
    units     mmol/kgw
    Cu        10.0
    Ba        5.0
    -water    1.0  # kg

EQUILIBRIUM_PHASES 1
    # No equilibrium phases - kinetics only

KINETICS 1
Calcite
    -tol    1e-8
    -m0     1.0
    -m      1.0
    -parms  1.0  0.6
    -step   1000 in 100

SELECTED_OUTPUT
    -file   calcite_kinetics.out
    -reset  false
    -step   true
    -time   true
    -pH     true
    -pe     true
    -si     Witherite Calcite

END
