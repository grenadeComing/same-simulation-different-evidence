# Mixing of two solutions 1:1 and heating from 20°C to 200°C in 10 steps
# Solution 1: 50 mmol/kg dissolved inorganic carbon
# Solution 2: 50 mmol/kg calcium

SOLUTION 1
    temp      20
    pH        7   charge
    units     mmol/kgw
    C(4)      50

SOLUTION 2
    temp      20
    pH        7   charge
    units     mmol/kgw
    Ca        50

# Mix 1:1
MIX 1
    1   0.5
    2   0.5

# Save the mixed solution as solution 3
SAVE SOLUTION 3

END

# Now use the mixed solution and heat it from 20 to 200°C in 10 steps
# with calcite equilibrium
USE SOLUTION 3

EQUILIBRIUM_PHASES 1
    Calcite   0   0

REACTION_TEMPERATURE 1
    20   38   56   74   92   110   128   146   164   182   200

SELECTED_OUTPUT
    -file   mixing_heating2.sel
    -reset  false
    -temperature   true
    -si            Calcite

END
