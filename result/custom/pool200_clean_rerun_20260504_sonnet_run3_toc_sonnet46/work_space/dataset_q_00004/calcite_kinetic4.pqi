SOLUTION 1
    temp      100
    pH        5
    pe        4
    units     mmol/kgw
    C(4)      0.5
    Mn        1.0

RATES
Calcite
-start
10  si_cc = SI("Calcite")
20  rate = PARM(1) * PARM(2) * (1 - 10^si_cc)
30  moles = rate * TIME
40  SAVE moles
-end

KINETICS 1
Calcite
    -m0    1.0
    -m     1.0
    -parms 10.0  0.001
    -steps 1000 in 100
    -bad_step_max 5000
    -tol   1e-8

USER_PUNCH
-headings time pH SI_Calcite log_delta_moles
-start
10 PUNCH SIM_TIME
20 PUNCH -LA("H+")
30 PUNCH SI("Calcite")
40 PUNCH LOG10(KIN("Calcite"))
-end

SELECTED_OUTPUT
    -file   calcite_kinetic4.out
    -reset  false
    -user_punch true

END
