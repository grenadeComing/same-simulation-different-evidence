TITLE 1D Transport Problem - 10 cells, 10 shifts (mol/L units)

# Initial solution (solution 1-10): pH 7.0, Ca 1.0 mmol/L, Cl 2.0 mmol/L
SOLUTION 1-10
    pH      7.0
    Ca      1.0   mmol/L
    Cl      2.0   mmol/L

# Infilling solution (solution 0): pH 7.0, Na 1.0 mmol/L, Cl 1.0 mmol/L
SOLUTION 0
    pH      7.0
    Na      1.0   mmol/L
    Cl      1.0   mmol/L

# Exchange sites for all 10 cells: 0.001 moles, equilibrate with solution 1
EXCHANGE 1-10
    X       0.001
    -equilibrate 1

TRANSPORT
    -cells          10
    -shifts         10
    -flow_direction forward
    -boundary_conditions flux flux
    -diffusion_coefficient 0.0
    -dispersivity  0.0
    -time_step     1.0
    -length        1.0
    -print_cells    1

PRINT
    -reset false
    -status false

SELECTED_OUTPUT
    -file           transport_out2.sel
    -reset          false
    -solution       true
    -step           true
    -pH             true
    -pe             true

END
