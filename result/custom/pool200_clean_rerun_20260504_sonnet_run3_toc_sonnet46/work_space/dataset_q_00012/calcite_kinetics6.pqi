SOLUTION 1
    temp      200
    pH        2.0
    pe        4.0
    units     mmol/kgw
    Cu        10.0
    Ba        5.0

RATES
Calcite
-start
10 si_cc = SI("Calcite")
20 IF (m <= 0) THEN GOTO 200
30 rate = PARM(2) * PARM(1) * (m/m0)^0.6 * (1 - 10^si_cc)
40 moles = rate * TIME
50 IF (moles > m) THEN moles = m
60 SAVE moles
200 END
-end

KINETICS 1
Calcite
    -tol   1e-8
    -m0    1.0
    -m     1.0
    -parms 1.0  1e-4
    -step  1000 in 100
    -bad_step_max 500

INCREMENTAL_REACTIONS true

SELECTED_OUTPUT
    -file   calcite_kinetics6.out
    -reset  false
    -step
    -time
    -alkalinity
    -pH
    -pe
    -totals Ca C Ba Cu

END
