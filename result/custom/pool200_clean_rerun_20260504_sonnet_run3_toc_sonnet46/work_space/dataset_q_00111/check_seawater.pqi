TITLE Check seawater SC

# Solution 2: Seawater, pH 8.1, Cl 19000 mg/L
SOLUTION 1 Seawater
    pH      8.1
    temp    25.0
    units   mg/L
    Cl      19000.0
    Na      10800
    Mg      1290
    S       905    as SO4
    Ca      412
    K       399
    C       28     as HCO3
    Br      67

SELECTED_OUTPUT
    -file           seawater_output.sel
    -reset          false
    -solution       true
    -pH             true

USER_PUNCH
    -headings  SC_uS_cm
    -start
10  PUNCH SC
    -end

END
