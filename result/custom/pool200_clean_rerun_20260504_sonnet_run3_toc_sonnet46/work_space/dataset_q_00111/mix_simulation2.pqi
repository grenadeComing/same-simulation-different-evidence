TITLE River water and Seawater Mixing - 0.3:0.7 ratio

# Solution 1: River water, pH 6.0, Cl 10 mg/L
SOLUTION 1 River Water
    pH      6.0
    temp    25.0
    units   mg/L
    Cl      10.0

# Solution 2: Seawater, pH 8.1, Cl 19000 mg/L
SOLUTION 2 Seawater
    pH      8.1
    temp    25.0
    units   mg/L
    Cl      19000.0
    Na      10800
    Mg      1290
    S       905    as SO4
    Ca      412
    K       399
    C       28     as HCO3
    Br      67

END

# Mix 30% river water and 70% seawater
MIX 1
    1   0.3
    2   0.7

SELECTED_OUTPUT
    -file           mix_output2.sel
    -reset          false
    -solution       true
    -pH             true

USER_PUNCH
    -headings  SC_uS_cm
    -start
10  PUNCH SC
    -end

END
