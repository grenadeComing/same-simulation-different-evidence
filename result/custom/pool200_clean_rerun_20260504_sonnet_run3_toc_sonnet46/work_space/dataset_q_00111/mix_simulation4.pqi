TITLE River water and Seawater Mixing - Na charge balance

# Solution 1: River water, pH 6.0, Cl 10 mg/L
SOLUTION 1 River Water
    pH      6.0
    temp    25.0
    units   mg/L
    Cl      10.0
    Na      10.0    charge

# Solution 2: Seawater, pH 8.1, Cl 19000 mg/L
SOLUTION 2 Seawater
    pH      8.1
    temp    25.0
    units   mg/L
    Cl      19000.0
    Na      19000.0    charge

END

# Mix 70% river water and 30% seawater
MIX 1
    1   0.7
    2   0.3

SELECTED_OUTPUT
    -file           mix_output4.sel
    -reset          false
    -solution       true
    -pH             true

USER_PUNCH
    -headings  SC_uS_cm
    -start
10  PUNCH SC
    -end

END
