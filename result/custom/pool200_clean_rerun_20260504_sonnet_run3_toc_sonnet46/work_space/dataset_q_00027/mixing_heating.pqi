
# Solution 1: 50 mmol/kg dissolved inorganic carbon
SOLUTION 1
    temp      20
    pH        7
    units     mmol/kgw
    C(4)      50

# Solution 2: 50 mmol/kg calcium
SOLUTION 2
    temp      20
    pH        7
    units     mmol/kgw
    Ca        50

# Mix solutions 1 and 2 in 1:1 ratio
MIX 1
    1    0.5
    2    0.5

# Save the mixed solution as solution 3
SAVE solution 3

END

# Now use solution 3 and heat from 20 to 200 in 10 steps
USE solution 3

EQUILIBRIUM_PHASES 1
    Calcite   0   0

REACTION_TEMPERATURE 1
    20  200  in 10 steps

SELECTED_OUTPUT
    -file     mixing_heating.sel
    -reset    false
    -temperature  true
    -pH           true
    -si           Calcite

END
