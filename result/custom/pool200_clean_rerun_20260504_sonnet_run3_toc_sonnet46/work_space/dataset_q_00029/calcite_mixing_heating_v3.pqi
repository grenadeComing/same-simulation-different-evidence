
# Solution 1: 50 mmol/kg dissolved inorganic carbon
SOLUTION 1
    temp      20
    pH        7.0
    C(4)      50 mmol/kgw
    units     mmol/kgw

# Solution 2: 50 mmol/kg calcium
SOLUTION 2
    temp      20
    pH        7.0
    Ca        50 mmol/kgw
    units     mmol/kgw

END

# Mix 1:1 (equal masses, 1 kg each -> 2 kg total)
MIX 1
    1   1.0
    2   1.0

SAVE solution 3

END

# Now heat the mixed solution from 20 to 200 C in 10 steps with calcite equilibrium
USE solution 3

EQUILIBRIUM_PHASES 1
    Calcite   0.0   0.0

REACTION_TEMPERATURE 1
    20.0  38.0  56.0  74.0  92.0  110.0  128.0  146.0  164.0  182.0  200.0

END
