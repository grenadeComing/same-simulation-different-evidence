SOLUTION 1
    temp      100
    pH        5
    units     mmol/kgw
    Ba        100
    -water    1  # kg

EQUILIBRIUM_PHASES 1
    Talc             0  10
    Rhodochrosite    0  10
    Sepiolite        0  10
    Sepiolite(d)     0  10
    Pb(OH)2          0  10

SELECTED_OUTPUT
    -file   mn3_output2.sel
    -reset  false
    -totals  Mn

USER_PUNCH
    -headings Mn_3_molality Mn_3_moles
    -start
10  PUNCH MOL("Mn+3") + MOL("MnOH+2") 
20  PUNCH TOT("Mn(3)")
    -end

END
