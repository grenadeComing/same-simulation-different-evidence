TITLE Pyrite Oxidation in Pure Water at 25C

SOLUTION 1
    temp      25
    pH        7.0
    pe        4.0
    redox     pe
    units     mol/kgw
    density   1.0
    water     1.0  # kg

EQUILIBRIUM_PHASES 1
    O2(g)     -0.7    10.0   # Constant atmospheric O2 source
    Pyrite     0.0    0.1    # Up to 0.1 moles of Pyrite can react (dissolve)
    Goethite   0.0    0.0    # Allow precipitation
    Gypsum     0.0    0.0    # Allow precipitation

SELECTED_OUTPUT
    -file     pyrite_oxidation.out
    -reset    false
    -pH       true
    -pe       true
    -alkalinity true
    -totals   Fe S Ca
    -equilibrium_phases Pyrite Goethite Gypsum O2(g)

END
