SOLUTION 1
    temp      100
    pH        7 charge
    Ca        50 mmol/kgw

EQUILIBRIUM_PHASES 1
    Calcite    0 10
    Gypsum     0 10
    Aragonite  0 10

GAS_PHASE 1
    -fixed_pressure
    -pressure 16
    -temperature 25
    CO2(g)    1.0
    CH4(g)    5.0
    H2S(g)    10.0

SELECTED_OUTPUT
    -file     sim_alkalinity2.out
    -alkalinity true
    -totals   Ca S C
    -pH       true
    -si       Calcite Gypsum Aragonite

END
