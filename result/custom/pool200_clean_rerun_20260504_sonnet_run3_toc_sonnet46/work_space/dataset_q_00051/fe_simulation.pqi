SOLUTION 1
    temp      100
    pH        3.0
    pe        4
    units     mol/kgw
    water     1

EQUILIBRIUM_PHASES 1
    K-mica        0  10
    Kaolinite     0  10
    Dolomite      0  10
    Epsomite      0  10
    Fe(OH)3(a)    0  10
    Halite        0  10

SELECTED_OUTPUT
    -file       fe_sim_output.txt
    -reset      false
    -totals     Fe(2) Fe(3)
    -molalities Fe+2 Fe+3 FeOH+ Fe(OH)2 Fe(OH)3 Fe(OH)4- FeOH+2 Fe(OH)2+ Fe2(OH)2+4

END
