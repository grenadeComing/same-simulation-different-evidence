SOLUTION 1  River Water
    pH      6.0
    temp    25.0
    units   mmol/L
    Cl      0.2821   # 10 mg/L / 35.453 g/mol * 1000 = 0.2821 mmol/L
    Na      0.2821   charge

SOLUTION 2  Seawater
    pH      8.1
    temp    25.0
    units   mmol/L
    Cl      536.0    # 19000 mg/L / 35.453 g/mol * 1000 = 536.0 mmol/L
    Na      536.0    charge

MIX 1
    1   0.7
    2   0.3

SELECTED_OUTPUT
    -file   mix_output4.sel
    -reset  false
    -pH     true

END
