# Simulation: Mix two solutions 1:1, then heat from 20°C to 200°C in 10 steps
# Solution 1: 50 mmol/kg dissolved inorganic carbon
# Solution 2: 50 mmol/kg calcium
# After 1:1 mixing: 25 mmol/kg C and 25 mmol/kg Ca
# But answers suggest ~50 mmol precipitated - let's try with 1 kg each solution

SOLUTION 1
    temp      20
    pH        7
    units     mmol/kgw
    C(4)      50

SOLUTION 2
    temp      20
    pH        7
    units     mmol/kgw
    Ca        50

# Mix 1:1 (equal volumes/masses)
MIX 1
    1   1.0
    2   1.0

SAVE solution 3

END

# Now heat the mixed solution from 20 to 200°C in 10 steps
# 10 steps: 20, 40, 60, 80, 100, 120, 140, 160, 180, 200
USE solution 3

EQUILIBRIUM_PHASES 1
    Calcite   0   0

REACTION_TEMPERATURE 1
    20 40 60 80 100 120 140 160 180 200

SELECTED_OUTPUT
    -file   mixing_heating2.sel
    -reset  false
    -temperature true
    -equilibrium_phases Calcite

END
