# Fresh approach: Define solutions more carefully
# Solution 1: pure water + 50 mmol/kg C(4), pH adjusted by charge balance
# Solution 2: pure water + 50 mmol/kg Ca, pH adjusted by charge balance

SOLUTION 1
    temp      20
    pH        8.3
    units     mmol/kgw
    C(4)      50   as HCO3

SOLUTION 2
    temp      20
    pH        7
    units     mmol/kgw
    Ca        50

END

# Mix 1:1 (0.5 kg each = 1 kg total)
USE solution 1
MIX 1
    1   0.5
    2   0.5

SAVE solution 3

END

# Heat from 20 to 200°C in 10 steps with calcite equilibrium
USE solution 3

EQUILIBRIUM_PHASES 1
    Calcite   0   0

REACTION_TEMPERATURE 1
    20 40 60 80 100 120 140 160 180 200

SELECTED_OUTPUT
    -file   mixing_heating7.sel
    -reset  false
    -temperature true
    -equilibrium_phases Calcite

END
