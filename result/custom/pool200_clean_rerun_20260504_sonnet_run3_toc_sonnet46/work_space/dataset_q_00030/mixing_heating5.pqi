# Simulation: Mix two solutions 1:1, then heat from 20°C to 200°C in 10 steps
# Solution 1: 50 mmol/kg dissolved inorganic carbon (charge balanced with Na)
# Solution 2: 50 mmol/kg calcium (charge balanced with Cl)
# After 1:1 mixing: 25 mmol/kg C, 25 mmol/kg Ca, 25 mmol/kg Na, 25 mmol/kg Cl

SOLUTION 1
    temp      20
    pH        7   charge
    units     mmol/kgw
    C(4)      50
    Na        50

SOLUTION 2
    temp      20
    pH        7   charge
    units     mmol/kgw
    Ca        50
    Cl        100

# Mix 1:1 (0.5 kg each = 1 kg total)
MIX 1
    1   0.5
    2   0.5

SAVE solution 3

END

# Now heat the mixed solution from 20 to 200°C in 10 steps
USE solution 3

EQUILIBRIUM_PHASES 1
    Calcite   0   0

REACTION_TEMPERATURE 1
    20 40 60 80 100 120 140 160 180 200

SELECTED_OUTPUT
    -file   mixing_heating5.sel
    -reset  false
    -temperature true
    -equilibrium_phases Calcite

END
