# Simulation: Mix two solutions 1:1, then heat from 20°C to 200°C in 10 steps
# Solution 1: 50 mmol/kg dissolved inorganic carbon
# Solution 2: 50 mmol/kg calcium
# Using 1 kg each solution mixed 1:1 (total 2 kg water)
# 10 discrete steps: 20 to 200°C, step size = (200-20)/10 = 18°C
# Temperatures: 20, 38, 56, 74, 92, 110, 128, 146, 164, 182, 200 (11 points, 10 steps)
# At step 5 (92°C) and step 6 (110°C) - 100°C is between steps

SOLUTION 1
    temp      20
    pH        7
    units     mmol/kgw
    C(4)      50

SOLUTION 2
    temp      20
    pH        7
    units     mmol/kgw
    Ca        50

# Mix 1:1 (equal volumes/masses) - using factor 1 for each
MIX 1
    1   1.0
    2   1.0

SAVE solution 3

END

# Now heat the mixed solution from 20 to 200°C in 10 steps
# 10 steps with 18°C increment: 20, 38, 56, 74, 92, 110, 128, 146, 164, 182, 200
USE solution 3

EQUILIBRIUM_PHASES 1
    Calcite   0   0

REACTION_TEMPERATURE 1
    20 38 56 74 92 110 128 146 164 182 200

SELECTED_OUTPUT
    -file   mixing_heating3.sel
    -reset  false
    -temperature true
    -equilibrium_phases Calcite

END
