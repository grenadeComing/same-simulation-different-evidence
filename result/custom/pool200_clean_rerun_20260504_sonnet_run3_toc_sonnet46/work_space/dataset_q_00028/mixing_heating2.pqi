# Simulation: Mix two solutions 1:1, then heat from 20°C to 200°C in 10 steps
# Solution 1: 50 mmol/kg dissolved inorganic carbon
# Solution 2: 50 mmol/kg calcium

SOLUTION 1
    temp      20
    pH        7   charge
    pe        4
    units     mmol/kgw
    C(4)      50

SOLUTION 2
    temp      20
    pH        7   charge
    pe        4
    units     mmol/kgw
    Ca        50

# Mix solutions 1 and 2 in 1:1 ratio
MIX 1
    1   0.5
    2   0.5

SAVE solution 3

END

# Now heat the mixed solution from 20°C to 200°C in 10 steps
USE solution 3

EQUILIBRIUM_PHASES 1
    Calcite   0   0   # Allow calcite to precipitate/dissolve

REACTION_TEMPERATURE 1
    20 200 in 10 steps

SELECTED_OUTPUT
    -file     mixing_heating2.sel
    -reset    false
    -temperature  true
    -pH           true
    -si           Calcite
    -equilibrium_phases  Calcite

END
