TITLE 1D Transport Problem - 10 cells, 10 shifts

# Initial solution (in cells): pH 7.0, Ca 1.0, Cl 2.0 (mmol/L)
SOLUTION 1-10
    pH      7.0
    Ca      1.0
    Cl      2.0

# Infilling solution (solution 0): pH 7.0, Na 1.0, Cl 1.0 (mmol/L)
SOLUTION 0
    pH      7.0
    Na      1.0
    Cl      1.0

# Exchange sites for all 10 cells, equilibrated with solution 1
EXCHANGE 1-10
    X       0.001
    equilibrate 1

TRANSPORT
    -cells          10
    -shifts         10
    -flow_direction forward
    -boundary_conditions flux flux
    -diffusion_coefficient 0.0
    -dispersivity  0.0
    -time_step      1.0
    -length         1.0

SELECTED_OUTPUT
    -file           transport_out2.sel
    -reset          false
    -step
    -solution
    -totals         Na Ca Cl
    -si             H2(g)

END
