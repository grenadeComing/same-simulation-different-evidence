SOLUTION 0 Infilling
    pH 7.0
    Na 1.0
    Cl 1.0
SOLUTION 1-10 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    equilibrate 1
    X 0.001
SELECTED_OUTPUT
    -file selected.out
    -reset false
    -step true
    -solution true
    -alkalinity true
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -correct_disp false
END
