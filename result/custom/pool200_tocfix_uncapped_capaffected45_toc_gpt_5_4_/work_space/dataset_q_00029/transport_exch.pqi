TITLE 1D transport with exchange

SOLUTION 0 Infilling
    temp 25
    pH 7.0
    pe 4
    redox pe
    units mmol/kgw
    Na 1.0
    Cl 1.0

SOLUTION 1-10 Initial
    temp 25
    pH 7.0
    pe 4
    redox pe
    units mmol/kgw
    Ca 1.0
    Cl 2.0

EXCHANGE_SPECIES
    X- = X-
        log_k 0
    Na+ + X- = NaX
        log_k 0
    Ca+2 + 2X- = CaX2
        log_k 0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -correct_disp true
    -lengths 1
    -dispersivities 0
    -time_step 1
    -print_frequency 1
    -punch_frequency 1

SELECTED_OUTPUT
    -file selected.out
    -reset false
    -simulation true
    -state true
    -solution true
    -distance true
    -time true
    -step true

USER_PUNCH
    -headings CaX2_mol
    10 PUNCH MOL("CaX2")
END
