TITLE Albite dissolution with H2S gas at 200 C
SOLUTION 1
    temp      200
    pH        2 charge
    Fe(+3)    4e-3
    Fe(+2)    4e-3
GAS_PHASE 1
    -fixed_pressure true
    -pressure 5
    H2S(g)    5
KINETICS 1
    Albite
        -m0    1
        -m     1
        -parms 1.0 10
        -steps 1000 in 100
USER_PUNCH
    -headings si_species_count
10 PUNCH TOT("Si"), MOL("H4SiO4"), MOL("H3SiO4-"), MOL("H2SiO4-2"), MOL("HSiO3-"), MOL("SiO2")
SELECTED_OUTPUT
    -file selected.out
    -reset false
    -user_punch true
END
