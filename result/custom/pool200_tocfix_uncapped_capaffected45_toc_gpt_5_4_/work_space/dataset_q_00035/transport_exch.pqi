TITLE 1D transport with exchange
SOLUTION 0
    temp 25
    pH 7.0 charge
    Na 1.0
    Cl 1.0
SOLUTION 1-10
    temp 25
    pH 7.0 charge
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    equilibrate 1
    X 0.001
TRANSPORT
    -cells 10
    -shifts 10
SELECTED_OUTPUT
    -file selected.out
    -reset false
    -high_precision true
USER_PUNCH
    -headings step cell cax2 nax frac
10 PUNCH STEP_NO, CELL_NO, MOL("CaX2"), MOL("NaX"), 2*MOL("CaX2")/(2*MOL("CaX2")+MOL("NaX"))
END
