TITLE 1D transport with exchange
SOLUTION 0 Infilling
    temp 25
    pH 7.0
    units mmol/kgw
    Na 1.0
    Cl 1.0
SOLUTION 1-10 Initial
    temp 25
    pH 7.0
    units mmol/kgw
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001 equilibrium_phase 1
    -equilibrate 1
TRANSPORT
    -cells 10
    -shifts 10
SELECTED_OUTPUT
    -file selected2.out
    -reset false
USER_PUNCH
    -headings step cell eqfrac_CaX2
10 PUNCH STEP_NO, CELL_NO, EQUI("CaX2")
END
