SOLUTION 0 Infilling
    pH      7.0
    pe      4
    Na      1.0
    Cl      1.0
SOLUTION 1-10 Initial
    pH      7.0
    pe      4
    Ca      1.0
    Cl      2.0
EXCHANGE 1-10
    equilibrate 1
    X       0.001
SELECTED_OUTPUT
    -file selected.out
    -reset false
    -step true
    -pH true
    -pe true
USER_PUNCH
    -headings cell sim step pH pe
    10 PUNCH CELL_NO, SIM_NO, STEP_NO, -LA("H+"), -LA("e-")
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -correct_disp false
    -lengths 10*1
    -dispersivities 10*0
    -punch_cells 10
    -punch_frequency 1
