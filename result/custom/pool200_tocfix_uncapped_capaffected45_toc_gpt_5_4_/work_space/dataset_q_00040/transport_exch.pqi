TITLE 1D transport with exchange
SOLUTION 0 Inflow
    pH 7.0
    Na 1.0
    Cl 1.0
SOLUTION 1-10 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    equilibrate 1
    X 0.001
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1
    -dispersivities 0
    -correct_disp true
    -diffusion_coefficient 0
    -punch_cells 4
    -punch_frequency 1
SELECTED_OUTPUT
    -file selected.out
    -reset false
    -simulation true
    -state true
    -solution true
    -distance true
    -time true
    -step true
    -pH true
    -totals H Cl Na Ca
    -molalities HCl
END
