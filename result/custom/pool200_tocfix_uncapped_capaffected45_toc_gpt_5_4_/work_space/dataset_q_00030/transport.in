TITLE 1D transport with exchange
SOLUTION 0
    temp 25
    pH 7.0
    units mmol/kgw
    Na 1.0
    Cl 1.0
SOLUTION 1-10
    temp 25
    pH 7.0
    units mmol/kgw
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -correct_disp true
    -diffusion_coefficient 0
    -dispersivities 0
    -print_cells 1
    -print_frequency 1
SELECTED_OUTPUT
    -file selected.out
    -reset false
    -step true
    -solution true
    -distance true
    -pH true
    -ionic_strength true
USER_PUNCH
    -headings step soln dist pH mu sc
    10 PUNCH STEP_NO, SOLN_NO, DIST, -LA("H+"), MU, SC
END
