SOLUTION 1
    temp      100
    pH        5
    pe        4
    units     mmol/kgw
    C(4)      0.5
    Mn(2)     1

KINETICS 1
    Calcite
        -m0     1
        -m      1
        -parms  10.0  0.001
        -tol    1e-8
    -steps 1000 in 100

INCREMENTAL_REACTIONS true

SELECTED_OUTPUT
    -file result6.out
    -reset false
    -step
    -pe
    -pH
    -totals Ca C(4) Mn
    -kinetic_reactants Calcite
    -saturation_indices Calcite

END
