SOLUTION 1
    temp      100
    pH        5
    pe        4
    units     mmol/kgw
    C(4)      0.5
    Mn        1

RATES
Calcite_custom
    -start
    10 si_cc = SI("Calcite")
    20 rate = PARM(1) * PARM(2) * (1 - 10^si_cc)
    30 moles = rate * TIME
    40 IF (moles > M) THEN moles = M
    50 SAVE moles
    -end

KINETICS 1
    Calcite_custom
        -formula CaCO3 1.0
        -m0     1
        -m      1
        -parms  10.0  0.001
        -tol    1e-8
    -steps 1000 in 100

INCREMENTAL_REACTIONS true

SELECTED_OUTPUT
    -file result.out
    -reset false
    -step
    -pe
    -pH
    -totals Ca C(4) Mn
    -kinetic_reactants Calcite_custom
    -saturation_indices Calcite

END
