SOLUTION 1
    temp      100
    pH        5
    pe        4
    units     mmol/kgw
    C(4)      0.5
    Mn        1

KINETICS 1
    Calcite
        -m0  1
        -m   1
        -parms 10.0  0.001
        -tol 1e-8

    -steps 1000 in 100

SELECTED_OUTPUT
    -file result3.out
    -totals Ca C(4) Mn
    -kinetics Calcite
    -saturation_indices Calcite Aragonite
    -pH
    -pe
    -time

END
