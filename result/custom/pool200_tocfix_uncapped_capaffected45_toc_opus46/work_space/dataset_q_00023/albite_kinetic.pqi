SOLUTION 1
    temp      200
    pH        2
    pe        4
    redox     pe
    units     mmol/kgw
    Fe(3)     4
    Fe(2)     4

KINETICS 1
    Albite
        -m0  1
        -m   1
        -parms 1.0  10
        -tol 1e-8
    -steps 1000 in 100

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g)    5.0

SELECTED_OUTPUT
    -file selected_output.txt
    -reset false
    -step true
    -totals Ba

END
