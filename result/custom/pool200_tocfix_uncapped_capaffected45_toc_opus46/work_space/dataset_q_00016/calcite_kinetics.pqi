SOLUTION 1
    temp      200
    pH        2
    pe        4
    units     mmol/kgw
    Cu        10
    Ba        5

KINETICS 1
    Calcite
        -m0  1
        -m   1
        -parms 1.0  10
        -tol 1e-8

    -steps 1000 in 100

INCREMENTAL_REACTIONS true

SELECTED_OUTPUT
    -file result.out
    -step
    -totals C(4) Cu(2)
    -molalities CO3-2 HCO3- CaCO3 CaHCO3+ CO2 MgCO3 NaHCO3 NaCO3- CuCO3 Cu(CO3)2-2 CuHCO3+ Cu+2 CuOH+ Cu(OH)2 CuCl+ CuCl2 Cu+ CuCl2-

END
