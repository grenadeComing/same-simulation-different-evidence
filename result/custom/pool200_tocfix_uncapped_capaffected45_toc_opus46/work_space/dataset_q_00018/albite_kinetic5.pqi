RATES
Albite_custom
    -start
    10 rate = PARM(1) * PARM(2) * (m/m0) * (1 - SR("Albite"))
    20 moles = rate * TIME
    30 SAVE moles
    -end

SOLUTION 1
    temp      200
    pH        2
    pe        4.0
    redox     pe
    units     mmol/kgw
    Fe(2)     4
    Fe(3)     4

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    -temp 200
    -volume 1000
    H2S(g) 5.0

KINETICS 1
    Albite_custom
        -formula NaAlSi3O8 1.0
        -m0 1.0
        -m  1.0
        -parms 1.0  10
        -tol 1e-8

    -steps 1000 in 100

SELECTED_OUTPUT
    -file selected5.out
    -reset false
    -step
    -pe
    -pH
    -totals Fe(2) Fe(3) Na Al Si S(-2)
    -kinetic_reactants Albite_custom
    -gases H2S(g)

END
