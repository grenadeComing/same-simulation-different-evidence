SOLUTION 1
    temp      100
    pH        5
    pe        4
    units     mmol/kgw
    C(4)      0.5
    Mn        1

RATES
Calcite_dissolve
    -start
10 A = PARM(1)
20 k = PARM(2)
30 sr_cc = SR("Calcite")
40 IF (M <= 0) THEN GOTO 200
50 rate = A * k * (1 - sr_cc) * (M/M0)^0.67
60 moles = rate * TIME
70 IF (moles > M) THEN moles = M
80 SAVE moles
90 GOTO 300
200 SAVE 0
300 END
    -end

KINETICS 1
Calcite_dissolve
    -formula CaCO3 1
    -m0 1
    -m  1
    -parms 10.0 0.001
    -steps 1000 in 100
    -tol 1e-8
    -bad_step_max 1000

SELECTED_OUTPUT
    -file calcite_sel.tsv
    -reset false
    -step true
    -time true
    -pH true
    -pe true
    -totals Ca C(4) Mn
    -kinetic_reactants Calcite_dissolve
    -saturation_indices Calcite

END
