SOLUTION 1
    temp      200
    pH        2
    pe        4.0
    redox     pe
    units     mmol/kgw
    Fe(2)     4
    Fe(3)     4

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g)    5.0

KINETICS 1
    Albite
        -m0  1.0
        -m   1.0
        -parms 1.0  10
        -tol 1e-12

    -steps 1000 in 100

SELECTED_OUTPUT
    -file selected.out
    -totals Si
    -kinetic_reactants Albite

END
