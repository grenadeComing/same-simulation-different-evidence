SOLUTION 0  # Infilling solution
    pH      7.0
    Na      1.0
    Cl      1.0
    -units  mmol/kgw

SOLUTION 1-10  # Initial solution in cells
    pH      7.0
    Ca      1.0
    Cl      2.0
    -units  mmol/kgw

EXCHANGE 1-10
    X       0.001
    -equilibrate 1

SELECTED_OUTPUT
    -file   result.out
    -reset  false
    -solution true
    -step    true
    -totals Na Ca Cl
    -activities Na+ Ca+2 Cl-

TRANSPORT
    -cells  10
    -shifts 10
    -lengths        1.0
    -dispersivities 0.0
    -diffusion_coefficient 0.0
    -correct_disp   true
    -punch_cells    1-10
    -punch_frequency 10

END
