SOLUTION 1
    temp      200
    pH        2
    pe        4
    units     mmol/kgw
    Cu        10
    Ba        5

RATES
    Calcite_custom
    -start
    10 rate = 10 * 1.0 * (1 - SR("Calcite"))
    20 moles = rate * TIME
    30 SAVE moles
    -end

KINETICS 1
    Calcite_custom
        -formula CaCO3 1
        -m0  1
        -m   1
        -tol 1e-8

    -steps 1000 in 100

INCREMENTAL_REACTIONS true

SELECTED_OUTPUT
    -file sel_out.tsv
    -step
    -totals Ca C Cu Ba
    -pH
    -pe
    -alkalinity
    -kinetic_reactants Calcite_custom

END
