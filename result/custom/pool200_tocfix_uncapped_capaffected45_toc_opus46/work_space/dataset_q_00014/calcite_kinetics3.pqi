SOLUTION 1
    temp      200
    pH        2
    pe        4
    units     mmol/kgw
    Cu        10
    Ba        5

KINETICS 1
    Calcite
        -m0  1
        -m   1
        -parms 10  1.0
        -tol 1e-8

    -steps 1000 in 100

INCREMENTAL_REACTIONS true

SELECTED_OUTPUT
    -file result3.out
    -reset false
    -step
    -time
    -kinetic_reactants Calcite

END
