SOLUTION 1
    temp      200
    pH        2
    Fe(2)     4  # mmol/kgw
    Fe(3)     4  # mmol/kgw

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g)    5.0

KINETICS 1
    Albite
        -m0  1.0
        -m   1.0
        -parms 1.0  10
        -tol 1e-8

    -steps 1000 in 100

SELECTED_OUTPUT
    -file result.out
    -reset false
    -step true
    -ionic_strength true
    -time true

END
