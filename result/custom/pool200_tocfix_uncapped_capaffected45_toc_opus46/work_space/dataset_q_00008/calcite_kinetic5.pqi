SOLUTION 1
    temp      100
    pH        5
    pe        4
    units     mmol/kgw
    C(4)      0.5
    Mn        1

RATES
Calcite_dissolve
    -start
10 rem parm(1) = specific surface area (m2/mol), parm(2) = rate constant (mol/m2/s)
20 SR_calc = SR("Calcite")
30 if (M <= 0 and SR_calc < 1) then goto 200
40 rate = PARM(2) * PARM(1) * (1 - SR_calc)
50 moles = rate * TIME
60 if (moles > M) then moles = M
200 SAVE moles
    -end

KINETICS 1
Calcite_dissolve
    -formula Calcite 1
    -m       1
    -m0      1
    -parms   10.0  0.001
    -tol     1e-8
-steps 1000 in 100

INCREMENTAL_REACTIONS true

SELECTED_OUTPUT
    -file result5.out
    -reset false
    -step
    -time
    -pH
    -pe
    -totals Ca C(4) Mn
    -kinetic_reactants Calcite_dissolve
    -saturation_indices Calcite

END
