SOLUTION 1
  temp 100
  pH 7 charge
  units mmol/kgw
  Ca 50

EQUILIBRIUM_PHASES 1
  Calcite 0 0
  Gypsum 0 0
  Aragonite 0 0

GAS_PHASE 1
  -fixed_pressure
  -temperature 25
  CO2(g) 1
  CH4(g) 5
  H2S(g) 10

SELECTED_OUTPUT
  -file sel.txt
  -reset false
USER_PUNCH
  -headings n_CO2_diss n_CH4_diss n_H2S_diss
  10 PUNCH TOT("C(4)"), TOT("C(-4)"), TOT("S(-2)")
END
