SOLUTION 1
    temp 100
    pH 3 charge
    pe 4
    units mol/kgw
    -water 1

EQUILIBRIUM_PHASES 1
    K-mica 0 10
    Kaolinite 0 10
    Dolomite 0 10
    Epsomite 0 10
    Fe(OH)3(a) 0 10
    Halite 0 10

SELECTED_OUTPUT
    -file selected.tsv
    -reset false
USER_PUNCH
    -headings mol_Fe2 mol_Fe3
    10 PUNCH MOL("Fe+2")
    20 PUNCH MOL("Fe+3")
END
