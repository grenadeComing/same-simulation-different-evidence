SOLUTION 0  Initial
    pH 7.0
    Ca 1.0
    Cl 2.0
SOLUTION 1-10  Initial_cells
    pH 7.0
    Ca 1.0
    Cl 2.0
SOLUTION 11  Infilling
    pH 7.0
    Na 1.0
    Cl 1.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -initial_time 0
    -time_step 1
    -diffusion_coefficient 0
    -dispersivity 0
    -lengths 1
    -punch_cells 4
    -punch_frequency 1
END

SELECTED_OUTPUT
    -file sel_out.txt
    -reset false
USER_PUNCH
    -headings shift mol_HCl
10 PUNCH SHIFT, MOL("HCl")
