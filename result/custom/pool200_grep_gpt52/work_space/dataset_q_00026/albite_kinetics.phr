TITLE Albite kinetics, pH 2, 200C, Fe2/Fe3, H2S(g) 5 atm

SOLUTION 1
    temp 200
    pH 2 charge
    Fe(2) 4 mmol/kgw
    Fe(3) 4 mmol/kgw
    -water 1

GAS_PHASE 1
    -fixed_pressure
    -pressure 5
    H2S(g) 1

KINETICS 1
    Albite
        -m0 1
        -m  1
        -parms 1.0 10
        -tol 1e-14
    -steps 10 100

SELECTED_OUTPUT
    -file selected.sel
    -reset false
USER_PUNCH
    -headings step Si_species_count
    -start
10 PUNCH STEP_NO
20 cnt = 0
30 n = TOT("Si")
40 FOR i = 1 TO n
50   name$ = TOT_NAME$(i,"Si")
60   IF (name$ <> "") THEN cnt = cnt + 1
70 NEXT i
80 PUNCH cnt
    -end
END
