TITLE Equilibration at 100C, pH 5, Ba 0.1 mol/kgw with mineral assemblage
SOLUTION 1
    temp 100
    pH 5 charge
    units mol/kgw
    Ba 0.1
EQUILIBRIUM_PHASES 1
    Talc 0 10
    Rhodochrosite 0 10
    Sepiolite 0 10
    Sepiolite(d) 0 10
    Pb(OH)2 0 10
SELECTED_OUTPUT
    -file selected.csv
    -reset false
    -ph true
    -totals Ba Mg Si Mn Pb C
USER_PUNCH
    -headings Talc_delta Rhodo_delta Sepiolite_delta Sepiolite_d_delta PbOH2_delta
    10 PUNCH EQUI_DELTA("Talc"), EQUI_DELTA("Rhodochrosite"), EQUI_DELTA("Sepiolite"), EQUI_DELTA("Sepiolite(d)"), EQUI_DELTA("Pb(OH)2")
END
