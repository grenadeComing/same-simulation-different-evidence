SOLUTION 1 DIC
    temp 20
    units mmol/kgw
    pH 7 charge
    C(4) 50

SOLUTION 2 Ca
    temp 20
    units mmol/kgw
    pH 7 charge
    Ca 50

MIX 1
    1 0.5
    2 0.5

EQUILIBRIUM_PHASES 1
    Calcite 0 0

REACTION_TEMPERATURE 1
    20 38 56 74 92 110 128 146 164 182 200

SELECTED_OUTPUT
    -reset false
    -high_precision true
USER_PUNCH
    -headings step temp pH
10 PUNCH STEP_NO, TC, -LA("H+")
END
