SOLUTION 1
    temp 25
    pH   7 charge
    units mol/kgw
    -water 1

EQUILIBRIUM_PHASES 1
    O2(g)  -0.7  10
    Pyrite 0     0.1
    Goethite 0   0
    Gypsum 0     0

SELECTED_OUTPUT
    -file pyrite_ox.sel
    -pH true
    -pe true
    -totals Fe S(6)
USER_PUNCH
    -headings Fe2_molal Fe3_molal
    10 PUNCH MOL("Fe+2"), MOL("Fe+3")
END
