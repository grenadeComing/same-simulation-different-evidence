SOLUTION 1
    temp 100
    pH   3 charge
    -water 1

EQUILIBRIUM_PHASES 1
    K-mica      0 10
    Kaolinite   0 10
    Dolomite    0 10
    Epsomite    0 10
    Fe(OH)3(a)  0 10
    Halite      0 10

SELECTED_OUTPUT
    -file kaol_sel.txt
    -reset false
USER_PUNCH
    -headings kaolinite_moles_final
    10 PUNCH EQUI("Kaolinite")
END
