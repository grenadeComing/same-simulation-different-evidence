TITLE 1D transport, 10 cells, 10 shifts, exchange in all cells

SOLUTION 0  # inflow solution
    pH 7.0
    Na 1.0
    Cl 1.0

SOLUTION 1-10  # initial solutions in cells
    pH 7.0
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -time_step 1
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1
    -dispersivities 0
    -correct_disp true
    -print_cells 1
    -print_frequency 10

SELECTED_OUTPUT
    -file selected.csv
    -reset false
USER_PUNCH
    -headings step pe_cell1
10 PUNCH TRANSPORT_STEP, -LA("pe")
END
