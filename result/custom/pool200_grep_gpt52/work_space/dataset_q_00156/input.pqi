SOLUTION 0 Infilling
    pH 7.0
    Na 1.0
    Cl 1.0
SOLUTION 1-10 Initial
    pH 7.0
    Ca 1.0
    Cl 2.0
EXCHANGE 1-10
    X 0.001
    -equilibrate 1
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1
    -time_step 1
    -punch_cells 4
SELECTED_OUTPUT
    -file sel.txt
    -reset false
USER_PUNCH
    -headings step NaX
10 PUNCH SHIFT, MOL("NaX")
END
