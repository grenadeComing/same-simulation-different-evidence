SOLUTION 1
    temp 150
    pH 7
    pe 4
    -water 1

GAS_PHASE 1
    -fixed_pressure
    -pressure 1
    -temperature 150
    CH4(g)  1 10
    CO2(g)  1 10
    NH3(g)  1 5

SELECTED_OUTPUT
    -file selected.txt
    -reset false
USER_PUNCH
    -headings C_species_count
10 PUNCH COUNT_SPECIES
END
