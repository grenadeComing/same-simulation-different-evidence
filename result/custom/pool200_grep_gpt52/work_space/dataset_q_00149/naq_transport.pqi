SOLUTION 0  Initial solution
    pH 7.0
    Ca 1.0
    Cl 2.0
SOLUTION 1-10  Initial in cells
    pH 7.0
    Ca 1.0
    Cl 2.0
SOLUTION 11  Infilling solution
    pH 7.0
    Na 1.0
    Cl 1.0
EXCHANGE 1-10
    X 0.001
    -equilibrate 1
TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1
    -dispersivities 0
    -correct_disp true
    -diffusion_coefficient 0
    -punch_frequency 1
    -print_frequency 1
SELECTED_OUTPUT
    -file naq_sel.tsv
    -reset false
    -high_precision true
USER_PUNCH
    -headings step cell NaX_molality
10 PUNCH STEP_NO, CELL_NO, MOL("NaX")
END
