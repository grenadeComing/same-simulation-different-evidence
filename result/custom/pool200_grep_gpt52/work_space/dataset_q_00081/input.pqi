SOLUTION 1 Pure water
    temp 150
    pH 7 charge
    pe 4
    -water 1

GAS_PHASE 1 Fixed P
    -fixed_pressure
    -pressure 1
    -temperature 150
    CH4(g)  0.4  10
    CO2(g)  0.4  10
    NH3(g)  0.2  5

SELECTED_OUTPUT
    -file selected.csv
    -reset false
USER_PUNCH
    -headings m_NH4 m_NH3
    10 PUNCH MOL("NH4+"), MOL("NH3")
END
