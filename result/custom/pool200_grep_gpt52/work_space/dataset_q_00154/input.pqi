SOLUTION 1
    pH 7.0
    units mmol/kgw
    Ca 1.0
    Cl 2.0

SOLUTION 0
    pH 7.0
    units mmol/kgw
    Na 1.0
    Cl 1.0

SOLUTION 2-10
    pH 7.0
    units mmol/kgw
    Ca 1.0
    Cl 2.0

EXCHANGE 1-10
    X 0.001
    -equilibrate 1

TRANSPORT
    -cells 10
    -shifts 10
    -flow_direction forward
    -boundary_conditions flux flux
    -lengths 1
    -dispersivities 0
    -time_step 1

SELECTED_OUTPUT
    -file selected.txt
    -reset false
USER_PUNCH
    -headings shift cell mu
    10 PUNCH SHIFT, CELL_NO, MU
END
