SOLUTION 1
    temp      200
    pH        2 charge
    pe        4
    units     mmol/kgw
    Cu        0.01
    Ba        0.005

KINETICS 1
    Calcite
        -m0     1
        -m      1
        -parms  1.0  10
        -steps  1000 in 100
        -tol    1e-12

KNOBS
    -iterations 500

SELECTED_OUTPUT
    -file sel.out
    -reset false
    -time
    -step
    -pH
END
